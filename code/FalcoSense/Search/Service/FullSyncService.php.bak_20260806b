<?php
declare(strict_types=1);

namespace FalcoSense\Search\Service;

use FalcoSense\Search\Helper\Data;
use FalcoSense\Search\Model\FullSyncPublisher;
use Magento\Catalog\Model\Product\Attribute\Source\Status;
use Magento\Catalog\Model\ResourceModel\Product\CollectionFactory;
use Magento\ConfigurableProduct\Model\Product\Type\Configurable;
use Psr\Log\LoggerInterface;

class FullSyncService
{
    private const BATCH_SIZE = 500;

    // Products priced above this are excluded from sync — placeholder/test pricing
    // (e.g. 99999) has repeatedly polluted the platform index and required manual cleanup.
    private const MAX_SYNC_PRICE = 90000.0;

    public function __construct(
        private readonly CollectionFactory     $collectionFactory,
        private readonly FullSyncPublisher     $publisher,
        private readonly Data                  $helper,
        private readonly LoggerInterface       $logger,
        private readonly DisabledParentResolver $disabledParentResolver,
        private readonly ProductSyncService    $syncService,
    ) {}

    /**
     * Load every enabled, in-stock, non-configurable, non-superseded product ID
     * priced at or below MAX_SYNC_PRICE, in pages of 500, publish each page as
     * one queue message.
     * Returns ['products' => int, 'batches' => int].
     */
    public function queueAll(int $magentoStoreId = 0): array
    {
        $page         = 1;
        $totalQueued  = 0;
        $totalBatches = 0;

        // A configurable child keeps its own independent status attribute --
        // disabling the parent does NOT disable its children. Without this,
        // an individually-still-Enabled child would sync on its own even
        // though its parent (the only thing actually shown/sold) is Disabled.
        $orphanedChildIds = $this->disabledParentResolver->getOrphanedChildIds($magentoStoreId);
        $orphanedChildIdSet = array_flip($orphanedChildIds);
        if (!empty($orphanedChildIds)) {
            $this->logger->info(sprintf(
                '[SmartSearch][FullSync] Excluding %d child product(s) of a disabled parent.',
                count($orphanedChildIds)
            ));
        }

        do {
            $rawItems = $this->fetchProductPage($page, $magentoStoreId);

            if (empty($rawItems)) {
                break;
            }

            $ids = empty($orphanedChildIdSet)
                ? array_map(static fn($p) => (int) $p->getId(), $rawItems)
                : array_map(
                    static fn($p) => (int) $p->getId(),
                    array_filter($rawItems, static fn($p) =>
                        !isset($orphanedChildIdSet[(int) $p->getId()])
                    )
                );

            if (!empty($ids)) {
                $this->publisher->publishBatch($ids, $magentoStoreId);

                $count = count($ids);
                $totalQueued  += $count;
                $totalBatches++;

                $this->logger->info(sprintf(
                    '[SmartSearch][FullSync] Queued page %d: %d product IDs (running total: %d).',
                    $page,
                    $count,
                    $totalQueued
                ));
            }

            $page++;
        } while (count($rawItems) === self::BATCH_SIZE);

        $this->logger->info(sprintf(
            '[SmartSearch][FullSync] Done queuing. products=%d batches=%d',
            $totalQueued,
            $totalBatches
        ));

        // ── Disabled/OOS/excluded sweep ─────────────────────────────────────
        // The upsert loop above only sends enabled+in-stock+non-configurable+
        // price-eligible products to the platform. Without this sweep, any
        // product previously synced but now disabled, OOS, changed to
        // configurable, or repriced above MAX_SYNC_PRICE stays in the platform
        // index — its attributes (color, brand, size) inflate facet counts even
        // though the product never appears in results.
        // No updated_at cursor here: full sync always scans the entire catalog.
        // This mirrors the sweep in Cron\ProductSync::execute().
        $deletePage   = 1;
        $totalDeleted = 0;
        do {
            $delCollection = $this->buildExcludedProductsCollection($magentoStoreId, $deletePage);
            $delIds        = array_map('intval', $delCollection->getAllIds());

            if (empty($delIds)) {
                break;
            }

            $delCount = $this->syncService->deleteBatch($delIds, $magentoStoreId);

            if ($delCount === -1) {
                $this->logger->error(sprintf(
                    '[SmartSearch][FullSync] Disabled/OOS/excluded sweep: connection failed or invalid API key (store %d).',
                    $magentoStoreId
                ));
                break;
            }

            $totalDeleted += max(0, $delCount);
            $this->logger->info(sprintf(
                '[SmartSearch][FullSync] Disabled/OOS/excluded sweep: deleted %d stale product(s) (store %d, page %d).',
                max(0, $delCount),
                $magentoStoreId,
                $deletePage
            ));

            $deletePage++;
        } while (count($delIds) === self::BATCH_SIZE);

        if ($totalDeleted > 0) {
            $this->logger->info(sprintf(
                '[SmartSearch][FullSync] Disabled/OOS/excluded sweep complete — removed %d stale product(s) from platform index.',
                $totalDeleted
            ));
        }

        return ['products' => $totalQueued, 'batches' => $totalBatches];
    }

    /**
     * Products that are disabled, OR out-of-stock, OR configurable, OR priced
     * above MAX_SYNC_PRICE — used by the full-sync sweep to clean stale/excluded
     * entries from the platform index. No updated_at cursor: full sync always
     * scans the entire catalog unconditionally.
     * Mirrors Cron\ProductSync::buildDisabledOrOosCollection() plus the
     * configurable/price exclusions added to fetchProductPage() below.
     */
    private function buildExcludedProductsCollection(int $storeId, int $page): \Magento\Catalog\Model\ResourceModel\Product\Collection
    {
        $collection = $this->collectionFactory->create();
        $collection->setStoreId($storeId);
        if ($storeId > 0) {
            $collection->addStoreFilter($storeId);
        }
        $collection->addAttributeToSelect(['status', 'price']);

        $collection->joinField(
            'is_in_stock',
            'cataloginventory_stock_item',
            'is_in_stock',
            'product_id=entity_id',
            ['stock_id' => 1],
            'left'
        );

        // status = disabled OR is_in_stock = 0 (left-joined, so NULL = no stock row = OOS)
        // OR type_id = configurable OR price > MAX_SYNC_PRICE
        $collection->addFieldToFilter(
            ['status', 'is_in_stock', 'type_id', 'price'],
            [
                ['eq' => Status::STATUS_DISABLED],
                ['eq' => 0],
                ['eq' => Configurable::TYPE_CODE],
                ['gt' => self::MAX_SYNC_PRICE],
            ]
        );

        $collection->setOrder('entity_id', 'ASC');
        $collection->setPageSize(self::BATCH_SIZE);
        $collection->setCurPage($page);

        return $collection;
    }

    private function fetchProductPage(int $page, int $storeId): array
    {
        $collection = $this->collectionFactory->create();
        $collection->addAttributeToSelect(['sku', 'price']);
        $collection->addAttributeToFilter('status', Status::STATUS_ENABLED);

        // Exclude configurable products — only their enabled/in-stock simple
        // children should ever be synced individually.
        $collection->addAttributeToFilter('type_id', ['neq' => Configurable::TYPE_CODE]);

        // Exclude products priced above MAX_SYNC_PRICE (placeholder/test pricing).
        $collection->addAttributeToFilter('price', ['lteq' => self::MAX_SYNC_PRICE]);

        // OOS exclusion — full sync only, never the real-time save observer.
        $collection->joinField(
            'is_in_stock',
            'cataloginventory_stock_item',
            'is_in_stock',
            'product_id=entity_id',
            ['stock_id' => 1],
            'inner'
        );
        $collection->addFieldToFilter('is_in_stock', 1);

        $collection->setPageSize(self::BATCH_SIZE);
        $collection->setCurPage($page);

        if ($storeId > 0) {
            $collection->addStoreFilter($storeId);
        }

        return array_values($collection->getItems());
    }
}
