<?php
declare(strict_types=1);

namespace FalcoSense\Search\ViewModel;

use FalcoSense\Search\Model\StyleConfig\Reader;
use Magento\Framework\View\Element\Block\ArgumentInterface;

/**
 * Exposes FalcoSense style config values to templates rendered by block classes
 * this module does not own (e.g. Webkul\Marketplace\Block\Profile), via layout
 * <arguments> injection instead of a custom block class.
 */
class StyleConfig implements ArgumentInterface
{
    public function __construct(
        private readonly Reader $reader
    ) {
    }

    public function getValue(string $componentCode, string $attributeCode, string $default = ''): string
    {
        return $this->reader->getValue($componentCode, $attributeCode) ?? $default;
    }
}
