<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>

        <tab id="ahy" translate="label" sortOrder="5">
            <label>Ahy</label>
        </tab>

        <section id="smart_search" translate="label" sortOrder="20"
                 showInDefault="1" showInWebsite="1" showInStore="1">
            <label>FalcoSense</label>
            <tab>ahy</tab>
            <resource>FalcoSense_Search::config</resource>

            <group id="general" translate="label" sortOrder="10"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General Settings</label>

                <field id="version_info" translate="label" sortOrder="1"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label></label>
                    <frontend_model>FalcoSense\Search\Block\Adminhtml\System\Config\VersionInfo</frontend_model>
                </field>

                <field id="frontend_enabled" translate="label" type="select"
                       sortOrder="5" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Frontend UI</label>
                    <comment>Controls the custom search overlay, category page, and product sliders. Disable to fall back to the store's native search and category layout.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <field id="header_mount" translate="label comment" type="select"
                       sortOrder="7" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Header Search Mount</label>
                    <comment><![CDATA[Where the search attaches in the header. <b>Automatic</b> detects the theme family and is correct for almost every store &mdash; only change this if the search box does not appear, or appears outside the header. This does not switch FalcoSense search on or off.]]></comment>
                    <source_model>FalcoSense\Search\Model\Config\Source\HeaderMount</source_model>
                    <depends><field id="frontend_enabled">1</field></depends>
                </field>

                <field id="enabled" translate="label" type="select"
                       sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Sync</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <field id="realtime_sync_enabled" translate="label" type="select"
                       sortOrder="11" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Real-Time Sync</label>
                    <comment>When enabled, product saves and stock changes are synced immediately. When disabled, only the cron sync runs.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>

                <field id="endpoint_url" translate="label" type="text"
                       sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Platform Endpoint URL</label>

                </field>

                <field id="api_key" translate="label" type="password"
                       sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>API Key</label>
                    <comment>X-Api-Key sent to the platform with every ingest request</comment>
                    <config_path>smart_search/general/api_key</config_path>
                </field>

                <field id="search_url" translate="label" type="text"
                       sortOrder="35" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Search API URL</label>

                </field>


            </group>

            <group id="add_to_cart_button" translate="label" sortOrder="15"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Product Card: Add to Cart Button</label>

                <field id="card_preview" translate="label" sortOrder="5"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label></label>
                    <frontend_model>FalcoSense\Search\Block\Adminhtml\System\Config\CardPreview</frontend_model>
                </field>

                <field id="border_radius" translate="label" type="text"
                       sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Corner Roundness (px)</label>
                    <comment>0 = square corners, 9999 = fully rounded pill shape. Applies to the header search Add/Options button.</comment>
                    <backend_model>FalcoSense\Search\Model\Config\Backend\StyleValue</backend_model>
                </field>

                <field id="icon" translate="label" type="image"
                       sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Icon</label>
                    <comment>Upload a PNG/SVG icon to replace the default cart icon on the Add button. Leave empty to keep the default.</comment>
                    <backend_model>FalcoSense\Search\Model\Config\Backend\StyleImage</backend_model>
                    <upload_dir config="system/filesystem/media">falcosense/icons</upload_dir>
                    <base_url type="media">falcosense/icons</base_url>
                </field>

                <field id="button_style" translate="label" type="select"
                       sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Button Style</label>
                    <comment>Applies to both the Add and Options buttons.</comment>
                    <source_model>FalcoSense\Search\Model\Config\Source\ButtonStyle</source_model>
                    <backend_model>FalcoSense\Search\Model\Config\Backend\StyleValue</backend_model>
                </field>

                <field id="label_text" translate="label" type="text"
                       sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Add Button Label Text</label>
                    <comment>Shown on the Add button's idle state (simple products). Leave blank to keep the default ("Add"). Max 50 characters.</comment>
                    <backend_model>FalcoSense\Search\Model\Config\Backend\StyleValue</backend_model>
                </field>

                <field id="options_label_text" translate="label" type="text"
                       sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Options Button Label Text</label>
                    <comment>Shown on the Options button (configurable products). Leave blank to keep the default ("Options"). Max 50 characters.</comment>
                    <backend_model>FalcoSense\Search\Model\Config\Backend\StyleValue</backend_model>
                </field>

            </group>

            <group id="product_card" translate="label" sortOrder="16"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Product Card</label>

                <field id="corner_radius" translate="label" type="text"
                       sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Corner Roundness (px)</label>
                    <comment>0 = square corners. Applies to every product card.</comment>
                    <backend_model>FalcoSense\Search\Model\Config\Backend\StyleValue</backend_model>
                </field>

                <field id="border_shadow_style" translate="label" type="select"
                       sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Border &amp; Shadow Style</label>
                    <source_model>FalcoSense\Search\Model\Config\Source\BorderShadowStyle</source_model>
                    <backend_model>FalcoSense\Search\Model\Config\Backend\StyleValue</backend_model>
                </field>

                <field id="card_spacing" translate="label" type="text"
                       sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Card Spacing (px)</label>
                    <comment>Gap between cards in the grid.</comment>
                    <backend_model>FalcoSense\Search\Model\Config\Backend\StyleValue</backend_model>
                </field>

                <field id="columns_per_row" translate="label" type="select"
                       sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Columns Per Row (Desktop)</label>
                    <comment>Applies to the search results, category, and seller profile grids at desktop width (1280px+). Not applied to homepage sliders. Tablet width stays fixed at 2 columns.</comment>
                    <source_model>FalcoSense\Search\Model\Config\Source\ColumnsPerRow</source_model>
                    <backend_model>FalcoSense\Search\Model\Config\Backend\StyleValue</backend_model>
                </field>

            </group>

            <group id="plp" translate="label" sortOrder="17"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>PLP</label>
                <comment>Storefront-specific values the listing components need. These were hardcoded to one store's data until now; a store that leaves them blank simply gets the behaviour switched off, never an error.</comment>

                <field id="fallback_image" translate="label comment" type="text"
                       sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Fallback Product Image</label>
                    <comment>Shown when a product has no image or the image fails to load. A path relative to the site root, e.g. /media/placeholder.png, or a full URL. Leave blank to show nothing rather than a placeholder.</comment>
                </field>

                <field id="cdn_base" translate="label comment" type="text"
                       sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Image CDN Base URL</label>
                    <comment>Origin that product images are rewritten to, e.g. https://static.example.com. Leave blank to serve images from this store's own /media.</comment>
                </field>

                <field id="free_shipping_sellers" translate="label comment" type="textarea"
                       sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Free Shipping Sellers</label>
                    <comment>Comma-separated seller names whose products show a FREE Shipping badge on the card. Leave blank on a single-seller store — no badge is shown.</comment>
                </field>

                <field id="default_seller" translate="label comment" type="text"
                       sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Default Seller Name</label>
                    <comment>Shown as "Sold By" when a product carries no seller. Leave blank to omit the line entirely.</comment>
                </field>

                <field id="scroll_offset" translate="label comment" type="text"
                       sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Scroll Offset (px)</label>
                    <comment>Space left clear above the results when a filter or page change scrolls them into view. Set this to the height of a sticky header so results do not land underneath it. 0 for no offset.</comment>
                    <validate>validate-digits</validate>
                </field>

            </group>

<group id="tools" translate="label" sortOrder="20"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Tools</label>

                <field id="sync_status" translate="label" sortOrder="5"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Sync Status</label>
                    <frontend_model>FalcoSense\Search\Block\Adminhtml\System\Config\SyncStatus</frontend_model>
                </field>

                <field id="full_sync_button" translate="label" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Full Product Sync</label>
                    <comment>Push all products to the search platform via ingest API (background). Monitor: tail -f var/log/smartsearch-full-sync.log</comment>
                    <frontend_model>FalcoSense\Search\Block\Adminhtml\System\Config\SyncAllButton</frontend_model>
                </field>

            </group>
        </section>

    </system>
</config>
