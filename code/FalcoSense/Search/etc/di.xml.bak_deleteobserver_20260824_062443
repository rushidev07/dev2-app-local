<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="smartsearch_full_sync" xsi:type="object">FalcoSense\Search\Console\Command\FullSyncCommand</item>
                <item name="smartsearch_image_compress" xsi:type="object">FalcoSense\Search\Console\Command\ImageCompressCommand</item>
            </argument>
        </arguments>
    </type>

    <!-- Bypass Magento's CatalogSearch result controller — it runs a full product
         collection query (150k+ rows) even though we render results via our own API.
         Our replacement just renders the page layout with no catalog queries. -->
    <preference for="Magento\CatalogSearch\Controller\Result\Index"
                type="FalcoSense\Search\Controller\Result\Index"/>

    <!-- Dedicated real-time sync logger → var/log/smartsearch-realtime.log -->
    <virtualType name="FalcoSense\Search\Logger\RealtimeSyncLoggerVirtual" type="FalcoSense\Search\Logger\RealtimeSyncLogger">
        <arguments>
            <argument name="name" xsi:type="string">smartsearch_realtime</argument>
            <argument name="handlers" xsi:type="array">
                <item name="realtime" xsi:type="object">FalcoSense\Search\Logger\Handler\RealtimeSyncHandler</item>
            </argument>
        </arguments>
    </virtualType>

    <!-- Dedicated full-sync logger → var/log/smartsearch-full-sync.log (INFO+)
         and var/log/smartsearch-full-sync-error.log (ERROR+ only, same events). -->
    <virtualType name="FalcoSense\Search\Logger\FullSyncLoggerVirtual" type="FalcoSense\Search\Logger\FullSyncLogger">
        <arguments>
            <argument name="name" xsi:type="string">smartsearch_full_sync</argument>
            <argument name="handlers" xsi:type="array">
                <item name="full_sync" xsi:type="object">FalcoSense\Search\Logger\Handler\FullSyncHandler</item>
                <item name="full_sync_error" xsi:type="object">FalcoSense\Search\Logger\Handler\FullSyncErrorHandler</item>
            </argument>
        </arguments>
    </virtualType>

    <!-- Dedicated image-compression logger → var/log/smartsearch-image-compress.log (INFO+)
         and var/log/smartsearch-image-compress-error.log (ERROR+ only, same events). -->
    <virtualType name="FalcoSense\Search\Logger\ImageCompressLoggerVirtual" type="FalcoSense\Search\Logger\ImageCompressLogger">
        <arguments>
            <argument name="name" xsi:type="string">smartsearch_image_compress</argument>
            <argument name="handlers" xsi:type="array">
                <item name="image_compress" xsi:type="object">FalcoSense\Search\Logger\Handler\ImageCompressHandler</item>
                <item name="image_compress_error" xsi:type="object">FalcoSense\Search\Logger\Handler\ImageCompressErrorHandler</item>
            </argument>
        </arguments>
    </virtualType>

    <!-- Inject the default Magento cache (backed by Redis if configured, file otherwise) -->
    <type name="FalcoSense\Search\Observer\ProductSaveObserver">
        <arguments>
            <argument name="cache" xsi:type="object">Magento\Framework\App\Cache\Type\Config</argument>
            <argument name="logger" xsi:type="object">FalcoSense\Search\Logger\RealtimeSyncLoggerVirtual</argument>
        </arguments>
    </type>

    <type name="FalcoSense\Search\Observer\StockChangeObserver">
        <arguments>
            <argument name="logger" xsi:type="object">FalcoSense\Search\Logger\RealtimeSyncLoggerVirtual</argument>
        </arguments>
    </type>

    <type name="FalcoSense\Search\Service\ProductSyncService">
        <arguments>
            <argument name="logger" xsi:type="object">FalcoSense\Search\Logger\RealtimeSyncLoggerVirtual</argument>
        </arguments>
    </type>

    <type name="FalcoSense\Search\Console\Command\FullSyncCommand">
        <arguments>
            <argument name="logger" xsi:type="object">FalcoSense\Search\Logger\FullSyncLoggerVirtual</argument>
            <argument name="imageCompressLogger" xsi:type="object">FalcoSense\Search\Logger\ImageCompressLoggerVirtual</argument>
        </arguments>
    </type>

    <!-- Image compression's own internal warning/error logging (e.g. missing source
         file, engine failure) now lands in its dedicated log too, whether triggered
         standalone via smartsearch:image:compress or chained from smartsearch:sync:full. -->
    <type name="FalcoSense\Search\Service\ProductImageCompressionService">
        <arguments>
            <argument name="logger" xsi:type="object">FalcoSense\Search\Logger\ImageCompressLoggerVirtual</argument>
        </arguments>
    </type>

    <preference for="Magento\Checkout\Model\Cart\ImageProvider" type="FalcoSense\Search\Model\Cart\ImageProvider"/>
    <preference for="Magento\Checkout\CustomerData\DefaultItem" type="Ahy\ThemeCustomization\CustomerData\DefaultItem"/>
</config>
