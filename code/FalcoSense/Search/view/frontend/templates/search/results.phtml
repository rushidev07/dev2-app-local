<!--
    EXPERIMENTAL: Declarative Shadow DOM boundary around the whole results
    grid. Everything from here down to the matching </template></div> below
    is real, server-rendered markup — a browser with native DSD support
    (Chrome/Edge, Firefox 123+, Safari 17.4+) attaches it as a genuine open
    shadow root during HTML parsing, before any JS runs, so SSR content and
    shadow isolation both hold at once. Older browsers get it via the
    idempotent fallback shim right after this block closes. Style isolation
    means the theme's compiled stylesheet has to be explicitly re-linked
    inside the boundary (it can't cascade in on its own) — that's the <link>
    right below.
-->
<div id="fs-search-shadow-host">
<template shadowrootmode="open">
<!--
    The module's OWN stylesheets, linked INSIDE the shadow root.

    This used to be a single getViewFileUrl('css/styles.css') — the HOST THEME's
    compiled stylesheet. That resolved to Hyva's Tailwind build on Everest, which
    is the only reason the utility classes in here ever worked. On any non-Hyva
    store that file does not exist (Luma ships css/styles-m.css and
    css/styles-l.css), so the link 404'd and this entire shadow root rendered
    with no styling at all.

    Light-DOM styles cannot cross a shadow boundary, so the three sheets declared
    in layout XML do not reach in here — they have to be linked again, which is
    what these three <link> tags do.
-->
<link rel="stylesheet" href="<?= $block->escapeUrl($block->getViewFileUrl('FalcoSense_Search::css/fs-tokens.css')) ?>">
<link rel="stylesheet" href="<?= $block->escapeUrl($block->getViewFileUrl('FalcoSense_Search::css/fs-base.css')) ?>">
<link rel="stylesheet" href="<?= $block->escapeUrl($block->getViewFileUrl('FalcoSense_Search::css/fs-components.css')) ?>">
<style>
/*
 * Only the host page-takeover rules remain — see the equivalent note in
 * category/results.phtml. These reach outside .fs-root deliberately, to collapse
 * the theme's column grid while the search results page is showing.
 *
 * NOTE: these are inside a shadow root, so they can only affect the host page on
 * a browser that flattens them... which it does not. They are kept here for
 * parity with the light-DOM copy further down this file, which is the one that
 * actually applies. Removing the duplicate is safe but out of scope for this pass.
 */
body.ahy-search-open .page-layout-2columns-left .columns,
body.ahy-search-open .page-layout-2columns-right .columns,
body.ahy-search-open .page-layout-3columns .columns {
