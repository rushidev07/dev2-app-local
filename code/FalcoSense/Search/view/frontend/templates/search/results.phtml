<script>
/**
 * Declarative Shadow DOM fallback shim (standard, idempotent pattern) — a
 * browser without native DSD support leaves the <template shadowrootmode>
 * above completely inert (its content never appears on screen at all). This
 * manually promotes any such leftover template into a real, attached shadow
 * root. Runs synchronously at parse time (not on DOMContentLoaded), so it
 * completes before Alpine's own bootstrap ever looks for the search results
 * component — see the alpine:initialized handler further below, which reads
 * #fs-search-shadow-host's .shadowRoot to find it wherever it ended up.
 * On a browser that DOES support DSD natively, the template has already been
 * promoted (and no longer exists as a <template> element) by the time this
 * runs, so the querySelectorAll below simply finds nothing — a safe no-op.
 */
(function attachShadowRoots(root) {
    root.querySelectorAll('template[shadowrootmode]').forEach(function (template) {
        var mode = template.getAttribute('shadowrootmode');
        var shadowRoot = template.parentNode.attachShadow({ mode: mode });
        shadowRoot.appendChild(template.content);
        template.remove();
        attachShadowRoots(shadowRoot);
    });
})(document);
</script>

<script>
    /*
 * ahySearchResults() now lives in web/js/plp/search-results.js.
 *
 * It was inline here, which meant a storefront could not replace this
 * template's markup without also losing the component — the reason
 * Ahy_PlpRevamp had to keep a full copy of it. As a file, markup and
 * behaviour are separable and every store shares one implementation.
 *
 * Registered in view/frontend/layout/default.xml. The file guards against
 * overwriting a host-supplied component of the same name.
 */

    function ahyZeroResults(popularUrl, suggestUrl, searchToken, query) {
        return {
            popularUrl,
            suggestUrl,
            searchToken,
            query,
            popularProducts: [],
            popularSearches: [],

            async load() {
                const t = await window.ahyTokenRefresh?.get();
                if (t) this.searchToken = t;
                try {
                    let r = await fetch(popularUrl + '?search_token=' + encodeURIComponent(this.searchToken) + '&limit=4', { credentials: 'include', cache: 'no-store' });
                    if (r.status === 401) {
                        const t2 = await window.ahyTokenRefresh?.refresh();
                        if (t2) this.searchToken = t2;
                        r = await fetch(popularUrl + '?search_token=' + encodeURIComponent(this.searchToken) + '&limit=4', { credentials: 'include', cache: 'no-store' });
                    }
                    const d = await r.json();
                    this.popularProducts = (d.data || d.results || []).slice(0, 4);
                } catch (e) { }
                try {
                    let r = await fetch(suggestUrl + '?search_token=' + encodeURIComponent(this.searchToken) + '&q=' + encodeURIComponent(query) + '&limit=6', { credentials: 'include', cache: 'no-store' });
                    if (r.status === 401) {
                        const t2 = await window.ahyTokenRefresh?.refresh();
                        if (t2) this.searchToken = t2;
                        r = await fetch(suggestUrl + '?search_token=' + encodeURIComponent(this.searchToken) + '&q=' + encodeURIComponent(query) + '&limit=6', { credentials: 'include', cache: 'no-store' });
                    }
                    const d = await r.json();
                    this.popularSearches = d.suggestions || d.results || [];
                } catch (e) { }
            },
        };
    }

    document.addEventListener('alpine:init', function () {
        if (typeof Alpine !== 'undefined') { window._ssAlpine = Alpine; }
    });
    document.addEventListener('alpine:initialized', function () {
        // The component root lives inside #fs-search-shadow-host's shadow root now
        // (attached natively during parsing, or by the fallback shim above) — fall
        // back to `document` only if that host somehow isn't there at all.
        var host = document.getElementById('fs-search-shadow-host');
        var root = (host && host.shadowRoot) ? host.shadowRoot : document;
        var el = root.querySelector('[x-data^="ahySearchResults"]');
        if (!el || !el.hasAttribute('x-cloak')) return;
        if (el._x_dataStack) { el.removeAttribute('x-cloak'); }
        else if (window._ssAlpine) { window._ssAlpine.initTree(el); }
    });
</script>

