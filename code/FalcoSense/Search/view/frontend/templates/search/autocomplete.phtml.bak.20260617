<?php
/** @var \FalcoSense\Search\Block\Search $block */
if (!$block->getData('helper') && !method_exists($block, 'getSuggestUrl')) {
    return;
}
$suggestUrl  = $block->escapeJs($block->getSuggestUrl());
$searchToken = $block->escapeJs($block->getSearchToken((int) $block->getPlatformStoreId()));
?>
<style>
#ahy-autocomplete {
    display: none;
    position: absolute;
    z-index: 9999;
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 8px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.13);
    width: 480px;
    max-width: 98vw;
    padding: 16px;
    box-sizing: border-box;
}
#ahy-autocomplete.ahy-ac-open { display: block; }
.ahy-ac-section-title {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: #888;
    margin: 0 0 8px;
}
.ahy-ac-keywords { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 16px; }
.ahy-ac-keyword {
    background: #f4f6f8;
    border: 1px solid #e0e4e8;
    border-radius: 20px;
    padding: 4px 12px;
    font-size: 13px;
    color: #1a3352;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
}
.ahy-ac-keyword:hover { background: #1a3352; color: #fff; border-color: #1a3352; }
.ahy-ac-products { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
.ahy-ac-product {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    padding: 8px;
    border-radius: 6px;
    border: 1px solid transparent;
    cursor: pointer;
    background: none;
}
.ahy-ac-product:hover { border-color: #e0e4e8; background: #f8f9fa; }
.ahy-ac-product img { width: 80px; height: 80px; object-fit: contain; margin-bottom: 6px; }
.ahy-ac-product-name { font-size: 12px; font-weight: 600; color: #1a3352; text-align: center; line-clamp: 2; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.ahy-ac-product-price { font-size: 12px; color: #555; margin-top: 3px; }
</style>

<div id="ahy-autocomplete" role="listbox" aria-label="Search suggestions"></div>

<script>
(function () {
    'use strict';

    var SUGGEST_URL  = '<?= $suggestUrl ?>';
    var SEARCH_TOKEN = '<?= $searchToken ?>';
    var dropdown     = document.getElementById('ahy-autocomplete');
    var input        = null;
    var debounceTimer = null;
    var lastFetch    = '';
    var popularCache = null;

    function getInput() {
        return document.getElementById('search');
    }

    function positionDropdown() {
        if (!input) return;
        var rect = input.getBoundingClientRect();
        dropdown.style.top  = (rect.bottom + window.scrollY + 4) + 'px';
        dropdown.style.left = (rect.left  + window.scrollX)      + 'px';
    }

    function openDropdown() {
        positionDropdown();
        dropdown.classList.add('ahy-ac-open');
    }

    function closeDropdown() {
        dropdown.classList.remove('ahy-ac-open');
    }

    function formatPrice(price) {
        if (price == null || price === '') return '';
        return '$' + parseFloat(price).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    }

    function renderPopular(data) {
        var terms    = (data.terms    || []).slice(0, 8);
        var products = (data.products || []).slice(0, 6);
        var html     = '';

        if (terms.length) {
            html += '<p class="ahy-ac-section-title">Popular Searches</p>';
            html += '<div class="ahy-ac-keywords">';
            terms.forEach(function (term) {
                html += '<span class="ahy-ac-keyword" data-query="' + escHtml(term) + '">' + escHtml(term) + '</span>';
            });
            html += '</div>';
        }

        if (products.length) {
            html += '<p class="ahy-ac-section-title">Popular Products</p>';
            html += '<div class="ahy-ac-products">';
            products.forEach(function (p) {
                var url   = p.url_key ? '/' + p.url_key + '.html' : '#';
                var img   = p.image   || '/media/catalog/product/placeholder/default/placeholder.jpg';
                var price = p.special_price && p.special_price < p.price ? p.special_price : p.price;
                html += '<a class="ahy-ac-product" href="' + escHtml(url) + '">';
                html += '<img src="' + escHtml(img) + '" alt="' + escHtml(p.title || '') + '" loading="lazy" onerror="this.src=\'/media/catalog/product/placeholder/default/placeholder.jpg\'">';
                html += '<span class="ahy-ac-product-name">' + escHtml(p.title || '') + '</span>';
                if (price) html += '<span class="ahy-ac-product-price">' + formatPrice(price) + '</span>';
                html += '</a>';
            });
            html += '</div>';
        }

        dropdown.innerHTML = html || '';
        if (html) openDropdown(); else closeDropdown();
        bindKeywordClicks();
    }

    function renderSuggestions(data) {
        var terms    = (data.terms    || []).slice(0, 6);
        var products = (data.products || []).slice(0, 6);
        var html     = '';

        if (terms.length) {
            html += '<p class="ahy-ac-section-title">Suggestions</p>';
            html += '<div class="ahy-ac-keywords">';
            terms.forEach(function (term) {
                html += '<span class="ahy-ac-keyword" data-query="' + escHtml(term) + '">' + escHtml(term) + '</span>';
            });
            html += '</div>';
        }

        if (products.length) {
            html += '<p class="ahy-ac-section-title">Products</p>';
            html += '<div class="ahy-ac-products">';
            products.forEach(function (p) {
                var url   = p.url_key ? '/' + p.url_key + '.html' : '#';
                var img   = p.image   || '/media/catalog/product/placeholder/default/placeholder.jpg';
                var price = p.special_price && p.special_price < p.price ? p.special_price : p.price;
                html += '<a class="ahy-ac-product" href="' + escHtml(url) + '">';
                html += '<img src="' + escHtml(img) + '" alt="' + escHtml(p.title || p.name || '') + '" loading="lazy" onerror="this.src=\'/media/catalog/product/placeholder/default/placeholder.jpg\'">';
                html += '<span class="ahy-ac-product-name">' + escHtml(p.title || p.name || '') + '</span>';
                if (price) html += '<span class="ahy-ac-product-price">' + formatPrice(price) + '</span>';
                html += '</a>';
            });
            html += '</div>';
        }

        dropdown.innerHTML = html || '';
        if (html) openDropdown(); else closeDropdown();
        bindKeywordClicks();
    }

    function bindKeywordClicks() {
        dropdown.querySelectorAll('.ahy-ac-keyword').forEach(function (el) {
            el.addEventListener('mousedown', function (e) {
                e.preventDefault();
                var q = el.getAttribute('data-query');
                if (input) input.value = q;
                closeDropdown();
                var form = input && input.form;
                if (form) form.submit();
                else window.location.href = '/catalogsearch/result/?q=' + encodeURIComponent(q);
            });
        });
    }

    function escHtml(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function fetchSuggest(q) {
        if (lastFetch === q) return;
        lastFetch = q;
        var url = SUGGEST_URL + '?search_token=' + encodeURIComponent(SEARCH_TOKEN) + '&q=' + encodeURIComponent(q);
        fetch(url)
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (q === '') renderPopular(data);
                else renderSuggestions(data);
            })
            .catch(function () { closeDropdown(); });
    }

    function onFocus() {
        var q = input.value.trim();
        if (q.length < 2) {
            if (popularCache) {
                renderPopular(popularCache);
            } else {
                fetchSuggest('');
            }
        }
    }

    function onInput() {
        var q = input.value.trim();
        clearTimeout(debounceTimer);
        if (q.length < 2) {
            if (popularCache) renderPopular(popularCache);
            else fetchSuggest('');
            return;
        }
        debounceTimer = setTimeout(function () { fetchSuggest(q); }, 200);
    }

    function onBlur() {
        setTimeout(closeDropdown, 180);
    }

    function attachToInput() {
        input = getInput();
        if (!input) return;

        // position dropdown absolutely in the document
        document.body.appendChild(dropdown);
        dropdown.style.position = 'absolute';

        input.addEventListener('focus',  onFocus);
        input.addEventListener('input',  onInput);
        input.addEventListener('blur',   onBlur);
        input.setAttribute('autocomplete', 'off');

        // Pre-fetch popular data silently so it's ready instantly on focus
        fetch(SUGGEST_URL + '?search_token=' + encodeURIComponent(SEARCH_TOKEN) + '&q=')
            .then(function (r) { return r.json(); })
            .then(function (data) { popularCache = data; })
            .catch(function () {});

        window.addEventListener('resize', function () { if (dropdown.classList.contains('ahy-ac-open')) positionDropdown(); });
        window.addEventListener('scroll', function () { if (dropdown.classList.contains('ahy-ac-open')) positionDropdown(); }, { passive: true });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', attachToInput);
    } else {
        attachToInput();
    }
}());
</script>
