                            <img :src="imgUrl(product.image)" :alt="product.name" width="244" height="244"
                                class="w-full object-contain object-center p-3"
                                :style="isFallbackImg(imgUrl(product.image)) ? 'max-width:244px;height:244px;margin:0 auto;display:block;opacity:0.45' : 'max-width:244px;height:244px;margin:0 auto;display:block'"
                                loading="eager"
                                fetchpriority="high" @error="handleImgError($event)"
                                :data-original-src="product.image" />
