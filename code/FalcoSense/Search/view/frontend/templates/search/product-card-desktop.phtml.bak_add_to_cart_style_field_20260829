                                                x-html="hyva.formatPrice(product.price)"></span>
                                        </div>
                                    </div>
                                </template>
                                <template
                                    x-if="product.price && (!product.special_price || product.special_price >= product.price)">
                                    <div class="flex flex-col items-baseline">
                                        <span class="capitalize text-ahy-red !font-bold !text-sm" x-show="product.type === 'configurable'">From</span>
                                        <span class="text-2xl font-extrabold text-ahy-blue"
                                            x-html="hyva.formatPrice(product.price)"></span>
                                    </div>
                                </template>
                                <template x-if="!product.price">
                                    <span
                                        class="capitalize !flex justify-center items-center w-full !rounded-full !bg-transparent !text-ahy-blue hover:shadow-[#0d2f47_0px_0px_0px_1px_inset] !text-sm !py-1.5 !px-2.5 font-bold !border-2 !border-ahy-blue">See
                                        Options</span>
                                </template>
                            </div>
                            <div class="flex items-center justify-between">
                                <p class="capitalize !text-gray-900 !font-semibold !text-sm text-nowrap" :class="isFreeShipping(product) ? '' : 'invisible'">FREE Shipping</p>
                                <div class="w-full mt-auto pt-3 max-w-[160px]">
                                    <template x-if="product.type !== 'configurable'">
                                        <button @click.prevent="addSimpleToCart(product)"
                                            :class="cartLoading[product.product_id] === true ? 'opacity-60 pointer-events-none' : ''"
                                            class="capitalize kuBtnDark !flex justify-center items-center gap-2 w-full !rounded-full !bg-transparent !text-ahy-blue hover:shadow-[#0d2f47_0px_0px_0px_1px_inset] !text-sm !py-1.5 !px-2.5 font-bold !border-2 !border-ahy-blue">
                                            <svg x-show="cartLoading[product.product_id] === true"
                                                class="animate-spin w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24">
                                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor"
                                                    stroke-width="4" />
                                                <path class="opacity-75" fill="currentColor"
                                                    d="M4 12a8 8 0 018-8V0C5.373 0 22 6.477 22 12h-4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z" />
                                            </svg>
                                            <svg x-show="cartLoading[product.product_id] !== true"
                                                class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                                            </svg>
                                            <span
                                                x-text="cartLoading[product.product_id] === true ? 'Adding…' : 'Add'"></span>
                                        </button>
                                    </template>
                                    <template x-if="product.type === 'configurable'">
                                        <button @click.prevent="$dispatch('ahy-cfg-modal-open', product)"
                                            class="capitalize kuBtnDark !flex justify-center items-center w-full !rounded-full !bg-transparent !text-ahy-blue hover:shadow-[#0d2f47_0px_0px_0px_1px_inset] !text-sm !py-1.5 !px-2.5 font-bold !border-2 !border-ahy-blue">
                                            Options
                                        </button>
                                    </template>
                                </div>
                            </div>
                        </div>
                    </div>
