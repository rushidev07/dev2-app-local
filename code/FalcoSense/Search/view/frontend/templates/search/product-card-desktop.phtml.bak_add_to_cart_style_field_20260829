 * No PHP variables are needed here — all data comes from the Alpine `product` scope.
 */
?>
                    <div class="bg-white relative flex flex-col group">

                        <button @click.prevent="addToWishlist(product)"
                            :disabled="wishLoading[product.product_id] === true" aria-label="Add to Wish List"
