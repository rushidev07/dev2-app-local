<?php
/** @var \FalcoSense\Search\Block\Search $block */
$productsApiUrl   = $block->escapeUrl($block->getProductsApiUrl());
$analyticsUrl     = $block->escapeUrl($block->getSearchAnalyticsUrl());
$searchToken      = $block->escapeJs($block->getSearchToken((int) $block->getPlatformStoreId()));
$searchQuery      = $block->escapeJs($block->getSearchQuery());
$addToCartUrl     = $block->escapeUrl($block->getUrl('checkout/cart/add'));
$platformStoreId  = (int) $block->getPlatformStoreId();
$customerGeoState = $block->escapeJs($block->getCustomerGeoState());
?>


<div
    x-data="ahySearchResults('<?= $productsApiUrl ?>', '<?= $searchToken ?>', '<?= $searchQuery ?>', <?= $platformStoreId ?>, '<?= $analyticsUrl ?>', '<?= $customerGeoState ?>')"
    x-init="init()"
    x-effect="var m = document.querySelector('.column.main'); if (m) m.style.minHeight = loading ? '1900px' : '';"
    x-cloak
    class="w-full"
>
    <!-- ── Mobile: Filter + Sort bar ──────────────────────────────────────── -->
    <div class="lg:hidden bg-ahy-bg border-b border-gray-300 px-4 py-3 flex items-center justify-between gap-3"
         x-show="!loading && results.length > 0"
         x-data="{ showMobileFilter: false }">

        <button @click="showMobileFilter = true"
                class="flex-1 max-w-[200px] border-2 border-ahy-blue text-ahy-blue font-bold uppercase tracking-widest text-xs py-2.5 px-5 rounded-full bg-transparent">
            Filter By
        </button>

        <!-- Mobile sort -->
        <div x-data="{ open: false }" class="relative flex items-center gap-1 text-sm text-ahy-blue font-medium">
            <span>Sort by:</span>
            <button @click="open = !open" class="font-bold flex items-center gap-1">
                <span x-text="sortLabel()"></span>
                <svg class="w-4 h-4 transition-transform" :class="open ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
            </button>
            <div x-show="open" @click.outside="open = false"
                 class="absolute right-0 top-8 bg-white border border-gray-200 rounded-xl shadow-lg z-50 w-48 py-1">
                <button @click="setSort('relevance'); open = false" class="w-full text-left px-4 py-2.5 text-sm hover:bg-gray-50" :class="sort === 'relevance' ? 'font-bold text-ahy-blue' : ''">Relevance</button>
                <button @click="setSort('price_asc'); open = false" class="w-full text-left px-4 py-2.5 text-sm hover:bg-gray-50" :class="sort === 'price_asc' ? 'font-bold text-ahy-blue' : ''">Price: Low to High</button>
                <button @click="setSort('price_desc'); open = false" class="w-full text-left px-4 py-2.5 text-sm hover:bg-gray-50" :class="sort === 'price_desc' ? 'font-bold text-ahy-blue' : ''">Price: High to Low</button>
            </div>
        </div>

        <!-- Mobile filter drawer -->
        <div x-show="showMobileFilter" x-cloak class="fixed inset-0 z-[500]" @keydown.escape.window="showMobileFilter = false">
            <div class="absolute inset-0 bg-black/50" @click="showMobileFilter = false"></div>
            <div class="absolute inset-y-0 right-0 w-full max-w-sm bg-white flex flex-col shadow-2xl">
                <div class="flex items-center justify-between px-5 py-4 border-b">
                    <span class="font-bold text-ahy-blue text-base uppercase tracking-wide">Filters</span>
                    <div class="flex items-center gap-4">
                        <button @click="clearAllFilters(); showMobileFilter = false"
                                class="text-xs text-ahy-blue underline font-semibold">Reset</button>
                        <button @click="showMobileFilter = false" class="text-gray-400 hover:text-gray-600">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                            </svg>
                        </button>
                    </div>
                </div>
                <div class="flex-1 overflow-y-auto px-5 py-4 space-y-4">
                    <!-- Mobile price filter -->
                    <template x-if="priceRange.min !== null">
                        <div class="border-b pb-4">
                            <p class="font-bold text-ahy-blue mb-3">Price</p>
                            <ul class="space-y-2.5">
                                <template x-for="bucket in priceRangeBuckets()" :key="bucket.label">
                                    <li>
                                        <label class="flex items-center gap-2.5 cursor-pointer group" @click.prevent="togglePriceRange(bucket)">
                                            <span class="w-4 h-4 border border-gray-400 rounded-sm flex-shrink-0 flex items-center justify-center transition-colors"
                                                  :class="activePriceRange && activePriceRange.label === bucket.label ? 'bg-ahy-blue border-ahy-blue' : 'bg-white group-hover:border-ahy-blue'">
                                                <svg x-show="activePriceRange && activePriceRange.label === bucket.label" class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                                                </svg>
                                            </span>
                                            <span class="text-sm text-gray-700 flex-1 leading-tight" x-text="bucket.label"></span>
                                        </label>
                                    </li>
                                </template>
                            </ul>
                        </div>
                    </template>
                    <!-- Mobile categorical filters -->
                    <template x-for="filter in filters" :key="filter.key">
                        <div class="border-b pb-4">
                            <p class="font-bold text-ahy-blue mb-3" x-text="filter.label"></p>
                            <ul class="space-y-2">
                                <template x-for="option in filter.options" :key="option.value">
                                    <li>
                                        <label class="flex items-center gap-2 cursor-pointer"
                                               @click.prevent="toggleFilter(filter.key, filter.label, option.value)">
                                            <span class="w-4 h-4 border border-gray-400 rounded flex-shrink-0 flex items-center justify-center"
                                                  :class="isFilterActive(filter.key, option.value) ? 'bg-ahy-blue border-ahy-blue' : 'bg-white'">
                                                <svg x-show="isFilterActive(filter.key, option.value)" class="w-2.5 h-2.5 text-white" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                                </svg>
                                            </span>
                                            <span class="text-sm flex-1" x-text="option.value"></span>
                                            <span class="text-sm text-gray-400" x-text="'(' + option.count + ')'"></span>
                                        </label>
                                    </li>
                                </template>
                            </ul>
                        </div>
                    </template>
                </div>
                <div class="px-5 py-4 border-t">
                    <button @click="showMobileFilter = false"
                            class="w-full py-3 bg-ahy-blue text-white font-bold rounded-full uppercase tracking-widest text-sm">
                        Apply Filters
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Main layout ──────────────────────────────────────────────────────── -->
    <div class="flex gap-8 px-4 lg:px-6 pt-0 lg:pt-4 pb-12">

        <!-- ── LEFT: Desktop filter sidebar ───────────────────────────────── -->
        <aside class="hidden lg:block shrink-0" style="width:260px" x-show="loading || results.length > 0">
            <div class="">

                <!-- Filter skeleton during loading -->
                <div x-show="loading" class="flex flex-col gap-4 pt-2">
                    <div class="skel h-4 rounded-full w-2/3"></div>
                    <div class="h-px bg-gray-200"></div>
                    <div class="skel h-3.5 rounded-full w-4/5"></div>
                    <div class="skel h-3.5 rounded-full w-3/5"></div>
                    <div class="skel h-3.5 rounded-full w-4/5"></div>
                    <div class="skel h-3.5 rounded-full w-3/5"></div>
                    <div class="skel h-3.5 rounded-full w-2/5"></div>
                    <div class="h-px bg-gray-200 mt-2"></div>
                    <div class="skel h-4 rounded-full w-2/3"></div>
                    <div class="skel h-3.5 rounded-full w-4/5"></div>
                    <div class="skel h-3.5 rounded-full w-3/5"></div>
                    <div class="skel h-3.5 rounded-full w-4/5"></div>
                    <div class="h-px bg-gray-200 mt-2"></div>
                    <div class="skel h-4 rounded-full w-2/3"></div>
                    <div class="skel h-3.5 rounded-full w-4/5"></div>
                    <div class="skel h-3.5 rounded-full w-3/5"></div>
                </div>

                <!-- Actual filters -->
                <div x-show="!loading && results.length > 0">

                <!-- Item count -->
                <div class="pb-3 mb-6 border-b-2 border-ahy-blue">
                    <span class="text-sm font-semibold text-ahy-blue">
                        (<span x-text="total"></span> Items)
                    </span>
                </div>

                <!-- Active filter tags -->
                <div x-show="activeFilters.length > 0 || activePriceMin !== '' || activePriceMax !== ''" class="mb-4 flex flex-wrap gap-2">
                    <template x-for="f in activeFilters" :key="f.key + f.value">
                        <span class="inline-flex items-center gap-1 bg-ahy-blue text-white text-xs px-3 py-1 rounded-full cursor-pointer"
                              @click="removeFilter(f.key, f.value)">
                            <span x-text="f.label + ': ' + f.value"></span>
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                            </svg>
                        </span>
                    </template>
                    <template x-if="activePriceMin !== '' || activePriceMax !== ''">
                        <span class="inline-flex items-center gap-1 bg-ahy-blue text-white text-xs px-3 py-1 rounded-full cursor-pointer"
                              @click="clearPriceFilter()">
                            <span x-text="'Price: ' + (activePriceMin !== '' ? '$' + activePriceMin : '') + (activePriceMin !== '' && activePriceMax !== '' ? ' – ' : '') + (activePriceMax !== '' ? '$' + activePriceMax : '')"></span>
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                            </svg>
                        </span>
                    </template>
                    <button class="text-xs text-ahy-blue underline" @click="clearAllFilters()">Reset all</button>
                </div>

                <!-- Filter sections -->
                <div class="space-y-0" x-show="filters.length > 0 || priceRange.min !== null">

                    <!-- Price filter -->
                    <template x-if="priceRange.min !== null">
                        <div class="border-t border-gray-200 py-4">
                            <button class="flex items-center justify-between w-full mb-3"
                                    @click="priceCollapsed = !priceCollapsed">
                                <span class="font-bold text-ahy-blue text-sm">Price</span>
                                <svg class="w-4 h-4 text-ahy-blue transition-transform" :class="priceCollapsed ? 'rotate-180' : ''"
                                     fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                                </svg>
                            </button>
                            <ul x-show="!priceCollapsed" class="space-y-2.5">
                                <template x-for="bucket in priceRangeBuckets()" :key="bucket.label">
                                    <li>
                                        <label class="flex items-center gap-2.5 cursor-pointer group" @click.prevent="togglePriceRange(bucket)">
                                            <span class="w-4 h-4 border border-gray-400 rounded-sm flex-shrink-0 flex items-center justify-center transition-colors"
                                                  :class="activePriceRange && activePriceRange.label === bucket.label ? 'bg-ahy-blue border-ahy-blue' : 'bg-white group-hover:border-ahy-blue'">
                                                <svg x-show="activePriceRange && activePriceRange.label === bucket.label" class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                                                </svg>
                                            </span>
                                            <span class="text-sm text-gray-700 flex-1 leading-tight" x-text="bucket.label"></span>
                                        </label>
                                    </li>
                                </template>
                            </ul>
                        </div>
                    </template>

                    <!-- Categorical filters -->
                    <template x-for="filter in filters" :key="filter.key">
                        <div class="border-t border-gray-200 py-4">
                            <button class="flex items-center justify-between w-full mb-3"
                                    @click="filter.collapsed = !filter.collapsed">
                                <span class="font-bold text-ahy-blue text-sm" x-text="filter.label"></span>
                                <svg class="w-4 h-4 text-ahy-blue transition-transform" :class="filter.collapsed ? 'rotate-180' : ''"
                                     fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                                </svg>
                            </button>
                            <ul x-show="!filter.collapsed" class="space-y-2.5">
                                <template x-for="option in (filter.showAll ? filter.options : filter.options.slice(0,5))" :key="option.value">
                                    <li>
                                        <label class="flex items-center gap-2.5 cursor-pointer group"
                                               @click.prevent="toggleFilter(filter.key, filter.label, option.value)">
                                            <span class="w-4 h-4 border border-gray-400 rounded-sm flex-shrink-0 flex items-center justify-center transition-colors"
                                                  :class="isFilterActive(filter.key, option.value) ? 'bg-ahy-blue border-ahy-blue' : 'bg-white group-hover:border-ahy-blue'">
                                                <svg x-show="isFilterActive(filter.key, option.value)" class="w-2.5 h-2.5 text-white" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                                </svg>
                                            </span>
                                            <span class="text-sm text-gray-700 flex-1 leading-tight" x-text="option.value"></span>
                                            <span class="text-sm text-gray-400 shrink-0" x-text="'(' + option.count + ')'"></span>
                                        </label>
                                    </li>
                                </template>
                                <li x-show="filter.options.length > 5">
                                    <button class="text-sm font-bold text-ahy-blue hover:underline"
                                            @click="filter.showAll = !filter.showAll">
                                        <span x-show="!filter.showAll">See More +</span>
                                        <span x-show="filter.showAll">See Less –</span>
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </template>
                </div>
                </div><!-- end x-show="!loading && results.length > 0" -->
            </div>
        </aside>

        <!-- ── RIGHT: Products ─────────────────────────────────────────────── -->
        <div class="flex-1 min-w-0">

            <!-- Desktop: sort + item count row -->
            <div class="hidden lg:flex items-center justify-end mb-5" x-show="!loading && results.length > 0">
                <div x-data="{ open: false }" class="relative flex items-center gap-1 text-sm text-ahy-blue">
                    <span>Sort by:</span>
                    <button @click="open = !open" class="font-bold flex items-center gap-1 ml-1">
                        <span x-text="sortLabel()"></span>
                        <svg class="w-4 h-4 transition-transform" :class="open ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </button>
                    <div x-show="open" @click.outside="open = false"
                         class="absolute right-0 top-8 bg-white border border-gray-200 rounded-xl shadow-lg z-50 w-52 py-1">
                        <button @click="setSort('relevance'); open = false" class="w-full text-left px-4 py-2.5 text-sm hover:bg-gray-50" :class="sort === 'relevance' ? 'font-bold text-ahy-blue' : ''">Relevance</button>
                        <button @click="setSort('price_asc'); open = false" class="w-full text-left px-4 py-2.5 text-sm hover:bg-gray-50" :class="sort === 'price_asc' ? 'font-bold text-ahy-blue' : ''">Price: Low to High</button>
                        <button @click="setSort('price_desc'); open = false" class="w-full text-left px-4 py-2.5 text-sm hover:bg-gray-50" :class="sort === 'price_desc' ? 'font-bold text-ahy-blue' : ''">Price: High to Low</button>
                    </div>
                </div>
            </div>

            <!-- Mobile item count -->
            <div class="lg:hidden text-sm font-semibold text-ahy-blue px-1 mb-3" x-show="!loading && results.length > 0">
                (<span x-text="total"></span> Items)
            </div>

            <!-- Spell correction banner (results replaced with corrected query) -->
            <div x-show="!loading && wasCorrection" class="mb-4 px-4 py-3 bg-white rounded-xl border border-gray-200 text-sm text-gray-600">
                Showing results for <strong class="text-ahy-blue" x-text="correctedQuery"></strong>
                instead of <em x-text="originalQuery"></em>.
                <span class="ml-1">
                    Do you still want to search for
                    <a class="text-ahy-blue font-semibold hover:underline cursor-pointer"
                       @click.prevent="searchExact(originalQuery)"
                       x-text="'&quot;' + originalQuery + '&quot;'"></a>?
                </span>
            </div>

            <!-- Did you mean banner (results exist but query has misspelled tokens) -->
            <div x-show="!loading && !wasCorrection && suggestedQuery" class="mb-4 px-4 py-3 bg-white rounded-xl border border-gray-200 text-sm text-gray-600">
                Did you mean
                <a class="text-ahy-blue font-semibold hover:underline cursor-pointer"
                   @click.prevent="searchExact(suggestedQuery)"
                   x-text="'&quot;' + suggestedQuery + '&quot;'"></a>?
            </div>

            <!-- Loading skeleton -->
            <div x-show="loading">
                <style>
                    .skel{background:#ebebeb;animation:skpulse 1.6s ease-in-out infinite;}
                    @keyframes skpulse{0%,100%{opacity:1}50%{opacity:.5}}
                </style>

                <!-- Desktop grid skeleton -->
                <div class="hidden lg:grid grid-cols-2 xl:grid-cols-3 gap-0.5">
                    <template x-for="i in 9" :key="i">
                        <div class="bg-white flex flex-col overflow-hidden">
                            <div class="skel w-full" style="height:244px"></div>
                            <div class="p-4 flex flex-col gap-3">
                                <div class="skel h-3.5 rounded-full w-4/5"></div>
                                <div class="skel h-3.5 rounded-full w-3/5"></div>
                                <div class="skel h-3 rounded-full w-2/5"></div>
                                <div class="flex items-center gap-2">
                                    <div class="skel h-3 rounded-full w-8"></div>
                                    <div class="skel h-6 rounded-full w-24"></div>
                                </div>
                                <div class="skel h-3 rounded-full w-28"></div>
                            </div>
                        </div>
                    </template>
                </div>

                <!-- Mobile list skeleton -->
                <div class="lg:hidden flex flex-col gap-0.5">
                    <template x-for="i in 6" :key="i">
                        <div class="bg-white flex gap-3 p-3">
                            <div class="skel shrink-0" style="width:128px;height:128px"></div>
                            <div class="flex-1 flex flex-col gap-2.5 py-1">
                                <div class="skel h-3.5 rounded-full w-4/5"></div>
                                <div class="skel h-3.5 rounded-full w-3/5"></div>
                                <div class="skel h-3 rounded-full w-2/5"></div>
                                <div class="flex items-center gap-2">
                                    <div class="skel h-3 rounded-full w-6"></div>
                                    <div class="skel h-5 rounded-full w-16"></div>
                                </div>
                                <div class="skel h-3 rounded-full w-20"></div>
                            </div>
                            <div class="shrink-0 flex flex-col items-center justify-center gap-3 w-20">
                                <div class="skel h-8 w-full rounded-full"></div>
                                <div class="skel h-8 w-8 rounded-full"></div>
                            </div>
                        </div>
                    </template>
                </div>
            </div>

            <!-- No results — popular products panel -->
            <div x-show="!loading && results.length === 0"
                 x-data="ahyZeroResults('<?= $block->escapeJs(preg_replace('#/api/search\.php$#', '/api/popular.php', $block->getSearchApiUrl())) ?>', '<?= $block->escapeJs(preg_replace('#/api/search\.php$#', '/api/suggest.php', $block->getSearchApiUrl())) ?>', '<?= $searchToken ?>', '<?= $searchQuery ?>')"
                 x-init="load()">
                <div class="bg-white rounded-xl border border-gray-100 shadow-sm mx-auto py-10 px-6" style="max-width:960px">
                    <p class="text-center text-gray-600 text-base mb-6">
                        We're sorry, no results found for <em class="font-semibold not-italic" x-text="'&quot;' + query + '&quot;'"></em>.
                    </p>

                    <p class="text-center font-extrabold text-ahy-blue text-sm uppercase tracking-widest mb-5">Popular Products</p>

                    <!-- Product grid -->
                    <div class="grid grid-cols-2 lg:grid-cols-4 gap-0.5" x-show="popularProducts.length > 0">
                        <template x-for="p in popularProducts" :key="p.sku">
                            <a :href="p.url_key ? '/' + p.url_key + '.html' : '#'"
                               class="bg-white flex flex-col p-3 hover:shadow-md transition group">
                                <img :src="p.image || '/media/catalog/product/placeholder/default/placeholder.jpg'"
                                     :alt="p.name"
                                     class="w-full object-contain mb-3"
                                     style="height:180px"
                                     loading="lazy"
                                     @error="$event.target.src='/media/catalog/product/placeholder/default/placeholder.jpg'"/>
                                <span class="text-sm font-bold text-ahy-blue leading-snug line-clamp-2 group-hover:underline" x-text="p.name"></span>
                                <div class="mt-1">
                                    <template x-if="p.special_price && p.special_price < p.price">
                                        <span class="text-sm font-extrabold text-ahy-blue" x-html="'Starting at ' + hyva.formatPrice(p.special_price)"></span>
                                    </template>
                                    <template x-if="!p.special_price || p.special_price >= p.price">
                                        <span class="text-sm font-extrabold text-ahy-blue" x-html="(p.type === 'configurable' ? 'Starting at ' : '') + hyva.formatPrice(p.price)"></span>
                                    </template>
                                </div>
                            </a>
                        </template>
                    </div>

                    <!-- Popular searches -->
                    <div x-show="popularSearches.length > 0" class="mt-6 text-center text-sm text-gray-600">
                        <span class="font-bold">Popular Searches: </span>
                        <template x-for="(term, i) in popularSearches" :key="term">
                            <span>
                                <a :href="'/catalogsearch/result/?q=' + encodeURIComponent(term)"
                                   class="text-ahy-blue hover:underline" x-text="term"></a><span x-show="i < popularSearches.length - 1">, </span>
                            </span>
                        </template>
                    </div>
                </div>
            </div>

            <!-- ── Desktop: 3-column grid ──────────────────────────────────── -->
            <div x-show="!loading && results.length > 0"
                 class="hidden lg:grid grid-cols-2 xl:grid-cols-3 gap-0.5">
                <template x-for="(product, index) in sortedResults()" :key="product.sku || product.product_id">
                    <div class="bg-white relative flex flex-col group">

                        <!-- Stock badge -->
                        <div class="absolute left-3 top-3 z-10"
                             x-show="product.variants && product.variants.length <= 10 && product.variants.length > 0">
                            <span class="rounded border-2 border-ahy-stock-green bg-white px-2 py-1 text-xs font-semibold text-ahy-stock-green"
                                  x-text="product.variants.length + ' Left'"></span>
                        </div>

                        <!-- Bookmark -->
                        <button x-data="initWishlist()" @click.prevent="addToWishlist(product.product_id)"
                                aria-label="Add to Wish List" type="button"
                                class="absolute top-2.5 right-2.5 z-10 w-9 h-9 rounded-full border border-gray-300 bg-white flex items-center justify-center text-ahy-blue hover:text-red-500 shadow-sm transition">
                            <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 15.91 20" fill="currentColor">
                                <path d="M14.41,1.5v16L9.27,12.71a1.62,1.62,0,0,0-2.19,0L1.5,17.58V1.5H14.41M14.76,0H1.15A1.16,1.16,0,0,0,0,1.15v18.1a.74.74,0,0,0,1.24.56l6.83-6a.12.12,0,0,1,.18,0l6.38,5.9a.74.74,0,0,0,.52.21.76.76,0,0,0,.76-.77v-18A1.15,1.15,0,0,0,14.76,0Z"/>
                            </svg>
                        </button>

                        <!-- Image -->
                        <a :href="product.url_key ? '/' + product.url_key + '.html' : '#'" @click="trackClick(product, index + 1)"
                           class="block overflow-hidden">
                            <img :src="product.image ? 'https://static.everest.com/media/catalog/product' + product.image.replace(/\.(jpg|png|jpeg)$/i, '.webp') : '/media/catalog/product/placeholder/default/placeholder.jpg'"
                                 :alt="product.name"
                                 width="244" height="244"
                                 class="w-full object-contain object-center p-3"
                                 style="max-width:244px;height:244px;margin:0 auto;display:block"
                                 loading="lazy"
                                 @error="handleImgError($event)"
                                 :data-original-src="product.image"/>
                        </a>

                        <!-- Info -->
                        <div class="flex flex-col flex-1 px-4 pb-4">

                            <!-- Rating -->
                            <div x-show="product.rating_count > 0" class="flex items-center gap-1 mt-2 mb-1">
                                <div class="flex text-yellow-400 text-sm">
                                    <template x-for="s in 5" :key="s">
                                        <svg class="w-3.5 h-3.5" :class="s <= Math.round(product.rating || 0) ? 'text-yellow-400' : 'text-gray-300'" fill="currentColor" viewBox="0 0 20 20">
                                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                        </svg>
                                    </template>
                                </div>
                                <span class="text-xs text-gray-500" x-text="product.rating_count"></span>
                            </div>

                            <!-- Name -->
                            <a :href="product.url_key ? '/' + product.url_key + '.html' : '#'"
                               class="line-clamp-2 !text-lg !font-extrabold text-ahy-blue leading-normal mt-1 h-[3.4rem]"
                               :title="product.name" x-html="product.name"
                               @click="trackClick(product, index + 1)"></a>

                            <!-- Seller -->
                            <p class="text-xs text-gray-500 mt-1"
                               x-text="'Sold By ' + (product.brand || 'The Everest Marketplace')"></p>

                            <!-- Price -->
                            <div class="AhyPrice min-h-[5.5rem] flex flex-col !overflow-visible mt-1">
                                <template x-if="product.price && product.special_price && product.special_price < product.price">
                                    <div>
                                        <div class="text-ahy-red text-xs font-bold uppercase">Deal</div>
                                        <div class="flex items-baseline gap-2">
                                            <span class="text-2xl font-extrabold text-ahy-blue" x-html="hyva.formatPrice(product.special_price)"></span>
                                            <span class="text-sm text-gray-400 line-through" x-html="hyva.formatPrice(product.price)"></span>
                                        </div>
                                    </div>
                                </template>
                                <template x-if="product.price && (!product.special_price || product.special_price >= product.price)">
                                    <div class="flex flex-col items-baseline">
                                        <span class="capitalize text-ahy-red !font-bold !text-sm">From</span>
                                        <span class="text-2xl font-extrabold text-ahy-blue" x-html="hyva.formatPrice(product.price)"></span>
                                    </div>
                                </template>
                                <template x-if="!product.price">
                                    <span class="capitalize !flex justify-center items-center w-full !rounded-full !bg-transparent !text-ahy-blue hover:shadow-[#0d2f47_0px_0px_0px_1px_inset] !text-sm !py-1.5 !px-2.5 font-bold !border-2 !border-ahy-blue">See Options</span>
                                </template>
                            </div>
                            <div class="flex items-center justify-between">
                                <!-- Free shipping -->
                                <p class="capitalize !text-gray-900 !font-semibold !text-sm text-nowrap">FREE Shipping</p>

                                <!-- CTA -->
                                <div class="w-full mt-auto pt-3 max-w-[160px]">
                                    <template x-if="product.type !== 'configurable'">
                                        <button @click.prevent="addSimpleToCart(product)"
                                                class="capitalize kuBtnDark !flex justify-center items-center w-full !rounded-full !bg-transparent !text-ahy-blue hover:shadow-[#0d2f47_0px_0px_0px_1px_inset] !text-sm !py-1.5 !px-2.5 font-bold !border-2 !border-ahy-blue AhyLandingAddToCartBtn">
                                            Add to Cart
                                        </button>
                                    </template>
                                    <template x-if="product.type === 'configurable'">
                                        <button @click.prevent="$dispatch('ahy-open-config-modal', product)"
                                                class="capitalize kuBtnDark !flex justify-center items-center w-full !rounded-full !bg-transparent !text-ahy-blue hover:shadow-[#0d2f47_0px_0px_0px_1px_inset] !text-sm !py-1.5 !px-2.5 font-bold !border-2 !border-ahy-blue AhyLandingAddToCartBtn">
                                            Options
                                        </button>
                                    </template>
                                </div>
                            </div>
                        </div>
                    </div>
                </template>
            </div>

            <!-- ── Mobile: horizontal card list ────────────────────────────── -->
            <div x-show="!loading && results.length > 0" class="lg:hidden flex flex-col gap-0.5">
                <template x-for="(product, index) in sortedResults()" :key="'m-' + (product.sku || product.product_id)">
                    <div class="flex gap-3 p-3 bg-white">

                        <!-- Image -->
                        <div class="shrink-0 w-32">
                            <a :href="product.url_key ? '/' + product.url_key + '.html' : '#'" @click="trackClick(product, index + 1)">
                                <img :src="product.image ? 'https://static.everest.com/media/catalog/product' + product.image.replace(/\.(jpg|png|jpeg)$/i, '.webp') : '/media/catalog/product/placeholder/default/placeholder.jpg'"
                                     :alt="product.name"
                                     width="244" height="244"
                                     class="w-full object-contain"
                                     style="max-width:244px;max-height:244px"
                                     loading="lazy"
                                     @error="handleImgError($event)"
                                     :data-original-src="product.image"/>
                            </a>
                            <p x-show="product.variants && product.variants.length > 1"
                               class="text-xs text-center text-gray-500 mt-1"
                               x-text="product.variants.length + ' Colors'"></p>
                        </div>

                        <!-- Info -->
                        <div class="flex-1 min-w-0 flex flex-col justify-between py-0.5">

                            <!-- Name -->
                            <a :href="product.url_key ? '/' + product.url_key + '.html' : '#'"
                               class="text-sm font-bold text-ahy-blue leading-snug line-clamp-3"
                               x-html="product.name" @click="trackClick(product, index + 1)"></a>

                            <!-- Seller -->
                            <p class="text-xs text-gray-500 mt-0.5"
                               x-text="'Sold By ' + (product.brand || 'The Everest Marketplace')"></p>

                            <!-- Price -->
                            <div class="mt-1">
                                <template x-if="product.price && product.special_price && product.special_price < product.price">
                                    <div class="flex items-baseline gap-1.5">
                                        <span class="text-xs font-bold text-ahy-red uppercase">Deal</span>
                                        <span class="text-base font-extrabold text-ahy-blue" x-html="hyva.formatPrice(product.special_price)"></span>
                                        <span class="text-xs text-gray-400 line-through" x-html="hyva.formatPrice(product.price)"></span>
                                    </div>
                                </template>
                                <template x-if="product.price && (!product.special_price || product.special_price >= product.price)">
                                    <div class="flex items-baseline gap-1">
                                        <span class="text-xs font-semibold text-ahy-red">From</span>
                                        <span class="text-base font-extrabold text-ahy-blue" x-html="hyva.formatPrice(product.price)"></span>
                                    </div>
                                </template>
                                <template x-if="!product.price">
                                    <span class="text-xs text-gray-500">See Options</span>
                                </template>
                            </div>

                            <!-- Free shipping -->
                            <p class="text-xs text-gray-900 font-semibold mt-0.5">FREE Shipping</p>
                        </div>

                        <!-- Right: CTA + Wishlist -->
                        <div class="shrink-0 flex flex-col items-center justify-center gap-2 pl-1">
                            <template x-if="product.type !== 'configurable'">
                                <button @click.prevent="addSimpleToCart(product)"
                                        class="text-xs font-bold py-2 px-3 rounded-full border-2 border-ahy-blue text-ahy-blue bg-white hover:bg-ahy-blue hover:text-white transition whitespace-nowrap">
                                    Add to Cart
                                </button>
                            </template>
                            <template x-if="product.type === 'configurable'">
                                <button @click.prevent="$dispatch('ahy-open-config-modal', product)"
                                        class="text-xs font-bold py-2 px-3 rounded-full border-2 border-ahy-blue text-ahy-blue bg-white hover:bg-ahy-blue hover:text-white transition whitespace-nowrap">
                                    Options
                                </button>
                            </template>
                            <button x-data="initWishlist()" @click.prevent="addToWishlist(product.product_id)"
                                    aria-label="Add to Wish List"
                                    class="w-8 h-8 rounded-full border border-gray-300 bg-white flex items-center justify-center text-ahy-blue hover:text-red-500 transition">
                                <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 15.91 20" fill="currentColor">
                                    <path d="M14.41,1.5v16L9.27,12.71a1.62,1.62,0,0,0-2.19,0L1.5,17.58V1.5H14.41M14.76,0H1.15A1.16,1.16,0,0,0,0,1.15v18.1a.74.74,0,0,0,1.24.56l6.83-6a.12.12,0,0,1,.18,0l6.38,5.9a.74.74,0,0,0,.52.21.76.76,0,0,0,.76-.77v-18A1.15,1.15,0,0,0,14.76,0Z"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                </template>
            </div>

            <!-- ── Pagination ───────────────────────────────────────────────── -->
            <div x-show="!loading && totalPages > 1" class="flex justify-center items-center gap-8 pt-10 pb-4">
                <button aria-label="Previous" :disabled="page <= 1"
                        @click="page > 1 && goToPage(page - 1)"
                        class="bg-white shadow-lg rounded-full w-12 h-12 flex items-center justify-center border border-gray-200"
                        :class="page <= 1 ? 'opacity-30 cursor-not-allowed' : 'hover:border-ahy-blue'">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                </button>

                <div x-data="{ open: false }" class="relative">
                    <button @click="open = !open" class="font-bold text-ahy-blue flex items-center gap-1">
                        Page <span x-text="page"></span> of <span x-text="totalPages"></span>
                        <svg class="w-4 h-4 ml-1 transition-transform" :class="open ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </button>
                    <nav x-show="open" @click.outside="open = false"
                         class="absolute bottom-8 left-1/2 -translate-x-1/2 bg-white border border-gray-200 rounded-xl shadow-lg z-20 w-36 max-h-52 overflow-auto py-1">
                        <template x-for="p in totalPages" :key="p">
                            <button class="w-full text-center px-4 py-2.5 text-sm hover:bg-gray-50"
                                    :class="p === page ? 'font-bold text-ahy-blue' : ''"
                                    @click="goToPage(p); open = false"
                                    x-text="'Page ' + p"></button>
                        </template>
                    </nav>
                </div>

                <button aria-label="Next" :disabled="page >= totalPages"
                        @click="page < totalPages && goToPage(page + 1)"
                        class="bg-white shadow-lg rounded-full w-12 h-12 flex items-center justify-center border border-gray-200"
                        :class="page >= totalPages ? 'opacity-30 cursor-not-allowed' : 'hover:border-ahy-blue'">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </button>
            </div>

        </div><!-- /products -->
    </div><!-- /main layout -->
</div>


<?php include __DIR__ . '/../slider/smart-slider.phtml'; ?>

<script>
function ahySearchResults(productsApiUrl, searchToken, searchQuery, platformStoreId, analyticsUrl, customerGeoState) {
    return {
        productsApiUrl,
        searchToken,
        searchQuery,
        platformStoreId,
        analyticsUrl,
        customerGeoState,
        results: [],
        filters: [],
        apiFacets: [],
        activeFilters: [],
        priceRange: { min: null, max: null },
        activePriceMin: '',
        activePriceMax: '',
        activePriceRange: null,
        priceCollapsed: false,
        total: 0,
        page: 1,
        pageSize: 50,
        totalPages: 1,
        sort: 'relevance',
        loading: true,
        wasCorrection: false,
        correctedQuery: '',
        originalQuery: '',
        suggestedQuery: '',

        init() {
            const params = new URLSearchParams(window.location.search);
            this.page = parseInt(params.get('p') || '1', 10);
            const sortParam = params.get('sort');
            if (sortParam) this.sort = sortParam;
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', () => this.fetch(), { once: true });
            } else {
                this.fetch();
            }
        },

        async fetch() {
            this.loading = true;
            try {
                const url = new URL(this.productsApiUrl);
                url.searchParams.set('search_token', this.searchToken);
                url.searchParams.set('q', this.searchQuery);
                url.searchParams.set('page', this.page);
                if (this.platformStoreId) url.searchParams.set('platform_store_id', this.platformStoreId);
                if (this.customerGeoState) url.searchParams.set('geo_state', this.customerGeoState);

                this.activeFilters.forEach(f => {
                    url.searchParams.set(f.key, f.value);
                });
                if (this.activePriceMin !== '') url.searchParams.set('price_min', this.activePriceMin);
                if (this.activePriceMax !== '') url.searchParams.set('price_max', this.activePriceMax);
                if (this.sort !== 'relevance') url.searchParams.set('sort', this.sort);

                const resp = await fetch(url.toString(), {credentials: 'include'});
                const data = await resp.json();

                if (data.success) {
                    this.results       = data.data || [];
                    this.total         = (data.pagination && data.pagination.total) || 0;
                    this.pageSize      = (data.pagination && data.pagination.per_page) || 50;
                    this.totalPages    = Math.max(1, Math.ceil(this.total / this.pageSize));
                    this.apiFacets     = data.facets || [];
                    this.wasCorrection = !!data.was_corrected;
                    this.correctedQuery = data.corrected_query || this.searchQuery;
                    this.originalQuery  = data.original_query  || this.searchQuery;
                    this.suggestedQuery = data.suggested_query || '';
                    this.buildFilters();
                } else {
                    console.error('[SmartSearch] Search API error:', data);
                }
            } catch(e) {
                console.error('[SmartSearch] Search fetch error', e);
            }
            this.loading = false;
        },

        buildFilters() {
            if (this.apiFacets.length === 0) return;
            const priceFacet = this.apiFacets.find(f => f.key === 'price');
            if (priceFacet) {
                this.priceRange = { min: priceFacet.min ?? null, max: priceFacet.max ?? null };
            }
            this.filters = this.apiFacets
                .filter(f => f.key !== 'price' && f.key !== 'category')
                .map(f => ({
                    key:       f.key,
                    label:     f.key === 'brand' ? 'Shop By Brand' : f.label,
                    collapsed: false,
                    showAll:   false,
                    options:   (f.options || []).map(o => ({ value: o.value, count: o.count })),
                }));
        },

        sortedResults() {
            return this.results;
        },

        searchExact(q) {
            const params = new URLSearchParams(window.location.search);
            params.set('q', q);
            window.location.search = params.toString();
        },

        toggleFilter(key, label, value) {
            const idx = this.activeFilters.findIndex(f => f.key === key && f.value === value);
            if (idx >= 0) this.activeFilters.splice(idx, 1);
            else this.activeFilters.push({ key, label, value });
            this.page = 1;
            window.scrollTo({ top: 0, behavior: 'smooth' });
            this.fetch();
        },

        removeFilter(key, value) {
            this.activeFilters = this.activeFilters.filter(f => !(f.key === key && f.value === value));
            this.page = 1;
            window.scrollTo({ top: 0, behavior: 'smooth' });
            this.fetch();
        },

        applyPriceFilter() { this.page = 1; window.scrollTo({ top: 0, behavior: 'smooth' }); this.fetch(); },
        clearPriceFilter() { this.activePriceMin = ''; this.activePriceMax = ''; this.activePriceRange = null; this.page = 1; window.scrollTo({ top: 0, behavior: 'smooth' }); this.fetch(); },
        clearAllFilters() { this.activeFilters = []; this.activePriceMin = ''; this.activePriceMax = ''; this.activePriceRange = null; this.page = 1; window.scrollTo({ top: 0, behavior: 'smooth' }); this.fetch(); },

        priceRangeBuckets() {
            if (this.priceRange.min === null) return [];
            const all = [
                { label: 'Under $50',     min: '',   max: 50   },
                { label: '$50 – $100',    min: 50,   max: 100  },
                { label: '$100 – $250',   min: 100,  max: 250  },
                { label: '$250 – $500',   min: 250,  max: 500  },
                { label: '$500 – $1,000', min: 500,  max: 1000 },
                { label: 'Over $1,000',   min: 1000, max: ''   },
            ];
            return all.filter(b => {
                const lo = b.min === '' ? 0 : b.min;
                const hi = b.max === '' ? Infinity : b.max;
                return lo < this.priceRange.max && hi > this.priceRange.min;
            });
        },

        togglePriceRange(bucket) {
            if (this.activePriceRange && this.activePriceRange.label === bucket.label) {
                this.activePriceRange = null;
                this.activePriceMin = '';
                this.activePriceMax = '';
            } else {
                this.activePriceRange = bucket;
                this.activePriceMin = bucket.min === '' ? '' : String(bucket.min);
                this.activePriceMax = bucket.max === '' ? '' : String(bucket.max);
            }
            this.applyPriceFilter();
        },

        isFilterActive(key, value) { return this.activeFilters.some(f => f.key === key && f.value === value); },

        goToPage(p) { this.page = p; this.fetch(); window.scrollTo({ top: 0, behavior: 'smooth' }); },
        setSort(val) { this.sort = val; this.page = 1; this.fetch(); },
        sortLabel() {
            return { relevance: 'Relevance', price_asc: 'Price: Low to high', price_desc: 'Price: High to low' }[this.sort] || 'Relevance';
        },

        handleImgError(event) {
            const orig = event.target.getAttribute('data-original-src');
            const withPrefix = orig ? 'https://static.everest.com/media/catalog/product' + orig : null;
            if (withPrefix && event.target.src !== withPrefix) {
                event.target.src = withPrefix;
            } else {
                event.target.src = '/media/catalog/product/placeholder/default/placeholder.jpg';
            }
        },

        async addSimpleToCart(product) {
            try {
                const fd = new FormData();
                fd.append('product', product.product_id);
                fd.append('qty', 1);
                fd.append('form_key', hyva.getFormKey());

                const resp = await fetch('<?= $addToCartUrl ?>', { method: 'POST', body: fd });
                if (resp.ok || resp.redirected) {
                    window.dispatchEvent(new CustomEvent('reload-customer-section-data'));
                    typeof window.dispatchMessages !== 'undefined' && window.dispatchMessages([{type: 'success', text: 'Product added to cart.'}], 3000);
                }
            } catch(e) {
                console.error('[SmartSearch] Add to cart failed', e);
            }
        },
    };
}

function ahyZeroResults(popularUrl, suggestUrl, searchToken, query) {
    return {
        popularUrl,
        suggestUrl,
        searchToken,
        query,
        popularProducts: [],
        popularSearches: [],

        async load() {
            try {
                const r = await fetch(popularUrl + '?search_token=' + encodeURIComponent(searchToken) + '&limit=4', {credentials: 'include'});
                const d = await r.json();
                this.popularProducts = (d.data || d.results || []).slice(0, 4);
            } catch(e) {}
            try {
                const r = await fetch(suggestUrl + '?search_token=' + encodeURIComponent(searchToken) + '&q=' + encodeURIComponent(query) + '&limit=6', {credentials: 'include'});
                const d = await r.json();
                this.popularSearches = d.suggestions || d.results || [];
            } catch(e) {}
        },
    };
}

document.addEventListener('alpine:init', function() {
    if (typeof Alpine !== 'undefined') { window._ssAlpine = Alpine; }
});
document.addEventListener('alpine:initialized', function() {
    var el = document.querySelector('[x-data^="ahySearchResults"]');
    if (el && el.hasAttribute('x-cloak') && window._ssAlpine) { window._ssAlpine.initTree(el); }
});
</script>
