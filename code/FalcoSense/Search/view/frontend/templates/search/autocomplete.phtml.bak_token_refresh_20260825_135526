    <!-- Sticky header -->
    <div style="position:sticky;top:0;z-index:1;background:#fff;border-bottom:1px solid #e5e7eb;">
        <div style="max-width:1400px;margin:0 auto;padding:14px 24px;display:flex;align-items:center;gap:16px;">
            <h1 id="ahyModalTitle" style="flex:1;font-size:20px;font-weight:900;color:#1a3352;margin:0;text-transform:uppercase;letter-spacing:.01em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"></h1>
            <div style="display:flex;align-items:center;gap:6px;flex-shrink:0;font-size:14px;color:#1a3352;">
                <span>Sort by:</span>
                <select id="ahyModalSort" style="border:none;background:transparent;color:#1a3352;font-weight:700;font-size:14px;cursor:pointer;outline:none;">
                    <option value="relevance">Relevance</option>
                    <option value="price_asc">Price: Low to High</option>
                    <option value="price_desc">Price: High to Low</option>
                </select>
            </div>
            <button id="ahyModalClose" style="width:36px;height:36px;border:none;background:transparent;font-size:22px;color:#6b7280;cursor:pointer;flex-shrink:0;" aria-label="Close">✕</button>
        </div>
    </div>

    <!-- Mobile: filter + count bar -->
    <div id="ahyMobileBar">
        <button id="ahyMobileFilterBtn" class="ahy-filter-bar-btn">Filter By</button>
        <span id="ahyMobileCount" style="font-size:13px;font-weight:600;color:#1a3352;"></span>
    </div>

    <!-- Body -->
    <div id="ahyModalBody" style="max-width:1400px;margin:0 auto;">

        <!-- Sidebar: filters (desktop) -->
        <aside id="ahyModalSidebar" style="padding-right:24px;">
            <div id="ahyModalCount" style="padding-bottom:12px;margin-bottom:4px;border-bottom:2px solid #1a3352;font-size:13px;font-weight:600;color:#1a3352;"></div>
            <div id="ahyModalFacets"></div>
        </aside>

        <!-- Products area -->
        <section id="ahyModalProducts">
            <div id="ahyModalGrid"></div>
            <div id="ahyModalPagination" style="display:flex;justify-content:center;gap:8px;margin-top:32px;flex-wrap:wrap;"></div>
        </section>
    </div>
</div>

<script>
(function () {
    'use strict';

    var API_URL  = '<?= $productsApiUrl ?>';
    var TOKEN    = '<?= $searchToken ?>';
    var STORE_ID = <?= $platformStoreId ?>;
    var DEBOUNCE = 300;

    var state = { query: '', page: 1, sort: 'relevance', filters: {} };
    var timer = null;

    var el = {};

    function init() {
        el.modal      = document.getElementById('ahySearchModal');
        el.grid       = document.getElementById('ahyModalGrid');
        el.facets     = document.getElementById('ahyModalFacets');
        el.count      = document.getElementById('ahyModalCount');
        el.mobileCount= document.getElementById('ahyMobileCount');
        el.pagination = document.getElementById('ahyModalPagination');
        el.sort       = document.getElementById('ahyModalSort');
        el.title      = document.getElementById('ahyModalTitle');

        var input = document.getElementById('search');
        if (!input) return;

        input.addEventListener('input', onInput);
        input.setAttribute('autocomplete', 'off');

        document.getElementById('ahyModalClose').addEventListener('click', closeModal);

        document.getElementById('ahyMobileFilterBtn').addEventListener('click', function () {
            var sidebar = document.getElementById('ahyModalSidebar');
            sidebar.style.display = sidebar.style.display === 'block' ? 'none' : 'block';
        });

        el.sort.addEventListener('change', function () {
            state.sort = this.value;
            state.page = 1;
            showLoading();
            doFetch();
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeModal();
        });
    }

    function onInput() {
        var q = this.value.trim();
        clearTimeout(timer);
        if (q.length < 2) { closeModal(); return; }
        if (q !== state.query) {
            state.query   = q;
            state.page    = 1;
            state.filters = {};
        }
        openModal();
        showLoading();
        timer = setTimeout(doFetch, DEBOUNCE);
    }

    function openModal()  { el.modal.classList.add('ahy-open'); document.body.style.overflow = 'hidden'; }
    function closeModal() { el.modal.classList.remove('ahy-open'); document.body.style.overflow = ''; }

    function showLoading() {
        el.title.textContent = '';
        el.count.textContent = '';
        el.mobileCount.textContent = '';
        el.facets.innerHTML  = skelSidebar();
        el.grid.innerHTML    = skelGrid();
        el.pagination.innerHTML = '';
    }

    function skelSidebar() {
        var widths = [80, 60, 75, 50, 65, 80, 55, 70, 45, 60, 75, 50];
        return widths.map(function (w) {
            return '<div class="ahy-skel" style="height:12px;border-radius:20px;margin-bottom:12px;width:' + w + '%"></div>';
        }).join('');
    }

    function skelGrid() {
        var html = '';
        for (var i = 0; i < 6; i++) {
            html += '<div style="background:#fff;padding:16px;display:flex;flex-direction:column;gap:10px;">'
                  + '<div class="ahy-skel" style="height:244px;"></div>'
                  + '<div class="ahy-skel" style="height:14px;border-radius:20px;width:80%"></div>'
                  + '<div class="ahy-skel" style="height:12px;border-radius:20px;width:55%"></div>'
                  + '<div class="ahy-skel" style="height:28px;border-radius:20px;width:45%"></div>'
                  + '</div>';
        }
        return html;
    }

    function buildUrl() {
        var params = new URLSearchParams({
            search_token:      TOKEN,
            platform_store_id: STORE_ID,
            q:                 state.query,
            page:              state.page,
            sort:              state.sort,
        });
        Object.keys(state.filters).forEach(function (k) { params.set(k, state.filters[k]); });
        return API_URL + '?' + params.toString();
    }

    function doFetch() {
        var q = state.query;
        fetch(buildUrl())
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (state.query !== q) return; // stale response, discard
                render(data);
            })
            .catch(function () {
                el.grid.innerHTML = '<div style="grid-column:1/-1;padding:40px;text-align:center;background:#fff;"><p style="color:#555;">Something went wrong. Please try again.</p></div>';
            });
    }

    function render(data) {
        var products = data.data       || [];
        var pg       = data.pagination || {};
        var facets   = data.facets     || [];
        var total    = pg.total        || 0;

        el.title.textContent      = 'SEARCH RESULTS FOR: \'' + state.query.toUpperCase() + '\'';
        el.count.textContent      = '(' + total + ' Items)';
        el.mobileCount.textContent= '(' + total + ' Items)';

        renderFacets(facets);
        renderGrid(products);
        renderPagination(pg);

        el.modal.scrollTop = 0;
    }

    function renderGrid(products) {
        if (!products.length) {
            el.grid.innerHTML = '<div style="grid-column:1/-1;padding:48px;text-align:center;background:#fff;">'
                + '<p style="font-size:16px;color:#555;">No results found for <strong style="color:#1a3352;">' + esc(state.query) + '</strong>.</p>'
                + '</div>';
            return;
        }
        el.grid.innerHTML = products.map(function (p) {
            var url    = p.url_key ? '/' + p.url_key + '.html' : '#';
            var imgSrc = p.image
                ? (imgUrl(p.image) || 'https://static.everest.com/media/.thumbswysiwyg/everest-logo_2_.png')
                : 'https://static.everest.com/media/.thumbswysiwyg/everest-logo_2_.png';
            var imgStyle = p.image ? '' : ' style="opacity:0.45"';
            var isDeal = p.special_price && p.special_price < p.price;

            var priceHtml = '';
            if (isDeal) {
                priceHtml = '<span class="ahy-price-deal">Deal</span>'
                    + '<div><span class="ahy-price-main">$' + fmtPrice(p.special_price) + '</span>'
                    + '<span class="ahy-price-orig">$' + fmtPrice(p.price) + '</span></div>';
            } else if (p.price) {
                priceHtml = '<span class="ahy-price-deal" style="color:#dc2626;">From</span>'
                    + '<span class="ahy-price-main">$' + fmtPrice(p.price) + '</span>';
            } else {
                priceHtml = '<a href="' + esc(url) + '" class="ahy-options-btn" style="margin-top:auto;align-self:flex-start;">See Options</a>';
            }

            return '<div class="ahy-card">'
                + '<a href="' + esc(url) + '" style="display:block;">'
                + '<img src="' + esc(imgSrc) + '" alt="' + esc(p.name) + '" class="ahy-card-img" loading="lazy"' + imgStyle
                + ' onerror="if(this.dataset.fb)return;this.dataset.fb=1;this.onerror=null;this.src=\'https://static.everest.com/media/.thumbswysiwyg/everest-logo_2_.png\';this.style.opacity=\'0.45\';">'
                + '</a>'
                + '<div class="ahy-card-body">'
                + '<a href="' + esc(url) + '" class="ahy-card-name">' + esc(p.name) + '</a>'
                + (p.brand ? '<p class="ahy-card-brand">Sold By ' + esc(p.brand) + '</p>' : '')
                + '<div class="ahy-card-price">' + priceHtml + '</div>'
                + '<div class="ahy-card-footer">'
                + '<span class="ahy-card-shipping">FREE Shipping</span>'
                + '<a href="' + esc(url) + '" class="ahy-options-btn">Options</a>'
                + '</div>'
                + '</div>'
                + '</div>';
        }).join('');
    }

    function renderFacets(facets) {
        if (!facets.length) { el.facets.innerHTML = ''; return; }

        el.facets.innerHTML = facets.map(function (facet) {
            var key     = esc(facet.key);
            var label   = esc(facet.label || facet.key);
            var options = facet.options || facet.values || [];

            var items = options.slice(0, 8).map(function (opt) {
                var val      = opt.value;
                var isActive = state.filters[facet.key] === val;
                return '<li class="ahy-facet-item">'
                    + '<span class="ahy-cb-box' + (isActive ? ' ahy-checked' : '') + '" data-fkey="' + key + '" data-fval="' + esc(val) + '">'
                    + (isActive ? '<svg width="10" height="10" fill="none" stroke="#fff" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>' : '')
                    + '</span>'
                    + '<span class="ahy-facet-val">' + esc(val) + '</span>'
                    + '<span class="ahy-facet-cnt">(' + (opt.count || 0) + ')</span>'
                    + '</li>';
            }).join('');

            return '<div class="ahy-facet-group">'
                + '<button class="ahy-facet-toggle">'
                + '<span class="ahy-facet-title">' + label + '</span>'
                + '<svg width="16" height="16" fill="none" stroke="#1a3352" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>'
                + '</button>'
                + '<ul class="ahy-facet-list">' + items + '</ul>'
                + '</div>';
        }).join('');

        // Filter checkbox clicks
        el.facets.querySelectorAll('.ahy-cb-box').forEach(function (box) {
            box.addEventListener('click', function () {
                var key = this.getAttribute('data-fkey');
                var val = this.getAttribute('data-fval');
                if (state.filters[key] === val) {
                    delete state.filters[key];
                } else {
                    state.filters[key] = val;
                }
                state.page = 1;
                showLoading();
                doFetch();
            });
        });

        // Collapsible toggle
        el.facets.querySelectorAll('.ahy-facet-toggle').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var list = this.nextElementSibling;
                list.style.display = list.style.display === 'none' ? '' : 'none';
            });
        });
    }

    function renderPagination(pg) {
        var page       = pg.page     || 1;
        var total      = pg.total    || 0;
        var perPage    = pg.per_page || 12;
        var totalPages = Math.ceil(total / perPage);

        if (totalPages <= 1) { el.pagination.innerHTML = ''; return; }

        var html   = '';
        var start  = Math.max(1, page - 2);
        var end    = Math.min(totalPages, page + 2);

        if (page > 1)          html += '<button class="ahy-page-btn" data-p="' + (page - 1) + '">‹ Prev</button>';
        for (var i = start; i <= end; i++) {
            html += '<button class="ahy-page-btn' + (i === page ? ' ahy-active' : '') + '" data-p="' + i + '">' + i + '</button>';
        }
        if (page < totalPages) html += '<button class="ahy-page-btn" data-p="' + (page + 1) + '">Next ›</button>';

        el.pagination.innerHTML = html;
        el.pagination.querySelectorAll('.ahy-page-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                state.page = parseInt(this.getAttribute('data-p'), 10);
                showLoading();
                doFetch();
                el.modal.scrollTop = 0;
            });
        });
    }

    function fmtPrice(n) {
        return parseFloat(n).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    }

    function esc(s) {
        return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function imgUrl(image) {
        if (!image) return '';
        if (image.indexOf('falcosense/800x800') !== -1) return image;
        var path = image.indexOf('http') === 0 ? image.replace(/^https?:\/\/[^/]+/, '') : image;
        var m = path.match(/\/catalog\/product\/(.+)$/);
        var rel = m ? m[1] : path.replace(/^\/+/, '');
        if (!rel) return '';
        var filename = rel.split('/').pop();
        if (!filename) return '';
        var c1 = filename[0], c2 = filename[1] || c1;
        return '/media/falcosense/800x800/' + c1 + '/' + c2 + '/' + filename;
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        setTimeout(init, 0);
    }
}());
</script>
