<?php
/**
 * Zero-results "Popular Products" panel for search/results.phtml.
 * @var \FalcoSense\Search\Block\Search $block
 *
 * Rendered as a child block in the exact same DOM position it previously
 * occupied inline, so its nested Alpine component (ahyZeroResults) still
 * inherits imgUrl()/isFallbackImg()/handleImgError() from the parent
 * ahySearchResults() scope via normal DOM-based scope resolution.
 */
$popularUrl  = $block->escapeJs(preg_replace('#/api/search\.php$#', '/api/popular.php', $block->getSearchApiUrl()));
$suggestUrl  = $block->escapeJs(preg_replace('#/api/search\.php$#', '/api/suggest.php', $block->getSearchApiUrl()));
$searchToken = $block->escapeJs($block->getSearchToken((int) $block->getPlatformStoreId()));
$searchQuery = $block->escapeJs($block->getSearchQuery());
?>
<div x-show="!loading && results.length === 0"
    x-data="ahyZeroResults('<?= $popularUrl ?>', '<?= $suggestUrl ?>', '<?= $searchToken ?>', '<?= $searchQuery ?>')"
    x-init="load()">
    <div class="bg-white rounded-xl border border-gray-100 shadow-sm mx-auto py-10 px-6"
        style="max-width:960px">
        <p class="text-center text-gray-600 text-base mb-6">
            We're sorry, no results found for <em class="font-semibold not-italic"
                x-text="'&quot;' + query + '&quot;'"></em>.
        </p>

        <p class="text-center font-extrabold text-ahy-blue text-sm uppercase tracking-widest mb-5">Popular
            Products</p>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-0.5" x-show="popularProducts.length > 0">
            <template x-for="(p, pIndex) in popularProducts" :key="pIndex + '-pop-' + (p.sku || p.product_id || 'x')">
                <a :href="p.url_key ? '/' + p.url_key + '.html' : '#'"
                    class="bg-white flex flex-col p-3 hover:shadow-md transition group">
                    <img :src="imgUrl(p.image)"
                        :alt="p.name" class="w-full object-contain mb-3"
                        :style="isFallbackImg(imgUrl(p.image)) ? 'height:180px;opacity:0.45' : 'height:180px'"
                        loading="lazy"
                        @error="handleImgError($event)"
                        :data-original-src="p.image" />
                    <span
                        class="text-sm font-bold text-ahy-blue leading-snug line-clamp-2 group-hover:underline"
                        x-text="p.name"></span>
                    <div class="mt-1">
                        <template x-if="p.special_price && p.special_price < p.price">
                            <span class="text-sm font-extrabold text-ahy-blue"
                                x-html="'Starting at ' + hyva.formatPrice(p.special_price)"></span>
                        </template>
                        <template x-if="!p.special_price || p.special_price >= p.price">
                            <span class="text-sm font-extrabold text-ahy-blue"
                                x-html="(p.type === 'configurable' ? 'Starting at ' : '') + hyva.formatPrice(p.price)"></span>
                        </template>
                    </div>
                </a>
            </template>
        </div>

        <div x-show="popularSearches.length > 0" class="mt-6 text-center text-sm text-gray-600">
            <span class="font-bold">Popular Searches: </span>
            <template x-for="(term, i) in popularSearches" :key="term">
                <span>
                    <a :href="'/catalogsearch/result/?q=' + encodeURIComponent(term)"
                        class="text-ahy-blue hover:underline" x-text="term"></a><span
                        x-show="i < popularSearches.length - 1">, </span>
                </span>
            </template>
        </div>
    </div>
</div>
