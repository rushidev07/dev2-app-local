<?php
/**
 * Desktop product card for the category results page — extracted verbatim
 * from category/results.phtml's inline markup so it can be rendered once via
 * $block->getChildHtml('product_card_desktop') and looped client-side by
 * Alpine's x-for in the parent template. No PHP variables are needed here;
 * all data comes from the Alpine `product` scope set up by the parent.
 */
$addToCartBorderRadius = $block->escapeHtmlAttr(
    $block->getStyleValue('add_to_cart_button', 'border_radius', '9999')
);
$addToCartIconUrl = $block->getStyleImageUrl('add_to_cart_button', 'icon');
$addToCartFilled = $block->getStyleValue('add_to_cart_button', 'button_style', 'outline') === 'filled';
// Admin filled/outline setting -> modifier class (see fs-components.css).
$addToCartVariantClass = $addToCartFilled ? 'fs-btn--filled' : 'fs-btn--outline';
$addToCartLabelOverride = $block->getStyleValue('add_to_cart_button', 'label_text', '');
$addToCartLabel = $addToCartLabelOverride !== '' ? $addToCartLabelOverride : 'Add';
$addToCartOptionsLabelOverride = $block->getStyleValue('add_to_cart_button', 'options_label_text', '');
$addToCartOptionsLabel = $addToCartOptionsLabelOverride !== '' ? $addToCartOptionsLabelOverride : 'Options';
$addToCartLabelJs = $block->escapeJs($addToCartLabel);
?>
<div class="fs-card" style="border-radius:var(--ahy-card-radius);border:var(--ahy-card-border);box-shadow:var(--ahy-card-shadow);">

    <button @click.prevent="addToWishlist(product.product_id)"
            :disabled="wishLoading[product.product_id] === true"
            aria-label="Add to Wish List" type="button"
            class="fs-card__wishlist">
        <template x-if="wishLoading[product.product_id] === true">
            <svg class="fs-icon fs-icon--spin" fill="none" viewBox="0 0 24 24"><circle class="fs-spinner__track" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="fs-spinner__head" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 22 6.477 22 12h-4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"/></svg>
        </template>
        <template x-if="wishLoading[product.product_id] !== true">
            <svg class="fs-icon fs-icon--lg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 15.91 20" fill="currentColor">
                <path d="M14.41,1.5v16L9.27,12.71a1.62,1.62,0,0,0-2.19,0L1.5,17.58V1.5H14.41M14.76,0H1.15A1.16,1.16,0,0,0,0,1.15v18.1a.74.74,0,0,0,1.24.56l6.83-6a.12.12,0,0,1,.18,0l6.38,5.9a.74.74,0,0,0,.52.21.76.76,0,0,0,.76-.77v-18A1.15,1.15,0,0,0,14.76,0Z"/>
            </svg>
        </template>
    </button>

    <a :href="product.url_key ? '/' + product.url_key + '.html' : '#'"
       class="fs-card__media">
        <img :src="imgUrl(product.image)"
             :alt="product.name"
             width="244" height="244"
             class="fs-card__image"
             :style="{ opacity: isFallbackImg(product.image) ? 0.45 : 1 }"
             style="max-width:244px;height:244px;margin:0 auto;display:block"
             loading="eager"
             fetchpriority="high"
             @error="handleImgError($event)"
             :data-original-src="product.image"/>
    </a>

    <div class="fs-card__body fs-card__body--roomy">

        <a :href="product.url_key ? '/' + product.url_key + '.html' : '#'"
           class="fs-card__title"
           :title="cleanName(product.name)" x-text="cleanName(product.name)"></a>

        <p class="fs-card__seller fs-card__seller--oneline"
           x-show="FalcoSense.soldBy(product.brand)" x-text="FalcoSense.soldBy(product.brand)"></p>

        <div class="fs-card__price">
            <template x-if="product.price && product.special_price && product.special_price < product.price">
                <div>
                    <div class="fs-card__deal-label">Deal</div>
                    <div class="fs-card__price-row">
                        <span class="fs-card__price-current" x-html="hyva.formatPrice(product.special_price)"></span>
                        <span class="fs-card__price-was" x-html="hyva.formatPrice(product.price)"></span>
                    </div>
                </div>
            </template>
            <template x-if="product.price && (!product.special_price || product.special_price >= product.price)">
                <div class="fs-card__price-col">
                    <span class="fs-card__price-from" x-show="product.type === 'configurable'">From</span>
                    <span class="fs-card__price-current" x-html="hyva.formatPrice(product.price)"></span>
                </div>
            </template>
            <template x-if="!product.price">
                <span class="fs-card__options-btn">See Options</span>
            </template>
        </div>

        <div class="fs-card__footer">
            <p class="fs-card__shipping" :class="isFreeShipping(product) ? '' : 'invisible'">FREE Shipping</p>
            <div class="fs-card__cta-wrap fs-card__cta-wrap--end">
                <template x-if="product.type !== 'configurable'">
                    <button @click.prevent="addSimpleToCart(product)"
                            :class="cartLoading[product.product_id] === true ? 'is-loading' : ''"
                            class="fs-btn fs-btn--mini <?= $addToCartVariantClass ?>"
                            style="border-radius: <?= $addToCartBorderRadius ?>px">
                        <svg x-show="cartLoading[product.product_id] === true" class="fs-icon fs-icon--spin" fill="none" viewBox="0 0 24 24"><circle class="fs-spinner__track" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="fs-spinner__head" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 22 6.477 22 12h-4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"/></svg>
                        <?php if ($addToCartIconUrl): ?>
                        <img x-show="cartLoading[product.product_id] !== true" src="<?= $block->escapeUrl($addToCartIconUrl) ?>" alt="" class="fs-btn__icon" />
                        <?php else: ?>
                        <svg x-show="cartLoading[product.product_id] !== true" class="fs-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                        <?php endif; ?>
                        <span class="fs-lg-up" x-text="cartLoading[product.product_id] === true ? 'Adding…' : '<?= $addToCartLabelJs ?>'"></span>
                        <span class="fs-md-only" x-text="cartLoading[product.product_id] === true ? '…' : '<?= $addToCartLabelJs ?>'"></span>
                    </button>
                </template>
                <template x-if="product.type === 'configurable'">
                    <button @click.prevent="$dispatch('ahy-cfg-modal-open', product)"
                            class="fs-btn fs-btn--mini <?= $addToCartVariantClass ?>"
                            style="border-radius: <?= $addToCartBorderRadius ?>px">
                        <span><?= $block->escapeHtml($addToCartOptionsLabel) ?></span>
                    </button>
                </template>
            </div>
        </div>
    </div>
</div>
