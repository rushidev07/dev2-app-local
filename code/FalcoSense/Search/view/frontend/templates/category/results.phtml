<script>
/*
 * ahyCategoryResults() now lives in web/js/plp/category-results.js.
 *
 * It was inline here, which meant a storefront could not replace this
 * template's markup without also losing the component — the reason
 * Ahy_PlpRevamp had to keep a full copy of it. As a file, markup and
 * behaviour are separable and every store shares one implementation.
 *
 * Registered in view/frontend/layout/default.xml. The file guards against
 * overwriting a host-supplied component of the same name.
 */

document.addEventListener('alpine:init', function() {
    if (typeof Alpine !== 'undefined') { window._ssAlpine = Alpine; }
});
document.addEventListener('alpine:initialized', function() {
    var el = document.querySelector('[x-data^="ahyCategoryResults"]');
    if (!el || !el.hasAttribute('x-cloak')) return;
    if (el._x_dataStack) {
        el.removeAttribute('x-cloak');
    } else if (window._ssAlpine) {
        window._ssAlpine.initTree(el);
    }
});
</script>

<style>
/*
 * Only rules that CANNOT live in web/css/fs-components.css remain here.
 *
 * Everything styling FalcoSense's own markup moved to the module stylesheet
 * under .fs-root — the card, grid, filters, chips, loader, slide-over and
 * mobile bar all went with it.
 *
 * ---------------------------------------------------------------------------
 * WHAT IS LEFT, AND WHY: host page-layout overrides.
 *
 * These reach OUTSIDE .fs-root on purpose. They collapse the host theme's
 * column grid so the product listing can run full width, and reserve column
 * height so the page does not jump while Alpine hydrates.
 *
 * They are the module's last remaining assumption about the page it is
 * installed in, and they are theme-specific: `grid-template-columns` only does
 * anything if the theme lays `.columns` out as a CSS grid (Hyva does; Luma does
 * not), so on a Luma store they are inert and the listing will sit inside the
 * theme's narrow main column instead.
 *
 * The portable replacement is a full-bleed .fs-root that does not care how the
 * host lays out its columns:
 *     .fs-plp-root { margin-inline: calc(50% - 50vw); }
 *
 * NOTE: an earlier draft of this note used
 *     width:100vw; margin-left:50%; transform:translateX(-50%);
 * DO NOT USE IT. A transform on an ancestor establishes a containing block for
 * position:fixed descendants, and we have four (.fs-drawer, .fs-slideover,
 * .fs-slideover__rail, .fs-panel — the mobile filter drawer). They would stop
 * being viewport-fixed and get trapped inside the grid. The margin-inline form
 * is transform-free and has no such effect.
 *
 * Remaining caveat either way: 50vw counts the scrollbar, so on a page with a
 * vertical scrollbar this overshoots by ~8px per side and can introduce a
 * horizontal scrollbar. Needs `overflow-x: clip` on a wrapper, or the host's
 * own container width, before it ships.
 *
 * That is deliberately NOT applied yet — it changes Everest's category layout
 * and needs visual confirmation on dev2 first. Until then this block stays.
 * ---------------------------------------------------------------------------
 */
/* min-height moved to .fs-root.is-loading (our own root). overflow-anchor stays
   here: .column.main is the scrolling container, and a descendant cannot switch
   off the browser's scroll anchoring for its ancestor. This is the one host
   property we still need, and it is documented as an integration note. */
.catalog-category-view .column.main { overflow-anchor: none; }

/* Category rows are taller than search rows, so this listing reserves more. */
.fs-root { --fs-plp-loading-min-height: 4500px; }
.catalog-category-view .columns { column-gap: 0 !important; row-gap: 0 !important; }
.catalog-category-view .wishlist-widget { display: none !important; }

@media (min-width: 768px) {
    .catalog-category-view .columns { padding-right: 0 !important; }
    .catalog-category-view .column.main { padding-right: 0 !important; }
}

/*
 * REMOVED: the .page-layout-* grid overrides.
 *
 * They forced the theme's .columns grid to a single column so our listing was
 * not squeezed beside an empty sidebar slot. catalog_category_view.xml now
 * declares layout="1column", so the framework produces a one-column page and
 * there is nothing left to override — see the comment at the top of that file.
 *
 * What went:
 *     .catalog-category-view.page-layout-2columns-left  .columns { grid-template-columns: repeat(1, ...) }
 *     .catalog-category-view.page-layout-2columns-right .columns { ... }
 *     .catalog-category-view.page-layout-3columns       .columns { ... }
 *     ...and the matching `grid-column-start: 1 !important` on .main
 *
 * Those rules only worked on a theme whose .columns is a CSS grid carrying
 * Magento's own body classes. Dropping them is what makes this page portable.
 */
</style>
