<?php
/** @var \FalcoSense\Search\Block\Category $block */
$productsApiUrl  = $block->escapeUrl($block->getProductsApiUrl());
$searchToken     = $block->getSearchToken((int) $block->getPlatformStoreId());
$categoryName    = $block->getCategoryName();
$categoryId      = $block->getCategoryId();
$addToCartUrl    = $block->escapeUrl($block->getUrl('checkout/cart/add'));
$platformStoreId = (int) $block->getPlatformStoreId();

// Server-side rendered view of this category's grid, for whatever page/sort
// the URL specifies — null only when the platform returned nothing usable or
// the category didn't resolve. See Block/Category::getPlpResult().
$plpResult = $block->getPlpResult();

$fmtPrice = static fn (float $p): string => '$' . number_format($p, 2);

$renderSsrCard = function (\FalcoSense\Search\Model\Plp\PlpItem $item) use ($block, $fmtPrice): string {
    $url = $item->urlKey !== '' ? '/' . $item->urlKey . '.html' : '#';
    $href = $block->escapeUrl($url);
    $name = $block->escapeHtml($item->name);
    $img = $block->escapeUrl($item->imageUrl);
    $seller = $block->escapeHtml($item->brand ?: $block->getDefaultSeller());

    if ($item->price !== null && $item->hasDiscount()) {
        $priceHtml = '<div class="fs-card__deal-label">Deal</div>'
            . '<div class="fs-card__price-row">'
            . '<span class="fs-card__price-current">' . $fmtPrice($item->specialPrice) . '</span>'
            . '<span class="fs-card__price-was">' . $fmtPrice($item->price) . '</span>'
            . '</div>';
    } elseif ($item->price !== null) {
        $fromLabel = $item->isConfigurable()
            ? '<span class="fs-card__price-from">From</span>'
            : '';
        $priceHtml = '<div class="fs-card__price-col">' . $fromLabel
            . '<span class="fs-card__price-current">' . $fmtPrice($item->price) . '</span></div>';
    } else {
        $priceHtml = '<span class="fs-card__options-btn">'
            . 'See Options</span>';
    }

    return '<div class="fs-card" '
        . 'style="border-radius:var(--ahy-card-radius);border:var(--ahy-card-border);box-shadow:var(--ahy-card-shadow);">'
        . '<a href="' . $href . '" class="fs-card__media">'
        . '<img src="' . $img . '" alt="' . $name . '" width="244" height="244" loading="eager" '
        . 'class="fs-card__image" />'
        . '</a>'
        . '<div class="fs-card__body fs-card__body--roomy">'
        . '<a href="' . $href . '" class="fs-card__title" title="' . $name . '">' . $name . '</a>'
        . '<p class="fs-card__seller">Sold By ' . $seller . '</p>'
        . '<div class="fs-card__price">' . $priceHtml . '</div>'
        . '</div></div>';
};
?>
