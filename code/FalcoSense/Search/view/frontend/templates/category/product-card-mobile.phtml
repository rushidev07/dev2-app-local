<?php
/**
 * Mobile product card for the category results page — extracted verbatim
 * from category/results.phtml's inline markup so it can be rendered once via
 * $block->getChildHtml('product_card_mobile') and looped client-side by
 * Alpine's x-for in the parent template. No PHP variables are needed here;
 * all data comes from the Alpine `product` scope set up by the parent.
 */
$addToCartBorderRadius = $block->escapeHtmlAttr(
    $block->getStyleValue('add_to_cart_button', 'border_radius', '9999')
);
$addToCartIconUrl = $block->getStyleImageUrl('add_to_cart_button', 'icon');
$addToCartFilled = $block->getStyleValue('add_to_cart_button', 'button_style', 'outline') === 'filled';
// Admin filled/outline setting -> modifier class (see fs-components.css).
$addToCartVariantClass = $addToCartFilled ? 'fs-btn--filled' : 'fs-btn--outline';
$addToCartLabelOverride = $block->getStyleValue('add_to_cart_button', 'label_text', '');
$addToCartLabel = $addToCartLabelOverride !== '' ? $addToCartLabelOverride : 'Add';
$addToCartOptionsLabelOverride = $block->getStyleValue('add_to_cart_button', 'options_label_text', '');
$addToCartOptionsLabel = $addToCartOptionsLabelOverride !== '' ? $addToCartOptionsLabelOverride : 'Options';
$addToCartLabelJs = $block->escapeJs($addToCartLabel);
?>
<div class="fs-card fs-card--mobile" style="border-radius:var(--ahy-card-radius);border:var(--ahy-card-border);box-shadow:var(--ahy-card-shadow);">

    <div class="fs-card__media-wrap" style="width:45%">
        <div class="fs-card__badge"
             x-show="product.variants && product.variants.length <= 10 && product.variants.length > 0">
            <span class="fs-card__stock-badge fs-card__stock-badge--tight"
                  x-text="(product.variants || []).length + ' Left'"></span>
        </div>
        <a :href="product.url_key ? '/' + product.url_key + '.html' : '#'" class="fs-card__media fs-card__media--fill">
            <img :src="imgUrl(product.image)"
                 :alt="product.name"
                 class="fs-card__image fs-card__image--fill"
                 :style="{ opacity: isFallbackImg(product.image) ? 0.45 : 1 }"
                 style="min-height:160px;max-height:200px"
                 loading="eager"
                 fetchpriority="high"
                 @error="handleImgError($event)"
                 :data-original-src="product.image"/>
        </a>
    </div>

    <div class="fs-card__body fs-card__body--mobile">
        <a :href="product.url_key ? '/' + product.url_key + '.html' : '#'"
           class="fs-card__title fs-card__title--snug" style="font-size:18px"
           x-text="cleanName(product.name)"></a>
        <p class="fs-card__seller fs-card__seller--oneline"
           x-show="FalcoSense.soldBy(product.brand)" x-text="FalcoSense.soldBy(product.brand)"></p>
        <div class="fs-card__price-block">
            <template x-if="product.price && product.special_price && product.special_price < product.price">
                <div>
                    <div class="fs-card__price-from fs-card__price-from--plain">Deal</div>
                    <div class="fs-card__price-row">
                        <span class="fs-card__price-current" x-html="hyva.formatPrice(product.special_price)"></span>
                        <span class="fs-card__price-was" x-html="hyva.formatPrice(product.price)"></span>
                    </div>
                </div>
            </template>
            <template x-if="product.price && (!product.special_price || product.special_price >= product.price)">
                <div>
                    <span class="fs-card__price-from fs-card__price-from--plain" x-show="product.type === 'configurable'">From</span>
                    <div class="fs-card__price-current" x-html="hyva.formatPrice(product.price)"></div>
                </div>
            </template>
        </div>
        <p class="fs-card__shipping fs-card__shipping--mobile" x-show="isFreeShipping(product)">FREE Shipping</p>
        <div class="fs-card__actions">
            <template x-if="product.type !== 'configurable'">
                <button @click.prevent="addSimpleToCart(product)"
                        :class="cartLoading[product.product_id] === true ? 'is-loading' : ''"
                        class="fs-btn fs-btn--compact <?= $addToCartVariantClass ?>"
                        style="border-radius: <?= $addToCartBorderRadius ?>px">
                    <svg x-show="cartLoading[product.product_id] === true" class="fs-icon fs-icon--xs fs-icon--spin" fill="none" viewBox="0 0 24 24"><circle class="fs-spinner__track" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="fs-spinner__head" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 22 6.477 22 12h-4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"/></svg>
                    <?php if ($addToCartIconUrl): ?>
                    <img x-show="cartLoading[product.product_id] !== true" src="<?= $block->escapeUrl($addToCartIconUrl) ?>" alt="" class="fs-btn__icon fs-icon--xs" />
                    <?php else: ?>
                    <svg x-show="cartLoading[product.product_id] !== true" class="fs-icon fs-icon--xs" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                    <?php endif; ?>
                    <span x-text="cartLoading[product.product_id] === true ? 'Adding…' : '<?= $addToCartLabelJs ?>'"></span>
                </button>
            </template>
            <template x-if="product.type === 'configurable'">
                <button @click.prevent="$dispatch('ahy-cfg-modal-open', product)"
                        class="fs-btn fs-btn--compact <?= $addToCartVariantClass ?>"
                        style="border-radius: <?= $addToCartBorderRadius ?>px">
                    <?= $block->escapeHtml($addToCartOptionsLabel) ?>
                </button>
            </template>
            <button @click.prevent="addToWishlist(product.product_id)"
                    :disabled="wishLoading[product.product_id] === true"
                    aria-label="Add to Wish List"
                    class="fs-card__wishlist fs-card__wishlist--inline">
                <template x-if="wishLoading[product.product_id] === true">
                    <svg class="fs-icon fs-icon--spin" fill="none" viewBox="0 0 24 24"><circle class="fs-spinner__track" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="fs-spinner__head" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 22 6.477 22 12h-4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"/></svg>
                </template>
                <template x-if="wishLoading[product.product_id] !== true">
                    <svg class="fs-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 15.91 20" fill="currentColor">
                        <path d="M14.41,1.5v16L9.27,12.71a1.62,1.62,0,0,0-2.19,0L1.5,17.58V1.5H14.41M14.76,0H1.15A1.16,1.16,0,0,0,0,1.15v18.1a.74.74,0,0,0,1.24.56l6.83-6a.12.12,0,0,1,.18,0l6.38,5.9a.74.74,0,0,0,.52.21.76.76,0,0,0,.76-.77v-18A1.15,1.15,0,0,0,14.76,0Z"/>
                    </svg>
                </template>
            </button>
        </div>
    </div>
</div>
