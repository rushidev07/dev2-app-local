<script>
if (typeof ahyConfigModal === 'undefined') {
    function ahyConfigModal() {
        return {
            open: false, product: { variants: [] }, selected: null, adding: false, error: '', activeImage: '', galleryImages: [], variantAttrs: {}, attrsLoaded: false, selectedAttrs: {},
            FALLBACK_IMG: 'https://static.everest.com/media/.thumbswysiwyg/everest-logo_2_.png',
            isFallbackImg(path) {
                return this.cdnImg(path) === this.FALLBACK_IMG;
            },
            cdnImg(path) {
                if (!path) return this.FALLBACK_IMG;
                if (path.includes('falcosense/800x800')) return path;
                let rel = path;
                if (path.startsWith('http')) {
                    const m = path.match(/\/catalog\/product\/(.+)$/);
                    if (!m) return this.FALLBACK_IMG;
                    rel = m[1];
                } else {
                    rel = rel.replace(/^\/+/, '');
                }
                if (!rel) return this.FALLBACK_IMG;
                const filename = rel.split('/').pop();
                if (!filename) return this.FALLBACK_IMG;
                const c1 = filename[0], c2 = filename[1] || c1;
                return '/media/falcosense/800x800/' + c1 + '/' + c2 + '/' + filename;
            },
            get displayPrice() {
                const src = this.selected || this.product;
                return src.special_price && src.special_price < src.price ? src.special_price : src.price;
            },
            get displayOriginal() {
                const src = this.selected || this.product;
                return src.special_price && src.special_price < src.price ? src.price : null;
            },
            init() {
                if (!window._ahyCfgModalInited) window.addEventListener('ahy-open-config-modal', e => {
                    this.product = { variants: [], ...e.detail };
                    this.selected = (e.detail.variants || []).find(v => v.in_stock) || null;
                    this.error = '';
                    this.activeImage = '';
                    this.galleryImages = [];
                    const _parentSku = e.detail.product_sku || e.detail.sku || '';
                    const _variantSkus = (e.detail.variants || []).map(v => v.sku || v.variant_sku).filter(Boolean);
                    const _allSkus = [...new Set([_parentSku, ..._variantSkus])].filter(Boolean);
                    if (_allSkus.length) {
                        fetch('/ahy_themecustomization/index/mediaGallery?skus=' + encodeURIComponent(_allSkus.join(',')), {credentials: 'include'})
                            .then(r => r.json())
                            .then(imgs => { this.galleryImages = imgs; if (imgs.length) this.activeImage = imgs[0]; })
                            .catch(() => {});
                    }
                    this.attrsLoaded = false;
                    const _vSkus = _variantSkus.filter(Boolean);
                    if (_vSkus.length) {
                        fetch('/variant-attrs.php?skus=' + encodeURIComponent(_vSkus.join(',')), {credentials: 'include'})
                            .then(r => r.json())
                            .then(attrs => {
                                this.variantAttrs = attrs || {};
                                this.attrsLoaded = true;
                                if (this.selected) {
                                    var _sku = this.selected.sku || this.selected.variant_sku || '';
                                    var _a = this.variantAttrs[_sku] || {};
                                    var _self = this;
                                    this.selectedAttrs = Object.fromEntries(Object.entries(_a).map(function(e) { return [e[0], _self.decodeHtml(e[1])]; }));
                                }
                            })
                            .catch(() => { this.attrsLoaded = true; });
                    } else {
                        this.attrsLoaded = true;
                    }
                    this.open = true; document.body.style.overflow = 'hidden';
                });
            },
            optionLabel(v) {
                var sku = v.sku || v.variant_sku || '';
                var attrs = sku ? (this.variantAttrs[sku] || {}) : {};
                var vals = Object.values(attrs);
                if (vals.length) return vals.map(v => this.decodeHtml(v)).join(' / ');
                var label = v.variant_title || v.name || '';
                if (label && this.product.name) {
                    var prefix = this.product.name.toLowerCase();
                    var lower  = label.toLowerCase();
                    if (lower.startsWith(prefix)) {
                        label = label.slice(this.product.name.length).replace(/^[\s\-\/]+/, '').trim();
                    }
                }
                return this.decodeHtml(label || sku);
            },
            attrGroups() {
                var groups = {}, order = [];
                var self = this;
                Object.values(this.variantAttrs).forEach(function(attrs) {
                    Object.entries(attrs).forEach(function(e) {
                        var name = e[0], val = self.decodeHtml(e[1]);
                        if (!groups[name]) { groups[name] = []; order.push(name); }
                        if (groups[name].indexOf(val) === -1) groups[name].push(val);
                    });
                });
                return order.map(function(name) { return { name: name, values: groups[name] }; });
            },
            selectAttr(attrName, value) {
                this.selectedAttrs = Object.assign({}, this.selectedAttrs, { [attrName]: value });
                var self = this;
                var matchedSku = null;
                Object.entries(this.variantAttrs).forEach(function(e) {
                    if (matchedSku) return;
                    var sku = e[0], attrs = e[1];
                    var matches = Object.entries(self.selectedAttrs).every(function(s) {
                        return self.decodeHtml(attrs[s[0]] || '') === s[1];
                    });
                    if (matches) matchedSku = sku;
                });
                if (matchedSku) {
                    var v = (this.product.variants || []).find(function(v) { return (v.sku || v.variant_sku) === matchedSku; });
                    if (v) { this.selected = v; if (v.image) this.activeImage = this.cdnImg(v.image); }
                }
                this.error = '';
            },
            isAttrSelected(attrName, value) { return this.selectedAttrs[attrName] === value; },
            decodeHtml(str) {
                if (!str) return str;
                return new DOMParser().parseFromString(str, 'text/html').body.textContent || str;
            },
            close() { this.open = false; this.selected = null; this.error = ''; document.body.style.overflow = ''; },
            selectVariant(v) { if (!v.in_stock) return; this.selected = v; this.error = ''; if (v.image) this.activeImage = this.cdnImg(v.image); },
            async addToCart() {
                if (!this.selected) { this.error = 'Please select an option first.'; return; }
                this.adding = true; this.error = '';
                try {
                    const fd = new FormData();
                    fd.append('product', this.selected.variant_id); fd.append('qty', 1); fd.append('form_key', hyva.getFormKey());
                    const resp = await fetch('<?= $addToCartUrl ?>', { method: 'POST', body: fd });
                    if (resp.ok || resp.redirected) { window.dispatchEvent(new CustomEvent('reload-customer-section-data')); window.dispatchEvent(new CustomEvent('toggle-cart')); this.close(); }
                    else this.error = 'Could not add to cart. Please try again.';
                } catch(e) { this.error = 'Could not add to cart. Please try again.'; }
                this.adding = false;
            },
        };
    }
}
