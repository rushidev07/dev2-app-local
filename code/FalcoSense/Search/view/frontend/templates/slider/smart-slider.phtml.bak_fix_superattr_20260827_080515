<script>
if (typeof ahySliderATC === 'undefined') {
    window.ahySliderATC = function(btn) {
        var productId = btn.dataset.productId;
        var url = btn.dataset.atcUrl;
        var fd = new FormData();
        fd.append('product', productId);
        fd.append('qty', 1);
        fd.append('form_key', hyva.getFormKey());
        btn.disabled = true;
        btn.style.opacity = '0.6';
        fetch(url, { method: 'POST', body: fd, credentials: 'same-origin' })
            .then(function(r) {
                if (r.ok || r.redirected) {
                    window.dispatchEvent(new CustomEvent('reload-customer-section-data'));
                    window.dispatchEvent(new CustomEvent('toggle-cart'));
                    typeof window.dispatchMessages !== 'undefined' && window.dispatchMessages([{type: 'success', text: 'Product added to cart.'}], 3000);
                }
            })
            .catch(function() {})
            .finally(function() {
                btn.disabled = false;
                btn.style.opacity = '';
            });
    };
}

(function() {
    function init_<?= $sliderId ?>() {
        if (typeof Swiper === 'undefined') { setTimeout(init_<?= $sliderId ?>, 100); return; }
        new Swiper('.<?= $sliderId ?>-swiper', {
            slidesPerView: 'auto',
            spaceBetween: 0,
            roundLengths: true,
            freeMode: true,
            freeModeMomentum: true,
            freeModeMomentumRatio: 0.25,
            freeModeMomentumVelocityRatio: 0.5,
            freeModeMomentumBounce: false,
            freeModeMinimumVelocity: 0.02,
            grabCursor: true,
            touchReleaseOnEdges: true,
            scrollbar: {
                el: '#<?= $sliderId ?> .swiper-scrollbar',
                draggable: true,
                snapOnRelease: true,
            },
            // Handle trackpad two-finger horizontal swipe as wheel events.
            // forceToAxis: horizontal scroll → slider only; vertical → page scroll.
            // thresholdDelta: absorbs micro-jitter at the start of a gesture.
            // releaseOnEdges: hands back to page scroll at slider boundaries.
            mousewheel: {
                forceToAxis: true,
                releaseOnEdges: true,
                sensitivity: 1,
                thresholdDelta: 5,
            },
            keyboard: { enabled: true },
        });
    }
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init_<?= $sliderId ?>);
    } else {
        init_<?= $sliderId ?>();
    }
})();

window.__ahySliderCfg = window.__ahySliderCfg || {};
window.__ahySliderCfg['<?= $sliderId ?>'] = <?= json_encode(array_values($cfgProducts), JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;

