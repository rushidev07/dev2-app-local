<script>
function ahyConfigModal() {
    return {
        open: false,
        product: {},
        selected: null,
        adding: false,
        error: '',
        activeImage: '',
        galleryImages: [],

        get displayPrice() {
            const src = this.selected || this.product;
            return src.special_price && src.special_price < src.price ? src.special_price : src.price;
        },
        get displayOriginal() {
            const src = this.selected || this.product;
            return src.special_price && src.special_price < src.price ? src.price : null;
        },
        init() {
            if (!window._ahyCfgModalInited) window.addEventListener('ahy-open-config-modal', e => {
                console.log('[MODAL OPEN]', e.detail.sku, e.detail.product_sku, Object.keys(e.detail)); this.product = e.detail;
                this.error       = '';
                this.activeImage = e.detail.image || '';
                document.body.style.overflow = 'hidden';

                const inStock = (e.detail.variants || []).filter(v => v.in_stock);
                if (inStock.length > 0) {
                    const lowest = inStock.reduce((a, b) =>
                        (a.special_price || a.price || Infinity) <= (b.special_price || b.price || Infinity) ? a : b
                    );
                    this.selected = lowest;
                    if (lowest.image) this.activeImage = lowest.image;
                } else {
                    this.selected = null;
                }

                this.galleryImages = [];
                if (e.detail.sku) {
                    fetch('/ahy_themecustomization/index/mediaGallery?sku=' + encodeURIComponent(e.detail.sku), {credentials: 'include'})
                        .then(r => r.json())
                        .then(imgs => { console.log('[GALLERY]', imgs); this.galleryImages = imgs; })
                        .catch(() => {});
                }
                this.open = true;
            });
        },

        close() {
            this.open            = false;
            this.selected        = null;
            this.error           = '';
            document.body.style.overflow = '';
        },

        selectVariant(v) {
            if (!v.in_stock) return;
            this.selected = v;
            this.error    = '';
            if (v.image) this.activeImage = v.image;
        },
        optionLabel(v) {
            var label = v.variant_title || v.name || '';
            if (label && this.product.name) {
                var prefix = this.product.name.toLowerCase();
                var lower  = label.toLowerCase();
                if (lower.startsWith(prefix)) {
                    label = label.slice(this.product.name.length).replace(/^[\s\-\/]+/, '').trim();
                }
            }
            return label || v.variant_sku || '';
        },

        async addToCart() {
            if (!this.selected) { this.error = 'Please select an option first.'; return; }
            this.adding = true;
            this.error  = '';
            try {
                const fd = new FormData();
                fd.append('product', this.selected.variant_id);
                fd.append('qty', 1);
                fd.append('form_key', hyva.getFormKey());

                const resp = await fetch('<?= $addToCartUrl ?>', { method: 'POST', body: fd });
                if (resp.ok || resp.redirected) {
                    window.dispatchEvent(new CustomEvent('reload-customer-section-data'));
                    this.close();
                } else {
                    this.error = 'Could not add to cart. Please try again.';
                }
            } catch(e) {
                this.error = 'Could not add to cart. Please try again.';
            }
            this.adding = false;
        },
    };
}

function ahyCategoryResults(productsApiUrl, searchToken, categoryName, platformStoreId) {
    return {
        productsApiUrl,
        searchToken,
        categoryName,
        platformStoreId,
        results: [],
        filters: [],
        apiFacets: [],
        activeFilters: [],
        priceRange: { min: null, max: null },
        activePriceMin: '',
        activePriceMax: '',
        activePriceRange: null,
        priceCollapsed: false,
        total: 0,
        page: 1,
        pageSize: 50,
        totalPages: 1,
        sort: 'relevance',
        loading: true,

        async _refreshToken() {
            const t = await window.ahyTokenRefresh?.get();
            if (t) this.searchToken = t;
            return !!t;
        },

        init() {
            window.addEventListener('ahy-token-refreshed', e => { this.searchToken = e.detail; });
            const params = new URLSearchParams(window.location.search);
            this.page = parseInt(params.get('p') || '1', 10);
            const sortParam = params.get('sort');
            if (sortParam) this.sort = sortParam;
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', () => this.fetch(), { once: true });
            } else {
                this.fetch();
            }
        },

        async fetch() {
            this.loading = true;
            try {
                const url = new URL(this.productsApiUrl);
                url.searchParams.set('search_token', this.searchToken);
                url.searchParams.set('category', this.categoryName);
                url.searchParams.set('page', this.page);
                if (this.platformStoreId) url.searchParams.set('platform_store_id', this.platformStoreId);

                this.activeFilters.forEach(f => {
                    if (f.key !== 'category') url.searchParams.append(f.key, f.value);
                });
                if (this.activePriceMin !== '') url.searchParams.set('price_min', this.activePriceMin);
                if (this.activePriceMax !== '') url.searchParams.set('price_max', this.activePriceMax);
                if (this.sort !== 'relevance') url.searchParams.set('sort', this.sort);

                let resp = await fetch(url.toString());
                if (resp.status === 401) {
                    await this._refreshToken();
                    url.searchParams.set('search_token', this.searchToken);
                    resp = await fetch(url.toString());
                }
                const data = await resp.json();

                if (data.success) {
                    this.results    = data.data || [];
                    this.total      = (data.pagination && data.pagination.total) || 0;
                    this.pageSize   = (data.pagination && data.pagination.per_page) || 50;
                    this.totalPages = Math.max(1, Math.ceil(this.total / this.pageSize));
                    this.apiFacets  = data.facets || [];
                    if (this.filters.length === 0) this.buildFilters();
                } else {
                    console.error('[SmartSearch] Category API error:', data);
                }
            } catch(e) {
                console.error('[SmartSearch] Category fetch error', e);
            }
            this.loading = false;
        },

        buildFilters() {
            if (this.apiFacets.length === 0) return;
            const priceFacet = this.apiFacets.find(f => f.key === 'price');
            if (priceFacet) {
                this.priceRange = { min: priceFacet.min ?? null, max: priceFacet.max ?? null };
            }
            this.filters = this.apiFacets
                .filter(f => f.key !== 'price' && f.key !== 'category')
                .map(f => ({
                    key:       f.key,
                    label:     f.key === 'brand' ? 'Shop By Brand' : f.label,
                    collapsed: false,
                    showAll:   false,
                    options:   (f.options || []).map(o => ({ value: o.value, count: o.count })),
                }));
        },

        sortedResults() {
            let res = this.results;
            if (this.activePriceMin !== '' || this.activePriceMax !== '') {
                const lo = this.activePriceMin !== '' ? parseFloat(this.activePriceMin) : 0;
                const hi = this.activePriceMax !== '' ? parseFloat(this.activePriceMax) : Infinity;
                res = res.filter(p => {
                    const price = parseFloat(
                        (p.special_price && parseFloat(p.special_price) < parseFloat(p.price))
                            ? p.special_price : (p.price || 0)
                    );
                    return price >= lo && (hi === Infinity || price <= hi);
                });
            }
            if (this.sort === 'relevance') return res;
            return [...res].sort((a, b) => {
                const getPrice = p => {
                    const base = parseFloat(p.price) || 0;
                    const sp   = parseFloat(p.special_price) || 0;
                    return (sp > 0 && sp < base) ? sp : base;
                };
                const diff = getPrice(a) - getPrice(b);
                return this.sort === 'price_asc' ? diff : -diff;
            });
        },

        toggleFilter(key, label, value) {
            const idx = this.activeFilters.findIndex(f => f.key === key && f.value === value);
            if (idx >= 0) this.activeFilters.splice(idx, 1);
            else this.activeFilters.push({ key, label, value });
            this.page = 1;
            this.fetch();
        },

        removeFilter(key, value) {
            this.activeFilters = this.activeFilters.filter(f => !(f.key === key && f.value === value));
            this.page = 1;
            this.fetch();
        },

        applyPriceFilter() { this.page = 1; this.fetch(); },
        clearPriceFilter() { this.activePriceMin = ''; this.activePriceMax = ''; this.activePriceRange = null; this.page = 1; this.fetch(); },
        clearAllFilters() { this.activeFilters = []; this.activePriceMin = ''; this.activePriceMax = ''; this.activePriceRange = null; this.page = 1; this.fetch(); },
        priceRangeBuckets() {
            if (this.priceRange.min === null) return [];
            const all = [
                { label: 'Under $50',     min: '',   max: 50   },
                { label: '$50 – $100',    min: 50,   max: 100  },
                { label: '$100 – $250',   min: 100,  max: 250  },
                { label: '$250 – $500',   min: 250,  max: 500  },
                { label: '$500 – $1,000', min: 500,  max: 1000 },
                { label: 'Over $1,000',   min: 1000, max: ''   },
            ];
            return all.filter(b => {
                const lo = b.min === '' ? 0 : b.min;
                const hi = b.max === '' ? Infinity : b.max;
                return lo < this.priceRange.max && hi > this.priceRange.min;
            });
        },
        togglePriceRange(bucket) {
            if (this.activePriceRange && this.activePriceRange.label === bucket.label) {
                this.activePriceRange = null;
                this.activePriceMin = '';
                this.activePriceMax = '';
            } else {
                this.activePriceRange = bucket;
                this.activePriceMin = bucket.min === '' ? '' : String(bucket.min);
                this.activePriceMax = bucket.max === '' ? '' : String(bucket.max);
            }
            this.applyPriceFilter();
        },
        isFilterActive(key, value) { return this.activeFilters.some(f => f.key === key && f.value === value); },

        goToPage(p) { this.page = p; this.fetch(); window.scrollTo({ top: 0, behavior: 'smooth' }); },
        setSort(val) { this.sort = val; this.page = 1; this.fetch(); },
        sortLabel() {
            return { relevance: 'Relevance', price_asc: 'Price: Low to high', price_desc: 'Price: High to low' }[this.sort] || 'Relevance';
        },

        FALLBACK_IMG: 'https://static.everest.com/media/.thumbswysiwyg/everest-logo_2_.png',
        isFallbackImg(image) {
            return this.imgUrl(image) === this.FALLBACK_IMG;
        },
        imgUrl(image) {
            if (!image || image.includes('no_selection')) return this.FALLBACK_IMG;
            if (image.includes('falcosense/800x800')) return image;
            let path = image;
            if (image.startsWith('http')) {
                const m = image.match(/\/catalog\/product\/(.+)$/);
                if (!m) return this.FALLBACK_IMG;
                path = m[1];
            } else {
                path = path.replace(/^\/+/, '');
            }
            if (!path) return this.FALLBACK_IMG;
            const filename = path.split('/').pop();
            if (!filename) return this.FALLBACK_IMG;
            const c1 = filename[0], c2 = filename[1] || c1;
            return '/media/falcosense/800x800/' + c1 + '/' + c2 + '/' + filename;
        },
        handleImgError(event) {
            const el = event.target;
            if (el.dataset.imgFailed) return;
            el.dataset.imgFailed = '1';
            el.src = this.FALLBACK_IMG;
            el.style.opacity = '0.45';
        },

        async addSimpleToCart(product) {
            try {
                const fd = new FormData();
                fd.append('product', product.product_id);
                fd.append('qty', 1);
                fd.append('form_key', hyva.getFormKey());

                const resp = await fetch('<?= $addToCartUrl ?>', { method: 'POST', body: fd });
                if (resp.ok || resp.redirected) {
                    window.dispatchEvent(new CustomEvent('reload-customer-section-data'));
                    typeof window.dispatchMessages !== 'undefined' && window.dispatchMessages([{type: 'success', text: 'Product added to cart.'}], 3000);
                }
            } catch(e) {
                console.error('[SmartSearch] Add to cart failed', e);
            }
        },
    };
}

// Hyva bundles Alpine as type="module" without exposing window.Alpine.
// Capture Alpine during alpine:init (the only moment it's reachable from inline scripts),
// then use it to manually process our element if Alpine skipped it.
document.addEventListener('alpine:init', function() {
    if (typeof Alpine !== 'undefined') {
        window._ssAlpine = Alpine;
    }
});
document.addEventListener('alpine:initialized', function() {
    var el = document.querySelector('[x-data^="ahyCategoryResults"]');
    if (!el || !el.hasAttribute('x-cloak')) return;
    if (el._x_dataStack) { el.removeAttribute('x-cloak'); }
    else if (window._ssAlpine) { window._ssAlpine.initTree(el); }
});
</script>

