<script>
if (typeof ahySliderATC === 'undefined') {
    window.ahySliderATC = function(btn) {
        var productId = btn.dataset.productId;
        var url = btn.dataset.atcUrl;
        var fd = new FormData();
        fd.append('product', productId);
        fd.append('qty', 1);
        fd.append('form_key', hyva.getFormKey());
        btn.disabled = true;
        btn.style.opacity = '0.6';
        fetch(url, { method: 'POST', body: fd, credentials: 'same-origin' })
            .then(function(r) {
                if (r.ok || r.redirected) {
                    window.dispatchEvent(new CustomEvent('reload-customer-section-data'));
                    window.dispatchEvent(new CustomEvent('toggle-cart'));
                    typeof window.dispatchMessages !== 'undefined' && window.dispatchMessages([{type: 'success', text: 'Product added to cart.'}], 3000);
                }
            })
            .catch(function() {})
            .finally(function() {
                btn.disabled = false;
                btn.style.opacity = '';
            });
    };
}

if (typeof ahySliderOpenOptions === 'undefined') {
    window.ahySliderOpenOptions = function(btn) {
        var product;
        try {
            product = JSON.parse(btn.dataset.product);
        } catch (e) {
            return;
        }
        window.dispatchEvent(new CustomEvent('ahy-cfg-modal-open', { detail: product, bubbles: true }));
    };
}

(function() {
    function init_<?= $sliderId ?>() {
        if (typeof Swiper === 'undefined') { setTimeout(init_<?= $sliderId ?>, 100); return; }
        new Swiper('.<?= $sliderId ?>-swiper', {
            slidesPerView: 'auto',
            spaceBetween: 0,
            freeMode: true,
            grabCursor: true,
            scrollbar: {
                el: '#<?= $sliderId ?> .swiper-scrollbar',
                draggable: true,
                snapOnRelease: false,
            },
            mousewheel: false,
            keyboard: { enabled: true },
        });
    }
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init_<?= $sliderId ?>);
    } else {
        init_<?= $sliderId ?>();
    }
})();
</script>
