$falcosenseImgUrl = static function (string $image): string {
    if ($image === '') return '';
    if (str_contains($image, 'falcosense/800x800')) return $image;
    $path = $image;
    if (str_starts_with($image, 'http')) {
        $path = preg_match('/\/catalog\/product\/(.+)$/', $image, $m) ? $m[1] : basename($image);
    }
    $filename = basename($path);
    if ($filename === '') return '';
    $c1 = $filename[0];
    $c2 = $filename[1] ?? $c1;
    return '/media/falcosense/800x800/' . $c1 . '/' . $c2 . '/' . $filename;
};
