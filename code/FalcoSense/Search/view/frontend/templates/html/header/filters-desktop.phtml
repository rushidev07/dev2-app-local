<?php
/**
 * Desktop sidebar filter list for html/header/search-form.phtml's #ahyModal
 * search results. No PHP variables needed — all data comes from the parent
 * ahyModalSearch() Alpine scope.
 */
?>
                <!-- Price -->
                <template x-if="priceRange.min !== null">
                    <div class="fs-filter-group">
                        <button class="fs-filter-group__toggle" @click="priceCollapsed = !priceCollapsed">
                            <span class="fs-filter-group__label">Price</span>
                            <svg class="fs-filter-group__chevron" :class="priceCollapsed ? 'is-collapsed' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                            </svg>
                        </button>
                        <ul x-show="!priceCollapsed" class="fs-filter-list">
                            <template x-for="bucket in priceRangeBuckets()" :key="bucket.label">
                                <li>
                                    <label class="fs-filter-option" @click.prevent="togglePriceRange(bucket)">
                                        <span class="fs-checkbox"
                                              :class="activePriceRange && activePriceRange.label === bucket.label ? 'is-checked' : ''">
                                            <svg x-show="activePriceRange && activePriceRange.label === bucket.label" class="fs-checkbox__tick" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                                            </svg>
                                        </span>
                                        <span class="fs-filter-option__label" x-text="bucket.label"></span>
                                    </label>
                                </li>
                            </template>
                        </ul>
                    </div>
                </template>

                <!-- Categorical filters -->
                <template x-for="filter in filters" :key="filter.key">
                    <div class="fs-filter-group">
                        <button class="fs-filter-group__toggle" @click="filter.collapsed = !filter.collapsed">
                            <span class="fs-filter-group__label" x-text="filter.label"></span>
                            <svg class="fs-filter-group__chevron" :class="filter.collapsed ? 'is-collapsed' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                            </svg>
                        </button>
                        <ul x-show="!filter.collapsed" class="fs-filter-list">
                            <template x-for="option in (filter.showAll ? filter.options : filter.options.slice(0,5))" :key="option.value">
                                <li>
                                    <label class="fs-filter-option" @click.prevent="toggleFilter(filter.key, filter.label, option.value)">
                                        <span class="fs-checkbox"
                                              :class="isFilterActive(filter.key, option.value) ? 'is-checked' : ''">
                                            <svg x-show="isFilterActive(filter.key, option.value)" class="fs-checkbox__tick fs-checkbox__tick--sm" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                            </svg>
                                        </span>
                                        <span class="fs-filter-option__label" x-text="option.value"></span>
                                        <span class="fs-filter-option__count" x-text="'(' + option.count + ')'"></span>
                                    </label>
                                </li>
                            </template>
                            <li x-show="filter.options.length > 5">
                                <button class="fs-filter-more" @click="filter.showAll = !filter.showAll">
                                    <span x-show="!filter.showAll">See More +</span>
                                    <span x-show="filter.showAll">See Less –</span>
                                </button>
                            </li>
                        </ul>
                    </div>
                </template>
