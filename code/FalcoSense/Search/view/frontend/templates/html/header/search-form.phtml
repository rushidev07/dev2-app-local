<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Magento\Search\Helper\Data as SearchHelper;
use FalcoSense\Search\Helper\Data as SmartSearchHelper;
use FalcoSense\Search\Service\SearchTokenService;


/** @var Escaper $escaper */
/** @var Template $block */
/** @var SearchHelper $helper */

$helper            = $this->helper(SearchHelper::class);
$smartSearchHelper = $this->helper(SmartSearchHelper::class);

$tokenService    = \Magento\Framework\App\ObjectManager::getInstance()->get(SearchTokenService::class);
$platformStoreId = (int) $smartSearchHelper->getPlatformStoreId();
$searchToken     = $tokenService->getToken($platformStoreId);

$endpoint = $smartSearchHelper->getEndpointUrl() ?: 'http://localhost:8080';
$parsed   = parse_url($endpoint);
$apiBase  = ($parsed['scheme'] ?? 'http') . '://' . ($parsed['host'] ?? 'localhost');
if (!empty($parsed['port'])) { $apiBase .= ':' . $parsed['port']; }
$productsApiUrl  = $apiBase . '/api/v1/products';
$addToCartUrl    = $block->getUrl('checkout/cart/add');
$tokenRefreshUrl = $block->escapeUrl($block->getUrl('smartsearch/search/token'));
$fsSearchUrl     = $block->escapeUrl($block->getUrl('fs/search'));
?>


<?php /*
    HEADER SEARCH INPUT — rendered once per placement.

    A responsive theme mounts this more than once. Everest's header.phtml calls
    it three times (mobile, and two desktop header variants), showing one at a
    time with CSS. That is correct for an input.

    It is NOT correct for the overlay, which is why the overlay now lives in
    html/header/search-overlay.phtml, mounted once in before.body.end. When both
    were in this file, three copies of id="ahyModal" went into the DOM, and a
    duplicate id makes every getElementById a coin flip.
*/ ?>
<!-- ── Search form ───────────────────────────────────────── -->
<script>
'use strict';
window._ahyOriginalUrl = window._ahyOriginalUrl || window.location.href;
window._ahySearchPushCount = window._ahySearchPushCount || 0;

function ahySetSearchUrl(url) {
    window._ahySearchPushCount++;
    history.pushState(history.state, '', url);
}

if (!window._ahyPopstateReloadBound) {
    window._ahyPopstateReloadBound = true;
    window.addEventListener('popstate', () => {
        if (window._ahySuppressPopstateReload) { window._ahySuppressPopstateReload = false; return; }
        window.location.reload();
    });
}

function initMiniSearch() {
    return {
        minSearchLength: <?= (int) $helper->getMinQueryLength() ?>,
        _searchResultBaseUrl: <?= json_encode($fsSearchUrl) ?>,
        _queryParamName: <?= json_encode($helper->getQueryParamName()) ?>,
        suggest() {
            const term = this.$refs.searchInput.value.trim();
            if (term.length < this.minSearchLength) {
                window.dispatchEvent(new CustomEvent('ahy-modal-close'));
                return;
            }
            this.$refs.searchInput.setCustomValidity('');
            window.dispatchEvent(new CustomEvent('ahy-modal-search', { detail: { query: term } }));
            const url = new URL(this._searchResultBaseUrl, window.location.origin);
            url.searchParams.set(this._queryParamName, term);
            ahySetSearchUrl(url.toString());
        },
        async onFocus() {
            if (this.$refs.searchInput.value.trim().length >= this.minSearchLength) {
                window.dispatchEvent(new CustomEvent('ahy-modal-open'));
            }
        },
        search(term) {
            const input = this.$refs.searchInput;
            term = term || input.value;
            if (term.length < this.minSearchLength) {
                input.setCustomValidity('<?= $escaper->escapeJs(__('Minimum Search query length is %1', $helper->getMinQueryLength())) ?>');
                input.reportValidity();
                return;
            }
            input.setCustomValidity('');
            input.value = term;
            this.$refs.form.submit();
        },
    }
}
</script>

<div class="fs-root fs-minisearch" x-data="initMiniSearch()">
    <form class="fs-minisearch__form" id="search_mini_form" x-ref="form" @submit.prevent="search()"
          action="<?= $fsSearchUrl ?>" method="get">

        <label class="fs-visually-hidden" for="search" data-role="minisearch-label">
            <span><?= $escaper->escapeHtml(__('Search')) ?></span>
        </label>

        <div class="fs-minisearch__field" data-ahy-file="2-FalcoSense_Search-html-header-search-form">
            <input id="search"
                x-ref="searchInput"
                type="text"
                autocomplete="off"
                name="<?= $escaper->escapeHtmlAttr($helper->getQueryParamName()) ?>"
                value="<?= /** @noEscape */ $helper->getEscapedQueryText() ?>"
                placeholder="<?= $escaper->escapeHtmlAttr(__('Search for products')) ?>"
                maxlength="<?= $escaper->escapeHtmlAttr($helper->getMaxQueryLength()) ?>"
                class="fs-minisearch__input"
                @focus="onFocus()"
                @input.debounce.300="suggest()"
                @keydown.escape="window.dispatchEvent(new CustomEvent('ahy-modal-close'))"
                @keydown.enter.prevent
            />
        </div>

    </form>
</div>
