<style>
/*
 * Only rules that CANNOT live in web/css/fs-components.css remain here.
 *
 * Everything that styles FalcoSense's own markup has moved to the module
 * stylesheet under the .fs-root namespace — the carousel (.pop-*), the mobile
 * card, the loader and the results row all went with it. What is left is the
 * page-takeover mechanism, which by definition has to reach outside .fs-root:
 * it hides the HOST page while the modal is open.
 *
 * That host coupling is deliberate and is the one thing this module still
 * asserts about the page it is installed in. It is scoped to body.ahy-search-open
 * so it only applies while the modal is actually open.
 */

/* Modal shell. #ahyModal also carries .fs-root; these ID-specificity rules sit
   above the reset, which is why display/background still apply to it. */
#ahyModal { display:none; width:100%; min-height:90vh; background:#efeadd; }
#ahyModal.is-open { display:block; }

/*
 * Keep the overlay the same width as the rest of the page.
 *
 * The theme calls getChildHtml('header-search') THREE times (header.phtml lines
 * 181, 209, 275 — mobile, desktop, and the sticky desktop variant), so this
 * template renders three times. Two land inside their .fs-modal-shell wrapper
 * and inherit its container width. The third ends up reparented directly under
 * .page-wrapper with no wrapper around it, so it rendered edge-to-edge while
 * the header and the /fs/search route page stayed centred — the width mismatch
 * that made the overlay look broken at >=1536px.
 *
 * Putting the container on #ahyModal itself makes it correct wherever it lands.
 * The child rule below then removes it again for the two that ARE wrapped, so
 * they are not padded twice. `.fs-modal-shell > #ahyModal` is (1,1,0) and beats
 * the plain `#ahyModal` (1,0,0), so nesting always wins.
 *
 * Values match .columns / .fs-modal-shell in web/css/fs-components.css.
 */
#ahyModal {
    margin-left: auto;
    margin-right: auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
}
@media (min-width: 640px)  { #ahyModal { max-width: 640px; } }
@media (min-width: 768px)  { #ahyModal { max-width: 768px; } }
@media (min-width: 1024px) { #ahyModal { max-width: 1024px; } }
@media (min-width: 1280px) { #ahyModal { max-width: 1280px; } }
@media (min-width: 1536px) { #ahyModal { max-width: 1536px; } }

.fs-modal-shell > #ahyModal {
    max-width: none;
    margin-left: 0;
    margin-right: 0;
    padding-left: 0;
    padding-right: 0;
}

/* Page takeover — hides the host page behind the modal. */
body.ahy-search-open .page-main,
body.ahy-search-open main,
body.ahy-search-open #maincontent { display:none !important; }
body.ahy-search-open .top-container { display:none !important; }
body.ahy-search-open { background:#efeadd !important; }

/* config-modal.phtml's fixed overlay. Its own .ahy-thumb-strip rules moved into
   fs-components.css as .fs-cfg__thumbs when that template was converted. */
.ahy-cfg-overlay { position:fixed; inset:0; z-index:999997; }
</style>