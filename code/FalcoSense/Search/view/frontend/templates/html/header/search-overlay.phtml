<?php /*
    SEARCH OVERLAY — mounted ONCE per page, in before.body.end.

    Split out of html/header/search-form.phtml. That template is rendered once
    per responsive placement, so the overlay was being emitted as many times as
    the theme mounted the input — three times on Everest, each carrying
    id="ahyModal". Only the first instance ever initialised (ahyModalSearch
    guards on window._ahyModalInited), leaving two inert duplicates competing
    for the same id.

    ahyTokenRefresh travels with this file rather than the input, because it is
    a page-level singleton shared with search/autocomplete.phtml and the three
    PLP components, and it only needs to exist once. before.body.end renders
    after the header, so the input's markup is already in place by the time this
    runs.
*/ ?>

<script>
window.ahyTokenRefresh = window.ahyTokenRefresh || (function () {
    const tokenUrl = <?= json_encode($tokenRefreshUrl) ?>;
    let cached = null;
    let inflight = null;

    async function fetchLive(force) {
        try {
            const url = force ? (tokenUrl + (tokenUrl.includes('?') ? '&' : '?') + 'force=1') : tokenUrl;
            const resp = await fetch(url, { credentials: 'include', cache: 'no-store' });
            const data = await resp.json();
            return data && data.success ? data.token : null;
        } catch (e) {
            console.error('[ahyTokenRefresh] fetch error', e);
            return null;
        }
    }

    return {
        async get() {
            if (cached) return cached;
            if (!inflight) {
                inflight = fetchLive(false).then(t => { cached = t; inflight = null; return t; });
            }
            return inflight;
        },
        async refresh() {
            cached = null;
            const t = await fetchLive(true);
            cached = t;
            if (t) window.dispatchEvent(new CustomEvent('ahy-token-refreshed', { detail: t }));
            return t;
        },
    };
})();

/*
 * ahyModalSearch() now lives in web/js/plp/modal-search.js.
 *
 * It was 391 lines inline here, which meant replacing this template's markup
 * also meant losing the overlay's behaviour. Registered in
 * view/frontend/layout/default.xml; the file guards against overwriting a
 * host-supplied component of the same name.
 *
 * It is still a fork of the engine in search-results.js — see that file's header
 * for what remains to be merged.
 */
</script>

<!--
    fs-modal-shell replaces a bare class="columns" here.

    That class was borrowed from the theme to get its centered container
    (max-width ladder + 1.5rem gutters). It also matched the theme's PAGE GRID
    rule, which is a descendant selector:
        .page-layout-2columns-left .columns { grid-template-columns: repeat(N, ...) }
    Any .columns under <body> matches it — including this one, sitting in the
    header and nowhere near the page layout. So whenever the host page's grid
    said 4 columns, this wrapper became a 4-column grid and the search overlay
    was squeezed into a quarter of the width. Forcing the host grid to 1 column
    fixed the overlay but collapsed the sidebar on every other page.

    The container styling is now replicated under our own namespaced class in
    fs-components.css, so the host's page-layout rules cannot reach it and we no
