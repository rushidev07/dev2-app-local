<script>
'use strict';
// Captured once, before any live-search typing changes the address bar, so the
// URL can be restored when the search modal closes.
window._ahyOriginalUrl = window._ahyOriginalUrl || window.location.href;

// Every debounced search (see the 1000ms debounce on the input below) gets
// its own real history entry via pushState, never replaceState — so pressing
// Back steps through each previous search one at a time, landing back on
// each in turn, all the way out to the page the visitor actually arrived on
// (replaceState would instead overwrite that arrival entry in place, leaving
// nothing for Back to land on but whatever was before this site entirely).
// We track how many we've pushed so closeModal() can pop all of them at once
// with a single history.go() instead of one at a time.
window._ahySearchPushCount = window._ahySearchPushCount || 0;

function ahySetSearchUrl(url) {
    window._ahySearchPushCount++;
    history.pushState(history.state, '', url);
}

// history.replaceState()/pushState() (used above/below to keep the URL in
// sync while typing) don't leave behind a DOM snapshot matching the pre-search
// page. So when the user hits Back/Forward, the browser's bfcache can try to
// restore the DOM as it last looked (mid-search, with the modal's own
// styling/state applied) instead of re-rendering fresh, producing a broken
// layout. Forcing a real reload on back/forward guarantees a clean, correctly
// styled page every time. This is suppressed for the one history.back() call
// closeModal() makes on its own (see below) since that's just collapsing the
// overlay, not a real user Back-button press, and reloading there would be a
// jarring, unnecessary flash for something that should feel instant.
if (!window._ahyPopstateReloadBound) {
    window._ahyPopstateReloadBound = true;
    window.addEventListener('popstate', () => {
        if (window._ahySuppressPopstateReload) { window._ahySuppressPopstateReload = false; return; }
        window.location.reload();
    });
}

function initMiniSearch() {
    return {
        minSearchLength: <?= (int) $helper->getMinQueryLength() ?>,
        _searchResultBaseUrl: <?= json_encode($fsSearchUrl) ?>,
        _queryParamName: <?= json_encode($helper->getQueryParamName()) ?>,
        suggest() {
            const term = this.$refs.searchInput.value.trim();
            if (term.length < this.minSearchLength) {
                window.dispatchEvent(new CustomEvent('ahy-modal-close'));
                return;
            }
            this.$refs.searchInput.setCustomValidity('');
            window.dispatchEvent(new CustomEvent('ahy-modal-search', { detail: { query: term } }));

            // Reflect the live query in the address bar (no page reload, no new
            // history entry per keystroke) so the URL always matches what the
            // AJAX search modal is currently showing.
            const url = new URL(this._searchResultBaseUrl, window.location.origin);
            url.searchParams.set(this._queryParamName, term);
            ahySetSearchUrl(url.toString());
        },
        async onFocus() {
            if (this.$refs.searchInput.value.trim().length >= this.minSearchLength) {
                window.dispatchEvent(new CustomEvent('ahy-modal-open'));
            }
        },
        search(term) {
            const input = this.$refs.searchInput;
            term = term || input.value;
            if (term.length < this.minSearchLength) {
                input.setCustomValidity('<?= $escaper->escapeJs(__('Minimum Search query length is %1', $helper->getMinQueryLength())) ?>');
                input.reportValidity();
                return;
            }
            input.setCustomValidity('');
            input.value = term;
            this.$refs.form.submit();
        },
    }
}
</script>

