<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <!--
                cacheable="false" makes Magento mark this entire page response
                as not cacheable (sets Cache-Control: no-cache/no-store on the
                response), so Varnish/the built-in FPC never stores it. This
                page is fully dynamic (live product results, live search
                token) — earlier work made it *safe* to cache by fetching the
                token live client-side, but this opts it out of caching
                entirely rather than relying on that.
            -->
            <block class="FalcoSense\Search\Block\Search"
                   name="ahy_smartsearch_search"
                   template="FalcoSense_Search::search/results.phtml"
                   cacheable="false"
                   before="-">
                <block class="FalcoSense\Search\Block\Search"
                       name="ahy_smartsearch_search_zero_results"
                       as="zero_results"
                       template="FalcoSense_Search::search/zero-results.phtml"
                       cacheable="false"/>
                <block class="Magento\Framework\View\Element\Template"
                       name="ahy_smartsearch_search_card_desktop"
                       as="product_card_desktop"
                       template="FalcoSense_Search::search/product-card-desktop.phtml"
                       cacheable="false"/>
                <block class="Magento\Framework\View\Element\Template"
                       name="ahy_smartsearch_search_card_mobile"
                       as="product_card_mobile"
                       template="FalcoSense_Search::search/product-card-mobile.phtml"
                       cacheable="false"/>
                <block class="Magento\Framework\View\Element\Template"
                       name="ahy_smartsearch_search_filters_desktop"
                       as="filters_desktop"
                       template="FalcoSense_Search::search/filters-desktop.phtml"
                       cacheable="false"/>
                <block class="Magento\Framework\View\Element\Template"
                       name="ahy_smartsearch_search_filters_mobile"
                       as="filters_mobile"
                       template="FalcoSense_Search::search/filters-mobile.phtml"
                       cacheable="false"/>
            </block>
        </referenceContainer>

        <!--
            Mirrors the theme's own Magento_CatalogSearch::layout/catalogsearch_result_index.xml
            cleanup exactly, so this route renders identically to the existing search
            results page instead of falling back to the default 2-column layout (which
            left the "Recently Ordered" reorder sidebar widget floating with no content
            beside it once the layered-nav/search-result blocks were removed).
        -->
        <referenceBlock name="search.result"          remove="true"/>
        <referenceBlock name="klevu_content_top"       remove="true"/>
        <referenceBlock name="catalogsearch.leftnav"   remove="true"/>
        <referenceBlock name="catalog.compare.sidebar" remove="true"/>
        <referenceContainer name="sidebar.main"       remove="true"/>
        <!-- Webkul MpAssignProduct injects a full product ListProduct block — remove it -->
        <referenceBlock name="mpassign.list"           remove="true"/>
        <!-- Remove search result list blocks added by Hyva/core that may still load collections -->
        <referenceBlock name="search_result_list"      remove="true"/>
        <referenceBlock name="search.search_terms_log" remove="true"/>
    </body>
</page>
