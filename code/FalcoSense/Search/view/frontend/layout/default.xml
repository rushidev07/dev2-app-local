<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <!--
            The module's own stylesheets. Until now FalcoSense shipped no CSS at
            all and relied on the host theme having compiled our templates'
            Tailwind classes into ITS stylesheet — true on Everest (Hyvä scans
            app/code/**/*.phtml), false on every other store, where the UI
            rendered unstyled.

            Load order matters and is the order below:
              fs-tokens      custom properties; the supported override surface
              fs-base        the .fs-root isolation layer; must precede components
              fs-components  the component rules themselves

            All three are scoped to .fs-root, so nothing here can affect the host
            store's own markup. Shadow-DOM surfaces additionally <link> these
            inside their shadow root, since light-DOM styles cannot cross that
            boundary.
        -->
        <css src="FalcoSense_Search::css/fs-tokens.css"/>
        <css src="FalcoSense_Search::css/fs-base.css"/>
        <css src="FalcoSense_Search::css/fs-components.css"/>

        <!--
            PLP components. Extracted out of search/results.phtml and
            category/results.phtml so a storefront can supply its own markup
            without having to copy our search logic (which is what Everest's
            Ahy_PlpRevamp module had to do). See web/js/plp/search-results.js.

            runtime.js declares window.FalcoSense and must load first; both
            component files only read from it.
        -->
        <script src="FalcoSense_Search::js/plp/runtime.js" defer="true"/>

        <!--
            The listing engine: the fetch/filter/sort/paginate behaviour the
            three surfaces share. Declared before them because each one calls
            FalcoSense.listingCore() at construction. All four are defer, which
            preserves declaration order.
        -->
        <script src="FalcoSense_Search::js/plp/listing-engine.js" defer="true"/>
        <script src="FalcoSense_Search::js/plp/search-results.js" defer="true"/>
        <script src="FalcoSense_Search::js/plp/category-results.js" defer="true"/>
        <script src="FalcoSense_Search::js/plp/modal-search.js" defer="true"/>
    </head>
    <body>
        <!--
            Header search mounts live in their own layout handles now:
                falcosense_header_hyva.xml   overrides "header-search"
                falcosense_header_luma.xml   removes "top.search", mounts into "header.container"

            Observer\AddLayoutHandles adds whichever one matches the store's
            configured Header Search Mount. Declaring both here and trying to
            suppress the wrong one at render time did not work: the Luma mount
            renders before the theme's header tree exists, so nothing could tell
            which family was in play, and both rendered.
        -->

        <referenceContainer name="before.body.end">
            <!--
                Loads Alpine only if the host theme hasn't already (see the
                template for the detection). Placed first in this container so
                its DOMContentLoaded listener is registered before anything
                below can depend on Alpine being available.
            -->
            <block class="Magento\Framework\View\Element\Template"
                   name="falcosense_alpine_bootstrap"
                   template="FalcoSense_Search::alpine-bootstrap.phtml"/>

            <block class="FalcoSense\Search\Block\ProductCard"
                   name="ahy_global_style_vars"
                   template="FalcoSense_Search::global-style-vars.phtml"/>

            <!--
                Per-store values for the PLP components (seller names, fallback
                image, CDN origin). Renders in the body, so it runs BEFORE the
                deferred scripts in <head> and they pick it up. The values come
                from Stores > Configuration > FalcoSense > PLP, so a storefront
                configures it rather than overriding the template.
            -->
            <block class="FalcoSense\Search\Block\Plp\Config"
                   name="falcosense_plp_config"
                   template="FalcoSense_Search::plp-config.phtml"/>

            <!--
                Search overlay. Declared here, once, rather than inside the
                header-search block: a responsive theme mounts the search INPUT
                several times (Everest's header.phtml calls it three times, one
                per breakpoint), and while three inputs are correct, three
                overlays are not — they shared id="ahyModal", which makes every
                getElementById on it a coin flip.

                The filter, card and zero-result blocks are children of this
                block because search-overlay.phtml is what renders them.
            -->
            <block class="Magento\Framework\View\Element\Template"
                   name="falcosense_search_overlay"
                   template="FalcoSense_Search::html/header/search-overlay.phtml">
            <block class="Magento\Framework\View\Element\Template"
                   name="header_filters_desktop"
                   template="FalcoSense_Search::html/header/filters-desktop.phtml"/>
            <block class="Magento\Framework\View\Element\Template"
                   name="header_filters_mobile"
                   template="FalcoSense_Search::html/header/filters-mobile.phtml"/>
            <block class="Magento\Framework\View\Element\Template"
                   name="header_zero_results"
                   template="FalcoSense_Search::html/header/zero-results.phtml"/>
            <block class="FalcoSense\Search\Block\ProductCard"
                   name="header_product_card_desktop"
                   template="FalcoSense_Search::html/header/product-card-desktop.phtml"/>
            <block class="FalcoSense\Search\Block\ProductCard"
                   name="header_product_card_mobile"
                   template="FalcoSense_Search::html/header/product-card-mobile.phtml"/>
            </block>

            <block class="Magento\Framework\View\Element\Template"
                   name="ahy_smartsearch_visitor_cookie"
                   template="FalcoSense_Search::visitor_cookie.phtml"
            />
            <block class="FalcoSense\Search\Block\GeoConsent"
                   name="ahy_geo_consent"
                   template="FalcoSense_Search::geo-consent.phtml"
                    ifconfig="smart_search/general/enabled"/>

            <!--
                Configurable-product options modal, used site-wide (category, search,
                sliders, header quick-search). Detaches itself and re-appends to <body>
                on init (see config-modal.phtml), so declaring it once here — rather
                than per-page — covers every page, including category and search.
            -->
            <block class="Magento\Framework\View\Element\Template"
                   name="ahy_smartsearch_config_modal"
                   template="FalcoSense_Search::modal/config-modal.phtml"/>
        </referenceContainer>
    </body>
</page>