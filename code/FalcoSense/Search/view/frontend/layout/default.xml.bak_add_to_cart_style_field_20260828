<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!--
            Override Hyvä's own header-search block (Magento_Theme::html/header/search-form.phtml)
            with our own copy of that same template, which adds live token refresh
            (so it survives full-page caching) and the /fs/search URL sync. This
            previously pointed at FalcoSense_Search::search/search-form.phtml, a file
            that was never created, so the override silently never applied and the
            theme's original template kept rendering instead.
        -->
        <referenceBlock name="header-search"
                        class="FalcoSense\Search\Block\HeaderSearchForm"
                        template="FalcoSense_Search::html/header/search-form.phtml">
            <block class="Magento\Framework\View\Element\Template"
                   name="header_filters_desktop"
                   template="FalcoSense_Search::html/header/filters-desktop.phtml"/>
            <block class="Magento\Framework\View\Element\Template"
                   name="header_filters_mobile"
                   template="FalcoSense_Search::html/header/filters-mobile.phtml"/>
            <block class="Magento\Framework\View\Element\Template"
                   name="header_zero_results"
                   template="FalcoSense_Search::html/header/zero-results.phtml"/>
            <block class="Magento\Framework\View\Element\Template"
                   name="header_product_card_desktop"
                   template="FalcoSense_Search::html/header/product-card-desktop.phtml"/>
            <block class="Magento\Framework\View\Element\Template"
                   name="header_product_card_mobile"
                   template="FalcoSense_Search::html/header/product-card-mobile.phtml"/>
        </referenceBlock>

        <referenceContainer name="before.body.end">
            <block class="Magento\Framework\View\Element\Template"
                   name="ahy_smartsearch_visitor_cookie"
                   template="FalcoSense_Search::visitor_cookie.phtml"
            />
            <block class="FalcoSense\Search\Block\GeoConsent"
                   name="ahy_geo_consent"
                   template="FalcoSense_Search::geo-consent.phtml"
                    ifconfig="smart_search/general/enabled"/>

            <!--
                Configurable-product options modal, used site-wide (category, search,
                sliders, header quick-search). Detaches itself and re-appends to <body>
                on init (see config-modal.phtml), so declaring it once here — rather
                than per-page — covers every page, including category and search.
            -->
            <block class="Magento\Framework\View\Element\Template"
                   name="ahy_smartsearch_config_modal"
                   template="FalcoSense_Search::modal/config-modal.phtml"/>
        </referenceContainer>
    </body>
</page>