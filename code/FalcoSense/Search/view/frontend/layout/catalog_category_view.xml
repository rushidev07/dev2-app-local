<?xml version="1.0"?>
<!--
    layout="1column" — the native way to say "this page has no sidebar".

    This page removes Magento's layered-navigation sidebar (see
    sidebar.main below) because FalcoSense renders its own filter column
    inside the main content area. But removing the sidebar's CONTENTS does
    not change the page's LAYOUT: <body> kept page-layout-2columns-left and
    the theme's .columns grid went on reserving a column for a sidebar that
    was no longer there.

    The listing then had to fight that empty column from CSS:

        .catalog-category-view.page-layout-2columns-left .columns {
            grid-template-columns: repeat(1, minmax(0, 1fr));
        }

    which only works on a theme that lays out .columns as a CSS grid with
    those exact body classes — i.e. Magento's own layouts and anything built
    on them. Declaring the layout instead gets the same result from the
    framework, on any theme, with no CSS.

    fs_search_index.xml has always done this; the category page had not.

    NOTE: this forces one column on EVERY category page. A storefront that
    wants to keep its own sidebar alongside our listing would need this to
    become configurable.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <!--
                cacheable="false" on every block below — SSR now renders real,
                per-request content here (varies by page/sort, and by which
                category), so leaving this page eligible for Full Page Cache
                would serve whichever response happened to be cached first for
                a given URL to every subsequent visitor, regardless of the
                current category/page/sort. Same fix already applied to the
                search routes for the same reason.
            -->
            <block class="FalcoSense\Search\Block\Category"
                   name="ahy_smartsearch_category"
                   template="FalcoSense_Search::category/results.phtml"
                   cacheable="false"
                   before="-">
                <block class="Magento\Framework\View\Element\Template"
                       name="ahy_smartsearch_category_zero_results"
                       as="zero_results"
                       template="FalcoSense_Search::category/zero-results.phtml"
                       cacheable="false"/>
                <block class="FalcoSense\Search\Block\ProductCard"
                       name="ahy_smartsearch_category_card_desktop"
                       as="product_card_desktop"
                       template="FalcoSense_Search::category/product-card-desktop.phtml"
                       cacheable="false"/>
                <block class="FalcoSense\Search\Block\ProductCard"
                       name="ahy_smartsearch_category_card_mobile"
                       as="product_card_mobile"
                       template="FalcoSense_Search::category/product-card-mobile.phtml"
                       cacheable="false"/>
                <block class="Magento\Framework\View\Element\Template"
                       name="ahy_smartsearch_category_filters_desktop"
                       as="filters_desktop"
                       template="FalcoSense_Search::category/filters-desktop.phtml"
                       cacheable="false"/>
                <block class="Magento\Framework\View\Element\Template"
                       name="ahy_smartsearch_category_filters_mobile"
                       as="filters_mobile"
                       template="FalcoSense_Search::category/filters-mobile.phtml"
                       cacheable="false"/>
            </block>
        </referenceContainer>

        <!-- Remove the default Magento product list so our block is the only one -->
        <referenceBlock name="category.products" remove="true"/>
        <referenceBlock name="search.result" remove="true"/>

        <!-- Remove the layered navigation sidebar -->
        <referenceContainer name="sidebar.main" remove="true"/>
    
        <!--
            Listing structured data (ItemList + Product/Offer).

            Mounted directly in "content" rather than as a child of the grid
            block: a host module may remove our grid (Ahy_PlpRevamp does), and
            structured data should not disappear with someone else's layout
            choice. Renders nothing on non-canonical views — see
            Block/Plp/StructuredData.
        -->
        <referenceContainer name="content">
            <block class="FalcoSense\Search\Block\Plp\StructuredData"
                   name="falcosense_plp_structured_data"
                   template="FalcoSense_Search::plp/structured-data.phtml"/>
        </referenceContainer>
</body>
</page>
