<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <!--
                cacheable="false" on every block below — without it, this page
                (server-rendered per-query SSR content, added after this file
                was first written) can be served from Magento's Full Page
                Cache: whichever response happened to be cached first for a
                given query (potentially from before SSR existed, or from a
                moment the platform was briefly slow) gets served to every
                subsequent visitor searching that same term, indefinitely,
                regardless of how correct the current render logic is. The
                header search form submits here (native /catalogsearch/result/,
                intercepted by this module's route), so this is the actual
                page most searches land on — fs_search_index.xml (direct
                /fs/search/?q= navigation) already had this exact fix; this
                brings the two routes to parity.
            -->
            <block class="FalcoSense\Search\Block\Search"
                   name="ahy_smartsearch_search"
                   template="FalcoSense_Search::search/results.phtml"
                   cacheable="false"
                   before="-">
                <block class="FalcoSense\Search\Block\Search"
                       name="ahy_smartsearch_search_zero_results"
                       as="zero_results"
                       template="FalcoSense_Search::search/zero-results.phtml"
                       cacheable="false"/>
                <block class="FalcoSense\Search\Block\ProductCard"
                       name="ahy_smartsearch_search_card_desktop"
                       as="product_card_desktop"
                       template="FalcoSense_Search::search/product-card-desktop.phtml"
                       cacheable="false"/>
                <block class="FalcoSense\Search\Block\ProductCard"
                       name="ahy_smartsearch_search_card_mobile"
                       as="product_card_mobile"
                       template="FalcoSense_Search::search/product-card-mobile.phtml"
                       cacheable="false"/>
                <block class="Magento\Framework\View\Element\Template"
                       name="ahy_smartsearch_search_filters_desktop"
                       as="filters_desktop"
                       template="FalcoSense_Search::search/filters-desktop.phtml"
                       cacheable="false"/>
                <block class="Magento\Framework\View\Element\Template"
                       name="ahy_smartsearch_search_filters_mobile"
                       as="filters_mobile"
                       template="FalcoSense_Search::search/filters-mobile.phtml"
                       cacheable="false"/>
            </block>
        </referenceContainer>

        <!-- Remove the default Magento search result block -->
        <referenceBlock name="search.result" remove="true"/>

        <!--
            Remove Magento_LayeredNavigation's search sidebar block. It is declared
            independently of search.result (in sidebar.main, by a different module's
            own catalogsearch_result_index.xml), so removing search.result above does
            NOT stop it: Magento\LayeredNavigation\Block\Navigation\Search builds its
            facet/filter counts from the configured search engine (Elasticsearch/
            OpenSearch) eagerly during layout generation, on every request, regardless
            of which controller ran or whether it's ever echoed. This page's filtering
            is driven by the FalcoSense platform API, not this block, so it must be
            removed too or every request still queries the search engine for facets.
        -->
        <referenceBlock name="catalogsearch.leftnav" remove="true"/>
    
        <!--
            Listing structured data (ItemList + Product/Offer).

            Mounted directly in "content" rather than as a child of the grid
            block: a host module may remove our grid (Ahy_PlpRevamp does), and
            structured data should not disappear with someone else's layout
            choice. Renders nothing on non-canonical views — see
            Block/Plp/StructuredData.
        -->
        <referenceContainer name="content">
            <block class="FalcoSense\Search\Block\Plp\StructuredData"
                   name="falcosense_plp_structured_data"
                   template="FalcoSense_Search::plp/structured-data.phtml"/>
        </referenceContainer>
</body>
</page>
