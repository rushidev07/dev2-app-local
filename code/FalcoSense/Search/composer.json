{
    "name": "falcosense/module-search",
    "description": "FalcoSense Search — AI-powered search, autocomplete and product listing for Magento 2. Ships its own styles and scripts so it runs on any theme.",
    "type": "magento2-module",
    "license": "proprietary",
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0",
        "magento/framework": "*",

        "magento/module-catalog": "*",
        "magento/module-catalog-inventory": "*",
        "magento/module-configurable-product": "*",
        "magento/module-store": "*",
        "magento/module-customer": "*",
        "magento/module-checkout": "*",
        "magento/module-quote": "*",
        "magento/module-directory": "*",
        "magento/module-url-rewrite": "*",
        "magento/module-backend": "*",
        "magento/module-config": "*",
        "magento/module-search": "*",

        "magento/module-catalog-search": "*",
        "magento/module-sales": "*",
        "magento/module-page-cache": "*"
    },
    "suggest": {
        "magento/module-wishlist": "Enables the wishlist button on product cards"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "FalcoSense\\Search\\": ""
        }
    }
}
