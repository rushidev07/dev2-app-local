<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <type name="Ahy\MissingImage\Logger\Handler">
        <arguments>
            <argument name="filesystem" xsi:type="object">Magento\Framework\Filesystem\Driver\File</argument>
        </arguments>
    </type>

    <type name="Ahy\MissingImage\Logger\Logger">
        <arguments>
            <argument name="name" xsi:type="string">ActiveSellerMissingImage</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">Ahy\MissingImage\Logger\Handler</item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="ahyCheckMissingSellerImages" xsi:type="object">Ahy\MissingImage\Console\CheckMissingSellerImages</item>
            </argument>
        </arguments>
    </type>

</config>
