        <template x-for="item in items" :key="item.id">
            <div
                class="snap-start shrink-0 rounded-lg overflow-hidden relative flex flex-col bg-white"
                :style="'width:210px;border:1px solid oklch(90% .005 80);transition:box-shadow 0.15s cubic-bezier(.4,0,.2,1);' + (hoveredId === item.id ? 'box-shadow:0 4px 20px 0 rgba(0,0,0,0.10);' : '')"
