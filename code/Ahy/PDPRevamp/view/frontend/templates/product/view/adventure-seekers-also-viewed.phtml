</div>
<script>
    function ahyAdventureSeekersCarousel(items) {
        return {
            items: items,
            ratings: {},
            addingIds: {},
            wished: {},
            wishingIds: {},
            hoveredId: null,
            hasOverflow: false,
            atStart: true,
            atEnd: false,
            init() {
                this.fetchRatings();
                this.$nextTick(() => {
                    this.checkOverflow();
                    this.updateScrollButtons();
                });
            },
            checkOverflow() {
                const scroller = this.$refs.scroller;
                this.hasOverflow = scroller.scrollWidth > scroller.clientWidth + 1;
            },
            updateScrollButtons() {
                const scroller = this.$refs.scroller;
                this.atStart = scroller.scrollLeft <= 1;
                // Same wider tolerance as customers-also-bought.phtml: exact
                // 1px equality left this stuck false due to subpixel
                // scrollWidth rounding from responsive card images.
                this.atEnd = scroller.scrollLeft + scroller.clientWidth >= scroller.scrollWidth - 8;
            },
            // Opens FalcoSense's own configurable-options quickview (config-modal.phtml,
            // wired globally via FalcoSense_Search's default.xml) instead of a Klevu-backed
            // one - its addToCart() doesn't depend on klevu_addtocart() at all, and it
            // opens the real minicart itself on success. The stub shape it expects
            // (product_id/brand/price/special_price/type) differs from this carousel's
            // own item shape (id/sellerName/regularPrice/finalPrice/isConfigurable), so
            // it's mapped here rather than passing item through unchanged.
            openOptionsModal(item) {
                window.dispatchEvent(new CustomEvent('ahy-cfg-modal-open', {
                    detail: {
                        product_id: item.id,
                        sku: item.sku,
                        name: item.name,
                        image: item.image,
                        brand: item.sellerName,
                        price: item.regularPrice,
                        special_price: item.hasDiscount ? item.finalPrice : undefined,
                        type: 'configurable',
                    },
                    bubbles: true
                }));
            },
            fetchRatings() {
                this.items.forEach((item) => {
                    fetch(BASE_URL + 'ahyyotpo/index/bulkratings?product_id=' + item.id)
                        .then((r) => r.json())
                        .then((rating) => {
                            if (rating && rating.total_reviews > 0) {
                                this.ratings = {
                                    ...this.ratings,
                                    [item.id]: {
                                        score: rating.average_score,
                                        count: rating.total_reviews,
                                    }
                                };
                            }
                        })
                        .catch((error) => console.error(error));
                });
            },
            toggleWish(id) {
                if (this.wished[id] || this.wishingIds[id]) {
                    return;
                }
                this.wishingIds[id] = true;
                // Fill immediately on click so the UI reacts instantly, regardless
                // of network/response timing; reverted below if the add fails.
                this.wished = { ...this.wished, [id]: true };
                const postData = 'product=' + id
                    + '&uenc=' + hyva.getUenc()
                    + '&form_key=' + hyva.getFormKey()
                    + '&qty=1';
                fetch(BASE_URL + 'wishlist/index/add/', {
                    headers: {
                        'content-type': 'application/x-www-form-urlencoded; charset=UTF-8',
                    },
                    body: postData,
                    method: 'POST',
                    mode: 'cors',
                    credentials: 'include',
                }).then((response) => {
                    if (response.redirected) {
                        window.location.href = response.url;
                    } else if (response.ok) {
                        return response.json();
                    } else {
                        typeof window.dispatchMessages !== 'undefined' && window.dispatchMessages(
                            [{ type: 'warning', text: '<?= $escaper->escapeJs(__('Could not add item to wishlist.')) ?>' }], 5000
                        );
                    }
                }).then((response) => {
                    this.wishingIds[id] = false;
                    if (!response) {
                        const reverted = { ...this.wished };
                        delete reverted[id];
                        this.wished = reverted;
                        return;
                    }
                    if (!response.success) {
                        const reverted = { ...this.wished };
                        delete reverted[id];
                        this.wished = reverted;
                    }
                    typeof window.dispatchMessages !== 'undefined' && window.dispatchMessages(
                        [{
                            type: response.success ? 'success' : 'error',
                            text: response.success
                                ? '<?= $escaper->escapeJs(__('%1 has been added to your Wish List.', __('Product'))) ?>'
                                : response.error_message,
                        }], 5000
                    );
                    window.dispatchEvent(new CustomEvent('reload-customer-section-data'));
                    if (response.success) {
                        setTimeout(() => { window.location.href = BASE_URL + 'wishlist/'; }, 600);
                    }
                }).catch((error) => {
                    this.wishingIds[id] = false;
                    const reverted = { ...this.wished };
                    delete reverted[id];
                    this.wished = reverted;
                    typeof window.dispatchMessages !== 'undefined' && window.dispatchMessages(
                        [{ type: 'error', text: error }], 5000
                    );
                });
            },
            scrollByCards(direction) {
                const scroller = this.$refs.scroller;
                const card = scroller.querySelector(':scope > div');
                const gap = window.innerWidth >= 640 ? 20 : 16;
                const cardWidth = card ? card.getBoundingClientRect().width + gap : 230;
                scroller.scrollBy({ left: direction * cardWidth, behavior: 'smooth' });
            },
            quickAdd(item) {
                if (this.addingIds[item.id]) return;
                this.addingIds[item.id] = true;
                try {
                    const body = new URLSearchParams();
                    body.set('product', item.id);
                    body.set('qty', '1');
                    body.set('form_key', hyva.getFormKey());
                    fetch(item.addToCartUrl, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                            'X-Requested-With': 'XMLHttpRequest',
                        },
                        body: body.toString(),
                        credentials: 'same-origin',
                    })
                    .then(() => {
                        this.addingIds[item.id] = false;
                        window.dispatchEvent(new CustomEvent('reload-customer-section-data'));
                        window.dispatchEvent(new CustomEvent('toggle-cart'));
                        typeof window.dispatchMessages !== 'undefined' && window.dispatchMessages(
                            [{ type: 'success', text: '<?= $escaper->escapeJs(__('Item added to your cart.')) ?>' }], 5000
                        );
                    })
                    .catch(() => {
                        this.addingIds[item.id] = false;
                        typeof window.dispatchMessages !== 'undefined' && window.dispatchMessages(
                            [{ type: 'error', text: '<?= $escaper->escapeJs(__('Something went wrong adding this item to your cart.')) ?>' }], 5000
                        );
                    });
                } catch (e) {
                    this.addingIds[item.id] = false;
                }
            },
        };
    }
</script>
<style>
    /* Plain CSS instead of Tailwind's "disabled:" variants - those aren't
       used anywhere else in this theme, so they aren't in the already-
       compiled styles.css and would need a Tailwind rebuild to appear.
       This works without one. */
    .ahy-carousel-nav-btn:disabled {
        opacity: 0.3;
        border-color: transparent;
        cursor: not-allowed;
    }
    .ahy-carousel-nav-btn:disabled:hover {
        background-color: transparent;
    }
    .ahy-asav-wish-btn {
        background-color: rgba(255, 255, 255, 0.8);
    }
    @media (max-width: 425px) {
        .adventure-seekers-also-viewed {
            padding-left: 1rem;
            padding-right: 1rem;
        }
    }
    .ahy-asav-track { scrollbar-width: none; -ms-overflow-style: none; }
    .ahy-asav-track::-webkit-scrollbar { display: none; }
    .ahy-asav-rating-row { min-height: 14px; }
    /* The Tailwind `truncate` utility is not in the compiled Hyvä CSS (this
       module's templates are outside the theme's content scan), so the seller
       line gets its ellipsis written out here. */
    .ahy-asav-brand {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    /* The three-line clamp lives on the element itself; -webkit-box sizes
       itself to the full text and leans on overflow:hidden for the cut, so
       line-height is pinned and max-height capped at exactly three lines -
       otherwise the clip lands mid-glyph and the top of a fourth line shows
       under the ellipsis. em units keep this correct across the
       text-xs/sm:text-sm step. */
    .ahy-asav-name {
        line-height: 1.25;
        min-height: 3.75em;
        max-height: 3.75em;
    }
</style>