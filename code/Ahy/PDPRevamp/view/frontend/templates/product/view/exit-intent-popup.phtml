<script>
    function pdprevampExitIntentPopup(config) {
        return {
            open: false,
            armed: true,
            dismissed: false,
            email: '',
            errorMsg: '',
            submitting: false,
            submitted: false,
            couponCode: '',
            copied: false,
            timerSeconds: config.timerSeconds,
            subscribeUrl: config.subscribeUrl,
            productId: config.productId || 0,
            expiry: 0,
            formattedTime: '00:00:00',
            interval: null,
            init() {
                const storageKey = 'ahyExitPopupExpiry';
                const dismissKey = 'ahyExitPopupDismissed';
                let expiry = parseInt(localStorage.getItem(storageKey), 10);
                if (!expiry || isNaN(expiry) || expiry <= Date.now()) {
                    expiry = Date.now() + (this.timerSeconds * 1000);
                    localStorage.setItem(storageKey, String(expiry));
                }
                this.expiry = expiry;

                // A dismissal used to live only in memory, so browsing several
                // PDPs re-showed the popup on each one. Persisted alongside the
                // expiry so "no thanks" is respected for the rest of the window.
                if (localStorage.getItem(dismissKey) === '1') {
                    this.dismissed = true;
                }

                this.tick();
                this.interval = setInterval(() => this.tick(), 1000);

                // Desktop: cursor leaves through the top of the viewport.
                document.addEventListener('mouseout', (event) => this.handleMouseOut(event));

                // Touch devices have no cursor, so the mouseout trigger above can
                // never fire there - the popup previously never appeared on phones
                // or tablets at all. A fast upward scroll reads as intent to
                // leave; a dwell timer covers the case where they simply stop.
                this.initMobileTriggers();
            },
            handleMouseOut(event) {
                if (!this.canShow()) {
                    return;
                }
                if (event.clientY <= 0 && event.relatedTarget === null) {
                    this.show();
                }
            },
            initMobileTriggers() {
                if (!window.matchMedia('(hover: none), (pointer: coarse)').matches) {
                    return;
                }

                let lastY = window.scrollY;
                let lastT = Date.now();

                window.addEventListener('scroll', () => {
                    if (!this.canShow()) {
                        return;
                    }

                    const y = window.scrollY;
                    const now = Date.now();
                    const dt = now - lastT;

                    if (dt > 0) {
                        // px per ms; negative delta = scrolling up.
                        const velocity = (lastY - y) / dt;
                        // Only well past the top, so an initial bounce does not
                        // count, and only on a decisive flick upward.
                        if (velocity > 1.2 && y > 400) {
                            this.show();
                        }
                    }

                    lastY = y;
                    lastT = now;
                }, { passive: true });

                // Fallback for a reader who stops rather than scrolls away.
                setTimeout(() => {
                    if (this.canShow() && window.scrollY > 200) {
                        this.show();
                    }
                }, 45000);
            },
            canShow() {
                return this.armed && !this.open && !this.dismissed && !this.submitted;
            },
            show() {
                this.open = true;
                this.armed = false;
            },
            close() {
                this.open = false;
                this.dismissed = true;
                try {
                    localStorage.setItem('ahyExitPopupDismissed', '1');
                } catch (e) {
                    // Private mode or blocked storage - dismissal just falls back
                    // to being per-page-load, which is the old behaviour.
                }
            },
            copyCode() {
                if (!this.couponCode || !navigator.clipboard) {
                    return;
                }
                navigator.clipboard.writeText(this.couponCode).then(() => {
                    this.copied = true;
                    setTimeout(() => { this.copied = false; }, 2000);
                });
            },
            tick() {
                const remaining = Math.max(0, Math.floor((this.expiry - Date.now()) / 1000));
                const hours = Math.floor(remaining / 3600);
                const minutes = Math.floor((remaining % 3600) / 60);
                const seconds = remaining % 60;
                this.formattedTime = [hours, minutes, seconds].map((n) => String(n).padStart(2, '0')).join(':');
                if (remaining <= 0 && this.interval) {
                    clearInterval(this.interval);
                }
            },
            submit() {
                if (!this.email || this.submitting) {
                    return;
                }
                this.submitting = true;
                this.errorMsg = '';
                fetch(this.subscribeUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: this.email, product_id: this.productId })
                })
                    .then((response) => response.json())
                    .then((data) => {
                        this.submitting = false;
                        if (data.success) {
                            // The code comes back from the server; nothing is
                            // guessed client-side.
                            this.couponCode = data.coupon_code || '';
                            this.submitted = true;
                        } else {
                            this.errorMsg = data.message || '<?= $escaper->escapeJs(__('Something went wrong. Please try again.')) ?>';
                        }
                    })
                    .catch(() => {
                        this.submitting = false;
                        this.errorMsg = '<?= $escaper->escapeJs(__('Something went wrong. Please try again.')) ?>';
                    });
            }
        };
    }
</script>
