        <script>
            function productStickyCart(stickyPrice) {
                return {
                    showStickyButton: false,
                    stickyQty: 1,
                    stickyPrice: stickyPrice || '',
                    productName: `<?= $productName ?>`,
                    productMainImage: '',
                    addToCartButtonDisabled: true,
                    stickyLoading: false,
                    init() {
                        this.productMainImage = "/media/catalog/product/<?= $escaper->escapeUrl($productMainImage) ?>";
                        if (this.productMainImage.includes("//")) {
                            this.productMainImage = this.productMainImage.replace(/\/{2,}/g, '/');
                        }
                        this.showStickyCart();
                        window.addEventListener('product-addtocart-success', () => { this.stickyLoading = false; });
                        window.addEventListener('product-addtocart-error', () => { this.stickyLoading = false; });
                    },
                    showStickyCart() {
                        let addToCartButton = document.querySelector('#addToCartActions');
                        let addToCartButtonEl = document.querySelector('#addToCartActions #product-addtocart-button');
                        if (addToCartButton) {
                            let elementRect = addToCartButton.getBoundingClientRect();
                            this.showStickyButton = elementRect.top < -70;
                            if (addToCartButtonEl) {
                                this.addToCartButtonDisabled = addToCartButtonEl.disabled;
                            }
                        }
                    },
                    submitStickyCart() {
                        this.stickyLoading = true;
                        const qtyInput = document.querySelector('#addToCartActions input[name="qty"]');
                        if (qtyInput) {
                            qtyInput.value = this.stickyQty;
                            qtyInput.dispatchEvent(new Event('input', { bubbles: true }));
                            qtyInput.dispatchEvent(new Event('change', { bubbles: true }));
                        }
                        const atcBtn = document.querySelector('#addToCartActions #product-addtocart-button');
                        if (atcBtn) atcBtn.click();
                    },
                }
            }
        </script>
