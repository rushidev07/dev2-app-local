<style>
    /* Three across at every width, matching the reference design: the bundle
       reads as "A + B + C", and stacking the cards into one column below 640px
       broke that - it turned into a vertical list with "+" signs floating
       between rows, which no longer looks like a bundle at all. The cards just
       get narrower instead, which is what the reference does down to 375px. */
    .pdp-fbt-row {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.5rem;
    }
    /* A two-item bundle left two cards in slots 1 and 2 of a three-slot grid,
       so the empty third slot showed as dead space down the right-hand side.

       The columns are sized to the width a card would have had in the
       three-across layout - (100% - two gaps) / 3 - rather than letting two
       tracks split the row at 1fr each. Cards keep the proportions they have
       everywhere else on the page, and justify-content centres the pair, so
       the leftover width is split evenly instead of all landing on the right.

       Scoped above the single-column breakpoint: below 481px the row is one
       card wide and there is nothing to centre. The attribute selector also
       outranks the plain .pdp-fbt-row rule above, so source order is not in
       play - the same specificity precaution the rest of this file takes. */
    @media (min-width: 481px) {
        .pdp-fbt-row[data-count="2"] {
            grid-template-columns: repeat(2, minmax(0, calc((100% - 3rem) / 3)));
            justify-content: center;
        }
    }
    /* Plain CSS instead of Tailwind's bg-[#FAFAF8] arbitrary value - same
       reason as the rest of this file's custom classes. Rounded and padded as
       its own panel, matching the reference, rather than a full-bleed strip. */
    .pdp-fbt-summary {
        background-color: #FAFAF8;
        border-radius: 0.75rem;
        padding: 0.875rem 1rem;
    }
    /* Plain CSS rather than Tailwind's gap-x-3/gap-y-1: neither is used
       elsewhere in this theme, so they are absent from the compiled
       styles.css and would silently no-op without a Tailwind rebuild. */
    .pdp-fbt-summary-info {
        column-gap: 0.75rem;
        row-gap: 0.25rem;
    }
    /* The grid already equalises the three cards' heights (stretch is the
       default align-items), so the name/vendor/price block does not need a
       min-height of its own. The old 7rem/2rem floors were what opened the
       big empty gap between the vendor name and the price on short names -
       the reference sits those three lines directly under one another. */
    .pdp-fbt-item-detail {
        padding: 0;
        gap: 0.125rem;
        overflow: hidden;
        min-width: 0;

    }
    /* Names wrap to two lines rather than truncating mid-word, which is what
       the reference shows at narrow widths ("Kids Hydration Bladder 1.5L"). */
    /* line-clamp alone is not enough: -webkit-box sizes itself to the full text
       and relies on overflow:hidden to cut the rest, so with a fractional
       line-height the clip lands mid-glyph and the top of the third line stays
       visible under the ellipsis. Pinning line-height and capping max-height to
       exactly two lines makes the cut fall on a clean line boundary. */
    .pdp-fbt-item-name {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.25;
        max-height: 3.75em;
        /* Poppins' descenders sit about 1px below the line box at this size,
           and overflow: hidden clips at the padding box - so with line-height
           1.25 and no padding the tails of g/y/p on the LAST visible line were
           being shaved off, at every clamp count. Measured at 12px: ink ran
           1.0px past the clip edge; 0.2em of bottom padding puts it 1.4px
           inside. Padding rather than a taller line-height so the spacing
           between the lines themselves is untouched, and em rather than px so
           it tracks the font size. */
        padding-bottom: 0.2em;
    }
    /* Between the single-column breakpoint and 520px the card is at its
       narrowest while still three across, so a long name reaches a third line
       just as max-height runs out - the line was rendering clipped through the
       middle of its glyphs rather than being dropped cleanly.

       Two lines with an ellipsis instead. The clamp does the truncating: a
       -webkit-box that overflows adds the ellipsis itself, so no text-overflow
       declaration is needed, and max-height moves in step with the clamp
       (2 x 1.25 line-height) so there is no partial third line left to cut.

       Scoped through the root class to outrank the single-class rule above -
       the same specificity precaution used elsewhere in this file, so the
       result does not depend on which stylesheet lands last. */
    @media (min-width: 481px) and (max-width: 519px) {
        .pdp-frequently-bought-together .pdp-fbt-item-name {
            -webkit-line-clamp: 2;
            line-clamp: 2;
            max-height: 2.5em;
        }
    }
    /* Absolutely positioned at every width now that the cards are always three
       across - it floats in the gap between two cards, vertically centred on
       the image rather than the whole card, so it sits level with the products
       the way the reference shows it. */
    .pdp-fbt-plus {
        position: absolute;
        top: 50%;
        left: calc(100% + 0.35rem);
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 1.5rem;
        height: 1.5rem;
        border-radius: 9999px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
        font-size: 1.1rem;
        line-height: 1;
        font-weight: 400;
        color: #9ca3af;
        transform: translate(-50%, -50%);
    }
    /* A money figure must never break across lines. The parent <p> is
       flex-wrap so the two prices can stack, but without nowrap on the spans
       themselves the digits wrapped too - "$12345.00" came out as "$123 / 45. /
       00" once the card got narrow enough. */
    .pdp-fbt-item-price > span {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 100%;

    }

    /* Keeps the CTA from being squeezed narrow when the summary text
       (price/savings) runs long beside it. Only applied at breakpoints where
       the two actually sit side by side: md–lg (full-width FBT panel) and xl+
       (half-width panel has ~564px available, enough for both). Excluded at lg
       (1024–1279px) because the FBT sits in a half-width column (~436px) and
       the summary re-stacks to avoid overflow - a min-width there would widen
       the button beyond the panel. */
    @media (min-width: 768px) and (max-width: 1023px) {
        .pdp-fbt-cta {
            min-width: 200px;
        }
    }
    @media (min-width: 1280px) {
        .pdp-fbt-cta {
            min-width: 200px;
        }
    }
    /*
       Below 480px there is no room for three cards abreast.

       The arithmetic: a 341px viewport leaves ~269px inside this panel (341
       minus ~32 of page gutter minus the 40 of p-5). Take two 1.75rem gaps off
       that and each card gets ~71px, against the ~120px the content needs for a
       square image, a two-line name and a price with its struck-through
       original. Three-across stops fitting at roughly
       3x120 + 2x16 + 40 + 32 = 464px, which is why the switch happens here.
       Before this, names were cut to "Sur...", prices broke mid-number
       ("$123 / 45. / 00") and the "THIS ITEM" badge was wider than its own card.

       The cards keep their shape - image on top, text beneath - and simply go
       one per row at full width, with the "+" as a centred chip between them.
       A horizontal row card (small image left, text right) was tried first and
       rejected on review: at full width the tall card reads better and the
       badge, image and price all sit where they do at wider breakpoints, so
       nothing about the card has to be re-learned between sizes.
    */
    @media (max-width: 480px) {
        .pdp-fbt-row {
            grid-template-columns: minmax(0, 1fr);
            /* The "+" chip supplies the spacing between cards now. */
            gap: 0;
        }
        /*
           Scoped through the root class deliberately. These two declarations
           each contend with a single-class Tailwind utility on the same element
           (h-full, and border-t further down), and an unscoped .pdp-fbt-card
           rule ties with them on specificity - which leaves stylesheet order to
           decide, and that race was being lost in practice. Root + class wins
           outright, whatever order the sheets land in.
        */
        .pdp-frequently-bought-together .pdp-fbt-card {
            /* Explicit rather than inherited from the flex-col utility, so the
               card's direction is stated where the layout is decided. */
            flex-direction: column;
            /*
               h-full exists to equalise the three cards' heights across the
               grid. In a single column there is nothing to equalise against,
               and because the label's parent is only as tall as its own
               contents, height: 100% can push the label over the "+" chip
               sitting below it - which is what put the chip on the card border.
            */
            height: auto;
        }
        /* Card's own p-2 already provides the inset now - an added padding
           here would double it up against the image's edge. */
        .pdp-fbt-item-detail {
            padding: 0;
        }
        /* Full card width, so names can afford a third line before clamping. */
        .pdp-fbt-item-name {
            -webkit-line-clamp: 3;
            line-clamp: 3;
            max-height: 3.75em;
        }
        /*
           In-flow chip centred between two stacked cards. It was absolutely
           positioned into a grid gap with "left: calc(100% + 0.875rem)" - magic
           offsets that only held while the cards were three across, so in one
           column the chips landed off to the side of the card instead of
           between them.
        */
        .pdp-fbt-plus {
            position: static;
            transform: none;
            margin: 0.625rem auto;
            width: 1.75rem;
            height: 1.75rem;
            font-size: 1rem;
        }
        .pdp-fbt-summary {
            padding: 0.75rem;
        }
        /* This group is one nowrap unit wider than the panel at this width, so
           it overflowed off both edges instead of wrapping - that is the
           "cted ... Sc" clipping. */
        .pdp-fbt-summary-prices {
            flex-wrap: wrap;
            justify-content: center;
            white-space: normal;
        }
        .pdp-fbt-summary-info > * {
            max-width: 100%;
        }
        /*
           The CTA carries whitespace-nowrap so "Add Bundle to Cart" stays on one
           line beside the summary text at desktop widths. Stacked and narrow
           that guarantee turns into an overflow: at 320px the panel leaves about
           224px inside it (320 minus ~32 of gutter, 40 of p-5 and 24 of the
           summary's own padding), while the button needs roughly 225px for
           48px of px-6, the 18px icon, its gap and the label. So the label ran
           out past the panel edge.

           Allowed to wrap instead of shortening the label or inventing another
           breakpoint - it is self-adjusting, because the text only ever takes a
           second line on the widths that cannot fit one.

           Scoped through the root class: white-space here contends with the
           whitespace-nowrap utility on the same element, and an unscoped rule
           only ties with it on specificity.
        */
        .pdp-frequently-bought-together .pdp-fbt-cta-button {
            white-space: normal;
            text-align: center;
            /*
               px-6 is 48px of the ~224px available, which is what forced the
               label to break into three lines ("Add / Bundle to / Cart") once
               wrapping was allowed. Trimming it costs nothing visually: the
               button is w-full with justify-center, so the content stays centred
               wherever the padding sits - the padding only ever inflated the
               button's minimum width. With 24px instead of 48 the label fits on
               one line again, and wrapping stays enabled as the fallback for
               anything narrower.
            */
            padding-left: 0.75rem;
            padding-right: 0.75rem;
            /*
               The .btn class lands font-size: 1rem (three .btn rules exist in
               the compiled stylesheet; the last one wins), and font-bold takes
               it to 700 weight - about 160px for "Add Bundle to Cart". Against
               174px of text room that was close enough to break to a second
               line. 0.675rem is the usual mobile CTA size and brings the label
               to roughly 137px, which clears the 178px now available with real
               margin rather than by a pixel.

               Both declarations are needed: font-size contends with .btn, and
               leaving line-height at .btn's 1.5rem would keep the old vertical
               rhythm on smaller text.
            */
            font-size: 0.675rem; 
            line-height: 1.25rem;
            /* gap-2's 8px is generous once the type is smaller. */
            gap: 0.375rem;
        }
        /* The cart icon must not be squeezed when the label takes two lines. */
        .pdp-fbt-cta-button svg {
            flex-shrink: 0;
            /* Scaled with the label; the 18x18 attributes on the element are
               presentational and CSS overrides them. */
            width: 16px;
            height: 16px;
        }
        /* min-width: auto on a flex item refuses to go below its content width,
           which would re-introduce the overflow one level up. */
        .pdp-fbt-cta {
            min-width: 0;
        }
    }
    
</style>
<script>
    function ahyFrequentlyBoughtTogether(items, discountPercent) {
        return {
            items: items,
            discountPercent: discountPercent,
            checked: items.map(item => item.id),
            submitting: false,

            // The offer is the whole three-product bundle or nothing, so
            // unticking one takes the discount off the summary here exactly as
            // it takes it off the cart. Mirrors
            // Ahy\PDPRevamp\Plugin\SalesRule\Model\RulesApplier::MIN_BUNDLE_ITEMS
            // (private there, so duplicated here) - the two MUST agree, or this
            // panel advertises a saving the cart will not honour, which is the
            // one failure mode this whole widget cannot afford.
            minBundleItems: 3,

            // Modal: opened once per configurable suggestion in the bundle,
            // one after another (resolveConfigurableSelection() below), not
            // for the current product - its swatch is chosen on the main PDP
            // form before this button is even clickable.
            modalOpen: false,
            modalLoading: false,
            modalError: '',
            modalValidationError: '',
            modalProductId: null,
            modalProductName: '',
            modalQueueTotal: 0,
            modalQueueRemaining: 0,
            _modalResolve: null,

            /**
             * Any click inside the modal (swatch pick, price/gallery re-
             * render triggered by it) was jumping the whole PAGE back to the
             * top - the injected swatch markup (Magento_Swatches'
             * swatch-item.phtml) carries Alpine directives like changeOption()
             * and selectedValues() that only exist on the main PDP's own
             * x-data scope, not this modal's, so Alpine resolves them against
             * whatever ancestor scope it finds and the resulting reactive
             * update/error appears to reset scroll. Rather than depend on
             * pinning that exact mechanism, hold window scroll in place for a
             * beat after every click here - covers this cause and any other
             * that surfaces the same symptom, without touching swatch/price/
             * gallery rendering or the add-to-cart flow at all.
             */
            _lockPageScroll() {
                const y = window.scrollY;
                let ticks = 0;
                const restore = () => {
                    if (window.scrollY !== y) {
                        window.scrollTo(window.scrollX, y);
                    }
                    if (++ticks < 30) {
                        requestAnimationFrame(restore);
                    }
                };
                requestAnimationFrame(restore);
            },

            toggleItem(itemId) {
                const index = this.checked.indexOf(itemId);
                if (index === -1) {
                    this.checked.push(itemId);
                } else {
                    this.checked.splice(index, 1);
                }
            },

            listTotal() {
                return this.selectedItems()
                    .reduce((sum, item) => sum + item.regularPrice, 0);
            },
            /** Sum actually charged before the bundle percent. */
            payableSubtotal() {
                return this.selectedItems()
                    .reduce((sum, item) => sum + item.finalPrice, 0);
            },
            selectedItems() {
                return this.items.filter(item => this.checked.includes(item.id));
            },
            /**
             * Whether the current selection earns the bundle percent at all -
             * a product carrying a percent is not enough, the shopper has to
             * be taking the full bundle.
             */
            get bundleQualifies() {
                return this.discountPercent > 0 && this.checked.length >= this.minBundleItems;
            },
            get showBundleDiscount() {
                return this.bundleQualifies;
            },
            payableTotal() {
                return this.bundleQualifies
                    ? this.payableSubtotal() * (1 - this.discountPercent / 100)
                    : this.payableSubtotal();
            },
            savings() {
                return this.listTotal() - this.payableTotal();
            },
            get hasSavings() {
                return this.savings() > 0.005;
            },
            notify(type, text) {
                typeof window.dispatchMessages !== 'undefined' && window.dispatchMessages(
                    [{ type: type, text: text }], 5000
                );
            },
            async addBundleToCart() {
                if (this.submitting || this.checked.length === 0) {
                    return;
                }
                this.submitting = true;

                const bundleId = this.items[0].id;
                const bundleSize = this.checked.length;
                // Only a qualifying selection is tagged as a bundle: a smaller
                // selection is an ordinary add-to-cart, and tagging it would
                // leave lines carrying a bundle id that can never be
                // discounted.
                const isBundle = bundleSize >= this.minBundleItems;

                // Every configurable item in the bundle - the anchor (index 0,
                // "This Item") included - resolves its options through its own
                // modal here, same as a suggestion. Split up front: simple
                // items need no resolution, configurable ones (any position)
                // queue for the one-after-another modal below.
                const immediate = [];
                const modalQueue = [];
                for (const productId of this.checked) {
                    const item = this.items.find(candidate => candidate.id === productId);
                    if (!item) {
                        continue;
                    }
                    if (item.requiresOptions) {
                        modalQueue.push(item);
                    } else {
                        immediate.push(item);
                    }
                }

                // All-or-nothing: resolve every configurable's options FIRST,
                // via its modal, WITHOUT touching the cart yet. Only once
                // every one of them is confirmed do we post anything at all -
                // cancelling any modal must leave the cart exactly as it was,
                // not just stop the rest of the queue.
                const resolved = [];
                let cancelled = false;

                try {
                    this.modalQueueTotal = modalQueue.length;
                    for (let i = 0; i < modalQueue.length; i++) {
                        const item = modalQueue[i];
                        this.modalQueueRemaining = modalQueue.length - i;

                        const options = await this.resolveConfigurableSelection(item);
                        if (options === null) {
                            cancelled = true;
                            break;
                        }

                        resolved.push({ item, options });
                    }
                } finally {
                    this.modalOpen = false;
                    this.clearModalHtml();
                    this.modalQueueTotal = 0;
                    this.modalQueueRemaining = 0;
                }

                if (cancelled) {
                    this.submitting = false;
                    this.notify('warning', 'Bundle add cancelled - nothing was added to your cart.');
                    return;
                }

                let added = 0;
                let failed = 0;

                try {
                    for (const item of immediate) {
                        const ok = await this.postAddToCart(item, null, bundleId, bundleSize, isBundle);
                        ok ? added++ : failed++;
                    }
                    for (const { item, options } of resolved) {
                        const ok = await this.postAddToCart(item, options, bundleId, bundleSize, isBundle);
                        ok ? added++ : failed++;
                    }
                } finally {
                    this.submitting = false;
                }

                window.dispatchEvent(new CustomEvent('reload-customer-section-data'));

                if (added > 0) {
                    this.notify(
                        'success',
                        added === 1
                            ? '1 item was added to your cart.'
                            : added + ' items were added to your cart.'
                    );
                }

                if (failed > 0) {
                    this.notify(
                        failed === added + failed ? 'error' : 'warning',
                        failed === added + failed
                            ? 'Nothing could be added to your cart. Please try again.'
                            : 'Some items could not be added to your cart.'
                    );
                }
            },

            /**
             * POSTs one item to the cart. `overrideOptions` is the
             * [[name, value], ...] pairs resolved from that item's own modal -
             * every configurable item (anchor included) goes through one, so
             * this is always populated when item.requiresOptions is true.
             */
            async postAddToCart(item, overrideOptions, bundleId, bundleSize, isBundle) {
                const formKey = hyva.getFormKey();
                const uenc = hyva.getUenc();

                const body = new URLSearchParams();
                body.set('product', item.id);
                body.set('qty', '1');
                body.set('form_key', formKey);
                body.set('uenc', uenc);

                if (isBundle) {
                    body.set('ahy_fbt_bundle_id', bundleId);
                    body.set('ahy_fbt_bundle_size', bundleSize);
                }

                if (item.requiresOptions) {
                    if (!overrideOptions) {
                        this.notify('warning', 'Please choose the options for ' + item.name + ' first.');
                        return false;
                    }
                    overrideOptions.forEach(([name, value]) => body.set(name, value));
                }

                try {
                    const response = await fetch(BASE_URL + 'checkout/cart/add/', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                            'X-Requested-With': 'XMLHttpRequest',
                        },
                        body: body.toString(),
                        credentials: 'same-origin',
                    });
                    // A rejected add still 302s, so only a hard HTTP error is
                    // provably ours to report here; anything Magento refused
                    // comes back as a flash message.
                    return response.ok || response.redirected;
                } catch (error) {
                    console.error(error);
                    return false;
                }
            },

            /**
             * Opens the modal for one configurable suggestion and resolves
             * once the shopper confirms a full option set (resolves with the
             * [[name, value], ...] pairs) or cancels (resolves null).
             */
            resolveConfigurableSelection(item) {
                return new Promise((resolve) => {
                    this._modalResolve = resolve;
                    this.modalProductId = item.id;
                    this.modalProductName = item.name;
                    this.modalError = '';
                    this.modalValidationError = '';
                    this.modalLoading = true;
                    this.modalOpen = true;
                    this.fetchModalOptions(item.id);
                });
            },

            async fetchModalOptions(productId) {
                ['pdpFbtModalSwatchScript', 'pdpFbtModalPriceScript', 'pdpFbtModalGalleryScript'].forEach((sid) => {
                    const old = document.getElementById(sid);
                    if (old) {
                        old.remove();
                    }
                });

                try {
                    const response = await fetch(
                        BASE_URL + 'ahy_themecustomization/index/GetProductSwatchesDetails?product_id='
                            + productId + '&v=' + Date.now(),
                        {
                            headers: { 'X-Requested-With': 'XMLHttpRequest' },
                            credentials: 'same-origin',
                        }
                    );
                    const data = await response.json();
                    this.modalLoading = false;

                    if (!data.success) {
                        this.modalError = data.message
                            || '<?= $escaper->escapeJs(__('Unable to load options for this product.')) ?>';
                        return;
                    }

                    this.$nextTick(() => this.injectModalHtml(data));
                } catch (error) {
                    console.error(error);
                    this.modalLoading = false;
                    this.modalError = '<?= $escaper->escapeJs(__('Unable to load options for this product.')) ?>';
                }
            },

            /**
             * Same script-extraction/reinjection pattern as
             * window.fetchSwatchesPhpPlp in Ahy_PlpRevamp's product grid -
             * the controller strips <script> tags out of the rendered block
             * HTML so they survive an innerHTML assignment, and this
             * re-creates them as real <script> elements so they execute.
             */
            injectModalHtml(data) {
                const swatchEl = document.getElementById('pdp-fbt-modal-swatch-wrap');
                const priceEl = document.getElementById('pdp-fbt-modal-price');
                const galleryEl = document.getElementById('pdp-fbt-modal-gallery');
                if (!swatchEl) {
                    return;
                }

                [
                    ['pdpFbtModalSwatchScript', data.swatch_script],
                    ['pdpFbtModalPriceScript', data.product_price_script],
                    ['pdpFbtModalGalleryScript', data.product_swatch_gallery_script],
                ].forEach(([sid, content]) => {
                    if (!content) {
                        return;
                    }
                    const s = document.createElement('script');
                    s.type = 'text/javascript';
                    s.id = sid;
                    s.innerHTML = content;
                    document.body.appendChild(s);
                });

                // swatch-item.phtml keys its radio id / label "for" on the
                // product id alone ('attribute-option-<productId>-<optionId>').
                // For the anchor item that product is the one this very page is
                // already rendering, so the injected markup would carry ids
                // identical to the main PDP form's - and label[for] resolves to
                // the FIRST match in document order, which is always the PDP's
                // (this modal is teleported to the end of <body>). Every click
                // in here would toggle the PDP's hidden radio instead of the
                // modal's own, leaving this scope's selectedValues untouched:
                // no ring movement, no size/colour switching. Namespacing the
                // ids keeps both copies addressable independently. The pairs
                // stay consistent because :id and :for are rendered from the
                // same literal prefix.
                swatchEl.innerHTML = String(data.swatch_html)
                    .replace(/attribute-option-/g, 'attribute-option-fbtmodal-');
                if (priceEl) {
                    priceEl.innerHTML = data.product_price_html;
                }
                if (galleryEl) {
                    galleryEl.innerHTML = data.product_swatch_gallery_html;
                    // Same width-class strip as the PLP drawer: the gallery
                    // block's own responsive width (meant for a full PDP
                    // column) fights this modal's fixed 480px shell.
                    const gw = galleryEl.querySelector('div[class*="md:w-"]');
                    if (gw) {
                        gw.className = gw.className
                            .replace(/\bmd:w-\S+/g, '')
                            .replace(/\bmd:h-\S+/g, '')
                            .replace(/\bmd:p[lr]-\S+/g, '');
                    }
                    const mm = document.getElementById('meet-marcus');
                    if (mm) {
                        mm.remove();
                    }
                }
            },

            /**
             * Reads the chosen super_attribute values out of the modal's
             * injected swatch markup, scoped to the modal container so a
             * concurrent selection on the main PDP form (if the anchor is
             * also configurable) can never bleed into this item's options.
             */
            readModalOptions() {
                const container = document.getElementById('pdp-fbt-modal-swatch-wrap');
                if (!container) {
                    return null;
                }
                const fields = container.querySelectorAll('[name^="super_attribute"]');
                if (!fields.length) {
                    return null;
                }
                const picked = new Map();
                for (const field of fields) {
                    if ((field.type === 'radio' || field.type === 'checkbox') && !field.checked) {
                        continue;
                    }
                    if (!field.value) {
                        return null;
                    }
                    picked.set(field.name, field.value);
                }
                const attributeNames = new Set(Array.from(fields).map((field) => field.name));
                if (picked.size < attributeNames.size) {
                    return null;
                }
                return Array.from(picked.entries());
            },

            confirmModalSelection() {
                const options = this.readModalOptions();
                if (!options) {
                    this.modalValidationError =
                        '<?= $escaper->escapeJs(__('Please select all options before continuing.')) ?>';
                    return;
                }
                this.settleModal(options);
            },

            cancelModal() {
                this.settleModal(null);
            },

            settleModal(result) {
                this.modalOpen = false;
                this.clearModalHtml();
                const resolve = this._modalResolve;
                this._modalResolve = null;
                if (resolve) {
                    resolve(result);
                }
            },

            /**
             * Empties the injected blocks once the modal is done with them.
             * Hiding the modal only takes it off screen - the markup, and the
             * duplicate element ids that come with it, stay live in the DOM
             * and keep competing with the main PDP form for the rest of the
             * page's life (see injectModalHtml()). The scripts are re-created
             * on the next open anyway (fetchModalOptions() removes them first),
             * so nothing here needs to survive the close.
             */
            clearModalHtml() {
                ['pdp-fbt-modal-swatch-wrap', 'pdp-fbt-modal-price', 'pdp-fbt-modal-gallery']
                    .forEach((id) => {
                        const el = document.getElementById(id);
                        if (el) {
                            el.innerHTML = '';
                        }
                    });
            },
        };
    }
</script>
