 * Match trust row. Rendered as a child of product.detail.page, as a
 * sibling of the two-column image+info area, spanning the full page width.
 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\CurrentProduct;
use Hyva\Theme\ViewModel\HeroiconsOutline;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var HeroiconsOutline $heroicons */
$heroicons = $viewModels->require(HeroiconsOutline::class);

/** @var CurrentProduct $currentProduct */
$currentProduct = $viewModels->require(CurrentProduct::class);
$product = $currentProduct->get();

/**
 * Shows every publication currently defined on the as_seen_in attribute by
 * default - no admin action needed on a new/untouched product. An admin can
 * still narrow it to a specific subset for one product using the existing
 * as_seen_in multiselect (Stores > Attributes > Product > as_seen_in >
 * Manage Options controls the available publications; the product edit
 * form's "As Seen In" group controls the per-product selection).
 */
$asSeenIn = [];
$attribute = $product->getResource()->getAttribute('as_seen_in');
if ($attribute) {
    $labelsById = [];
    foreach ($attribute->getSource()->getAllOptions(false) as $option) {
        $labelsById[(string) $option['value']] = (string) $option['label'];
    }

    $asSeenInRaw = trim((string) $product->getData('as_seen_in'));
    if ($asSeenInRaw !== '') {
        $optionIds = array_filter(explode(',', $asSeenInRaw), static fn ($id) => $id !== '');
        foreach ($optionIds as $optionId) {
            if (isset($labelsById[$optionId])) {
                $asSeenIn[] = $labelsById[$optionId];
            }
        }
    } else {
        $asSeenIn = array_values($labelsById);
    }
}

/**
 * Per-publication wordmark styling (italic/letter-spacing/casing), matching
 * each outlet's real masthead - ported from the reference design's
 * AsSeenIn.tsx. Font-family is intentionally left out here: the reference
 * uses a distinct font per brand (e.g. Georgia for Outside), but this site
 * keeps its own font family throughout.
 */
$asSeenInBrandStyles = [
    'BACKPACKER'   => ['italic' => false, 'tracking' => '0.15em', 'transform' => 'uppercase', 'title' => 'Backpacker'],
    'OUTSIDE'      => ['italic' => true,  'tracking' => '0.05em', 'transform' => 'uppercase', 'title' => 'Outside'],
    'GearJunkie'   => ['italic' => false, 'tracking' => '0.05em', 'transform' => 'none',      'title' => 'GearJunkie'],
    'REI CO-OP'    => ['italic' => false, 'tracking' => '0.05em', 'transform' => 'none',      'title' => 'REI Co-op Journal'],
    'TRAIL RUNNER' => ['italic' => false, 'tracking' => '0.15em', 'transform' => 'uppercase', 'title' => 'Trail Runner'],
];
$asSeenInDefaultBrandStyle = ['italic' => false, 'tracking' => '0.05em', 'transform' => 'none'];
