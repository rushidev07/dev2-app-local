        white-space: nowrap;
    }
    /* The Tailwind `line-clamp-2`/`truncate` utilities on these two elements are
       not in the compiled Hyvä CSS (this module's templates are outside the
       theme's content scan), so the clamp is written out here the same way the
       sibling carousels do it. -webkit-box sizes itself to the full text and
       leans on overflow:hidden for the cut, so line-height is pinned and
       max-height capped at exactly two lines - otherwise the clip lands
       mid-glyph and the top of a third line shows under the ellipsis. */
    .ahy-cab-name {
        color: #0d2f47;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.25;
        min-height: 2.5em;
        max-height: 2.5em;
    }
    .ahy-cab-rating-row {
        min-height: 14px;
    }
    .ahy-cab-review-count {
        color: #6b7688;
    }
    .ahy-cab-price {
        color: #0d2f47;
        font-family: "DM Mono", monospace;
    }
    .ahy-cab-compare-price {
        color: oklch(0.5 0.015 240);
    }
    .ahy-cab-quick-add {
        background-color: #e85d26;
    }
