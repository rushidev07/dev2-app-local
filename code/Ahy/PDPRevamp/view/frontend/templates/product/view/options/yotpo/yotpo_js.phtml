<?php
/**
 * Alpine data functions backing the dynamic PDP review UI: the star/count
 * line above the product title (product-detail-page.phtml, product-info.phtml)
 * and the full "Ratings & Reviews" section (yotpo_reviews.phtml). Reviews are
 * fetched through Ahy_PDPRevamp's own controllers (see
 * Ahy\PDPRevamp\Service\YotpoClient), which call Yotpo server-side - no Yotpo
 * app key or secret is ever exposed to the browser.
 */

declare(strict_types=1);

use Ahy\PDPRevamp\ViewModel\AuthRedirect;
use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\ProductPage;
use Magento\Catalog\Model\Product;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var ProductPage $productViewModel */
$productViewModel = $viewModels->require(ProductPage::class);
/** @var Product $product */
$product = $productViewModel->getProduct();
$productId = (int) $product->getId();

/** @var AuthRedirect $authRedirect */
$authRedirect = $viewModels->require(AuthRedirect::class);
$productUrl = $product->getProductUrl();
if (!$authRedirect->isLoggedIn()) {
    // Same registration as yotpo_reviews.phtml - both run on the same PDP
    // render, so this is a harmless duplicate set of the same session value
    // when both templates render together.
    $authRedirect->setAfterAuthUrl($productUrl);
}
$signInUrl = $block->getUrl('customer/account/login', [
    '_secure' => $block->getRequest()->isSecure(),
    'referer' => base64_encode($productUrl),
]);
?>
<script defer id="ahy-yotpoReview">
    function yotpoReview() {
        return {
            search:             "",
            fetchUrl:           "<?= $escaper->escapeUrl($block->getUrl('ahyyotpo/index/reviews', ['product_id' => $productId, 'per_page' => 150])) ?>",
            // Vote state. canVote starts null ("not yet known") rather than
            // false so the buttons are not briefly rendered as sign-in prompts
            // for a logged-in customer while the reviews request is in flight;
            // the reviews response sets it. productId is needed so a vote can
            // tell the server which product's cached reviews to invalidate.
            productId:          <?= (int) $productId ?>,
            canVote:            null,
            votePending:        false,
            voteMessage:        "",
            voteMessageReviewId: null,
            pageSize:           3,
            showPagination:     false,
            modalOpen:          false,
            pageNumber:         0,
            reviewData:         "",
            currentIndex:       0,
            currentImage:       {},
            oneStartCount:      0,
            twoStartCount:      0,
            fiveStartCount:     0,
            fourStartCount:     0,
            threeStartCount:    0,
            allReviewsData:     "",
            selectedRatings:    [],
            totalReviewCount:    0,
            // Reviews land highest-rated first by default. All reviews for the
            // product are already fetched in one call, so this is a pure
            // client-side ordering - no extra request.
            defaultSortValue:   { target: { value: 'rating-high-low' } },
            currentSortValue:   'rating-high-low',
            isReviewAvailable:   false,
            currentContentData: {},
            twoStartPercentage:  0,
            oneStartPercentage:  0,
            fiveStartPercentage: 0,
            fourStartPercentage: 0,
            threeStartPercentage: 0,
            totalReviewCountText: '',
            totalRatingCountText: '',
            currentReviewAllImages: {},

            initReview() {
                const yotpoApiOptions = {
                    method: "GET",
                    headers: {
                        "accept": "application/json",
                        "Content-Type": "application/json",
                    },
                };

                // Several yotpoReview() instances exist on one PDP (the star
                // line above the title, and this section) and all fetch the
                // same URL. Sharing one in-flight request across all of them
                // avoids firing duplicate simultaneous requests that could
                // otherwise race each other against the server-side cache.
                window.ahyYotpoReviewsFetches = window.ahyYotpoReviewsFetches || {};
                if (!window.ahyYotpoReviewsFetches[this.fetchUrl]) {
                    window.ahyYotpoReviewsFetches[this.fetchUrl] = fetch(this.fetchUrl, yotpoApiOptions)
                        .then(res => res.json());
                }

                window.ahyYotpoReviewsFetches[this.fetchUrl]
                    .then(data => {
                        // Whether this visitor may vote, and their existing vote
                        // per review (review.my_vote), are stamped onto this
                        // response server-side - they cannot come from the page
                        // itself, which Varnish serves from cache to everyone.
                        this.canVote = data.can_vote === true;

                        if (data.response.bottomline.total_review > 0) {
                            this.reviewData = data.response.reviews;
                            this.allReviewsData = this.reviewData;
                            this.isReviewAvailable = true;
                            this.allInitFunctions();
                        }
                    })
                    .catch(err => {
                        console.error(err);
                    });
            },
            openDialog(index) {
                this.currentIndex = index;
                this.currentImage = null;
                this.currentContentData = null;
                this.currentReviewAllImages = null;
                this.reviewData.forEach(review => {
                    this.currentReviewAllImages = review.images_data || [];
                    this.currentContentData = {
                        "content": review.content,
                        "title": review.title
                    };
                    this.currentImage = (review.images_data || [])[index];
                });
                if (this.currentImage) {
                    this.modalOpen = true;
                }
            },
            prevImage() {
                if (this.currentIndex > 0) {
                    this.currentIndex--;
                    this.currentImage = this.currentReviewAllImages[this.currentIndex];
                }
            },
            nextImage() {
                if (this.currentIndex < this.currentReviewAllImages.length - 1) {
                    this.currentIndex++;
                    this.currentImage = this.currentReviewAllImages[this.currentIndex];
                }
            },
            allInitFunctions() {
                this.reviewsSortBy(this.defaultSortValue);
                this.calculateIndividualStarPercentage();
            },
            getAverageReviewScore() {
                if (this.reviewData.length > 0) {
                    const totalScore = this.reviewData.reduce((acc, curr) => acc + curr.score, 0);
                    const averageScore = totalScore / this.reviewData.length;
                    return averageScore.toFixed(1);
                }
                return null;
            },
            calculateIndividualStarPercentage() {
                const totalReviews = this.reviewData.length;
                this.totalReviewCount = totalReviews;
                this.totalRatingCountText = this.totalReviewCount === 1 ? 'rating' : 'ratings';
                this.totalReviewCountText = this.totalReviewCount === 1 ? 'review' : 'reviews';
                let oneStarCount = 0;
                let twoStarCount = 0;
                let threeStarCount = 0;
                let fourStarCount = 0;
                let fiveStarCount = 0;

                this.reviewData.forEach(review => {
                    switch (review.score) {
                        case 1: oneStarCount++; break;
                        case 2: twoStarCount++; break;
                        case 3: threeStarCount++; break;
                        case 4: fourStarCount++; break;
                        case 5: fiveStarCount++; break;
                        default: break;
                    }
                });

                this.oneStartCount = oneStarCount;
                this.twoStartCount = twoStarCount;
                this.threeStartCount = threeStarCount;
                this.fourStartCount = fourStarCount;
                this.fiveStartCount = fiveStarCount;

                this.oneStartPercentage = ((oneStarCount / totalReviews) * 100).toFixed(2) + '%';
                this.twoStartPercentage = ((twoStarCount / totalReviews) * 100).toFixed(2) + '%';
                this.threeStartPercentage = ((threeStarCount / totalReviews) * 100).toFixed(2) + '%';
                this.fourStartPercentage = ((fourStarCount / totalReviews) * 100).toFixed(2) + '%';
                this.fiveStartPercentage = ((fiveStarCount / totalReviews) * 100).toFixed(2) + '%';
            },
            // Pure - reads reactive state and returns a value, no side effects.
            // Calling a method with side effects (mutating this.totalPages etc.)
            // directly from x-for's iterable expression is unreliable, since
            // Alpine may re-evaluate it multiple times per render pass.
            get filteredReviews() {
                if (this.search === "") {
                    return this.reviewData;
                }
                const term = this.search.toLowerCase();
                return this.reviewData.filter(review => {
                    return (review.content || '').toLowerCase().includes(term)
                        || (review.title || '').toLowerCase().includes(term)
                        || (review.user.display_name || '').toLowerCase().includes(term);
                });
            },
            get totalPages() {
                return this.filteredReviews.length;
            },
            searchReviews() {
                const startPage = this.pageNumber * this.pageSize, endPage = startPage + this.pageSize;
                return this.filteredReviews.slice(startPage, endPage);
            },
            pages() {
                return Array.from({ length: Math.ceil(this.totalPages / this.pageSize) });
            },
            nextPage() {
                if (this.pageNumber + 1 < this.pageCount()) {
                    this.pageNumber++;
                    this.scrollToYotpoReviews();
                }
            },
            prevPage() {
                if (this.pageNumber > 0) {
                    this.pageNumber--;
                    this.scrollToYotpoReviews();
                }
            },
            pageCount() {
                return Math.ceil(this.totalPages / this.pageSize);
            },
            startPageResults() {
                return this.pageNumber * this.pageSize + 1;
            },
            endResults() {
                let resultsOnPage = (this.pageNumber + 1) * this.pageSize;
                if (resultsOnPage <= this.totalPages) {
                    return resultsOnPage;
                }
                return this.totalPages;
            },
            viewPage(index) {
                this.pageNumber = index;
                this.scrollToYotpoReviews();
            },
            scrollToYotpoReviews() {
                const reviewsEl = document.getElementById('ahy-yotpo-product-reviews');
                if (reviewsEl) {
                    reviewsEl.scrollIntoView({ behavior: 'smooth' });
                }
            },
            formatReviewDate(timestamp) {
                if (!timestamp) {
                    return '';
                }
                const date = new Date(timestamp);
                const options = { year: "numeric", month: "short", day: "numeric" };
                return date.toLocaleDateString("en-US", options);
            },
            /**
             * Cast or retract this customer's "helpful" vote on a review.
             *
             * State comes from review.my_vote ("up" or null), which the reviews
             * endpoint stamps per customer. It used to be read back out of a CSS
             * class on the thumb icon, which meant a page reload wiped it and the
             * same visitor could vote again on every load.
             *
             * Helpful is the only direction: there is no "not helpful" vote.
             *
             * The vote_type argument is kept for signature compatibility with the
             * template's existing reviewFeedback(1, ...) call and is ignored.
             */
            reviewFeedback(vote_type, review, event) {
                if (this.votePending) {
                    return;
                }

                // Guests are told to sign in rather than having the request
                // rejected silently; the count stays visible either way.
                if (this.canVote === false) {
                    this.voteMessage = "<?= $escaper->escapeJs(__('Please sign in to vote on reviews.')) ?>";
                    this.voteMessageReviewId = review.id;
                    return;
                }

                // Clicking an existing vote retracts it.
                const isRetraction = review.my_vote === "up";

                // Optimistic update, remembered so it can be rolled back on
                // failure - the response carries no authoritative total.
                const snapshot = {
                    my_vote: review.my_vote || null,
                    votes_up: review.votes_up || 0,
                };

                review.votes_up = Math.max(0, (review.votes_up || 0) + (isRetraction ? -1 : 1));
                review.my_vote = isRetraction ? null : "up";

                this.votePending = true;
                this.voteMessage = "";

                const options = {
                    method: "POST",
                    headers: { accept: "application/json", "Content-Type": "application/json" },
                    body: JSON.stringify({
                        review_id: review.id,
                        vote_type: "up",
                        product_id: this.productId || null,
                        // Retracting is stated explicitly rather than inferred
                        // server-side from "you already voted", so a duplicate
                        // request cannot delete a vote by accident.
                        unvote: isRetraction,
                    }),
                };

                fetch('<?= $escaper->escapeUrl($block->getUrl('ahyyotpo/index/vote')) ?>', options)
                    .then(response => response.json().then(body => ({ status: response.status, body })))
                    .then(({ status, body }) => {
                        if (status === 401 || (body && body.requires_login)) {
                            // Session expired between page load and click.
                            this.revertVote(review, snapshot);
                            this.canVote = false;
                            this.voteMessage = body && body.message
                                ? body.message
                                : "<?= $escaper->escapeJs(__('Please sign in to vote on reviews.')) ?>";
                            this.voteMessageReviewId = review.id;
                            return;
                        }

                        if (!body || body.success !== true) {
                            this.revertVote(review, snapshot);
                            return;
                        }

                        // Trust the server's view of the resulting direction.
                        review.my_vote = body.my_vote || null;
                    })
                    .catch(err => {
                        this.revertVote(review, snapshot);
                        console.error(err);
                    })
                    .finally(() => {
                        this.votePending = false;
                    });
            },
            revertVote(review, snapshot) {
                review.my_vote = snapshot.my_vote;
                review.votes_up = snapshot.votes_up;
            },
            reviewsSortBy(event) {
                this.currentSortValue = event.target.value;
                this.applySort();
            },
            /**
             * Re-applies whichever sort is active. Kept separate from
             * reviewsSortBy so the rating filter can restore the order after it
             * rebuilds reviewData from the unsorted allReviewsData.
             */
            applySort() {
                const byNewest = (a, b) => new Date(b.created_at || 0) - new Date(a.created_at || 0);
                switch (this.currentSortValue) {
                    case "most-recent":
                        this.reviewData = [...this.reviewData].sort(byNewest);
                        break;
                    case "least-recent":
                        this.reviewData = [...this.reviewData].sort((a, b) => new Date(a.created_at || 0) - new Date(b.created_at || 0));
                        break;
                    case "rating-high-low":
                        // Newest wins among equal scores, so the lead review is
                        // the best-rated *and* freshest rather than arbitrary.
                        this.reviewData = [...this.reviewData].sort((a, b) => (b.score - a.score) || byNewest(a, b));
                        break;
                    case "rating-low-high":
                        this.reviewData = [...this.reviewData].sort((a, b) => (a.score - b.score) || byNewest(a, b));
                        break;
                    default:
                        return;
                }
            },
            filterByRatings(event) {
                const checked = event.target.checked;
                const value = event.target.value;

                if (checked) {
                    this.selectedRatings.push(value);
                } else {
                    const index = this.selectedRatings.indexOf(value);
                    if (index !== -1) {
                        this.selectedRatings.splice(index, 1);
                    }
                }

                if (this.selectedRatings.length == 0 || this.selectedRatings.length == 5) {
                    this.reviewData = this.allReviewsData;
                } else {
                    this.reviewData = this.allReviewsData.filter(review => {
                        return this.selectedRatings.includes(review.score.toString());
                    });
                }
                // allReviewsData is in Yotpo's own order, so the active sort has
                // to be re-applied or filtering silently reverts to it.
                this.applySort();
                this.viewPage(0);
            },
            goToReview() {
                if (this.totalReviewCount === 0) {
                    window.dispatchEvent(new CustomEvent('open-yotpo-write-review'));
                    return;
                }
                const reviewEl = document.getElementById('ahy-yotpo-product-reviews');
                if (reviewEl) {
                    reviewEl.scrollIntoView({ behavior: "smooth" });
                }
            },
        };
    }
</script>

<script defer id="ahy-createReview">
    function createReview() {
        return {
            sku: '<?= $escaper->escapeJs($product->getSku()) ?>',
            product_title: '<?= $escaper->escapeJs($product->getName()) ?>',
            product_url: '<?= $escaper->escapeJs($product->getProductUrl()) ?>',
            customerName: '',
            customerEmail: '',
            errorMessage: null,
            showForm: true,
            showThankYouForm: false,
            display_name: '',
            email: '',
            review_content: '',
            review_title: '',
            review_score: null,
            photos: [],
            photoError: null,
            /**
             * Autosaves whatever's typed so far to sessionStorage as the
             * shopper fills the form, and restores it on load - so a guest
             * who gets sent to sign in (see submitReviews() below) and
             * comes back doesn't lose their draft, without needing a click
             * handler on the "Sign in" link itself: that link is injected
             * via x-html (see yotpo_reviews.phtml's errorMessage binding),
             * and Alpine directives added that way aren't reliably wired up,
             * so continuous autosave sidesteps that entirely.
             */
            init() {
                this.restoreDraft();
                this.$watch('review_title', () => this.saveDraft());
                this.$watch('review_content', () => this.saveDraft());
                this.$watch('review_score', () => this.saveDraft());
                this.$watch('photos', () => this.saveDraft());

                /**
                 * private-content-loaded only fires when this Hyva theme's
                 * customer-data reimplementation actually re-fetches
                 * customer/section/load - which it skips whenever the
                 * 'customer' section is already cached (unexpired) in
                 * localStorage, the common case for a returning logged-in
                 * shopper. Without this, getCustomerName()/getCustomerEmail()
                 * stay empty on those page loads and every submission falls
                 * back to 'Anonymous' / 'guest@review.everest.com' despite the
                 * shopper being logged in. Reading the cached section directly
                 * here covers that gap - same localStorage key/shape this
                 * theme already reads elsewhere (see shortcut_button.phtml's
                 * cartData.cart) - and the window listener above still
                 * applies a freshly-fetched section if one arrives later.
                 * Not a RequireJS require(): Hyva doesn't load
                 * Magento_Customer/js/customer-data on the storefront.
                 */
                try {
                    const cached = JSON.parse(localStorage.getItem('mage-cache-storage') || '{}');
                    if (cached.customer) {
                        this.getCustomerData({ customer: cached.customer });
                    }
                } catch (error) {
                    // Cached section missing/corrupt - the window listener above still covers a fresh fetch.
                }
            },
            draftKey() {
                return 'ahy_review_draft_' + this.sku;
            },
            saveDraft() {
                if (!this.review_title && !this.review_content && !this.review_score && !this.photos.length) {
                    return;
                }
                const draft = {
                    review_title: this.review_title,
                    review_content: this.review_content,
                    review_score: this.review_score,
                    photos: this.photos,
                };
                try {
                    sessionStorage.setItem(this.draftKey(), JSON.stringify(draft));
                } catch (error) {
                    // Likely quota exceeded from photo data URLs - retry text-only
                    // so at least the written review survives, not just photos.
                    try {
                        sessionStorage.setItem(this.draftKey(), JSON.stringify({ ...draft, photos: [] }));
                    } catch (innerError) {
                        // Storage unavailable entirely - draft just won't survive a redirect.
                    }
                }
            },
            restoreDraft() {
                let raw;
                try {
                    raw = sessionStorage.getItem(this.draftKey());
                } catch (error) {
                    return;
                }
                if (!raw) {
                    return;
                }
                try {
                    const draft = JSON.parse(raw);
                    this.review_title = draft.review_title || '';
                    this.review_content = draft.review_content || '';
                    this.review_score = draft.review_score || null;
                    this.photos = Array.isArray(draft.photos) ? draft.photos : [];
                    this.showForm = true;
                } catch (error) {
                    // Corrupt draft - ignore, start with an empty form as normal.
                } finally {
                    sessionStorage.removeItem(this.draftKey());
                }
            },
            addPhotos(event) {
                this.photoError = null;
                const allowedTypes = ['image/jpeg', 'image/png', 'image/webp'];
                const maxSize = 10 * 1024 * 1024;
                const maxCount = 4; // Yotpo's images/process endpoint accepts at most 4 photos per review.

                for (const file of Array.from(event.target.files || [])) {
                    if (this.photos.length >= maxCount) {
                        this.photoError = 'You can add up to 4 photos.';
                        break;
                    }
                    if (!allowedTypes.includes(file.type)) {
                        this.photoError = 'Photos must be JPG, PNG, or WebP.';
                        continue;
                    }
                    if (file.size > maxSize) {
                        this.photoError = 'Each photo must be 10MB or smaller.';
                        continue;
                    }
                    const reader = new FileReader();
                    reader.onload = (e) => {
                        this.photos.push({ dataUrl: e.target.result, name: file.name });
                    };
                    reader.readAsDataURL(file);
                }
                event.target.value = '';
            },
            removePhoto(index) {
                this.photos.splice(index, 1);
            },
            /**
             * canVote is the outer yotpoReview() component's flag (really
             * "is this visitor logged in" - see initReview() below) - passed
             * in from the template rather than read as this.canVote, since
             * this method's "this" is createReview()'s own data only, one
             * Alpine component removed from where canVote actually lives.
             *
             * Same guest gate, same wording, and the same "sign in" link as
             * the "Helpful" vote button (reviewFeedback() below): checked
             * up front to avoid a pointless round trip, and again from the
             * server's actual response, since canVote can be stale if the
             * session expired after the page loaded.
             */
            submitReviews(canVote) {
                this.errorMessage = null;

                if (canVote === false) {
                    this.errorMessage = "<?= $escaper->escapeJs(__('Please sign in to write a review.')) ?> "
                        + '<a href="<?= $escaper->escapeUrl($signInUrl) ?>" class="font-semibold underline">'
                        + "<?= $escaper->escapeJs(__('Sign in')) ?></a>";
                    return;
                }

                /**
                 * The star widget's own input (wr_review_score, in
                 * yotpo_reviews.phtml) is type="hidden" - browsers exclude
                 * hidden inputs from constraint validation entirely, so its
                 * "required" attribute has never actually blocked anything.
                 * Checked here instead, before the request goes out at all.
                 */
                if (!this.review_score) {
                    this.showForm = true;
                    this.showThankYouForm = false;
                    this.errorMessage = "<?= $escaper->escapeJs(__('Please select a star rating.')) ?>";
                    return;
                }

                const data = {
                    sku: this.sku,
                    product_title: this.product_title,
                    product_url: this.product_url,
                    display_name: this.display_name,
                    email: this.email,
                    review_content: this.review_content,
                    review_title: this.review_title,
                    review_score: this.review_score,
                    images: this.photos.map(photo => photo.dataUrl)
                };
                const options = {
                    method: 'POST',
                    headers: { accept: 'application/json', 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                };

                fetch('<?= $escaper->escapeUrl($block->getUrl('ahyyotpo/index/review')) ?>', options)
                    .then(response => response.json().then(body => ({ status: response.status, body })))
                    .then(({ status, body }) => {
                        if (status === 401 || (body && body.requires_login)) {
                            this.showForm = true;
                            this.showThankYouForm = false;
                            this.errorMessage = (body && body.message
                                ? body.message
                                : "<?= $escaper->escapeJs(__('Please sign in to write a review.')) ?>")
                                + ' <a href="<?= $escaper->escapeUrl($signInUrl) ?>" class="font-semibold underline">'
                                + "<?= $escaper->escapeJs(__('Sign in')) ?></a>";
                            return;
                        }

                        /**
                         * status is the authoritative success/failure signal.
                         * body.status?.message alone used to decide this, but
                         * a rejected submission (e.g. Controller\Index\Review's
                         * 400 "<field> is required") has no status.message key
                         * either - identical to a real Yotpo success response's
                         * shape ({code, message: 'ok', ...}, no "status"
                         * wrapper) - so that check was reading every 400 as a
                         * success and showing the "thank you" screen for a
                         * submission that was never actually saved.
                         */
                        const message = body.status?.message ?? body.error;
                        if (status < 400 && (message === 'ok' || typeof message === 'undefined')) {
                            this.showForm = false;
                            this.showThankYouForm = true;
                            this.photos = [];
                            try {
                                sessionStorage.removeItem(this.draftKey());
                            } catch (error) {
                                // Nothing to clean up if storage isn't available.
                            }
                            return;
                        }
                        this.showForm = true;
                        this.showThankYouForm = false;
                        switch (message) {
                            case 'email is required':
                                this.errorMessage = 'Please enter your email address';
                                break;
                            case 'review_title is required':
                                this.errorMessage = 'Please enter a review summary';
                                break;
                            case 'review_content is required':
                                this.errorMessage = 'Please enter a review description';
                                break;
                            case 'display_name is required':
                                this.errorMessage = 'Please enter your name';
                                break;
                            case 'review_score is required':
                                this.errorMessage = 'Please select a star rating';
                                break;
                            case 'duplicate_review':
                                this.errorMessage = 'You have already submitted a review for this product';
                                break;
                            default:
                                this.errorMessage = message || "<?= $escaper->escapeJs(__('Something went wrong. Please try again.')) ?>";
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        this.errorMessage = 'Something went wrong. Please try again.';
                    });
            },
            getCustomerData(customerData) {
                if (typeof customerData.customer.fullname === 'undefined' || typeof customerData.customer.email === 'undefined') {
                    this.customerName = '';
                    this.customerEmail = '';
                } else {
                    this.customerName = customerData.customer.fullname;
                    this.customerEmail = customerData.customer.email;
                }
                return customerData;
            },
            getCustomerName() {
                return this.customerName;
            },
            getCustomerEmail() {
                return this.customerEmail;
            },
        };
    }
</script>
