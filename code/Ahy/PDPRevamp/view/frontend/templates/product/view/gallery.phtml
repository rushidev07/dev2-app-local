                <?php /* flex-wrap + shrink-0 on every child: the icons have a fixed
                         28px box, but as flex items that is only a base size, so when
                         the "Copied!" label widens the row they were being squashed
                         into ovals. Wrapping is the correct overflow behaviour here. */ ?>
                <div class="flex flex-wrap items-center gap-3 lg:shrink-0"
                     x-data="{
                         copied: false,
                         shareUrl: '<?= $escaper->escapeJs($shareProductUrl) ?>',
                         async copyLink() {
                             try {
                                 if (navigator.clipboard && window.isSecureContext) {
                                     await navigator.clipboard.writeText(this.shareUrl);
                                 } else {
                                     /* navigator.clipboard is undefined on non-HTTPS origins
                                        and older browsers - fall back rather than throw. */
                                     const field = document.createElement('textarea');
                                     field.value = this.shareUrl;
                                     field.setAttribute('readonly', '');
                                     field.style.position = 'fixed';
                                     field.style.opacity = '0';
                                     document.body.appendChild(field);
                                     field.select();
                                     document.execCommand('copy');
                                     document.body.removeChild(field);
                                 }
                                 this.copied = true;
                                 setTimeout(() => { this.copied = false }, 2000);
                             } catch (error) {
                                 console.error(error);
                             }
                         }
                     }"
                     x-show="!fullscreen"
                >
