    >
        <template x-if="isDesktop">
            <div class="">
                <?php 
                    $productInfoDetailsBlock = $this->getLayout()->getBlock('product.info.details');
                    echo  $productInfoDetailsBlock ? $productInfoDetailsBlock->toHtml() : ''; 
                ?>
