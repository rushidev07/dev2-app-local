<?php
/**
 * PDP "Frequently Bought Together" section. Suggestions are algorithmic
 * (same category as the current product - see
 * Ahy\PDPRevamp\Block\Product\View\FrequentlyBoughtTogether), distinct from
 * the merchant-curated Amasty bundle-pack widget shown elsewhere on this
 * page. Renders nothing if the current product has no category or no
 * other products share it.
 */

declare(strict_types=1);

use Ahy\PDPRevamp\Block\Product\View\FrequentlyBoughtTogether;
use Magento\Catalog\Model\Product;
use Magento\Framework\Escaper;

/** @var FrequentlyBoughtTogether $block */
/** @var Escaper $escaper */

$items = $block->getBundleItems();
if (count($items) < 2) {
    return;
}

$imageHelper = $block->getImageHelper();
$priceHelper = $block->getPriceHelper();
$sellerHelper = $this->helper('Webkul\Marketplace\Helper\Data');

$discountPercent = $block->getBundleDiscountPercent();

$itemsData = [];
$regularTotal = 0.0;
foreach ($items as $item) {
    /** @var Product $item */
    $finalPrice = $block->getItemFinalPrice($item);
    $regularPrice = $block->getItemRegularPrice($item);
    $regularTotal += $finalPrice;

    $vendorName = '';
    $sellerData = $sellerHelper->getSellerProductDataByProductId($item->getId());
    if (isset($sellerData->getData()[0]) && $sellerData->getData()[0]) {
        $sellerObj = $sellerData->getData()[0];
        $sellerDataObj = $sellerHelper->getSellerDataBySellerId($sellerObj['seller_id']);
        $sellerInfo = $sellerDataObj->getData()[0] ?? null;
        if ($sellerInfo) {
            $vendorName = $sellerInfo['shop_title'] ?: ($sellerInfo['name'] ?? '');
        }
    }

    $itemsData[] = [
        'id' => (int) $item->getId(),
        'name' => $item->getName(),
        'vendor' => $vendorName,
        'image' => $imageHelper->init($item, 'ahy_fbt_thumbnail')->setImageFile($item->getData('small_image'))->getUrl(),
        'finalPrice' => round($finalPrice, 2),
        'regularPrice' => round($regularPrice, 2),
        'hasDiscount' => $regularPrice > $finalPrice,
    ];
}
?>
<div
    class="pdp-frequently-bought-together bg-white rounded-lg border border-gray-200 p-5"
    x-data="ahyFrequentlyBoughtTogether(<?= $escaper->escapeHtmlAttr(json_encode($itemsData)) ?>, <?= (int) $discountPercent ?>)"
>
    <h2 class="font-extrabold text-ahy-blue text-lg mb-4"><?= __('Frequently Bought Together') ?></h2>

    <div class="pdp-fbt-row">
        <template x-for="(item, index) in items" :key="item.id">
            <div class="relative flex flex-col sm:block items-stretch gap-1 w-full min-w-0">
                <label
                    class="relative flex flex-col rounded-lg border-2 overflow-hidden cursor-pointer w-full min-w-0"
                    :class="checked.includes(item.id) ? '' : 'opacity-50'"
                    style="border-color:#e85d26;"
                >
                    <span
                        x-show="index === 0"
                        class="absolute top-2 left-2 z-10 rounded-full px-2 py-0.5 text-xs font-bold text-white uppercase"
                        style="background:#e85d26;"
                    ><?= __('This Item') ?></span>
                    <span
                        class="absolute top-2 right-2 z-10 w-6 h-6 rounded-full flex items-center justify-center text-white"
                        :style="checked.includes(item.id) ? 'background:#e85d26;' : 'background:#d1d5db;'"
                    >
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>
                    </span>
                    <input
                        type="checkbox"
                        class="sr-only"
                        :checked="checked.includes(item.id)"
                        @change="toggleItem(item.id)"
                        :disabled="index === 0"
                    >
                    <div style="aspect-ratio:1/1;overflow:hidden;">
                        <img :src="item.image" :alt="item.name" class="w-full h-full min-w-0 object-contain bg-white">
                    </div>
                    <div class="p-3 border-t border-gray-100 flex flex-col flex-1 min-h-[86px]">
                        <p class="text-sm font-bold text-ahy-blue leading-tight truncate" x-text="item.name"></p>
                        <p class="text-xs text-gray-500 truncate" x-text="item.vendor"></p>
                        <p class="mt-1 truncate">
                            <span class="font-bold text-ahy-blue" x-text="'$' + item.finalPrice.toFixed(2)"></span>
                            <span x-show="item.hasDiscount" class="text-xs text-gray-400 line-through ml-1" x-text="'$' + item.regularPrice.toFixed(2)"></span>
                        </p>
                    </div>
                </label>
                <span x-show="index < items.length - 1" class="flex items-center justify-center shrink-0 text-2xl text-gray-300 font-light py-0.5 sm:py-0 sm:absolute sm:top-1/2 sm:z-20 sm:-translate-y-1/2 pdp-fbt-plus">+</span>
            </div>
        </template>
    </div>

    <div class="flex flex-col sm:flex-row sm:flex-nowrap items-center justify-between gap-3 mt-4 pt-4 border-t border-gray-200">
        <div class="flex items-center justify-center sm:justify-start gap-3 flex-wrap min-w-0 text-center sm:text-left">
            <span class="text-sm text-ahy-blue" x-text="checked.length + ' items selected'"></span>
            <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-bold" style="background:#f0fdf4;color:#15803d;" x-text="'Bundle & Save ' + discountPercent + '%'"></span>
            <span class="text-sm text-gray-400 line-through" x-text="'$' + regularTotal().toFixed(2)"></span>
            <span class="text-xl font-extrabold text-ahy-blue" x-text="'$' + discountedTotal().toFixed(2)"></span>
            <span class="text-sm font-semibold" style="color:#15803d;" x-text="'Save $' + savings().toFixed(2)"></span>
        </div>
        <button
            type="button"
            class="btn flex items-center justify-center gap-2 w-full sm:w-auto shrink-0 whitespace-nowrap rounded-lg text-white font-bold px-6 py-3"
            style="background:#e85d26;"
            onmouseover="this.style.background='#d14e1c'"
            onmouseout="this.style.background='#e85d26'"
            :disabled="submitting"
            @click="addBundleToCart()"
        >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="21" r="1"></circle><circle cx="19" cy="21" r="1"></circle><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path></svg>
            <span x-text="submitting ? 'Adding...' : 'Add Bundle to Cart'"></span>
        </button>
    </div>
</div>

<style>
    .pdp-fbt-row {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.5rem;
    }
    @media (min-width: 640px) {
        .pdp-fbt-row {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 1rem;
        }
        .pdp-fbt-plus {
            left: calc(100% + 0.5rem);
            transform: translate(-50%, -50%);
        }
    }
</style>
<script>
    function ahyFrequentlyBoughtTogether(items, discountPercent) {
        return {
            items: items,
            discountPercent: discountPercent,
            checked: items.map(item => item.id),
            submitting: false,
            toggleItem(itemId) {
                const index = this.checked.indexOf(itemId);
                if (index === -1) {
                    this.checked.push(itemId);
                } else {
                    this.checked.splice(index, 1);
                }
            },
            regularTotal() {
                return this.items
                    .filter(item => this.checked.includes(item.id))
                    .reduce((sum, item) => sum + item.finalPrice, 0);
            },
            discountedTotal() {
                return this.regularTotal() * (1 - this.discountPercent / 100);
            },
            savings() {
                return this.regularTotal() - this.discountedTotal();
            },
            addBundleToCart() {
                if (this.submitting || this.checked.length === 0) {
                    return;
                }
                this.submitting = true;
                const formKey = hyva.getFormKey();
                const requests = this.checked.map(productId => {
                    const body = new URLSearchParams();
                    body.set('product', productId);
                    body.set('qty', '1');
                    body.set('form_key', formKey);
                    return fetch(BASE_URL + 'checkout/cart/add/', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                            'X-Requested-With': 'XMLHttpRequest',
                        },
                        body: body.toString(),
                        credentials: 'same-origin',
                    });
                });

                Promise.all(requests)
                    .then(() => {
                        this.submitting = false;
                        window.dispatchEvent(new CustomEvent('reload-customer-section-data'));
                        typeof window.dispatchMessages !== 'undefined' && window.dispatchMessages(
                            [{ type: 'success', text: 'Bundle items added to your cart.' }], 5000
                        );
                    })
                    .catch((error) => {
                        this.submitting = false;
                        typeof window.dispatchMessages !== 'undefined' && window.dispatchMessages(
                            [{ type: 'error', text: 'Something went wrong adding the bundle to your cart.' }], 5000
                        );
                        console.error(error);
                    });
            },
        };
    }
</script>
