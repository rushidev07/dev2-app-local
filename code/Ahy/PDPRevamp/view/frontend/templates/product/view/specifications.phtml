<?php
/**
 * PDP "Specifications" tab content. See Block\Product\View\Specifications
 * for where the label/value pairs come from (the pdp_specifications
 * textarea attribute, one "Label: Value" per line).
 */

declare(strict_types=1);

use Ahy\PDPRevamp\Block\Product\View\Specifications;
use Magento\Framework\Escaper;

/** @var Specifications $block */
/** @var Escaper $escaper */

$specifications = $block->getSpecifications();
?>
<?php if (!$specifications): ?>
    <div class="text-sm" style="color:#6b7688;">
        <?= __('Specifications coming soon.') ?>
    </div>
<?php else: ?>
    <h3 class="font-bold text-ahy-blue text-lg mb-4"><?= __('Technical Specifications') ?></h3>
    <div class="rounded-lg overflow-hidden" style="border:1px solid #e1ddde;">
        <?php foreach ($specifications as $index => $spec): ?>
            <div
                class="flex flex-col sm:flex-row sm:items-center text-sm <?= $index > 0 ? 'border-t border-gray-100' : '' ?>"
                style="background:<?= $index % 2 === 1 ? '#FBFBF9' : '#fff' ?>;"
            >
                <div class="sm:w-1/3 px-4 py-2.5 font-semibold text-ahy-blue" style="border-right:1px solid #e1ddde;">
                    <?= $escaper->escapeHtml($spec['label']) ?>
                </div>
                <div class="sm:w-2/3 px-4 py-2.5" style="color:#4a5a74;">
                    <?= $escaper->escapeHtml($spec['value']) ?>
                </div>
            </div>
        <?php endforeach; ?>
    </div>
<?php endif; ?>
