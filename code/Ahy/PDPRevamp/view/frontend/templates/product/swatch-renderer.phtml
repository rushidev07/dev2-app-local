    <script>
        // product/color-swatch-resolver.phtml (head.additional) publishes these
        // two maps for the CURRENT product only, which is all the main PDP
        // needs. This template is also rendered for OTHER products though -
        // the FBT bundle's modal injects it via ahy_themecustomization/index/
        // GetProductSwatchesDetails - and without their own colour option ids
        // present, window.ahyGetSwatchStyle() returns null for every option and
        // every colour falls into the plain-text pass below instead of showing
        // a swatch. Ship this product's own entries alongside its markup so any
        // copy of these swatches is self-sufficient wherever it is rendered.
        // Merged, never assigned: option ids are attribute-option ids, so an id
        // always means the same colour, and the anchor's entries must survive.
        window.AHY_ADMIN_COLOR_HEX = Object.assign(
            window.AHY_ADMIN_COLOR_HEX || {},
            <?= /* @noEscape */ json_encode((object) $swatchHexMaps['admin']) ?>
        );
        window.AHY_NATIVE_SWATCH_HEX = Object.assign(
            window.AHY_NATIVE_SWATCH_HEX || {},
            <?= /* @noEscape */ json_encode((object) $swatchHexMaps['native']) ?>
        );

        function initConfigurableSwatchOptions_<?= (int) $productId ?>() {
            const configurableOptionsComponent = initConfigurableOptions(
                '<?= (int) $productId ?>',
                <?= /* @noEscape */ $block->getJsonConfig() ?>
            );
            const swatchOptionsComponent = initSwatchOptions(
                <?= /* @noEscape */ $block->getJsonSwatchConfig() ?>,
                <?= /* @noEscape */ $block->getJsonConfig() ?>
            );
            return Object.assign(
                configurableOptionsComponent,
                swatchOptionsComponent,
                {
                    swatchSort
                }
            );
            function swatchSort(a, b) {
                const order = ['XS', 'S', 'M', 'L', 'XL', 'XXL', 'XXXL'];
                const sizeMap = {
                    'extra small': 'XS',
                    'small': 'S',
                    'medium': 'M',
                    'large': 'L',
                    'extra large': 'XL',
                    'double extra large': 'XXL',
                    'triple extra large': 'XXXL'
                };

                const normalizeLabel = (label) => {
                    const clean = label.toLowerCase().trim();
                    return sizeMap[clean] || label.toUpperCase().trim();
                };

                const aLabel = normalizeLabel(a.label);
                const bLabel = normalizeLabel(b.label);

                const aIndex = order.indexOf(aLabel);
                const bIndex = order.indexOf(bLabel);

                if (aIndex !== -1 && bIndex !== -1) {
                    return aIndex - bIndex;
                }
                if (aIndex !== -1) return -1;
                if (bIndex !== -1) return 1;

                // Handle numeric labels like "2", "10"
                const aNum = parseInt(aLabel, 10);
                const bNum = parseInt(bLabel, 10);
                const aIsNum = !isNaN(aNum);
                const bIsNum = !isNaN(bNum);

                if (aIsNum && bIsNum) {
                    return aNum - bNum;
                }

                return aLabel.localeCompare(bLabel);
            }
        }
    </script>
