<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;

/** @var Template $block */

// Only the background image is managed from Admin > Content > Blocks
// ("home_give_back_fund_banner") - admins can swap it there without a
// deploy. Heading, copy, and button are hardcoded below so their Tailwind
// classes are guaranteed to compile: Tailwind's build only scans *.phtml
// files, and this markup previously lived in a .php string that was
// silently purged from the compiled CSS, leaving the banner unstyled.
$blockHtml = $block->getLayout()
    ->createBlock(\Magento\Cms\Block\Block::class)
    ->setBlockId('home_give_back_fund_banner')
    ->toHtml();
// This install auto-generates a scoped "cmsb{id}-" Tailwind stylesheet for
// CMS block content and wraps it in a <style> tag around the block's own
// markup. strip_tags() only removes the <style> tags themselves, not the
// CSS text between them, so that whole ruleset was leaking into
// $backgroundImageUrl as garbage text ahead of the real URL. Drop the
// entire <style>...</style> block first so only the actual content (the
// image URL) is left to strip tags from.
$blockHtml = preg_replace('#<style\b[^>]*>.*?</style>#is', '', $blockHtml) ?? $blockHtml;
$backgroundImageUrl = trim(strip_tags($blockHtml));
$backgroundImageStyle = $backgroundImageUrl
    ? sprintf("background-image:url('%s')", $block->escapeUrl($backgroundImageUrl))
    : '';
?>
<section class="ahy-give-back-banner relative overflow-hidden"
         style="width:100vw;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw;">
    <div class="absolute inset-0 ahy-give-back-bg" style="<?= $block->escapeHtmlAttr($backgroundImageStyle) ?>"></div>
    <div class="absolute inset-0 ahy-give-back-overlay"></div>
    <div class="relative container ahy-give-back-inner text-center">
        <div class="ahy-give-back-content mx-auto space-y-4">
            <p class="ahy-give-back-label">
                <?= $block->escapeHtml(__('The Everest Give Back Fund')) ?>
            </p>
            <h2 class="ahy-give-back-heading text-3xl font-extrabold text-white leading-tight">
                <?= $block->escapeHtml(__('Helping People Thrive')) ?><br/><?= $block->escapeHtml(__('in the Outdoors')) ?>
            </h2>
            <p class="ahy-give-back-text leading-relaxed mx-auto">
                <?= $block->escapeHtml(__("Every purchase on Everest.com supports outdoor conservation, trail maintenance, and youth outdoor education programs. Because the outdoors isn't just something we visit \xe2\x80\x94 it's where we belong.")) ?>
            </p>
            <a href="<?= $block->escapeUrl($block->getUrl('give-back-fund')) ?>"
               class="ahy-give-back-button inline-block text-white text-sm font-semibold rounded-full transition-all no-underline">
                <?= $block->escapeHtml(__('Learn About the Give Back Fund')) ?>
            </a>
        </div>
    </div>
</section>
