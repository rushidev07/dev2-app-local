<?xml version="1.0"?>
<!--
    Read-only claims grid. No edit/delete actions and no mass actions by design -
    see Controller\Adminhtml\ExitCouponClaim\Index for why.

    The dataSource name must match the item key registered on
    UiComponent\DataProvider\CollectionFactory in etc/adminhtml/di.xml, which is
    what supplies the joined collection.
-->
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">ahy_pdprevamp_exit_coupon_listing.ahy_pdprevamp_exit_coupon_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>ahy_pdprevamp_exit_coupon_columns</spinner>
        <deps>
            <dep>ahy_pdprevamp_exit_coupon_listing.ahy_pdprevamp_exit_coupon_listing_data_source</dep>
        </deps>
    </settings>

    <dataSource name="ahy_pdprevamp_exit_coupon_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Ahy_PDPRevamp::exit_coupon_claims</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="ahy_pdprevamp_exit_coupon_listing_data_source">
            <settings>
                <requestFieldName>entity_id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filterSearch name="fulltext"/>
        <filters name="listing_filters">
            <settings>
                <templates>
                    <filters>
                        <select>
                            <param name="template" xsi:type="string">ui/grid/filters/elements/ui-select</param>
                            <param name="component" xsi:type="string">Magento_Ui/js/form/element/ui-select</param>
                        </select>
                    </filters>
                </templates>
            </settings>
        </filters>
        <paging name="listing_paging"/>
        <exportButton name="export_button"/>
    </listingToolbar>

    <columns name="ahy_pdprevamp_exit_coupon_columns">
        <settings>
            <childDefaults>
                <param name="fieldClass" xsi:type="array">
                    <item name="data-grid-checkbox-cell" xsi:type="boolean">false</item>
                </param>
            </childDefaults>
        </settings>

        <column name="entity_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>desc</sorting>
            </settings>
        </column>

        <column name="email" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">Email</label>
            </settings>
        </column>

        <column name="coupon_code" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">Coupon Code</label>
            </settings>
        </column>

        <!-- Blank means the claim was made as a guest and the claimant has not
             signed in or registered since; Observer\LinkExitCouponClaimToCustomer
             fills it in when they do. -->
        <column name="customer_name" sortOrder="40">
            <settings>
                <filter>text</filter>
                <label translate="true">Customer</label>
            </settings>
        </column>

        <column name="customer_id" sortOrder="50">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Customer ID</label>
                <visible>false</visible>
            </settings>
        </column>

        <column name="product_sku" sortOrder="60">
            <settings>
                <filter>text</filter>
                <label translate="true">Claimed On (SKU)</label>
            </settings>
        </column>

        <!-- Our own flag, set by Observer\MarkExitCouponRedeemed at order
             placement. Shown next to times_used so a disagreement between the two
             is visible rather than hidden. -->
        <column name="is_redeemed" component="Magento_Ui/js/grid/columns/select" sortOrder="70">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Redeemed</label>
            </settings>
        </column>

        <!-- Magento's own counter on salesrule_coupon, joined in the collection.
             Authoritative for whether the code was actually used. -->
        <column name="times_used" sortOrder="80">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Times Used</label>
            </settings>
        </column>

        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="90">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Claimed At</label>
            </settings>
        </column>

        <column name="expires_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="100">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Expires At</label>
            </settings>
        </column>
    </columns>
</listing>
