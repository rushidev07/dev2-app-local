<script>
    (function () {
        'use strict';

        var panel = document.getElementById('ahy-two-color-swatch-panel');
        var uploadUrl = panel.dataset.uploadUrl;
        var mediaBaseUrl = panel.dataset.mediaBaseUrl;
        var container = document.querySelector('[data-role="ahy-two-color-swatch-container"]');
        var addButton = document.getElementById('ahy-two-color-add-swatch');
        var template = document.getElementById('ahy-two-color-new-row-template');
        var counter = 0;

        function closeAllSubmenus() {
            Array.prototype.forEach.call(
                document.querySelectorAll('.ahy-two-color-submenu'),
                function (menu) {
                    menu.style.display = 'none';
                }
            );
        }

        function isImagePath(value) {
            return value.charAt(0) === '/';
        }

        function renderFace(wrapper) {
            var face = wrapper.querySelector('.ahy-two-color-swatch-face');
            var value = wrapper.querySelector('.ahy-two-color-value').value;

            if (isImagePath(value)) {
                face.style.backgroundImage = 'url(\'' + mediaBaseUrl + value + '\')';
                face.style.backgroundSize = 'cover';
                face.style.backgroundPosition = 'center';
                face.style.backgroundColor = '';
            } else {
                face.style.backgroundImage = '';
                face.style.backgroundColor = value;
            }
        }

        function setValue(wrapper, value, onChange) {
            wrapper.querySelector('.ahy-two-color-value').value = value;
            renderFace(wrapper);
            onChange();
        }

        /**
         * Wires the swatch face / "Choose a color" / "Upload a file" /
         * "Clear" menu for one .ahy-two-color-swatch-wrapper. onChange fires
         * after any action changes the hidden value, so callers can also
         * re-sync a new row's combined hidden field.
         */
        function wireSwatchPicker(wrapper, onChange) {
            var face = wrapper.querySelector('.ahy-two-color-swatch-face');
            var colorInput = wrapper.querySelector('.ahy-two-color-color-input');
            var fileInput = wrapper.querySelector('.ahy-two-color-file-input');
            var submenu = wrapper.querySelector('.ahy-two-color-submenu');

            renderFace(wrapper);

            face.addEventListener('click', function (event) {
                event.stopPropagation();
                var isOpen = submenu.style.display === 'block';
                closeAllSubmenus();
                submenu.style.display = isOpen ? 'none' : 'block';
            });

            wrapper.querySelector('.ahy-two-color-choose-btn').addEventListener('click', function (event) {
                event.stopPropagation();
                submenu.style.display = 'none';
                var current = wrapper.querySelector('.ahy-two-color-value').value;
                if (!isImagePath(current)) {
                    colorInput.value = current;
                }
                colorInput.click();
            });

            wrapper.querySelector('.ahy-two-color-upload-btn').addEventListener('click', function (event) {
                event.stopPropagation();
                submenu.style.display = 'none';
                fileInput.click();
            });

            wrapper.querySelector('.ahy-two-color-clear-btn').addEventListener('click', function (event) {
                event.stopPropagation();
                submenu.style.display = 'none';
                setValue(wrapper, '#ffffff', onChange);
            });

            colorInput.addEventListener('input', function () {
                setValue(wrapper, colorInput.value, onChange);
            });

            fileInput.addEventListener('change', function () {
                var file = fileInput.files[0];
                if (!file) {
                    return;
                }

                var formData = new FormData();
                formData.append('datafile', file);
                formData.append('form_key', window.FORM_KEY);

                fetch(uploadUrl, {method: 'POST', body: formData, credentials: 'same-origin'})
                    .then(function (response) {
                        return response.json();
                    })
                    .then(function (result) {
                        fileInput.value = '';

                        if (result.error) {
                            alert(result.error); // eslint-disable-line no-alert
                            return;
                        }

                        var path = result.file_path || '';
                        if (path.charAt(0) !== '/') {
                            path = '/' + path;
                        }
                        setValue(wrapper, path, onChange);
                    })
                    .catch(function () {
                        fileInput.value = '';
                        alert('Upload failed.'); // eslint-disable-line no-alert
                    });
            });
        }

        function syncHiddenValue(row) {
            var first = row.querySelector('.ahy-two-color-first').value;
            var second = row.querySelector('.ahy-two-color-second').value;
            row.querySelector('.ahy-two-color-hidden').value = first + ',' + second;
        }

        document.addEventListener('click', closeAllSubmenus);

        // Existing rows: wire each already-rendered swatch picker.
        Array.prototype.forEach.call(
            container.querySelectorAll('.ahy-two-color-swatch-wrapper'),
            function (wrapper) {
                wireSwatchPicker(wrapper, function () {});
            }
        );

        addButton.addEventListener('click', function () {
            var key = 'ahy_new_' + (counter++);
            var html = template.innerHTML.split('__KEY__').join(key);
            var wrapperEl = document.createElement('tbody');
            wrapperEl.innerHTML = html.trim();
            var row = wrapperEl.firstElementChild;

            Array.prototype.forEach.call(
                row.querySelectorAll('.ahy-two-color-swatch-wrapper'),
                function (swatchWrapper) {
                    wireSwatchPicker(swatchWrapper, function () {
                        syncHiddenValue(row);
                    });
                }
            );
            row.querySelector('.ahy-two-color-remove-row').addEventListener('click', function () {
                row.parentNode.removeChild(row);
            });

            container.appendChild(row);
            syncHiddenValue(row);
        });
    })();
</script>
