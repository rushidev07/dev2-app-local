<style>
    /* Same reason as the native grid's #swatch-visual-options-panel rule -
     * without it, the absolutely-positioned popup menu below would get
     * clipped by this wrapper's default overflow. */
    #ahy-two-color-swatch-panel {
        overflow: visible;
    }
    .ahy-two-color-swatch-wrapper {
        display: inline-block;
        position: relative;
        margin-right: 34px;
    }
    /*
     * A native <input type="color"> draws its own swatch preview with
     * browser-specific internal padding, which breaks down (Firefox in
     * particular falls back to an empty box) once squeezed to a small
     * custom size. So the visible box is a plain span with its
     * background set directly - always renders identically everywhere,
     * and handles an image background too, which a color input never
     * could. The real <input type="color"> is only ever used transiently
     * (see the script below) so it's just hidden entirely, not overlaid.
     */
    .ahy-two-color-swatch-face {
        display: inline-block;
        position: relative;
        width: 25px;
        height: 24px;
        border: 1px solid #c6c5c3;
        /* visible, not hidden - :before/:after below extend outside this
         * box's bounds and would otherwise get clipped, same as
         * .swatch_window's own "overflow: visible !important" rule. */
        overflow: visible;
        vertical-align: middle;
        cursor: pointer;
    }
    /*
     * The outer bordered box joining the swatch to its arrow is two pseudo-
     * elements on Magento_Swatches' own .swatch_window, reused here
     * verbatim (same values) so this reads as one continuous control
     * instead of a loose color box floating next to a bare arrow character -
     * see .swatch_window/.swatch_window:before/.swatch_window:after in
     * vendor/magento/module-swatches/view/adminhtml/web/css/swatches.css.
     */
    .ahy-two-color-swatch-face:before {
        position: absolute;
        content: '';
        top: -4px;
        left: -4px;
        width: 27px;
        height: 26px;
        background: transparent;
        border-radius: 3px 0 0 3px;
        border: 3px solid #fff;
        z-index: 1;
        outline: 1px solid #adadad;
    }
    .ahy-two-color-swatch-face:after {
        position: absolute;
        content: '\2193';
        top: -5px;
        right: -22px;
        font-size: 19px;
        color: #808080;
        width: 16px;
        height: 32px;
        background: #fff;
        border-radius: 0 3px 3px 0;
        border: 1px solid #adadad;
        text-align: center;
        z-index: 8;
    }
    .ahy-two-color-color-input,
    .ahy-two-color-file-input {
        display: none;
    }
    /* Reuses Magento_Swatches' own popup classes (.swatch_sub-menu_container,
     * .swatch_row, .swatch_row_name), already loaded on this page by the
     * native "Manage Swatch" grid, so this menu matches it exactly. */
    .ahy-two-color-submenu {
        top: 100%;
        left: 0;
    }
</style>
