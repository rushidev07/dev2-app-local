                            <div class="plp-card-seller"
                                 x-text="product.brand ? 'Sold by ' + product.brand : 'Sold by The Everest Marketplace'"></div>

                            <div class="mt-2">
                                <template x-if="hasDiscount">
                                    <div>
                                        <div class="plp-mobile-price-grid">
                                            <div class="plp-mobile-caliber">
                                                <div class="plp-caliber-title">CaliberNation</div>
                                                <div class="plp-mobile-caliber-value">$0.00</div>
                                            </div>
                                            <div class="plp-mobile-normal">
