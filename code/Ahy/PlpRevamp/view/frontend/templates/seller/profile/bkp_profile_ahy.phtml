                            <a :href="product.url_key ? '/' + product.url_key + '.html' : '#'" class="block h-full">
                                <img :src="imgUrl(product.image)"
                                     :alt="product.name"
                                     class="w-full h-full object-contain p-3"
                                     :style="{ opacity: isFallbackImg(product.image) ? 0.45 : 1 }"
