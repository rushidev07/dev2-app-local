                                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#166534" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                                                </span>
                                                <span class="plp-caliber-save-text">MEMBERS SAVE $0.00<br>0% OFF MSRP</span>
                                            </div>
                                            <a class="plp-caliber-join" href="/caliber-nation">JOIN CALIBER ></a>
                                        </div>
                                        <div class="plp-normal-col">
                                            <template x-if="hasDiscount">
                                                <div>
                                                    <div class="plp-normal-title">Sale Price</div>
                                                    <div class="plp-normal-value" x-html="hyva.formatPrice(displayPrice)"></div>
                                                    <div class="plp-nonmember-wrap">
                                                        <span class="plp-nonmember-text">NON-MEMBERS SAVE <span class="plp-pct-inline" x-text="savingsPct + '%'"></span></span>
                                                        <span class="plp-nonmember-msrp"><span class="plp-pct-block" x-text="savingsPct + '% '"></span>OFF MSRP</span>
                                                    </div>
                                                    <div class="plp-msrp-line">
                                                        MSRP <span class="line-through" x-html="hyva.formatPrice(product.price)"></span>
                                                    </div>
                                                </div>
                                            </template>
                                            <template x-if="!hasDiscount && product.price">
                                                <div>
                                                    <div class="plp-normal-title">Price</div>
                                                    <div class="plp-normal-value" x-html="hyva.formatPrice(product.price)"></div>
                                                </div>
                                            </template>
                                            <template x-if="!product.price">
                                                <div>
                                                    <span class="plp-see-options-btn">See Options</span>
