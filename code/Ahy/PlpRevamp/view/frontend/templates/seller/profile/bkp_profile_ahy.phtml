                        </div>
                    </div>
                </template>
            </div>

            <!-- ── Pagination ───────────────────────────────────────────────── -->
            <div x-show="!loading && totalPages > 1" class="flex justify-center items-center gap-8 pt-10 pb-4">
                <button aria-label="Previous" :disabled="page <= 1"
                        @click="page > 1 && goToPage(page - 1)"
                        class="bg-white shadow-lg rounded-full w-12 h-12 flex items-center justify-center border border-gray-200"
                        :class="page <= 1 ? 'opacity-30 cursor-not-allowed' : 'hover:border-ahy-blue'">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                </button>

                <div x-data="{ open: false }" class="relative">
                    <button @click="open = !open" class="font-bold text-ahy-blue flex items-center gap-1">
                        Page <span x-text="page"></span> of <span x-text="totalPages"></span>
                        <svg class="w-4 h-4 ml-1 transition-transform" :class="open ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </button>
                    <nav x-show="open" @click.outside="open = false"
                         class="absolute bottom-8 left-1/2 -translate-x-1/2 bg-white border border-gray-200 rounded-xl shadow-lg z-20 w-36 max-h-52 overflow-auto py-1">
                        <template x-for="p in totalPages" :key="p">
                            <button class="w-full text-center px-4 py-2.5 text-sm hover:bg-gray-50"
                                    :class="p === page ? 'font-bold text-ahy-blue' : ''"
                                    @click="goToPage(p); open = false"
                                    x-text="'Page ' + p"></button>
                        </template>
                    </nav>
                </div>

                <button aria-label="Next" :disabled="page >= totalPages"
                        @click="page < totalPages && goToPage(page + 1)"
                        class="bg-white shadow-lg rounded-full w-12 h-12 flex items-center justify-center border border-gray-200"
                        :class="page >= totalPages ? 'opacity-30 cursor-not-allowed' : 'hover:border-ahy-blue'">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </button>
            </div>

        </div><!-- /products -->
    </div><!-- /main layout -->
</div>

<script>
document.addEventListener('alpine:init', () => {
    Alpine.data('ahySellerPLP', (collectionUrl, filtersUrl, searchToken, brandName, addToCartUrl) => ({
        results: [], filters: [], activeFilters: [],
        priceRange: { min: null, max: null },
        priceBuckets: [],
        activePriceMin: '', activePriceMax: '', activePriceRange: null, priceCollapsed: false,
        cartLoading: {}, wishLoading: {},
        total: 0, page: 1, pageSize: 18, totalPages: 1,
        sort: 'popularity', loading: true,

        async init() {
            console.log('%c[FalcoSense PLP][profile_ahy.phtml] build: scroll-fix-2026-08-14', 'color:#0d2f47;font-weight:bold;');
            const params = new URLSearchParams(window.location.search);
            this.page = parseInt(params.get('p') || '1', 10);
            await Promise.all([this.fetchFilters(), this.fetchProducts()]);
            // Landing directly on page 2+ (a reload, or a shared/bookmarked link)
            // would otherwise leave the shopper sitting above the banner/bio/tabs
            // content at the very top of the page — jump straight to the grid,
            // same target the pagination buttons scroll to.
            if (this.page > 1) {
                this.$nextTick(() => this._scrollToResults());
            }
        },

        async fetchFilters() {
            try {
                const url = new URL(filtersUrl);
                url.searchParams.set('search_token', searchToken);
                url.searchParams.set('brand', brandName);
                const res  = await fetch(url.toString());
                const json = await res.json();
                if (!json.success) return;
                const f = json.filters || {};
                if (f.price) {
                    this.priceRange   = { min: f.price.min, max: f.price.max };
                    this.priceBuckets = this.priceRangeBuckets();
                }
                const colorNames = ['color','colour','item color','hat color','optic color','optic laser color','colors','choose_color','color_'];
                const sizeNames  = ['size','clothing size','waist','inseam','boot_size','shoe_size','bag_sizes','sizes'];
                const toOpt = v => typeof v === 'object' ? { value: v.value, count: v.count } : { value: v, count: null };
                const facets = [];
                (f.attributes || []).forEach(attr => {
                    const nameLower = attr.name.toLowerCase();
                    let key, label;
                    if (colorNames.includes(nameLower))      { key = 'color'; label = 'Color'; }
                    else if (sizeNames.includes(nameLower))  { key = 'size';  label = 'Size';  }
                    else { key = 'attr:' + attr.name; label = attr.name; }
                    const existing = facets.find(fc => fc.key === key);
                    if (existing) {
                        attr.values.forEach(v => { const o = toOpt(v); if (!existing.options.some(x => x.value === o.value)) existing.options.push(o); });
                    } else {
                        facets.push({ key, label, collapsed: false, showAll: false, options: attr.values.map(toOpt) });
                    }
                });
                this.filters = facets;
            } catch(e) { console.error('[SellerPLP] filters error', e); }
        },

        async fetchProducts() {
            this.loading = true;
            try {
                const url = new URL(collectionUrl);
                url.searchParams.set('search_token', searchToken);
                url.searchParams.set('brand', brandName);
                url.searchParams.set('limit', this.pageSize);
                url.searchParams.set('offset', (this.page - 1) * this.pageSize);
                url.searchParams.set('sort', this.sort);
                if (this.activePriceMin !== '') url.searchParams.set('price_min', this.activePriceMin);
                if (this.activePriceMax !== '') url.searchParams.set('price_max', this.activePriceMax);
                this.activeFilters.forEach(f => {
                    if (f.key === 'category') url.searchParams.set('category', f.value);
                    else if (f.key === 'color') url.searchParams.set('color', f.value);
                    else if (f.key === 'size')  url.searchParams.set('size', f.value);
                    else url.searchParams.set(f.key, f.value);
                });
                const res  = await fetch(url.toString());
                const json = await res.json();
                if (json.success) {
                    this.results    = (json.products || []).map(p => ({ ...p, product_id: p.product_id || p.id }));
                    this.total      = json.total || 0;
                    this.totalPages = Math.max(1, Math.ceil(this.total / this.pageSize));
                }
            } catch(e) { console.error('[SellerPLP] products error', e); }
            finally { this.loading = false; }
        },

        sortedResults() { return this.results; },

        priceRangeBuckets() {
            if (this.priceRange.min === null) return [];
            const all = [
                { label: 'Under $50',     min: '',   max: 50   },
                { label: '$50 – $100',    min: 50,   max: 100  },
                { label: '$100 – $250',   min: 100,  max: 250  },
                { label: '$250 – $500',   min: 250,  max: 500  },
                { label: '$500 – $1,000', min: 500,  max: 1000 },
                { label: 'Over $1,000',   min: 1000, max: ''   },
            ];
            return all.filter(b => {
                const lo = b.min === '' ? 0 : b.min;
                const hi = b.max === '' ? Infinity : b.max;
                return lo < this.priceRange.max && hi > this.priceRange.min;
            });
        },
        // Drives the scroll animation ourselves via requestAnimationFrame instead
        // of window.scrollTo({behavior:'smooth'}). Safari's native smooth-scroll
        // can get interrupted/clipped when the page's scrollable height changes
        // mid-animation — which is exactly what happens here, since fetchProducts()
        // briefly hides the grid a frame after we start scrolling — leaving the
        // scroll stuck partway or not moving at all. Re-asserting the target
        // position every frame (rather than handing off to the browser once)
        // behaves identically across Safari, Chrome and Firefox.
        _animateScrollTo(targetY, duration = 500) {
            if (this._scrollAnimFrame) cancelAnimationFrame(this._scrollAnimFrame);
            const startY = window.scrollY;
            const distance = targetY - startY;
            if (Math.abs(distance) < 2) return;
            const startTime = performance.now();
            const easeInOutQuad = t => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);
            const step = (now) => {
                const progress = Math.min((now - startTime) / duration, 1);
                window.scrollTo(0, startY + distance * easeInOutQuad(progress));
                this._scrollAnimFrame = progress < 1 ? requestAnimationFrame(step) : null;
            };
            this._scrollAnimFrame = requestAnimationFrame(step);
        },

        _scrollToResults() {
            // .column.main wraps the ENTIRE page (banner, logo, tabs, about-us
            // text, AND the grid) — its top is basically the top of the page,
            // so scrolling there looks like nothing happened. #seller-results-layout
            // wraps just the filters + grid, further down past all the bio content.
            const el = document.querySelector('#seller-results-layout') || document.querySelector('.column.main');
            if (!el) return;
            const y = Math.max(0, el.getBoundingClientRect().top + window.pageYOffset);
            console.log('[FalcoSense PLP][profile_ahy.phtml] _scrollToResults: from', window.scrollY, 'to', y);
            this._animateScrollTo(y);
        },

        togglePriceRange(bucket) {
            if (this.activePriceRange && this.activePriceRange.label === bucket.label) {
                this.activePriceRange = null; this.activePriceMin = ''; this.activePriceMax = '';
            } else {
                this.activePriceRange = bucket;
                this.activePriceMin = bucket.min === '' ? '' : String(bucket.min);
                this.activePriceMax = bucket.max === '' ? '' : String(bucket.max);
            }
            this.page = 1; this._scrollToResults(); this.fetchProducts();
        },
        isFilterActive(key, value) { return this.activeFilters.some(f => f.key === key && f.value === value); },
        toggleFilter(key, label, value) {
            if (this.isFilterActive(key, value)) { this.removeFilter(key, value); return; }
            this.activeFilters.push({ key, label, value });
            this.page = 1; this._scrollToResults(); this.fetchProducts();
        },
        removeFilter(key, value) {
            this.activeFilters = this.activeFilters.filter(f => !(f.key === key && f.value === value));
            this.page = 1; this._scrollToResults(); this.fetchProducts();
        },
        clearPriceFilter() { this.activePriceMin = ''; this.activePriceMax = ''; this.activePriceRange = null; this.page = 1; this._scrollToResults(); this.fetchProducts(); },
        clearAllFilters() { this.activeFilters = []; this.activePriceMin = ''; this.activePriceMax = ''; this.activePriceRange = null; this.page = 1; this._scrollToResults(); this.fetchProducts(); },

        goToPage(p) {
            console.log('[FalcoSense PLP][profile_ahy.phtml] goToPage:', p, 'clicked at scrollY=', window.scrollY);
            this.page = p;
            const url = new URL(window.location.href);
            url.searchParams.set('p', p);
            history.replaceState(history.state, '', url);
            // Scroll from wherever the shopper clicked BEFORE fetchProducts() flips
            // loading=true and hides the grid — hiding it first collapses the page
            // height out from under the current (possibly deep) scroll position,
            // which the browser then clamps to fit, producing a visible snap toward
            // the footer before our smooth scroll corrects it. Scrolling first, and
            // letting one frame paint before the collapse, keeps the animation
            // starting from the actual click point.
            this.paginationLoading = true;
            this._scrollToResults();
            requestAnimationFrame(() => {
                this.fetchProducts().then(() => { this.paginationLoading = false; });
            });
        },
        setSort(s) { this.sort = s; this.page = 1; this.fetchProducts(); },
        sortLabel() {
            return { popularity: 'Relevance', price_asc: 'Price: Low to high', price_desc: 'Price: High to low' }[this.sort] || 'Relevance';
        },

        FREE_SHIPPING_SELLERS: ['The Everest Marketplace', 'The Everest Collection'],
        isFreeShipping(product) {
            return this.FREE_SHIPPING_SELLERS.includes(product.brand || 'The Everest Marketplace');
        },
        cleanName(name) {
            if (!name) return '';
            const d = document.createElement('textarea');
            d.innerHTML = name;
            return d.value;
        },

        FALLBACK_IMG: 'https://static.everest.com/media/.thumbswysiwyg/everest-logo_2_.png',
        isFallbackImg(image) {
            return this.imgUrl(image) === this.FALLBACK_IMG;
        },
        imgRelPath(image) {
            if (!image || image.includes('no_selection')) return '';
            if (image.startsWith('http')) {
                const fm = image.match(/\/falcosense\/[^/]+\/(?:.*\/)?([^/]+\/[^/]+\/[^/]+)$/);
                if (fm) return fm[1];
                const m = image.match(/\/catalog\/product\/(.+)$/);
                return m ? m[1] : '';
            }
            const filename = image.split('/').pop();
            if (filename && filename.length >= 2) {
                return filename[0] + '/' + filename[1] + '/' + filename;
            }
            return image.replace(/^\/+/, '');
        },
        imgUrl(image) {
            if (!image || image.includes('no_selection')) return this.FALLBACK_IMG;
            const rel = this.imgRelPath(image);
            if (!rel) return this.FALLBACK_IMG;
            return 'https://static.everest.com/media/falcosense/800x800/' + rel;
        },
        handleImgError(event) {
            const el = event.target;
            if (el.dataset.imgFailed) return;
            el.dataset.imgFailed = '1';
            if (el.src !== this.FALLBACK_IMG) el.src = this.FALLBACK_IMG;
            el.style.opacity = '0.45';
        },

        async addSimpleToCart(product) {
            const pid = product.product_id;
            this.cartLoading = { ...this.cartLoading, [pid]: true };
            try {
                const fd = new FormData();
                fd.append('product', pid); fd.append('qty', 1); fd.append('form_key', hyva.getFormKey());
                const resp = await fetch(addToCartUrl, { method: 'POST', body: fd });
                if (resp.ok || resp.redirected) {
                    window.dispatchEvent(new CustomEvent('reload-customer-section-data'));
                    window.dispatchEvent(new CustomEvent('toggle-cart'));
                    typeof window.dispatchMessages !== 'undefined' && window.dispatchMessages([{type: 'success', text: 'Product added to cart.'}], 3000);
                }
            } catch(e) { console.error('[SellerPLP] cart error', e); }
            finally { this.cartLoading = { ...this.cartLoading, [pid]: false }; }
        },

        async addToWishlist(product) {
            const pid = product.product_id;
            this.wishLoading = { ...this.wishLoading, [pid]: true };
            try {
                const resp = await fetch(window.BASE_URL + 'wishlist/index/add/', {
                    method: 'POST',
                    headers: { 'content-type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                    body: 'form_key=' + hyva.getFormKey() + '&product=' + pid + '&uenc=' + hyva.getUenc(),
                    credentials: 'include',
                });
                if (resp.redirected) { window.location.href = resp.url; return; }
                if (resp.ok) {
                    const data = await resp.json().catch(() => null);
                    const msg  = data && data.success ? 'Product added to Wish List.' : (data && data.error_message) || 'Could not add to wishlist.';
                    const type = data && data.success ? 'success' : 'error';
                    typeof window.dispatchMessages !== 'undefined' && window.dispatchMessages([{ type, text: msg }], 5000);
                    window.dispatchEvent(new CustomEvent('reload-customer-section-data'));
                }
            } catch(e) { console.error('[SellerPLP] wishlist error', e); }
            finally { this.wishLoading = { ...this.wishLoading, [pid]: false }; }
        },
    }));
});
</script>

