<?php
/** @var \Ahy\PlpRevamp\Block\Category\SubcategoryCards $block */

$currentCategory = $block->getCurrentCategory();

// Exit early — let normal layout handle the page if attribute not enabled
if (!$currentCategory->getData('ahy_use_subcategory_layout')) {
    return;
}

$childCategories  = $block->getChildrenCategories();
$featuredSourceId = $block->getFeaturedSourceId();

// Per-section switches. Each already implies the master switch (see the block).
$showSubcategoryCards = $block->isSubcategoryCardsEnabled();
$showFeaturedProducts = $block->isFeaturedProductsEnabled();
$showFeaturedBrands   = $block->isFeaturedBrandsEnabled();

// Admin-configurable cap on how many subcategory cards render. 0 = show all.
$subcategoryCardsLimit = $block->getSubcategoryCardsCount();
$renderedCardCount     = 0;

// The cards section needs children; Featured Products and Featured Brands do not.
// This used to be an early return, which meant a category with no subcategories
// rendered nothing at all even with both other sections configured.
$showSubcategoryCards = $showSubcategoryCards && $childCategories->count() > 0;

// Nothing switched on — leave the page to the normal layout.
if (!$showSubcategoryCards && !$showFeaturedProducts && !$showFeaturedBrands) {
    return;
}
// Admin-configurable settings with fallbacks
$featuredTitle       = $block->escapeHtml($block->getFeaturedTitle());
$featuredSubtitle    = $block->escapeHtml($block->getFeaturedSubtitle());
// Escaped, then newlines turned into <br> so paragraph breaks survive without
// letting raw HTML through.
$featuredDescription = $showFeaturedProducts
    ? nl2br($block->escapeHtml($block->getFeaturedDescription()))
    : '';
// $featuredSourceId = $block->getFeaturedSourceId();
// $mediaBaseUrl     = $block->getMediaBaseUrl();

// Only load the collection when the section will actually render — this runs a
// product query with a stock join, so it is not worth paying for when switched off.
$featuredProducts = $showFeaturedProducts
    ? $block->getFeaturedProducts()
    : null;
$mediaBaseUrl     = rtrim($block->getMediaBaseUrl(), '/');

$categoryUrl = $currentCategory->getUrl();

// Yotpo endpoint — same source used by product grid and Klevu PLP
$yotpoEndpoint          = $block->escapeUrl($block->getUrl('ahy_plprevamp/yotpo/bottomline'));
$featuredProductIdsJson = ($showFeaturedProducts && $featuredSourceId)
    ? /* @noEscape */ json_encode(array_map(fn($p) => (int)$p->getId(), $featuredProducts->getItems()))
    : '[]';
?>

<style>
