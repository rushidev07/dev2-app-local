    .ahy-brand-grid::-webkit-scrollbar        { height: 6px; }
    .ahy-brand-grid::-webkit-scrollbar-track  { background: transparent; }
    .ahy-brand-grid::-webkit-scrollbar-thumb  { background: #d4d4d8; border-radius: 99px; }
</style>

<div class="ahy-plp-revamp">

<?php if ($showSubcategoryCards): ?>
<!-- Sub-category cards -->
<div class="homepage-category-option container ahy-plp-padding ahy-plp-remove-padding-left-right">
    <ul role="list" class="ahy-subcat-grid mt-3 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 items-start justify-center gap-4 lg:grid-cols-4">
        <?php foreach ($childCategories as $child): ?>
            <?php
            // Skip the featured source category — not shown as a card
            if ($featuredSourceId && (int)$child->getId() === $featuredSourceId) {
                continue;
            }
            // Skip any child named 'Featured Products' — auto-hides even without source ID configured
            if (strtolower(trim($child->getName())) === 'featured products') {
                continue;
            }
            // Stop once the admin-configured card limit is reached (0 = show all)
            if ($subcategoryCardsLimit > 0 && $renderedCardCount >= $subcategoryCardsLimit) {
                break;
            }
            $renderedCardCount++;
            $name         = $block->escapeHtml($child->getName());
            $keywords     = $block->escapeHtml(trim((string)$child->getData('ahy_card_keywords')));
            $url          = $child->getUrl();
            $customImage  = $child->getData('ahy_card_image');
            if ($customImage) {
                // Stored value is /media/catalog/category/file.jpg — prepend web base URL
                $imageUrl = rtrim($block->getStoreBaseUrl(), '/') . '/' . ltrim($customImage, '/');
            } else {
                $imageUrl = $child->getImageUrl();
            }
            ?>
            <li class="mb-4">
                <a href="<?= $block->escapeUrl($url) ?>">
                    <div class="category-image-ahy"
                         style="aspect-ratio:360/315;overflow:hidden;background:#fff;display:flex;align-items:center;justify-content:center;">
                        <?php if ($imageUrl): ?>
                            <img loading="lazy"
                                 src="<?= $block->escapeUrl($imageUrl) ?>"
                                 alt="<?= $name ?>"
                                 class="w-full"
                                 width="360"
                                 height="315"
                                 style="width:100%;height:100%;object-fit:contain;" />
                        <?php else: ?>
                            <img src="<?= $block->escapeUrl($block->getFallbackImageUrl()) ?>"
                                 alt="Everest"
                                 class="ahy-fallback-img" />
                        <?php endif; ?>
                    </div>
                    <div class="category-name-ahy">
                        <h3 class="text-ahy-blue pt-5 font-bold capitalize ahy-subcat-card-name"
                            style="line-height:1.4rem;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:1.4rem;padding-bottom:2px;word-break:break-word;overflow-wrap:break-word;text-align:center;"><?= $name ?></h3>
                        <?php if ($keywords): ?>
                            <p class="ahy-card-keywords"
                               style="font-size:0.8rem;line-height:1.2rem;color:var(--plp-text-muted);margin:2px 0 0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;word-break:break-word;overflow-wrap:break-word;text-align:center;"><?= $keywords ?></p>
                        <?php endif; ?>
                    </div>
                </a>
            </li>
        <?php endforeach; ?>
    </ul>
</div>
<?php endif; // $showSubcategoryCards ?>

<?php if ($showFeaturedProducts && $featuredSourceId): ?>
<!-- Featured Products -->
<div class="container ahy-plp-padding">
    <div style="margin-bottom:var(--plp-gap);">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:var(--plp-card-pad);margin-bottom:6px;">
            <h2 class="ahy-section-title" style="font-size:1.5rem;font-weight:800;color:var(--plp-blue);text-transform:uppercase;letter-spacing:-0.02em;margin:0;">
                <?= $featuredTitle ?>
            </h2>
            <a href="<?= $block->escapeUrl($block->getSeeMoreUrl()) ?>"
               style="flex-shrink:0;font-size:0.75rem;font-weight:700;color:var(--plp-blue);text-transform:uppercase;letter-spacing:0.05em;border:2px solid var(--plp-blue);padding:6px 12px;white-space:nowrap;text-decoration:none;border-radius:99px;">
                SEE MORE
            </a>
        </div>
        <p style="font-size:0.85rem;color:var(--plp-text-muted);margin:0;"><?= $featuredSubtitle ?></p>
    </div>

    <div class="ahy-featured-grid"
         x-data="{}"
         x-init="$store.yotpoReviews && $store.yotpoReviews.fetch(<?= $featuredProductIdsJson ?>, '<?= $yotpoEndpoint ?>')"
         style="display:grid;grid-template-columns:repeat(2,1fr);gap:var(--plp-gap);">
        <?php foreach ($featuredProducts as $product): ?>
            <?php
            $productId    = (int)$product->getId();
            $productName  = $block->escapeHtml($product->getName());
            $productUrl   = $product->getProductUrl();
            $imagePath    = $product->getSmallImage();
            $hasImage     = $imagePath && $imagePath !== 'no_selection';
            $imageFullUrl = $hasImage ? 'https://www.everest.com/media/catalog/product' . $imagePath : '';
            $price        = (float)$product->getPrice();
            $specialPrice = (float)$product->getSpecialPrice();
            $displayPrice = ($specialPrice > 0 && $specialPrice < $price) ? $specialPrice : $price;

            $labelText  = $block->getProductLabelText((string)$product->getData('ahy_product_label'));
            $labelColor = (string)$product->getData('ahy_product_label_color');
            $labelBg    = $labelText ? $block->getLabelBgColor($labelColor) : '';
            ?>
            <a href="<?= $block->escapeUrl($productUrl) ?>" style="display:block;text-decoration:none;color:inherit;">
                <div style="position:relative;aspect-ratio:360/315;overflow:hidden;background:#ffffff;display:flex;align-items:center;justify-content:center;">
                    <?php if ($labelText): ?>
                        <span style="position:absolute;top:0;left:0;padding:4px var(--plp-card-pad);font-size:0.7rem;font-weight:700;text-transform:uppercase;color:#fff;background-color:<?= $block->escapeHtml($labelBg) ?>;z-index:1;line-height:1.4;margin-top: 0.5rem; margin-left: 0.5rem; border-radius: 5px;">
                            <?= $block->escapeHtml($labelText) ?>
                        </span>
                    <?php endif; ?>
                    <?php if ($hasImage): ?>
                    <?php $fallbackUrl = $mediaBaseUrl . '/catalog/product' . $imagePath; ?>
                    <img loading="lazy"
                         src="<?= $block->escapeUrl($imageFullUrl) ?>"
                         onerror="if(!this.dataset.fb){this.dataset.fb=1;this.src='<?= $block->escapeUrl($fallbackUrl) ?>'}"
                         alt="<?= $productName ?>"
                         width="360"
                         height="315"
                         style="width:100%;height:100%;object-fit:contain;" />
                    <?php else: ?>
                    <img src="<?= $block->escapeUrl($block->getFallbackImageUrl()) ?>"
                         alt="Everest"
                         class="ahy-fallback-img" />
                    <?php endif; ?>
                </div>
                <div style="padding:var(--plp-card-pad) 0;">
                    <p class="ahy-featured-name" style="font-size:0.9rem;font-weight:600;color:var(--plp-blue);margin:0 0 12px;line-height:1.3;overflow:hidden;display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;">
                        <?= $productName ?>
                    </p>
                    <div x-data="{ get _r(){ return $store.yotpoReviews ? $store.yotpoReviews.data['<?= $productId ?>'] : null } }"
                         style="display:flex;align-items:center;gap:4px;margin-bottom:4px;">
                        <div style="display:flex;gap:2px;">
                            <template x-for="i in [1,2,3,4,5]" :key="i">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                     :style="'fill:' + ((_r && _r.count > 0 && i <= Math.round(_r.score)) ? 'var(--plp-star)' : 'var(--plp-star-empty)')">
                                    <polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/>
                                </svg>
                            </template>
                        </div>
                        <span x-text="(_r && _r.count > 0) ? '(' + _r.count + ')' : '0'"
                              style="font-size:0.75rem;color:var(--plp-text-light);"></span>
                    </div>
                    <div style="display:flex;align-items:baseline;gap:6px;flex-wrap:wrap;">
                        <span style="font-size:1rem;font-weight:700;color:var(--plp-blue);">$<?= number_format($displayPrice, 2) ?></span>
                        <?php if ($specialPrice > 0 && $specialPrice < $price): ?>
                            <span style="font-size:0.8rem;color:var(--plp-text-light);text-decoration:line-through;font-weight:400;">$<?= number_format($price, 2) ?></span>
                        <?php endif; ?>
                    </div>
                </div>
            </a>
        <?php endforeach; ?>
    </div>

    <?php if ($featuredProducts->count() === 0): ?>
        <p style="color:var(--plp-text-muted);text-align:center;padding:32px 0;">No featured products found.</p>
    <?php endif; ?>

    <?php if ($featuredDescription !== ''): ?>
    <!-- Featured Products description — no divider, sits directly under the grid -->
    <div class="ahy-featured-description" x-data="{ expanded: false, clamped: false }" x-init="
        $nextTick(() => {
            const el = $refs.descText;
            const cs = getComputedStyle(el);
            let lh = parseFloat(cs.lineHeight);
            if (isNaN(lh)) lh = parseFloat(cs.fontSize) * 1.9;
            if (el.scrollHeight > lh * 2 + 2) {
                clamped = true;
            }
        })
    ">
        <p class="ahy-featured-description-text" :class="{ 'is-clamped': clamped && !expanded, 'is-expanded': expanded }" x-ref="descText"><?= /* @noEscape */ $featuredDescription ?></p>
        <span class="ahy-featured-description-more" x-show="clamped" @click="expanded = !expanded" x-text="expanded ? 'See less' : 'See more..'"></span>
    </div>
    <?php endif; ?>
</div>
<?php endif; // $showFeaturedProducts ?>
<?php
