            SEE ALL
        </a>
    </div>
    <ul role="list" class="ahy-brand-grid">
        <?php foreach ($featuredBrands as $brand): ?>
        <li>
            <a href="<?= $block->escapeUrl($brand['url']) ?>"
               style="display:inline-flex;align-items:center;justify-content:center;min-width:200px;padding: 1.2rem;border:none;background:#F4F4F5;text-decoration:none;font-size:0.9rem;font-weight:600;color:var(--plp-blue);text-align:center;white-space:nowrap;transition:background 0.15s;"
               onmouseover="this.style.background='#f0f4f7';"
               onmouseout="this.style.background='#F4F4F5';">
                <?= $block->escapeHtml($brand['label']) ?>
            </a>
        </li>
        <?php endforeach; ?>
    </ul>
</div>
<?php endif; // $featuredBrands ?>

