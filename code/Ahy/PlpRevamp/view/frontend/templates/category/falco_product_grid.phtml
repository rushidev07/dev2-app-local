            <!-- ==================== PAGINATION ==================== -->
            <div x-show="!loading && results.length > 0 && totalPages > 1" class="flex justify-center items-center gap-4 md:gap-8 pt-10 pb-4 px-2">
                <button aria-label="Previous" :disabled="page <= 1"
                        @click="page > 1 && goToPage(page - 1)"
                        class="bg-white shadow-lg rounded-full w-12 h-12 flex items-center justify-center border border-gray-200 flex-shrink-0"
                        :class="page <= 1 ? 'opacity-30 cursor-not-allowed' : 'hover:border-ahy-blue'">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                </button>

                <div x-data="{
                        open: false,
                        dropTop: 0,
                        dropLeft: 0,
                        toggle() {
                            const r = this.$refs.trigger.getBoundingClientRect();
                            this.dropTop  = r.bottom + 4;
                            this.dropLeft = r.left + r.width / 2;
                            this.open = !this.open;
                        }
                     }" class="relative flex-shrink-0">
                    <button x-ref="trigger" @click.stop="toggle()" class="font-bold text-ahy-blue flex items-center gap-1">
                        Page <span x-text="page"></span> of <span x-text="totalPages"></span>
                        <svg class="w-4 h-4 ml-1 transition-transform" :class="open ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </button>
                    <template x-teleport="body">
                        <nav x-show="open" @click.outside="open = false"
                             :style="`position:fixed;top:${dropTop}px;left:${dropLeft}px;transform:translateX(-50%);z-index:9999;`"
                             class="bg-white border border-gray-200 rounded-xl shadow-lg w-36 max-h-52 overflow-auto py-1">
