<script>
(function() {
    if (typeof window.fetchSwatchesPhpPlp !== 'undefined') return;
    var BASE = '<?= $escaper->escapeJs($block->getBaseUrl()) ?>';
    window.fetchSwatchesPhpPlp = async function(productId) {
        var id   = '_' + productId;
        var swatchEl   = document.getElementById('php_swatch_html'   + id);
        var priceEl    = document.getElementById('php_product_price'  + id);
        var galleryEl  = document.getElementById('php_swatch_gallery' + id);
        var atcWrapEl  = document.getElementById('php_atc_wrap'       + id);
        if (!swatchEl) return;
        swatchEl.innerHTML = '<div style="padding:16px;color:#666;">Loading options…</div>';
        try {
            var res  = await fetch(BASE + 'ahy_themecustomization/index/GetProductSwatchesDetails?product_id=' + productId + '&v=' + Date.now());
            var data = await res.json();
            if (data.success === true) {
                ['swatchesScriptContentDynamic','swatchesPriceScript','swatchesGalleryScript'].forEach(function(sid) {
                    var old = document.getElementById(sid); if (old) old.remove();
                });
                [['swatchesScriptContentDynamic', data.swatch_script],
                 ['swatchesPriceScript',          data.product_price_script],
                 ['swatchesGalleryScript',         data.product_swatch_gallery_script]
                ].forEach(function(pair) {
                    var s = document.createElement('script');
                    s.type = 'text/javascript'; s.id = pair[0]; s.innerHTML = pair[1];
                    document.body.appendChild(s);
                });
                swatchEl.innerHTML = data.swatch_html;
                if (priceEl)   priceEl.innerHTML   = data.product_price_html;
                // if (galleryEl) {
                //     galleryEl.innerHTML = data.product_swatch_gallery_html;
                //     var modifiedHtml = galleryEl.innerHTML.replace(/<div[^>]*\bclass\s*=\s*(['"])(?:(?!\1)[^>])*\border-1\s+w-full\s+md:w-5\/12\s+lg:w-1\/2\s+(?:(?!\1)[^>])*\1[^>]*>/gi, '<div>');
                //     galleryEl.innerHTML = modifiedHtml;
                //     var mm = document.getElementById('meet-marcus'); if (mm) mm.remove();
                // }
                if (galleryEl) {
                        galleryEl.innerHTML = data.product_swatch_gallery_html;
                        // Remove width/padding constraints from gallery wrapper — class varies by Hyvä version
                        // (was "border-1 w-full md:w-5/12 lg:w-1/2", now "order-1 w-full md:w-3/5 md:h-auto md:pl-2 md:pr-6")
                        var gw = galleryEl.querySelector('div[class*="md:w-"]');
                        if (gw) {
                            gw.className = gw.className
                                .replace(/\bmd:w-\S+/g, '')
                                .replace(/\bmd:h-\S+/g, '')
                                .replace(/\bmd:p[lr]-\S+/g, '');
                        }
                        var mm = document.getElementById('meet-marcus'); if (mm) mm.remove();
                    }
                if (atcWrapEl) atcWrapEl.style.display = 'block';
            } else {
                swatchEl.innerHTML = data.message || 'Unable to load options.';
            }
        } catch(e) {
            console.error('fetchSwatchesPhpPlp', e);
            swatchEl.innerHTML = 'Error loading options.';
        }
    };
})();
</script>

<script>
/*
 * CaliberNation member prices for the PHP PLP.
 *
 * Fetched client-side rather than rendered in PHP so full page cache can keep
 * serving this grid. Only products that resolve a member discount come back, so
 * a missing key is the "no member price" signal the cards use (x-show="_cp") to
 * hide the CaliberNation column.
 */
document.addEventListener('alpine:init', function() {
    if (Alpine.store('ahyCaliberPrices')) return;
    Alpine.store('ahyCaliberPrices', {
        data: {},
        enabled: false,
        isMember: false,
        fetch: async function(ids, baseUrl) {
            if (!ids || !ids.length) return;
            var self = this;
            self.data = {};
            // The endpoint caps a request at 50 ids; chunk so a long page never
            // silently loses the tail of its grid.
            for (var i = 0; i < ids.length; i += 50) {
                var chunk = ids.slice(i, i + 50);
                try {
                    var r = await fetch(baseUrl + '?ids=' + chunk.join(','), { credentials: 'include' });
                    if (!r.ok) continue;
                    var json = await r.json();
                    if (!json.pricing_enabled) return;
                    self.enabled  = true;
                    self.isMember = !!json.is_member;
                    self.data = Object.assign({}, self.data, json.prices || {});
                } catch (e) {
                    console.error('[CaliberNation] price fetch error', e);
                }
            }
        }
    });
});
</script>

