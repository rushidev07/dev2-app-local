                                        <div style="background:#dcfce7;padding:5px 7px;margin-top:6px;display:flex;align-items:flex-start;gap:5px;border-radius:6px;">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#166534" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:1px;"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                                            <span style="font-size:0.6rem;color:#166534;font-weight:600;line-height:1.3;">MEMBERS SAVE $0.00<br>0% OFF MSRP</span>
                                        </div>
                                        <a href="/caliber-nation" style="font-size:0.65rem;font-weight:700;color:#dc2626;text-decoration:none;display:flex;justify-content:center;align-items:center;gap:3px;margin-top:8px;text-transform:uppercase;letter-spacing:0.04em;width:100%;">
                                            JOIN CALIBER
                                            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
                                        </a>
                                    </div>

                                    <!-- Normal price col -->
                                    <div class="normal-price-col">
                                        <?php if (!$isInStock): ?>
                                            <div style="font-weight:700;color:#dc2626;font-size:0.9rem;">Out of Stock</div>
                                        <?php else: ?>
                                            <div style="font-size:0.65rem;font-weight:700;color:#12334b;letter-spacing:0.04em;margin-bottom:4px;">
                                                <?= $hasDisc ? 'Sale Price' : ($isSimple ? 'Price' : 'From') ?>
                                            </div>
                                            <div style="font-size:1.4rem;font-weight:800;color:#12334b;"
                                                 x-html="hyva.formatPrice(<?= $dispPrice ?>)">
                                                $<?= number_format($dispPrice, 2) ?>
                                            </div>
                                            <?php if ($hasDisc): ?>
                                            <div style="background:#D30100;padding:4px 6px;margin-top:6px;display:inline-block;border-radius:6px;">
                                                <span style="font-size:0.6rem;color:#ffffff;font-weight:600;">NON-MEMBERS SAVE <?= $savingsPct ?>% OFF MSRP</span>
                                            </div>
                                            <div style="font-size:0.75rem;color:#6b7280;margin-top:6px;">
                                                MSRP <span style="text-decoration:line-through;"
                                                            x-html="hyva.formatPrice(<?= $origPrice ?>)">
                                                    $<?= number_format($origPrice, 2) ?>
                                                </span>
                                            </div>
                                            <?php endif; ?>
                                        <?php endif; ?>
                                    </div>

                                </div>
                            </div>

                            <!-- Add to Cart + mobile wishlist -->
                            <div class="kuProdAdditional !static !visible !inset-0 !w-full !border-0 !bg-transparent ahy-atc-wrap" style="margin-top:auto;padding-top:10px;">
                                <div class="!static kuProdAdditionalData" style="padding:0 16px 16px;">
                                    <div class="flex gap-2 items-center">

                                        <?php if (!$isInStock): ?>
                                            <!-- Out of stock -->
                                            <div style="flex:1;min-width:0;">
                                                <a href="<?= $productUrl ?>"
                                                   class="capitalize kuBtnDark !flex justify-center items-center w-full !rounded-full !text-white !text-sm !py-1.5 !px-2.5 font-bold !border-0"
                                                   style="background-color:#0d2f47;text-decoration:none;">
                                                    <span class="!text-sm px-2 font-bold">Details</span>
                                                </a>
                                            </div>

                                        <?php elseif (!$isSimple): ?>
                                            <!-- Configurable/grouped: Options -->
                                            <div style="flex:1;min-width:0;">
                                                <a href="<?= $productUrl ?>"
                                                   class="capitalize kuBtnDark !flex justify-center items-center w-full !rounded-full !text-white !text-sm !py-1.5 !px-2.5 font-bold !border-0"
                                                   style="background-color:#0d2f47;text-decoration:none;">
                                                    <span class="!text-sm px-2 font-bold">Options</span>
                                                </a>
                                            </div>

                                        <?php else: ?>
                                            <!-- Simple in stock: Add to Cart -->
                                                                                        <div style="flex:1;min-width:0;"
                                                 x-data="{ loading: false }"
                                                 @click.prevent="
                                                    if (loading) return;
                                                    loading = true;
                                                    const fd = new FormData();
                                                    fd.append('product', '<?= $productId ?>');
                                                    fd.append('qty', '1');
                                                    fd.append('form_key', hyva.getFormKey());
                                                    fetch('<?= $atcUrl ?>', {
                                                        method: 'POST',
                                                        body: new URLSearchParams(fd),
                                                        headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8', 'X-Requested-With': 'XMLHttpRequest' }
                                                    })
                                                    .then(res => res.ok ? res.json().catch(() => ({})) : {})
                                                    .then(() => {
                                                        window.dispatchEvent(new CustomEvent('product-addtocart-success'));
                                                        window.dispatchEvent(new CustomEvent('reload-customer-section-data'));
                                                    })
                                                    .catch(() => window.dispatchEvent(new CustomEvent('product-addtocart-error')))
                                                    .finally(() => {
                                                        setTimeout(() => {
                                                            loading = false;
                                                            window.dispatchEvent(new CustomEvent('toggle-cart'));
                                                        }, 800);
                                                    });
                                                 ">
                                                <button type="button"
                                                        :disabled="loading"
                                                        class="capitalize kuBtnDark !flex justify-center items-center w-full !rounded-full !text-white !text-sm !py-1.5 !px-2.5 font-bold !border-0"
                                                        style="background-color:#0d2f47;cursor:pointer;position:relative;">
                                                    <template x-if="loading">
                                                        <span class="absolute inset-0 flex justify-center items-center">
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 128 128">
                                                                <g>
                                                                    <circle cx="16" cy="64" r="4" fill="#fff"/>
                                                                    <circle cx="16" cy="64" r="8" fill="#fff" transform="rotate(45 64 64)"/>
                                                                    <circle cx="16" cy="64" r="12" fill="#fff" transform="rotate(90 64 64)"/>
                                                                    <circle cx="16" cy="64" r="16" fill="#fff" transform="rotate(135 64 64)"/>
                                                                    <animateTransform attributeName="transform" type="rotate" values="45 64 64;90 64 64;135 64 64;180 64 64;225 64 64;270 64 64;315 64 64;0 64 64" calcMode="discrete" dur="960ms" repeatCount="indefinite"/>
                                                                </g>
                                                            </svg>
                                                        </span>
                                                    </template>
                                                    <span :style="loading ? 'visibility:hidden' : ''" class="flex items-center gap-1">
                                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 lg:ml-2" viewBox="0 0 30.61 25.71">
                                                            <polyline fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" points="0.75 0.75 5.51 0.75 10.82 15.88 25.24 15.88 29.86 3.3 10.84 3.3"/>
                                                            <circle fill="none" stroke="#ffffff" stroke-width="2.5" stroke-miterlimit="10" cx="11.98" cy="22.46" r="2.5"/>
                                                            <circle fill="none" stroke="#ffffff" stroke-width="2.5" stroke-miterlimit="10" cx="24.48" cy="22.46" r="2.5"/>
                                                        </svg>
                                                        <span class="!text-sm px-2 font-bold">Add to Cart</span>
                                                    </span>
                                                </button>
                                            </div>
                                        <?php endif; ?>

                                        <!-- Mobile wishlist -->
                                        <button x-data="initWishlist()"
                                                @click.prevent="addToWishlist(<?= $productId ?>)"
                                                aria-label="Add to Wish List"
                                                type="button"
                                                class="rounded-full w-9 h-9 md:hidden ring-1 ring-gray-300 bg-white p-0 border-0 inline-flex shrink-0 items-center justify-center text-gray-500 hover:text-red-600">
                                            <svg class="w-5 h-5" data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 15.91 20">
                                                <path style="fill:#0d2f47;" d="M14.41,1.5v16L9.27,12.71a1.62,1.62,0,0,0-2.19,0L1.5,17.58V1.5H14.41M14.76,0H1.15A1.16,1.16,0,0,0,0,1.15v18.1a.74.74,0,0,0,1.24.56l6.83-6a.12.12,0,0,1,.18,0l6.38,5.9a.74.74,0,0,0,.52.21.76.74,0,0,0,.76-.77v-18A1.15,1.15,0,0,0,14.76,0Z"/>
                                            </svg>
                                        </button>

                                    </div>
                                </div>
                            </div>

                        </footer>
                    </div>
                </li>
                <?php endforeach; ?>
            </ul>
        </div>

        <!-- Pagination — matches Klevu kuPagination style -->
        <?php if ($totalPages > 1): ?>
        <div class="kuPagination" style="display:flex;justify-content:center;align-items:center;gap:32px;padding:32px 0;">

            <!-- Prev arrow -->
            <?php if ($curPage > 1): ?>
            <a href="<?= $escaper->escapeUrl($block->getPagerUrl($curPage - 1)) ?>" style="text-decoration:none;">
                <button aria-label="Previous" style="background:#fff;border:none;box-shadow:0 4px 16px rgba(0,0,0,0.12);border-radius:9999px;width:48px;height:48px;display:flex;align-items:center;justify-content:center;cursor:pointer;">
                    <img src="/media/icons/arrow-nav.svg" class="w-6" style="width:24px;transform:rotate(90deg);margin-right:2px;" alt="Previous">
                </button>
            </a>
            <?php else: ?>
            <button aria-label="Previous" disabled style="background:#fff;border:none;box-shadow:0 4px 16px rgba(0,0,0,0.12);border-radius:9999px;width:48px;height:48px;display:flex;align-items:center;justify-content:center;opacity:0.3;cursor:not-allowed;">
                <img src="/media/icons/arrow-nav.svg" style="width:24px;transform:rotate(90deg);margin-right:2px;" alt="Previous">
            </button>
            <?php endif; ?>

            <!-- Page X of Y dropdown -->
            <div x-data="{ open: false }" style="position:relative;display:inline-block;">
                <a href="javascript:void(0)"
                   @click.prevent="open = !open"
                   style="display:flex;align-items:center;gap:6px;color:#0d2f47;text-decoration:none;">
                    <button type="button" style="display:flex;align-items:center;font-weight:700;color:#0d2f47;background:none;border:none;cursor:pointer;font-size:0.9rem;gap:6px;">
                        <span>Page <?= (int)$curPage ?> of <?= (int)$totalPages ?></span>
                        <span :class="{ 'rotate-180': open }"
                              style="display:inline-block;width:20px;height:20px;background-image:url('/media/icons/arrow-nav.svg');background-size:contain;background-repeat:no-repeat;background-position:center;transition:transform 0.2s;margin-left:4px;"></span>
                    </button>
                </a>

                <!-- SVG arrow indicator -->
                <svg x-show="open" style="position:absolute;left:50%;transform:translateX(-50%);top:28px;width:40px;height:24px;color:#0d2f47;fill:currentColor;stroke:currentColor;z-index:10;" width="8" height="8">
                    <rect x="14" y="-10" width="35" height="35" transform="rotate(45)"/>
                </svg>

                <!-- Page dropdown list -->
                <nav x-show="open"
                     @click.outside="open = false"
                     style="position:absolute;left:50%;transform:translateX(-50%);top:44px;z-index:20;width:160px;background:#fff;border-top:2px solid #0d2f47;border-radius:2px;box-shadow:0 4px 16px rgba(13,47,71,0.15);max-height:208px;overflow-y:auto;padding:16px;">
                    <?php for ($pg = 1; $pg <= $totalPages; $pg++): ?>
                    <div style="display:flex;padding:12px 0;border-bottom:1px solid #e5e7eb;">
                        <a href="<?= $escaper->escapeUrl($block->getPagerUrl($pg)) ?>"
                           @click="open = false"
                           style="color:#0d2f47;text-decoration:none;font-weight:<?= $pg === $curPage ? '700' : '400' ?>;">
                            Page <?= (int)$pg ?>
                        </a>
                    </div>
                    <?php endfor; ?>
                </nav>
            </div>

            <!-- Next arrow -->
            <?php if ($curPage < $totalPages): ?>
            <a href="<?= $escaper->escapeUrl($block->getPagerUrl($curPage + 1)) ?>" style="text-decoration:none;">
                <button aria-label="Next" style="background:#fff;border:none;box-shadow:0 4px 16px rgba(0,0,0,0.12);border-radius:9999px;width:48px;height:48px;display:flex;align-items:center;justify-content:center;cursor:pointer;">
                    <img src="/media/icons/arrow-nav.svg" style="width:24px;transform:rotate(270deg);margin-left:2px;" alt="Next">
                </button>
            </a>
            <?php else: ?>
            <button aria-label="Next" disabled style="background:#fff;border:none;box-shadow:0 4px 16px rgba(0,0,0,0.12);border-radius:9999px;width:48px;height:48px;display:flex;align-items:center;justify-content:center;opacity:0.3;cursor:not-allowed;">
                <img src="/media/icons/arrow-nav.svg" style="width:24px;transform:rotate(270deg);margin-left:2px;" alt="Next">
            </button>
            <?php endif; ?>

        </div>
        <?php endif; ?>

    </div><!-- end right col -->
</div><!-- end ahy-php-plp -->

<style>
/* Grid columns */
.ahy-php-plp .kuResults ul li { width: 33.33%; }

/* Price section — narrower cards due to sidebar, reduce padding vs Klevu */
.ahy-php-plp .ahy-price-section { padding: 10px 12px 0 !important; }
.ahy-php-plp .ahy-price-grid { display: grid !important; grid-template-columns: 1fr 1fr !important; gap: 12px !important; background-image: linear-gradient(#e5e7eb, #e5e7eb); background-size: 1px 100%; background-position: center; background-repeat: no-repeat; }
.ahy-php-plp .ahy-price-grid .caliber-nation-price-col { border-right: none !important; }
.ahy-php-plp .ahy-price-grid > div { min-width: 0; }

/* Tablet ≤1100px: 2-col cards */
@media (max-width: 1100px) {
    .ahy-php-plp .kuResults ul li { width: 50%; }
}

/* Mobile ≤767px: sidebar stacks above, 1-col cards, vertical card layout — mirrors catnav-styles.css mobile rules */
@media (max-width: 767px) {
    .ahy-php-plp { flex-direction: column !important; }
    .ahy-php-plp-sidebar { width: 100% !important; max-width: 100% !important; }
    .ahy-php-plp .kuResults ul li { width: 100% !important; }
    .ahy-php-plp .kuProdWrap { display: flex !important; flex-direction: column !important; align-items: stretch !important; }
    .ahy-php-plp .kuProdWrap > footer[ku-block] { display: flex !important; flex-direction: column !important; flex: 1 !important; min-width: 0 !important; }
    .ahy-php-plp .klevuImgWrap { height: 160px !important; }
    .ahy-php-plp .ahy-price-section { padding: 8px 26px 0 !important; margin-bottom: 20px !important; }
}
@media (max-width: 767px) and (min-width: 480px) {
    .ahy-php-plp .klevuImgWrap { height: 200px !important; }
}
@media (max-width: 767px) and (min-width: 640px) {
    .ahy-php-plp .klevuImgWrap { height: 240px !important; }
}

/* Very small screens ≤480px: 1-col cards */
@media (max-width: 480px) {
    .ahy-php-plp .kuResults ul li { width: 100%; }
}

/* Pagination dropdown scrollbar — matches Klevu .ahy-swipeable */
.ahy-php-plp .kuPagination nav {
    scrollbar-width: thin;
    scrollbar-color: #0d2f47 #efeadd;
    filter: drop-shadow(0px 0 11px rgba(13,47,71,0.5));
}
.ahy-php-plp .kuPagination nav::-webkit-scrollbar {
    width: 5px;
    background-color: #efeadd;
    border-radius: 17px;
}
.ahy-php-plp .kuPagination nav::-webkit-scrollbar-thumb {
    background-color: #0d2f47;
    border-radius: 17px;
}
</style>
<script>
(function() {
    function ahyAjaxFilter(url) {
        var container = document.getElementById('ahy-php-plp-container');
        if (!container) { window.location.href = url; return; }
        container.style.opacity = '0.4';
        container.style.pointerEvents = 'none';
        window.history.pushState({ ahyFilter: true }, '', url);
        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function(r) { return r.text(); })
            .then(function(html) {
                var parser = new DOMParser();
                var doc = parser.parseFromString(html, 'text/html');
                var newContainer = doc.getElementById('ahy-php-plp-container');
                if (!newContainer) { window.location.href = url; return; }
                var fresh = document.createElement('div');
                fresh.id = 'ahy-php-plp-container';
                fresh.className = container.className;
                fresh.setAttribute('style', newContainer.getAttribute('style') || '');
                fresh.innerHTML = newContainer.innerHTML;
                container.parentNode.replaceChild(fresh, container);
            })
            .catch(function() { window.location.href = url; });
    }
    window.ahyAjaxFilter = ahyAjaxFilter;

    document.addEventListener('click', function(e) {
        var link = e.target.closest('#ahy-php-plp-container a[href]');
        if (!link) return;
        var href = link.getAttribute('href');
        if (!href || href === '#' || href.startsWith('javascript:')) return;
        // Only intercept filter sidebar and pagination — let product card links navigate normally
        var inSidebar = e.target.closest('.ahy-php-plp-sidebar');
        var inPagination = e.target.closest('.kuPagination');
        if (!inSidebar && !inPagination) return;
        e.preventDefault();
        ahyAjaxFilter(href);
    });

    window.addEventListener('popstate', function() {
        ahyAjaxFilter(window.location.href);
    });
})();
</script>
