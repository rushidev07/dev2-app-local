<script>
    'use strict';
    function initResultsSearch() {
        return {
            search() {
                // The theme's header form declares x-ref="form" (see
                // Magento_Theme::html/header/search-form.phtml), not "searchForm".
                // Because that form is @submit.prevent, a bad ref meant .submit()
                // threw and the results page never navigated on a new search.
                // Resolve defensively so this works whichever ref is present.
                var f = this.$refs.form || this.$refs.searchForm
                        || (this.$el && this.$el.closest('form'))
                        || document.getElementById('search_mini_form');
                if (f) { f.submit(); } else { console.error('[AHY PLP] search form not found'); }
            }
        }
    }
    var YOTPO_ENDPOINT   = '<?= $yotpoEndpoint ?>';
    var CALIBER_ENDPOINT = '<?= $caliberEndpoint ?>';
    var SELLER_ENDPOINT  = '<?= $sellerEndpoint ?>';
</script>

