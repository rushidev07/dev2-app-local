<?php
/** @var \Magento\Framework\Escaper $escaper */
$klevuYotpoEndpoint   = $escaper->escapeUrl($block->getUrl('ahy_plprevamp/yotpo/bottomline'));
$klevuCaliberEndpoint = $escaper->escapeUrl($block->getUrl('caliber-nation/pricing/memberprice'));
?>
<script>
(function() {
    var YOTPO_ENDPOINT   = '<?= $klevuYotpoEndpoint ?>';
    var CALIBER_ENDPOINT = '<?= $klevuCaliberEndpoint ?>';

    /*
     * CaliberNation member prices for Klevu-rendered cards.
     *
     * Klevu builds its cards client-side, so there is no PHP render pass to price
     * them in. The store holds only the products the endpoint actually returned a
     * member price for — a missing key is the "no member price" signal the card
     * markup uses (x-show="_cp") to hide the CaliberNation column entirely.
     *
     * Registered inline rather than via a layout <script src> because the Klevu
     * handles do not load yotpo-store.js, which is why $store.yotpoReviews is
     * absent on these pages. Keeping this self-contained avoids that trap.
     */
    function registerCaliberStore() {
        if (!window.Alpine || Alpine.store('ahyCaliberPrices')) return;
        Alpine.store('ahyCaliberPrices', {
            data: {},
            requested: {},
            enabled: false,
            isMember: false,
            fetch: async function(ids) {
                var self = this;
                var newIds = (ids || []).filter(function(id) { return id && !(String(id) in self.requested); });
                if (!newIds.length) return;
                newIds.forEach(function(id) { self.requested[String(id)] = true; });
                // The endpoint caps a request at 50 ids; send in chunks so a long
                // page never silently loses the tail of its grid.
                for (var i = 0; i < newIds.length; i += 50) {
                    var chunk = newIds.slice(i, i + 50);
                    try {
                        var r = await fetch(CALIBER_ENDPOINT + '?ids=' + chunk.join(','), { credentials: 'include' });
                        if (!r.ok) continue;
                        var json = await r.json();
                        if (!json.pricing_enabled) return;
                        self.enabled  = true;
                        self.isMember = !!json.is_member;
                        self.data = Object.assign({}, self.data, json.prices || {});
                    } catch (e) {
                        console.error('[CaliberNation] price fetch error', e);
                    }
                }
            }
        });
    }
    if (window.Alpine) { registerCaliberStore(); }
    document.addEventListener('alpine:init', registerCaliberStore);

    // MutationObserver: detect when Klevu renders product cards, then batch-fetch Yotpo
    var fetchTimer = null;
    var observer = new MutationObserver(function() {
        clearTimeout(fetchTimer);
        fetchTimer = setTimeout(function() {
            var cards = document.querySelectorAll('[ku-product-block][data-id]');
            var ids = [];
            cards.forEach(function(c) {
                var id = c.getAttribute('data-id');
                if (id) ids.push(id);
            });
            if (ids.length && window.Alpine && Alpine.store('yotpoReviews')) {
                Alpine.store('yotpoReviews').fetch(ids, YOTPO_ENDPOINT);
            }
            if (ids.length && window.Alpine && Alpine.store('ahyCaliberPrices')) {
                Alpine.store('ahyCaliberPrices').fetch(ids);
            }
        }, 200);
    });

    document.addEventListener('DOMContentLoaded', function() {
        observer.observe(document.body, { childList: true, subtree: true });
    });
})();
</script>

