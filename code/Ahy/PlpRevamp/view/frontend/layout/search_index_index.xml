<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Ahy_PlpRevamp::css/catnav-styles.css"/>
    </head>
    <body>
        <!-- Marker: proves whether the 'search_index_index' handle is active on a given URL. -->
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Text" name="ahy_marker_search_index_index">
                <arguments>
                    <argument name="text" xsi:type="string">&lt;script&gt;console.log('%c[AHY LAYOUT]%c handle fired: search_index_index','background:#7c3aed;color:#fff;padding:2px 6px;border-radius:3px;font-weight:700','');window.AHY_LAYOUT_HANDLES=(window.AHY_LAYOUT_HANDLES||[]).concat('search_index_index');&lt;/script&gt;&lt;!-- AHY-ACTIVE-HANDLE: search_index_index --&gt;</argument>
                </arguments>
            </block>
        </referenceContainer>

        <!-- Kill FalcoSense grid. Present in ALL four files so it fires from whichever handle owns the block. -->
        <referenceBlock name="ahy_smartsearch_search" remove="true"/>

        <referenceContainer name="content">
            <block class="FalcoSense\Search\Block\Search"
                   name="ahy_plprevamp_search_grid"
                   template="Ahy_PlpRevamp::search/falco_search_grid.phtml"
                   cacheable="false"
                   before="-"/>
        </referenceContainer>

        <!--
            Remove ThemeCustomization search blocks whose templates were moved to Ahy_PlpRevamp.
            Re-register them pointing to Ahy_PlpRevamp::klevu/ templates.
        -->

        <!-- Remove old ThemeCustomization blocks -->
        <referenceBlock name="ahy_themecustomization.klevu.search_results_page_template" remove="true"/>
        <referenceBlock name="ahy_themecustomization.serac.result.template.product.block" remove="true"/>
        <referenceBlock name="ahy_themecustomization.search.result.landing.template.product.card.block" remove="true"/>
        <referenceBlock name="ahy_themecustomization.landing.klevu.landing.template.results.block" remove="true"/>
        <referenceBlock name="ahy_themecustomization.landing.klevu.landing.template.sort.by.block" remove="true"/>
        <referenceBlock name="ahy_themecustomization.landing.ku.filter.tags.template.block" remove="true"/>
        <referenceBlock name="ahy_themecustomization.landing.klevu.landing.template.results.heading.title.block" remove="true"/>
        <referenceBlock name="ahy_themecustomization.landing.filters" remove="true"/>
        <referenceBlock name="ahy_themecustomization.landing.pagination" remove="true"/>

        <!-- Re-add blocks pointing to Ahy_PlpRevamp templates -->
        <referenceBlock name="head.additional">

            <block class="Klevu\FrontendJs\Block\Template" after="klevu_frontendjs.js_init" before="klevu_frontendjs.js_includes" name="ahy_plprevamp.search.klevu_landing_template" template="Ahy_PlpRevamp::klevu/klevu_landing_template.phtml">
                <arguments>
                    <argument name="is_enabled_conditions_fqcn" xsi:type="array">
                        <item name="klevu_search_themev2" xsi:type="string">Klevu\Search\Service\ThemeV2\IsEnabledCondition</item>
                    </argument>
                </arguments>
            </block>

            <block class="Klevu\FrontendJs\Block\Template" after="klevu_frontendjs.js_init" before="klevu_frontendjs.js_includes" name="ahy_plprevamp.search.product.block" template="Ahy_PlpRevamp::klevu/klevu_landing_template_product_block.phtml">
                <arguments>
                    <argument name="is_enabled_conditions_fqcn" xsi:type="array">
                        <item name="klevu_catnav_themev2" xsi:type="string">Klevu\Categorynavigation\Service\ThemeV2\IsEnabledCondition</item>
                    </argument>
                </arguments>
            </block>

            <block class="Klevu\FrontendJs\Block\Template" after="klevu_frontendjs.js_init" before="klevu_frontendjs.js_includes" name="ahy_plprevamp.search.product.card.block" template="Ahy_PlpRevamp::klevu/landing_page_product_addToCart.phtml">
                <arguments>
                    <argument name="is_enabled_conditions_fqcn" xsi:type="array">
                        <item name="klevu_search_themev2" xsi:type="string">Klevu\Search\Service\ThemeV2\IsEnabledCondition</item>
                    </argument>
                </arguments>
            </block>

            <block class="Klevu\FrontendJs\Block\Template" after="klevu_frontendjs.js_init" before="klevu_frontendjs.js_includes" name="ahy_plprevamp.search.results.block" template="Ahy_PlpRevamp::klevu/klevu_landing_template_results.phtml">
                <arguments>
                    <argument name="is_enabled_conditions_fqcn" xsi:type="array">
                        <item name="klevu_catnav_themev2" xsi:type="string">Klevu\Categorynavigation\Service\ThemeV2\IsEnabledCondition</item>
                    </argument>
                </arguments>
            </block>

            <block class="Klevu\FrontendJs\Block\Template" after="klevu_frontendjs.js_init" before="klevu_frontendjs.js_includes" name="ahy_plprevamp.search.sort.by.block" template="Ahy_PlpRevamp::klevu/klevu_landing_template_sort_by.phtml">
                <arguments>
                    <argument name="is_enabled_conditions_fqcn" xsi:type="array">
                        <item name="klevu_catnav_themev2" xsi:type="string">Klevu\Categorynavigation\Service\ThemeV2\IsEnabledCondition</item>
                    </argument>
                </arguments>
            </block>

            <block class="Klevu\FrontendJs\Block\Template" after="klevu_frontendjs.js_init" before="klevu_frontendjs.js_includes" name="ahy_plprevamp.search.filter.tags.block" template="Ahy_PlpRevamp::klevu/ku_filter_tags_template.phtml">
                <arguments>
                    <argument name="is_enabled_conditions_fqcn" xsi:type="array">
                        <item name="klevu_catnav_themev2" xsi:type="string">Klevu\Categorynavigation\Service\ThemeV2\IsEnabledCondition</item>
                    </argument>
                </arguments>
            </block>

            <block class="Klevu\FrontendJs\Block\Template" after="klevu_frontendjs.js_init" before="klevu_frontendjs.js_includes" name="ahy_plprevamp.search.results.heading.title.block" template="Ahy_PlpRevamp::klevu/klevu_landing_template_results_heading_title.phtml">
                <arguments>
                    <argument name="is_enabled_conditions_fqcn" xsi:type="array">
                        <item name="klevu_catnav_themev2" xsi:type="string">Klevu\Categorynavigation\Service\ThemeV2\IsEnabledCondition</item>
                    </argument>
                </arguments>
            </block>

            <block class="Klevu\FrontendJs\Block\Template" after="klevu_frontendjs.js_init" before="klevu_frontendjs.js_includes" name="ahy_plprevamp.search.filters" template="Ahy_PlpRevamp::klevu/klevu_landing_template_filters.phtml">
                <arguments>
                    <argument name="is_enabled_conditions_fqcn" xsi:type="array">
                        <item name="klevu_catnav_themev2" xsi:type="string">Klevu\Categorynavigation\Service\ThemeV2\IsEnabledCondition</item>
                    </argument>
                </arguments>
            </block>

            <block class="Klevu\FrontendJs\Block\Template" after="klevu_frontendjs.js_init" before="klevu_frontendjs.js_includes" name="ahy_plprevamp.search.pagination" template="Ahy_PlpRevamp::klevu/klevu_landing_template_pagination.phtml">
                <arguments>
                    <argument name="is_enabled_conditions_fqcn" xsi:type="array">
                        <item name="klevu_catnav_themev2" xsi:type="string">Klevu\Categorynavigation\Service\ThemeV2\IsEnabledCondition</item>
                    </argument>
                </arguments>
            </block>

        </referenceBlock>
    </body>
</page>
