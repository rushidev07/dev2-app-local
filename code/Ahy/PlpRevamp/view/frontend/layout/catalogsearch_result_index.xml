<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Ahy_PlpRevamp::css/catnav-styles.css"/>
    </head>
    <body>
        <!--
            Handle: catalogsearch_result_index
            /catalogsearch/result/ - route id equals frontName here, so this name is stable across versions.

            FalcoSense derives this handle from its route id, and that id has changed
            across versions (fssearch -> fs_search -> fs). Magento takes the layout
            handle from the route ID, not the frontName, so the handle name moves with
            it. Both spellings are shipped so this keeps working on either version;
            only one ever fires, the other file is simply never read.
        -->
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Text" name="ahy_marker_catalogsearch_result_index">
                <arguments>
                    <argument name="text" xsi:type="string">&lt;script&gt;console.log('%c[AHY LAYOUT]%c handle fired: catalogsearch_result_index','background:#7c3aed;color:#fff;padding:2px 6px;border-radius:3px;font-weight:700','');&lt;/script&gt;&lt;!-- AHY-ACTIVE-HANDLE: catalogsearch_result_index --&gt;</argument>
                </arguments>
            </block>
        </referenceContainer>

        <!--
            Remove FalcoSense's own grid. In the modular version this block owns five
            child blocks (product_card_desktop/mobile, filters_desktop/mobile,
            zero_results); removing the parent removes those children too, so none of
            its card markup can render alongside ours.
        -->
        <referenceBlock name="ahy_smartsearch_search" remove="true"/>

        <!--
            PlpRevamp grid. Self-contained: it carries its own cards, filters,
            CaliberNation pricing and Yotpo ratings, none of which exist in
            FalcoSense's ahySearchResults component - which is why the child
            templates cannot be overridden individually.

            Class stays FalcoSense\Search\Block\Search so the search engine is
            unchanged: same products API, search token, spell correction, geo
            state and analytics.
        -->
        <referenceContainer name="content">
            <block class="FalcoSense\Search\Block\Search"
                   name="ahy_plprevamp_search_grid"
                   template="Ahy_PlpRevamp::search/falco_search_grid.phtml"
                   cacheable="false"
                   before="-"/>
        </referenceContainer>

        <!--
            FalcoSense performs this cleanup in its own layout file, but on any handle
            where its filename does not match, that file never loads and none of it
            applies - which is what left a stray 2-column sidebar on /fs/search/ and
            let native search blocks keep querying Elasticsearch. Replicated here.
        -->
        <referenceBlock name="search.result"           remove="true"/>
        <referenceBlock name="search_result_list"      remove="true"/>
        <referenceBlock name="search.search_terms_log" remove="true"/>
        <referenceBlock name="catalogsearch.leftnav"   remove="true"/>
        <referenceBlock name="klevu_content_top"       remove="true"/>
        <referenceBlock name="catalog.compare.sidebar" remove="true"/>
        <referenceBlock name="mpassign.list"           remove="true"/>
        <referenceContainer name="sidebar.main"        remove="true"/>
        <referenceContainer name="sidebar.additional"  remove="true"/>
    </body>
</page>
