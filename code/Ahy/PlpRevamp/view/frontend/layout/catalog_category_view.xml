<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!--
            Injected on ALL category pages.
            Template exits early if ahy_use_subcategory_layout = 0 on the category.
        -->
        <referenceContainer name="main">
            <block class="Ahy\PlpRevamp\Block\Category\SubcategoryCards"
                   name="ahy.subcategory.cards"
                   template="Ahy_PlpRevamp::category/subcategory_cards.phtml"
                   before="-"/>
        </referenceContainer>

        <!-- Remove FalcoSense default grid, PlpRevamp owns the PLP now -->
        <referenceBlock name="ahy_smartsearch_category" remove="true"/>

        <referenceContainer name="content">
            <block class="Ahy\PlpRevamp\Block\Category\FalcoProductGrid"
                   name="ahy.plp.product.grid"
                   template="Ahy_PlpRevamp::category/falco_product_grid.phtml"
                   before="-"/>
        </referenceContainer>
    </body>
</page>
