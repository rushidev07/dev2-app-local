<script>
function switchImg(thumb, src) {
    document.getElementById('flxp-main-img').src = src;
    document.querySelectorAll('.flxp-img-thumb').forEach(t => t.classList.remove('active'));
    thumb.classList.add('active');
}
// Close modal on overlay click
document.getElementById('flxp-reject-modal').addEventListener('click', function(e) {
    if (e.target === this) this.classList.remove('open');
});
</script>
