<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Sales\Model\Order">
        <plugin name="update_payment_donation_order" type="Ahy\ThemeCustomization\Plugin\AddDonationPaypal"/>
    </type>
    <type name="Magento\Paypal\Model\Cart">
        <plugin name="update_paypal_donation_order" type="Ahy\ThemeCustomization\Plugin\AddDonationPaypal"/>
    </type>
    <type name="Magento\Store\Model\Store">
        <plugin name="ahy_rewrite_media_static_host" type="Ahy\ThemeCustomization\Plugin\MediaBaseUrlPlugin"/>
    </type>
    <type name="Magento\Customer\CustomerData\SectionPoolInterface">
        <arguments>
            <argument name="sectionSourceMap" xsi:type="array">
                <item name="extra_actions" xsi:type="string">Ahy\ThemeCustomization\CustomerData\ExtraActions</item>
            </argument>
        </arguments>
    </type>
</config>
