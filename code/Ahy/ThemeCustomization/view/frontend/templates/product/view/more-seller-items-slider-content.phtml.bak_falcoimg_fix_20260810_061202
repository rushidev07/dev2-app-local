$falcosenseImgUrl = static function (string $image): string {
    if ($image === '') return '';
    $path = $image;
    if (str_starts_with($image, 'http')) {
        if (!preg_match('#/catalog/product/(.+)$#', $image, $m)) return '';
        $path = $m[1];
    }
    $filename = basename($path);
    if ($filename === '') return '';
    $c1 = $filename[0];
    $c2 = $filename[1] ?? $c1;
    return '/media/falcosense/800x800/' . $c1 . '/' . $c2 . '/' . $filename;
};
