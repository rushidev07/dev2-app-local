<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">

    <body>
        <referenceContainer name="content">
            <block class="FalcoSense\Search\Block\Collection" name="falcosense_popular_products" template="FalcoSense_Search::collection/results.phtml">
                <arguments>
                    <argument name="heading" xsi:type="string">Popular Products</argument>
                    <argument name="sort" xsi:type="string">popularity</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
