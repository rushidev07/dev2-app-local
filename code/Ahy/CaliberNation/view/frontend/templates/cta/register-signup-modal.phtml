<?php
/**
 * Caliber Nation — signup modal on the account-registration page.
 * Hosts the same MembershipSignup component the landing page uses; opened via the
 * "open-caliber-signup" window event from the Join & Save banner. The component is
 * rendered at page load (x-show, not x-if) so Magewire hydrates it normally.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 */
?>
<div x-data="{ open: false }"
     @open-caliber-signup.window="open = true; document.body.classList.add('overflow-hidden')"
     x-init="$watch('open', v => { if (!v) document.body.classList.remove('overflow-hidden') })">
    <div x-show="open"
         x-cloak
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         @keydown.window.escape="open = false"
         class="fixed inset-0 z-50 flex items-start justify-center px-4 py-8 bg-black/40 overflow-auto"
         style="backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);">
        <div @click.away="open = false"
             class="relative bg-white rounded-2xl shadow-2xl w-full max-w-2xl max-h-[90vh] overflow-auto">
            <button @click="open = false"
                    type="button"
                    class="absolute top-4 right-4 z-10 flex items-center justify-center w-9 h-9
                           rounded-full bg-white/80 text-gray-500 hover:text-red-500 shadow transition"
                    aria-label="<?= $escaper->escapeHtmlAttr(__('Close')) ?>">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none"
                     viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
            <?= $block->getChildHtml('signup_form') ?>
        </div>
    </div>
</div>
