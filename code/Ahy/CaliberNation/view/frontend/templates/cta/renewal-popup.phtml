<?php
/**
 * Renewal popup for expired members — shown ONCE PER SESSION on the cart page,
 * alongside the persistent inline banner. Cart is never full-page-cached, so the
 * per-customer shouldShow() guard is reliable here (a site-wide popup would need a
 * customer-data section instead).
 *
 * Brand-themed (dark ahy-blue card + white logo) to match the Caliber Nation panel.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Ahy\CaliberNation\ViewModel\RenewalPrompt $viewModel
 */
$viewModel = $block->getData('view_model');
if (!$viewModel || !$viewModel->shouldShow()) {
    return;
}
$isWinback = $viewModel->isWinbackEligible();
?>
<div x-data="{
        open: false,
        init() {
            // Show only once per browser session; the banner stays as the quiet reminder.
            if (!sessionStorage.getItem('cn_renewal_popup_seen')) {
                this.open = true;
            }
        },
        dismiss() {
            this.open = false;
            sessionStorage.setItem('cn_renewal_popup_seen', '1');
        }
     }"
     x-init="init()">
    <div x-show="open"
         x-cloak
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         @keydown.window.escape="dismiss()"
         class="fixed inset-0 z-50 flex items-center justify-center px-4"
         style="background: rgba(0,0,0,0.45); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);">
        <div @click.away="dismiss()"
             class="relative bg-ahy-blue rounded-2xl shadow-2xl w-full max-w-md max-h-[90vh] overflow-auto
                    px-8 py-10 text-center">
            <button @click="dismiss()" type="button"
                    class="absolute top-3 right-3 flex items-center justify-center w-9 h-9 rounded-full
                           text-gray-300 hover:text-white transition"
                    aria-label="<?= $escaper->escapeHtmlAttr(__('Close')) ?>">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none"
                     viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>

            <img src="/media/wysiwyg/caliber-nation/caliber-nation-logo.png"
                 alt="Caliber Nation" class="w-44 mx-auto mb-5"/>

            <h3 class="font-league-gothic text-white text-5xl uppercase leading-none mb-4">
                <?= $escaper->escapeHtml(__('Renew Your Membership')) ?>
            </h3>
            <p class="text-white opacity-80 text-sm md:text-base leading-relaxed max-w-[300px] mx-auto mb-6">
                <?= $escaper->escapeHtml($viewModel->getMessage()) ?>
            </p>

            <?php if ($isWinback): ?>
                <div class="mb-6">
                    <span class="inline-block bg-ahy-red text-white font-bold rounded-full px-6 py-2 text-lg">
                        <?= $escaper->escapeHtml(__('Come back for %1', $viewModel->getWinbackPriceFormatted())) ?>
                    </span>
                </div>
            <?php endif; ?>

            <div class="w-12 h-0.5 bg-ahy-red mx-auto mb-6"></div>

            <ul class="text-white text-sm text-left space-y-2 max-w-[280px] mx-auto mb-8">
                <li class="flex items-start gap-2"><span class="text-ahy-red mt-0.5 shrink-0">&#10003;</span>10%–90% off member products</li>
                <li class="flex items-start gap-2"><span class="text-ahy-red mt-0.5 shrink-0">&#10003;</span>Member-only spotlight deals from sellers</li>
                <li class="flex items-start gap-2"><span class="text-ahy-red mt-0.5 shrink-0">&#10003;</span>Early-bird access to sales &amp; new sellers</li>
            </ul>

            <a href="<?= $escaper->escapeUrl($viewModel->getRenewUrl()) ?>"
               class="flex items-center justify-center w-full bg-ahy-red hover:bg-ahy-red-light
                      text-white font-bold rounded-full h-14 transition-colors">
                <?= $escaper->escapeHtml(__('Renew Membership')) ?>
            </a>
            <button @click="dismiss()" type="button"
                    class="mt-4 text-sm text-gray-300 hover:text-white underline">
                <?= $escaper->escapeHtml(__('Maybe later')) ?>
            </button>
        </div>
    </div>
</div>
