    <script>
    (function () {
        var typeEl  = document.getElementById('discount_type');
        var valueEl = document.getElementById('discount_value');
        var form    = document.getElementById('calibernation-participation-form');

        function applyConstraint() {
            if (typeEl.value === 'percent') {
                valueEl.setAttribute('max', '100');
            } else {
                valueEl.removeAttribute('max');
            }
        }

        typeEl.addEventListener('change', applyConstraint);
        applyConstraint(); // run on page load

        form.addEventListener('submit', function (e) {
            if (typeEl.value === 'percent' && parseFloat(valueEl.value) > 100) {
                e.preventDefault();
                alert('<?= $escaper->escapeJs(__('Percentage discount cannot exceed 100%.')) ?>');
                valueEl.focus();
            }
        });
    })();
    </script>

