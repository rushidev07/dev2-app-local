<?php
/**
 * Caliber Nation — Membership Manager (Magewire interactive controls)
 *
 * IMPORTANT: Single root <div> required — Magewire attaches wire:id here.
 *
 * @var \Magento\Framework\View\Element\Template                    $block
 * @var \Magento\Framework\Escaper                                  $escaper
 * @var \Ahy\CaliberNation\Magewire\Account\MembershipManager       $magewire
 */
?>

<div>

    <?php if ($magewire->cancellationDone): ?>
    <!-- ── Cancellation success ──────────────────────────────────────────────── -->
    <div class="flex flex-col items-center text-center py-4"
         x-data="{show:false}"
         x-init="requestAnimationFrame(()=>{show=true}); setTimeout(()=>{ window.location.reload() }, 2000)"
         x-show="show"
         x-transition:enter="transition ease-out duration-500"
         x-transition:enter-start="opacity-0 scale-95"
         x-transition:enter-end="opacity-100 scale-100">

        <!-- Checkmark circle -->
        <div class="flex items-center justify-center w-14 h-14 rounded-full bg-green-100 mb-4">
            <svg class="w-7 h-7 text-green-600" fill="none" stroke="currentColor"
                 viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
            </svg>
        </div>

        <h3 class="font-league-gothic text-2xl text-ahy-blue mb-1">
            <?= $escaper->escapeHtml(__('Membership Cancelled')) ?>
        </h3>
        <p class="text-sm text-gray-500 mb-6 max-w-xs leading-relaxed">
            <?= $escaper->escapeHtml($magewire->successMessage) ?>
        </p>
        <p class="text-xs text-gray-400 mt-2">
            <?= $escaper->escapeHtml(__('Redirecting you now...')) ?>
        </p>
    </div>

    <?php else: ?>

    <!-- After a successful state change, reload so the server-rendered overview
         (Payment Method / Renews-Expires / card art) matches. Short delay lets the
         success toast show first. -->
    <?php if ($magewire->reload): ?>
    <div x-data x-init="setTimeout(() => window.location.reload(), 1200)"></div>
    <?php endif; ?>

    <!-- ── Error toast ───────────────────────────────────────────────────────── -->
    <?php if ($magewire->errorMessage): ?>
    <div x-data="{ show: true }"
         x-init="setTimeout(() => show = false, 7000)"
         x-show="show"
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0 -translate-y-1"
         x-transition:enter-end="opacity-100 translate-y-0"
         x-transition:leave="transition ease-in duration-300"
         x-transition:leave-start="opacity-100 translate-y-0"
         x-transition:leave-end="opacity-0 -translate-y-1"
         class="relative flex items-start gap-3 mb-5 pr-9 p-4
                bg-red-50 border border-red-200 rounded-lg text-sm text-red-700 overflow-hidden">

        <!-- Icon -->
        <svg class="w-5 h-5 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
        </svg>

        <!-- Message -->
        <span class="flex-1"><?= $escaper->escapeHtml($magewire->errorMessage) ?></span>

        <!-- Close button -->
        <button @click="show = false" type="button"
                class="absolute top-3 right-3 flex items-center justify-center w-5 h-5
                       text-red-400 hover:text-red-600 transition-colors rounded">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
            </svg>
        </button>

        <!-- 7-second drain bar -->
        <span x-data="{ w: 100 }"
              x-init="$nextTick(() => { w = 0 })"
              :style="'width:' + w + '%'"
              class="absolute bottom-0 left-0 h-0.5 bg-red-300 rounded-full"
              style="transition: width 7s linear;">
        </span>
    </div>
    <?php endif; ?>

    <!-- ── Success toast ──────────────────────────────────────────────────────── -->
    <?php if ($magewire->successMessage): ?>
    <div x-data="{ show: true }"
         x-init="setTimeout(() => show = false, 7000)"
         x-show="show"
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0 -translate-y-1"
         x-transition:enter-end="opacity-100 translate-y-0"
         x-transition:leave="transition ease-in duration-300"
         x-transition:leave-start="opacity-100 translate-y-0"
         x-transition:leave-end="opacity-0 -translate-y-1"
         class="relative flex items-start gap-3 mb-5 pr-9 p-4
                bg-green-50 border border-green-200 rounded-lg text-sm text-green-700 overflow-hidden">

        <!-- Icon -->
        <svg class="w-5 h-5 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>

        <!-- Message -->
        <span class="flex-1"><?= $escaper->escapeHtml($magewire->successMessage) ?></span>

        <!-- Close button -->
        <button @click="show = false" type="button"
                class="absolute top-3 right-3 flex items-center justify-center w-5 h-5
                       text-green-400 hover:text-green-600 transition-colors rounded">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
            </svg>
        </button>

        <!-- 7-second drain bar -->
        <span x-data="{ w: 100 }"
              x-init="$nextTick(() => { w = 0 })"
              :style="'width:' + w + '%'"
              class="absolute bottom-0 left-0 h-0.5 bg-green-300 rounded-full"
              style="transition: width 7s linear;">
        </span>
    </div>
    <?php endif; ?>

    <!-- ── Auto-renew toggle (Phase 5: card-guarded) ─────────────────────────── -->
    <!--
        Driven by server state ($magewire->autoRenew) rather than optimistic Alpine,
        because enabling may be rejected or require a card choice. wire:key re-renders
        on any state change so the switch/picker never inherit stale markup.
    -->
    <?php $canToggle = $magewire->autoRenew || $magewire->hasUsableCard; ?>
    <div wire:key="autorenew-<?= (int) $magewire->autoRenew ?>-<?= (int) $magewire->boundTokenId ?>-<?= $magewire->showCardPicker ? '1' : '0' ?>"
         class="mb-6">

        <!-- Row: icon  |  label (flex-1)  |  spinner + toggle (shrink-0) -->
        <div class="flex items-center gap-3">

            <!-- Icon bubble -->
            <div class="flex-shrink-0 flex items-center justify-center w-10 h-10 rounded-full bg-ahy-yellow-card border border-yellow-200">
                <svg class="w-5 h-5 text-ahy-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                </svg>
            </div>

            <!-- Label — takes all remaining space so toggle is never pushed off-screen -->
            <p class="flex-1 text-sm font-bold text-ahy-blue">
                <?= $escaper->escapeHtml(__('Auto-Renew')) ?>
            </p>

            <!-- Loading spinner (only visible during Magewire call) -->
            <svg wire:loading wire:target="toggleAutoRenew,confirmCard"
                 class="animate-spin h-4 w-4 text-ahy-blue flex-shrink-0"
                 xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
            </svg>

            <!-- Toggle switch — reflects server state; disabled when no usable card -->
            <button <?= $canToggle ? 'wire:click="toggleAutoRenew"' : '' ?>
                    wire:loading.attr="disabled"
                    wire:target="toggleAutoRenew"
                    type="button"
                    role="switch"
                    <?= $canToggle ? '' : 'disabled' ?>
                    aria-checked="<?= $magewire->autoRenew ? 'true' : 'false' ?>"
                    aria-label="<?= $escaper->escapeHtmlAttr($magewire->autoRenew ? __('Disable auto-renew') : __('Enable auto-renew')) ?>"
                    class="relative inline-flex h-7 w-14 flex-shrink-0 items-center rounded-full overflow-hidden
                           transition-colors duration-200 focus:outline-none focus:ring-2
                           focus:ring-ahy-blue focus:ring-offset-2
                           disabled:opacity-50 disabled:cursor-not-allowed
                           <?= $magewire->autoRenew ? 'bg-ahy-blue' : 'bg-gray-300' ?>">
                <span style="<?= $magewire->autoRenew ? 'transform:translateX(31px)' : 'transform:translateX(5px)' ?>"
                      class="inline-block h-5 w-5 rounded-full bg-white shadow-md
                             transition-transform duration-200 ease-in-out">
                </span>
            </button>
        </div>

        <!-- Description / no-card prompt -->
        <?php if (!$magewire->autoRenew && !$magewire->hasUsableCard): ?>
            <p class="text-xs text-red-500 mt-3 pl-[52px]">
                <?= $escaper->escapeHtml(__('Add a card to enable auto-renew.')) ?>
                <button type="button"
                        x-data="{}"
                        @click="$dispatch('cn-open-add-card')"
                        class="underline font-semibold hover:text-ahy-red">
                    <?= $escaper->escapeHtml(__('Add a card')) ?>
                </button>
            </p>
        <?php else: ?>
            <p class="text-xs text-gray-400 mt-3 pl-[52px]">
                <?= $escaper->escapeHtml($magewire->autoRenew
                    ? __('Renews automatically on your next billing date.')
                    : __('Will not renew — expires at end of period.')) ?>
            </p>
        <?php endif; ?>

        <!-- Bound renewal card + Change (Phase 5.4) -->
        <?php if ($magewire->boundTokenId && $magewire->boundCardLabel !== ''): ?>
            <div class="flex items-center flex-wrap gap-2 text-xs text-ahy-blue mt-2 pl-[52px]">
                <span><?= $escaper->escapeHtml(__('Renewal card:')) ?>
                    <strong><?= $escaper->escapeHtml($magewire->boundCardLabel) ?></strong></span>
                <button wire:click="changeRenewalCard" type="button"
                        class="underline hover:text-ahy-red">
                    <?= $escaper->escapeHtml(__('Change')) ?>
                </button>
            </div>
        <?php endif; ?>

        <!-- Card picker (Phase 5.3 / 5.4) -->
        <?php if ($magewire->showCardPicker): ?>
            <div class="mt-4 ml-[52px] rounded-xl border border-yellow-200 bg-ahy-yellow-card p-4">
                <p class="text-sm font-bold text-ahy-blue mb-3">
                    <?= $escaper->escapeHtml($magewire->pickerMode === 'change'
                        ? __('Choose a new renewal card')
                        : __('Choose a card to renew with')) ?>
                </p>
                <div class="space-y-2">
                    <?php foreach ($magewire->usableCards as $card): ?>
                        <label class="flex items-center gap-2 text-sm text-ahy-blue cursor-pointer">
                            <input type="radio" name="cn-renewal-card"
                                   wire:model="selectedTokenId"
                                   value="<?= (int) $card['id'] ?>"
                                   class="accent-ahy-blue" />
                            <?= $escaper->escapeHtml($card['label']) ?>
                        </label>
                    <?php endforeach; ?>
                </div>
                <div class="flex flex-wrap gap-3 mt-4">
                    <button wire:click="confirmCard"
                            wire:loading.attr="disabled"
                            wire:target="confirmCard"
                            type="button"
                            class="inline-flex items-center justify-center bg-ahy-red hover:bg-ahy-red-light
                                   text-white font-bold text-sm rounded-full px-5 h-10 transition-colors
                                   disabled:opacity-60 disabled:cursor-not-allowed">
                        <?= $escaper->escapeHtml($magewire->pickerMode === 'change'
                            ? __('Update Card')
                            : __('Enable Auto-Renew')) ?>
                    </button>
                    <button wire:click="dismissCardPicker" type="button"
                            wire:loading.attr="disabled"
                            wire:target="confirmCard"
                            class="inline-flex items-center justify-center border border-gray-200
                                   hover:border-ahy-blue text-gray-500 hover:text-ahy-blue
                                   font-semibold text-sm rounded-full px-5 h-10 transition-all
                                   disabled:opacity-50 disabled:cursor-not-allowed">
                        <?= $escaper->escapeHtml(__('Cancel')) ?>
                    </button>
                </div>
            </div>
        <?php endif; ?>
    </div>

    <!-- ── Divider ───────────────────────────────────────────────────────────── -->
    <div class="border-t border-gray-100 mb-6"></div>

    <!-- ── Cancel section — Alpine-driven show/hide, zero server round-trip ──── -->
    <!--
        showCancel is purely local Alpine state. Clicking "Cancel Membership" reveals
        the confirmation panel INSTANTLY without any Magewire call. Only "Yes, Cancel"
        triggers a server call via wire:click="cancelMembership".
    -->
    <div x-data="{ showCancel: false }">

        <!-- Cancel membership button -->
        <button x-show="!showCancel"
                @click="showCancel = true"
                type="button"
                class="group inline-flex items-center gap-2 border border-red-200 hover:border-red-400
                       text-red-500 hover:text-red-600 hover:bg-red-50
                       text-sm font-semibold rounded-full px-5 py-2.5 transition-all duration-150">
            <svg class="w-4 h-4 shrink-0 transition-transform duration-150 group-hover:scale-110"
                 fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
            </svg>
            <?= $escaper->escapeHtml(__('Cancel Membership')) ?>
        </button>

        <!-- Inline cancel confirmation — shown instantly via Alpine -->
        <div x-show="showCancel"
             x-cloak
             x-transition:enter="transition ease-out duration-200"
             x-transition:enter-start="opacity-0 -translate-y-1"
             x-transition:enter-end="opacity-100 translate-y-0"
             x-transition:leave="transition ease-in duration-150"
             x-transition:leave-start="opacity-100 translate-y-0"
             x-transition:leave-end="opacity-0 -translate-y-1"
             class="rounded-xl border border-red-200 overflow-hidden">

            <!-- Red header bar — increased padding for breathing room -->
            <div class="flex items-center gap-4 px-5 py-5 bg-red-50 border-b border-red-200">
                <svg class="w-5 h-5 text-red-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                </svg>
                <p class="text-sm font-bold text-red-700">
                    <?= $escaper->escapeHtml(__('Cancel your membership?')) ?>
                </p>
            </div>

            <!-- Body -->
            <div class="px-5 py-4 bg-white">
                <p class="text-xs text-gray-500 leading-relaxed mb-5">
                    <?php /* Cancelling is PAID-THROUGH: auto-renew stops, but benefits
                             continue until renewal_date (see MemberAccess). Never say
                             access is lost immediately — it isn't. */ ?>
                    <?php if ($magewire->paidThroughDate !== ''): ?>
                        <?= $escaper->escapeHtml(__(
                            'Auto-renew will be turned off and you won\'t be charged again. You keep all your member benefits until %1 — the end of the period you\'ve already paid for. After that date your membership ends.',
                            $magewire->paidThroughDate
                        )) ?>
                    <?php else: ?>
                        <?= $escaper->escapeHtml(__('Auto-renew will be turned off and you won\'t be charged again. You keep all your member benefits until the end of the period you\'ve already paid for.')) ?>
                    <?php endif; ?>
                </p>

                <div class="flex flex-wrap items-center gap-3">

                    <!-- Confirm: Cancel (server call) -->
                    <button wire:click="cancelMembership"
                            wire:loading.attr="disabled"
                            wire:target="cancelMembership"
                            type="button"
                            class="inline-flex items-center justify-center gap-2 bg-ahy-red hover:bg-ahy-red-light
                                   text-white font-bold text-sm rounded-full px-6 h-11 transition-colors
                                   disabled:opacity-60 disabled:cursor-not-allowed">
                        <span wire:loading.remove wire:target="cancelMembership"
                              class="inline-flex items-center gap-2">
                            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                            </svg>
                            <?= $escaper->escapeHtml(__('Yes, Cancel')) ?>
                        </span>
                        <span wire:loading wire:target="cancelMembership" class="whitespace-nowrap">
                            <svg class="animate-spin h-4 w-4 inline-block align-middle mr-2" xmlns="http://www.w3.org/2000/svg"
                                 fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
                            </svg><?= $escaper->escapeHtml(__('Cancelling...')) ?>
                        </span>
                    </button>

                    <!-- Dismiss: Alpine-only, zero server call — disabled while cancelling -->
                    <button @click="showCancel = false"
                            type="button"
                            wire:loading.attr="disabled"
                            wire:target="cancelMembership"
                            class="inline-flex items-center justify-center border border-gray-200
                                   hover:border-ahy-blue text-gray-500 hover:text-ahy-blue
                                   font-semibold text-sm rounded-full px-6 h-11 transition-all duration-150
                                   disabled:opacity-50 disabled:cursor-not-allowed">
                        <?= $escaper->escapeHtml(__('No, Keep It')) ?>
                    </button>
                </div>
            </div>
        </div>

    </div>

    <?php endif; ?>

</div>
