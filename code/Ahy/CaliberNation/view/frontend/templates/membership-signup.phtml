                <div wire:key="cn-signup"
                     x-data="{
                         showPassword: false,
                         showPasswordConfirm: false,
                         localPassword: '',
                         localConfirmPassword: '',
                         attemptedSubmit: false,
                         fieldChangeCounter: 0,
                         phoneInvalid() {
                             void this.fieldChangeCounter;
                             const el = document.getElementById('cn-telephone');
                             if (!el || el.value.trim() === '') return false;
                             return el.value.replace(/\D/g, '').length < 10;
                         },
                         allFieldsFilled() {
                             void this.fieldChangeCounter;
                             const ids = ['cn-first-name', 'cn-last-name', 'cn-email', 'cn-street', 'cn-city', 'cn-region', 'cn-postcode', 'cn-telephone'];
                             const fieldsOk = ids.every(id => !this.isFieldEmpty(id));
                             const namesOk = !this.nameStartsWithDigit('cn-first-name') && !this.nameStartsWithDigit('cn-last-name');
                             <?php if (!$magewire->isLoggedIn): ?>
                             const pwOk = this.localPassword.length >= <?= (int) $magewire->minPasswordLength ?>
                                 && this.passwordSetsCount() >= <?= (int) $magewire->minCharacterSets ?>
                                 && this.localPassword === this.localConfirmPassword
                                 && this.localConfirmPassword.length > 0;
                             return fieldsOk && namesOk && !this.phoneInvalid() && pwOk;
                             <?php else: ?>
                             return fieldsOk && namesOk && !this.phoneInvalid();
                             <?php endif; ?>
                         },
                         passwordSetsCount() {
                             const pw = this.localPassword;
                             let sets = 0;
                             if (/[a-z]/.test(pw)) sets++;
                             if (/[A-Z]/.test(pw)) sets++;
                             if (/[0-9]/.test(pw)) sets++;
                             if (/[^a-zA-Z0-9]/.test(pw)) sets++;
                             return sets;
                         },
                         passwordTooShort() {
                             return this.localPassword.length > 0
                                 && this.localPassword.length < <?= (int) $magewire->minPasswordLength ?>;
                         },
                         isFieldEmpty(id) {
                             void this.fieldChangeCounter;
                             const el = document.getElementById(id);
                             return el ? el.value.trim() === '' : false;
                         },
                         nameStartsWithDigit(id) {
                             void this.fieldChangeCounter;
                             const el = document.getElementById(id);
                             return el ? /^\d/.test(el.value.trim()) : false;
                         },
                         remainingSets() {
                             return Math.max(0, <?= (int) $magewire->minCharacterSets ?> - this.passwordSetsCount());
                         },
                         passwordRequired() {
                             return this.attemptedSubmit && this.localPassword.length === 0;
                         },
                         confirmRequired() {
                             return this.attemptedSubmit && this.localConfirmPassword.length === 0;
                         },
                         passwordMissingSets() {
                             return this.localPassword.length > 0
                                 && this.remainingSets() > 0;
                         },
                         passwordMismatch() {
                             return (this.localConfirmPassword.length > 0 || this.attemptedSubmit)
                                 && this.localConfirmPassword !== this.localPassword;
                         },
                         submitJoin() {
                             this.attemptedSubmit = true;
                             const requiredIds = ['cn-first-name', 'cn-last-name', 'cn-email', 'cn-street', 'cn-city', 'cn-region', 'cn-postcode', 'cn-telephone'];
                             const hasEmptyFields = requiredIds.some(id => this.isFieldEmpty(id));
                             const hasNameError = this.nameStartsWithDigit('cn-first-name') || this.nameStartsWithDigit('cn-last-name');
                             <?php if (!$magewire->isLoggedIn): ?>
                             const hasPwError = this.localPassword.length === 0
                                 || this.localConfirmPassword.length === 0
                                 || this.passwordTooShort()
                                 || this.passwordMissingSets()
                                 || this.passwordMismatch();
                             if (hasEmptyFields || hasNameError || this.phoneInvalid() || hasPwError) return;
                             <?php else: ?>
                             if (hasEmptyFields || hasNameError || this.phoneInvalid()) return;
                             <?php endif; ?>
                             $wire.join();
                         },
                         strengthScore() {
                             const pw = this.localPassword;
                             const minLen  = <?= (int) $magewire->minPasswordLength ?>;
                             const minSets = <?= (int) $magewire->minCharacterSets ?>;
                             if (!pw) return 0;
                             let sets = 0;
                             if (/[a-z]/.test(pw)) sets++;
                             if (/[A-Z]/.test(pw)) sets++;
                             if (/[0-9]/.test(pw)) sets++;
                             if (/[^a-zA-Z0-9]/.test(pw)) sets++;
                             if (pw.length < minLen || sets < minSets) return 1;
                             const ls = pw.length >= 16 ? 2 : (pw.length >= 12 ? 1 : 0);
                             const ss = sets >= 4 ? 2 : (sets >= 3 ? 1 : 0);
                             const t  = ls + ss;
                             return t >= 4 ? 4 : (t >= 2 ? 3 : 2);
                         },
                         strengthLabel() { return ['No Password','Weak','Fair','Strong','Very Strong'][this.strengthScore()]; },
                         strengthLabelStyle() { return ['color:#9ca3af','color:#ef4444','color:#ca8a04','color:#2563eb','color:#16a34a'][this.strengthScore()]; },
                         strengthBarStyle(i) { const s=this.strengthScore(); if(i>s) return 'background:#e5e7eb'; return ['','background:#ef4444','background:#eab308','background:#2563eb','background:#22c55e'][s]; }
                     }">

