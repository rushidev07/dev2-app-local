    <?php /* Keep the loader overlay up until checkout paints. Magewire stops the loader
             inside its own message.processed hook and only THEN queues the redirect in a
             setTimeout (see livewire.js), so the form would repaint for a beat before the
             browser leaves. Re-raising it on any response carrying a redirect closes that
             gap. detail must be an object: the loader's notification messenger reads
             detail.loader, and a bare value throws when it filters the message list. */ ?>
    <div x-data="{}"
         x-init="(() => {
                     const pin = () => window.Magewire.hook('message.processed', (message) => {
                         if (message.response && message.response.effects && message.response.effects.redirect) {
                             setTimeout(() => window.Magewire.dispatchEvent('loader:start', { detail: { loader: true } }));
                         }
                     });
                     window.Magewire
                         ? pin()
                         : document.addEventListener('magewire:available', pin, { once: true });
                 })()"></div>

    <?php if (!$formOnly): ?>
    <?php /* Join/Renew CTAs link here with ?scrollTo=signup rather than a #fragment:
             browsers jump to a fragment instantly during navigation, so there is no
             distance left to animate. Arriving at the top of the page instead lets us
             own the whole scroll. Waits for window.load because the tall hero above
             uses lazy background images — scrolling before that settles overshoots.
             Kept off the <section>, which is the Magewire root (wire:id). */ ?>
    <div x-data="{}"
         x-init="(() => {
                     const p = new URLSearchParams(window.location.search);
                     if (p.get('<?= /* @noEscape */ \Ahy\CaliberNation\Model\Config::SIGNUP_SCROLL_PARAM ?>')
                         !== '<?= /* @noEscape */ \Ahy\CaliberNation\Model\Config::SIGNUP_SCROLL_VALUE ?>') { return; }
                     const go = () => setTimeout(() => {
                         document.getElementById('membership-signup')
                             .scrollIntoView({ behavior: 'smooth', block: 'start' });
                         /* Drop the flag so a refresh or Back doesn't re-scroll. */
                         p.delete('<?= /* @noEscape */ \Ahy\CaliberNation\Model\Config::SIGNUP_SCROLL_PARAM ?>');
                         const q = p.toString();
                         window.history.replaceState(null, '', window.location.pathname + (q ? '?' + q : ''));
                     }, 150);
                     document.readyState === 'complete'
                         ? go()
                         : window.addEventListener('load', go, { once: true });
                 })()"></div>
    <?php endif; ?>
