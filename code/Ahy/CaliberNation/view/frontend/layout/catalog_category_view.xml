<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template"
                   name="caliber_nation.plp.renewal_prompt"
                   template="Ahy_CaliberNation::cta/renewal-prompt.phtml"
                   before="category.products">
                <arguments>
                    <argument name="view_model" xsi:type="object">Ahy\CaliberNation\ViewModel\RenewalPrompt</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
