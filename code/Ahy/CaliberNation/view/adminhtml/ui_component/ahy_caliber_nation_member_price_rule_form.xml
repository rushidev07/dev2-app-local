<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">ahy_caliber_nation_member_price_rule_form.ahy_caliber_nation_member_price_rule_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Category Level Discount</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="Ahy\CaliberNation\Block\Adminhtml\PriceRule\Edit\BackButton"/>
            <button name="delete" class="Ahy\CaliberNation\Block\Adminhtml\PriceRule\Edit\DeleteButton"/>
            <button name="save" class="Ahy\CaliberNation\Block\Adminhtml\PriceRule\Edit\SaveButton"/>
        </buttons>
        <namespace>ahy_caliber_nation_member_price_rule_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>ahy_caliber_nation_member_price_rule_form.ahy_caliber_nation_member_price_rule_form_data_source</dep>
        </deps>
    </settings>

    <dataSource name="ahy_caliber_nation_member_price_rule_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="calibernation/pricerule/save"/>
        </settings>
        <dataProvider name="ahy_caliber_nation_member_price_rule_form_data_source"
                      class="Ahy\CaliberNation\Model\MemberPriceRule\DataProvider">
            <settings>
                <requestFieldName>entity_id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <fieldset name="general">
        <settings>
            <label translate="true">Category Level Discount</label>
        </settings>
        <field name="entity_id" formElement="hidden">
            <settings>
                <dataType>number</dataType>
                <visible>false</visible>
            </settings>
        </field>
        <field name="scope" formElement="select">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Applies To</label>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Ahy\CaliberNation\Model\Config\Source\RuleScope"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="target_id">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Ahy\CaliberNation\Model\Category\Options</item>
                <item name="config" xsi:type="array">
                    <item name="component" xsi:type="string">Ahy_CaliberNation/js/form/element/disabled-ui-select</item>
                    <item name="disabledMessage" xsi:type="string">"%1" already has a discount rule. Please edit the existing record instead.</item>
                    <item name="elementTmpl" xsi:type="string">ui/grid/filters/elements/ui-select</item>
                    <item name="filterOptions" xsi:type="boolean">true</item>
                    <item name="multiple" xsi:type="boolean">false</item>
                    <item name="showCheckbox" xsi:type="boolean">false</item>
                    <item name="disableLabel" xsi:type="boolean">true</item>
                    <item name="label" xsi:type="string" translate="true">Category</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="componentType" xsi:type="string">field</item>
                    <item name="dataScope" xsi:type="string">target_id</item>
                    <item name="sortOrder" xsi:type="number">20</item>
                    <item name="notice" xsi:type="string" translate="true">Search and select the category this discount applies to.</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>
        <field name="discount_type" formElement="select">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Discount Type</label>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Ahy\CaliberNation\Model\Config\Source\DiscountType"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="discount_value" formElement="input">
            <settings>
                <dataType>number</dataType>
                <label translate="true">Discount Value</label>
                <notice translate="true">Percent → % off; Fixed → flat amount off.</notice>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                    <rule name="validate-number" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="is_active" formElement="select">
            <settings>
                <dataType>number</dataType>
                <label translate="true">Active</label>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Magento\Config\Model\Config\Source\Yesno"/>
                    </settings>
                </select>
            </formElements>
        </field>
    </fieldset>
</form>
