<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Show "Member Discount Value" with 2 decimals instead of the raw EAV
         decimal's "50.000000" on the product form. -->
    <virtualType name="Magento\Catalog\Ui\DataProvider\Product\Form\Modifier\Pool">
        <arguments>
            <argument name="modifiers" xsi:type="array">
                <item name="ahyCaliberNationMemberDiscountDecimal" xsi:type="array">
                    <item name="class" xsi:type="string">
                        Ahy\CaliberNation\Ui\DataProvider\Product\Form\Modifier\MemberDiscountDecimal
                    </item>
                    <item name="sortOrder" xsi:type="number">200</item>
                </item>
            </argument>
        </arguments>
    </virtualType>
</config>
