<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <!-- Daily auto-renewal at 03:00. -->
        <job name="ahy_caliber_nation_process_renewals"
             instance="Ahy\CaliberNation\Cron\ProcessRenewals"
             method="execute">
            <schedule>0 3 * * *</schedule>
        </job>
    </group>
</config>
