                $image        = $product['image'] ?? '';
                $price        = isset($product['price'])         ? (float) $product['price']         : null;
                $specialPrice = isset($product['special_price']) ? (float) $product['special_price'] : null;
                $isCfg        = (($product['type'] ?? '') === 'configurable');
                $inStock      = (bool) ($product['in_stock'] ?? true);
                $productId    = (int) ($product['product_id'] ?? $product['id'] ?? 0);
                $hasSpecial   = $specialPrice && $price && $specialPrice < $price;
                $variants     = $product['variants'] ?? [];

                if ($image && !preg_match('#^https?://#', $image)) {
                    $image = $mediaBase . '/' . ltrim($image, '/');
                }
