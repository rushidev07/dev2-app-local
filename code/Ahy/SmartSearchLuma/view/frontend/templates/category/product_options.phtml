<template id="ahy-config-wrap-tpl">
    <div class="ahy-config-wrap">
        <button class="ahy-opts-btn" type="button"><span>Options</span></button>
        <div class="ahy-config-panel">
            <div class="ahy-opts"></div>
            <div class="ahy-panel-footer">
                <button class="action tocart primary ahy-add-to-cart" type="button" disabled>
                    <span>Add to Cart</span>
                </button>
                <button class="ahy-hide-btn" type="button">Hide</button>
            </div>
        </div>
    </div>
</template>

<template id="ahy-opt-group-tpl">
    <div class="ahy-opt-group">
        <span class="ahy-opt-label"></span>
        <div class="ahy-opt-swatches"></div>
    </div>
</template>

<template id="ahy-swatch-tpl">
    <button class="ahy-swatch" type="button"></button>
</template>
