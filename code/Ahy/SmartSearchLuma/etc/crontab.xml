<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">

    <group id="default">
        <job name="ahy_smartsearchluma_delta_sync"
             instance="Ahy\SmartSearchLuma\Cron\ProductSync"
             method="execute">
            <schedule>* * * * *</schedule>
        </job>
        <job name="ahy_smartsearchluma_plp_warm"
             instance="Ahy\SmartSearchLuma\Cron\PlpCacheWarmer"
             method="execute">
            <schedule>*/5 * * * *</schedule>
        </job>
    </group>

</config>
