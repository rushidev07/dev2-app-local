<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:App/etc/config.xsd">
    <default>
        <smart_search>
            <general>
                <frontend_enabled>1</frontend_enabled>
                <enabled>1</enabled>
                <widget_enabled>0</widget_enabled>
                <ssr_shell_enabled>0</ssr_shell_enabled>
                <category_enhancement_enabled>0</category_enhancement_enabled>
                <category_grid_selector>.products.wrapper</category_grid_selector>
                <theme_accent_color></theme_accent_color>
                <api_key></api_key>
                <endpoint_url>http://host.docker.internal:8080/api/v1/ingest/products</endpoint_url>
                <search_url>http://host.docker.internal:8001/api/search.php</search_url>
                <platform_store_id>0</platform_store_id>
                <products_per_page>12</products_per_page>
            </general>
            <plp>
                <ssr_enabled>0</ssr_enabled>
                <cache_ttl>600</cache_ttl>
                <platform_timeout_ms>500</platform_timeout_ms>
                <fallback_min_ratio>0</fallback_min_ratio>
                <warm_enabled>0</warm_enabled>
                <warm_limit>50</warm_limit>
            </plp>
            <no_results_modal>
                <enabled>1</enabled>
                <title>No results for "{query}"</title>
                <subtitle>Try a new search or explore what's trending.</subtitle>
                <section_heading>Trending Products</section_heading>
                <product_count>6</product_count>

            </no_results_modal>
            <cron>
                <last_sync_at></last_sync_at>
            </cron>
        </smart_search>
    </default>
</config>
