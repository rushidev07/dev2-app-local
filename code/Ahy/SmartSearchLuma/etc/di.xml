<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="smartsearchluma_full_sync" xsi:type="object">Ahy\SmartSearchLuma\Console\Command\FullSyncCommand</item>
            </argument>
        </arguments>
    </type>

    <virtualType name="Ahy\SmartSearchLuma\Logger\RealtimeSyncLoggerVirtual" type="Ahy\SmartSearchLuma\Logger\RealtimeSyncLogger">
        <arguments>
            <argument name="name" xsi:type="string">smartsearchluma_realtime</argument>
            <argument name="handlers" xsi:type="array">
                <item name="realtime" xsi:type="object">Ahy\SmartSearchLuma\Logger\Handler\RealtimeSyncHandler</item>
            </argument>
        </arguments>
    </virtualType>

    <type name="Ahy\SmartSearchLuma\Observer\ProductSaveObserver">
        <arguments>
            <argument name="cache" xsi:type="object">Magento\Framework\App\Cache\Type\Config</argument>
            <argument name="logger" xsi:type="object">Ahy\SmartSearchLuma\Logger\RealtimeSyncLoggerVirtual</argument>
        </arguments>
    </type>

    <type name="Ahy\SmartSearchLuma\Observer\StockChangeObserver">
        <arguments>
            <argument name="logger" xsi:type="object">Ahy\SmartSearchLuma\Logger\RealtimeSyncLoggerVirtual</argument>
        </arguments>
    </type>

    <type name="Ahy\SmartSearchLuma\Service\ProductSyncService">
        <arguments>
            <argument name="logger" xsi:type="object">Ahy\SmartSearchLuma\Logger\RealtimeSyncLoggerVirtual</argument>
        </arguments>
    </type>

    <!--
        Ports & Adapters for cart integration. The default adapters below drive
        Magento's own real cart/quote and configurable-attribute APIs — never a
        SKU-string guess, never a bypass of the native add-to-cart contract. A client
        with a non-standard cart (marketplace, custom checkout) swaps either
        preference in their own module's di.xml, without touching this module.
    -->
    <preference for="Ahy\SmartSearchLuma\Api\CartAdapterInterface"
                type="Ahy\SmartSearchLuma\Model\Cart\NativeCartAdapter"/>
    <preference for="Ahy\SmartSearchLuma\Api\VariantResolverInterface"
                type="Ahy\SmartSearchLuma\Model\Cart\NativeVariantResolver"/>

    <!--
        PLP data Port. TEMPORARILY bound directly to the platform adapter,
        bypassing the CachedPlpProvider decorator (ISR cache + last-known-good
        fallback) to test the module's behavior with every render hitting the
        platform live. Revert to CachedPlpProvider (see git history) once
        that experiment is done — without it, a platform outage falls straight
        through to the native Magento grid with no stale-data fallback.
    -->
    <preference for="Ahy\SmartSearchLuma\Api\PlpDataProviderInterface"
                type="Ahy\SmartSearchLuma\Service\Plp\OpenSearchPlpProvider"/>

</config>
