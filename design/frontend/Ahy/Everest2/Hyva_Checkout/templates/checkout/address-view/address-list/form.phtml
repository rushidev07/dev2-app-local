<script>
    (function () {
        function cleanupModal() {
            // Restore body
            document.body.classList.remove(
                '_has-modal',
                'overflow-hidden',
                '_scroll-lock',
                'modal-open'
            );
            document.body.style.overflow = '';
            document.body.style.pointerEvents = '';
            document.documentElement.style.overflow = '';

            // Target every possible overlay selector used by Hyvä/Magento
            const selectors = [
                '.modal-custom-overlay',
                '.modals-overlay',
                '._modal-overlay',
                '.modal-backdrop',
                '.hyva-modal-overlay',
                '.modal-slide-overlay',
                '[data-role="modal-overlay"]',
                '[x-ref="overlay"]',
                '.fixed.inset-0',
                '[aria-modal="true"] ~ div',
            ];

            document.querySelectorAll(selectors.join(',')).forEach(function (el) {
                el.style.pointerEvents = 'none';
                el.style.zIndex = '-1';
                el.style.display = 'none';
                try { el.remove(); } catch(e) {}
            });
        }

        // Hyvä modal close event
        window.addEventListener('modal-closed', function () {
            setTimeout(cleanupModal, 50);
        });

        // Catch clicking outside the modal (on backdrop)
        document.addEventListener('click', function (e) {
            var el = e.target;
            var isBackdrop =
                el.classList.contains('modal-custom-overlay') ||
                el.classList.contains('modals-overlay') ||
                el.classList.contains('modal-backdrop') ||
                el.classList.contains('hyva-modal-overlay') ||
                el.classList.contains('modal-slide-overlay') ||
                el.getAttribute('data-role') === 'modal-overlay' ||
                el.getAttribute('x-ref') === 'overlay' ||
                (el.tagName === 'DIV' && el.classList.contains('fixed') && el.classList.contains('inset-0'));

            if (isBackdrop) {
                setTimeout(cleanupModal, 100);
            }
        }, true);

        // Fallback: watch for modal disappearing from DOM
        var observer = new MutationObserver(function (mutations) {
            mutations.forEach(function (mutation) {
                mutation.removedNodes.forEach(function (node) {
                    if (node.nodeType === 1) {
                        var isModal =
                            node.classList && (
                                node.classList.contains('modal-slide') ||
                                node.classList.contains('modal-popup') ||
                                node.classList.contains('hyva-modal') ||
                                node.getAttribute && node.getAttribute('role') === 'dialog'
                            );
                        if (isModal) {
                            setTimeout(cleanupModal, 100);
                        }
                    }
                });
            });
        });

        observer.observe(document.body, { childList: true, subtree: true });
    })();
</script>