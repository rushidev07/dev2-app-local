<!-- Scroll-to-top button (mobile only) -->
<button id="scroll-to-top" 
        class="fixed bg-ahy-red-light text-white p-3 rounded-full shadow-lg md:hidden" 
        style="display: none; left: 10px; bottom: 10px;">
    <svg xmlns="http://www.w3.org/2000/svg" width="27px" height="17px" viewBox="0 0 24 24" fill="none">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 3C12.2652 3 12.5196 3.10536 12.7071 3.29289L19.7071 10.2929C20.0976 10.6834 20.0976 11.3166 19.7071 11.7071C19.3166 12.0976 18.6834 12.0976 18.2929 11.7071L13 6.41421V20C13 20.5523 12.5523 21 12 21C11.4477 21 11 20.5523 11 20V6.41421L5.70711 11.7071C5.31658 12.0976 4.68342 12.0976 4.29289 11.7071C3.90237 11.3166 3.90237 10.6834 4.29289 10.2929L11.2929 3.29289C11.4804 3.10536 11.7348 3 12 3Z" fill="currentColor"/>
    </svg>
</button>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const btn = document.getElementById('scroll-to-top');

    // Show button only if screen is small (mobile)
    function handleScroll() {
        if (window.innerWidth < 768) { // Tailwind 'md' breakpoint
            btn.style.display = window.scrollY > 200 ? 'block' : 'none';
        } else {
            btn.style.display = 'none';
        }
    }

    window.addEventListener('scroll', handleScroll);
    window.addEventListener('resize', handleScroll); // handle screen resize

    btn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    handleScroll(); // initial check
});
</script>

<style>
.bg-ahy-red-light{
    background-color: rgb(216 58 58/var(--tw-bg-opacity,1));
    width: 50px;
    height: 50px;
}
</style>