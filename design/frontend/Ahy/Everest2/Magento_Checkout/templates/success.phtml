declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Checkout\Block\Onepage\Success;

/** @var Success $block */
/** @var Escaper $escaper */

// Caliber Nation: did this order include the membership product? (viewmodel wired via
// Ahy_CaliberNation checkout_onepage_success.xml)
$cnSuccess  = $block->getData('cn_success');
$cnIsMember = $cnSuccess && $cnSuccess->justBecameMember();
// Membership-only orders ship nothing, so they show a Member Number instead of an
// order number. A mixed order shows BOTH: it still needs its order number for
// fulfilment and tracking.
$cnOnly      = $cnIsMember && $cnSuccess->isMembershipOnly();
$cnMemberNo  = $cnIsMember ? $cnSuccess->getMemberNumber() : null;
// Only suppress the order number when we actually have a number to show in its
// place — never leave the page with no reference at all.
$cnHideOrder = $cnOnly && $cnMemberNo;
?>
<div class="checkout-success container flex flex-col justify-center items-center py-4 px-6">
    <?php if ($block->getOrderId()): ?>
        <?php if ($block->getCanViewOrder()): ?>
            <div class="container flex mt-0 justify-center pt-8 md:pt-12 pb-4 md:pb-8 ">
                <h1 class="text-ahy-blue page-title !font-extrabold title-font uppercase text-3xl md:text-6xl">
                    <span class="base" data-ui-id="page-title-wrapper">Thank you for your purchase!</span>
                </h1>
            </div>
            <?php if ($cnMemberNo): ?>
                <p class="text-center">
                    <?= $escaper->escapeHtml(
                        __('Your member number is: %1.', sprintf('<strong>%s</strong>', $cnMemberNo)),
                        ['strong']
                    ) ?>
                </p>
            <?php endif; ?>
            <?php if (!$cnHideOrder): ?>
                <p class="text-center">
                    <?= $escaper->escapeHtml(
                        __(
                            'Your order number is: %1.',
                            sprintf(
                                '<a href="%s" class="order-number"><strong>%s</strong></a>',
                                $escaper->escapeUrl($block->getViewOrderUrl()),
                                $block->getOrderId()
                            )
                        ),
                        ['a', 'strong']
                    ) ?>
                </p>
            <?php endif; ?>
        <?php  else: ?>
            <div class="container flex mt-0 justify-center pt-8 md:pt-12 pb-4 md:pb-8 ">
                <h1 class="text-ahy-blue page-title text-center !font-extrabold title-font uppercase text-3xl md:text-6xl">
                    <span class="base" data-ui-id="page-title-wrapper">Thank you for your purchase!</span>
                </h1>
            </div>
            <?php if ($cnMemberNo): ?>
                <p class="text-center"><?= $escaper->escapeHtml(__('Your member number is: <span class="font-bold">%1</span>.', $cnMemberNo), ['span']) ?></p>
            <?php endif; ?>
            <?php if (!$cnHideOrder): ?>
                <p class="text-center"><?= $escaper->escapeHtml(__('Your order # is: <span class="font-bold">%1</span>.', $block->getOrderId()), ['span']) ?></p>
            <?php endif; ?>
        <?php endif;?>
        <p class="text-center">
            <?php // Nothing ships on a membership-only order, so don't promise tracking. ?>
            <?= $escaper->escapeHtml(
                $cnHideOrder
                    ? __('We\'ll email you a confirmation with your membership details.')
                    : __('We\'ll email you an order confirmation with details and tracking info.')
            ) ?>
        </p>

        <?php if ($cnIsMember): ?>
            <div class="mt-6 text-center max-w-xl">
                <p class="text-ahy-blue text-xl md:text-2xl font-extrabold uppercase">
                    <?= $escaper->escapeHtml(__('You are now a Caliber Nation Member!')) ?>
                </p>
                <p class="text-center mt-2 text-ahy-blue">
                    <?= $escaper->escapeHtml(__('Enjoy your perks — exclusive member pricing, member-only spotlight deals, and early-bird access to sales.')) ?>
                </p>
                <a href="<?= $escaper->escapeUrl($block->getUrl('caliber-nation/account')) ?>"
                   class="inline-flex items-center justify-center mt-5 bg-ahy-red hover:bg-ahy-red-light text-white font-bold rounded-full px-8 h-12 transition-colors">
                    <?= $escaper->escapeHtml(__('View My Membership')) ?>
                </a>
            </div>
        <?php endif; ?>
    <?php endif; ?>

    <?= $block->getAdditionalInfoHtml() ?>

    <div class="my-4">
        <a class="" href="<?= $escaper->escapeUrl($block->getContinueUrl()) ?>">
            <button class="border-3 border-ahy-blue rounded-full font-bold text-sm w-56 h-12 hover:shadow-[#0d2f47_0px_0px_0px_1px_inset]">
                <span class="font-bold"><?= $escaper->escapeHtml(__('Keep Shopping')) ?></span>
            </button>
        </a>
    </div>
</div>

<script type="text/javascript">
    (function e() {
        var e = document.createElement("script");
        e.type = "text/javascript", e.async = true, e.src = "//staticw2.yotpo.com/NUJogmcy1Rt0zI1mKiVaZY2BjAk7Lh11NmBbS1T9/widget.js";
        var t = document.getElementsByTagName("script")[0];
        t.parentNode.insertBefore(e, t)
    })();
</script>
<script>
    yotpoTrackConversionData = {
        orderId: "<?= $block->getOrderId()?>",
        orderAmount: "<?= $block->getGrandTotal() ?>",
        orderCurrency: "USD"
    }
</script>
<noscript>
    <img src="//api.yotpo.com/conversion_tracking.gif?app_key=NUJogmcylRtOZIlmKiVaZzY2BjAk7Lh11NmBbS1T9&order_id=<?= $block->getOrderId() ?>&order_amount=<?= $block->getGrandTotal() ?>&order_currency=USD" width="1" height="1">
</noscript>