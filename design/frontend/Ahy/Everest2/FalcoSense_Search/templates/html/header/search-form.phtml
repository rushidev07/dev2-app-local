    /* ── No CaliberNation price: use the freed width ────────────────────────
       The column collapses to 1fr, so the normal-price block lays itself out as
       a 2x2 grid instead of a tall stack:

           Sale Price          |  NON-MEMBERS SAVE x% OFF MSRP
           $19.99              |  MSRP  $29.00

       Placement is explicit rather than auto-flow so the no-discount card —
       which has only the title and value — keeps them stacked in column 1
       instead of being pushed side by side. Desktop only; the mobile cards use
       their own markup. */
    @media (min-width: 768px) {
        /* Scoped to :has(.plp-normal-promo) so only the discounted card splits in
           two — a card without a discount has just the price half and keeps its
           normal stacked flow. The two halves are wrapper elements, so each stacks
           independently: the badge no longer sets the height of the row holding
           "Sale Price", which is what was pushing the price away from its label. */
        .plp-price-grid--single .plp-normal-col > div:has(.plp-normal-promo) {
            display: grid;
            grid-template-columns: 1fr 1fr;      /* equal halves, as in the caliber layout */
            column-gap: 24px;
            align-items: start;
        }
        /* Divider drawn as a centred 1px background stripe rather than a border: the
           two halves are individually-placed grid items, not wrapper elements, so a
           border would render as two broken segments. Same #e5e7eb as
           .plp-caliber-col's border-right.

           Gated on :has() so it only appears when the right-hand column actually has
           content. A card with no discount has no badge and no MSRP line, and a rule
           against an empty half is just a stray line. Browsers without :has() drop
           this rule entirely, which loses the divider rather than misplacing it. */
        .plp-price-grid--single .plp-normal-col > div:has(.plp-normal-promo) {
            background-image: linear-gradient(#e5e7eb, #e5e7eb);
            background-size: 1px 100%;
            background-position: center;
            background-repeat: no-repeat;
        }
        .plp-price-grid--single .plp-normal-promo { padding-left: 4px; }
        .plp-price-grid--single .plp-normal-promo .plp-nonmember-wrap { margin-top: 0; }
    }

