                maxlength="<?= $escaper->escapeHtmlAttr($helper->getMaxQueryLength()) ?>"
                class="w-full p-2 py-3 leading-normal placeholder-black transition appearance-none text-grey-800
                       focus:outline-none focus:border-transparent focus:ring-transparent pl-6 rounded-full border-transparent"
                @focus="onFocus()"
                @input.debounce.300="suggest()"
                @keydown.escape="window.dispatchEvent(new CustomEvent('ahy-modal-close'))"
                @keydown.enter.prevent
            />
        </div>

        <button type="submit" title="<?= $escaper->escapeHtml(__('Search')) ?>" class="action search sr-only" aria-label="Search">
            <?= $escaper->escapeHtml(__('Search')) ?>
        </button>
    </form>
