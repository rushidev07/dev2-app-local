<?php
declare(strict_types=1);

use Magento\Catalog\Block\Product\View\Details;
use Magento\Framework\Escaper;
use Hyva\Theme\ViewModel\ProductPage;

/** @var Details $block */
/** @var Escaper $escaper */

$titleRenderer = $block->getChildBlock('product.section.title.renderer');
$defaultTitleTemplate = $titleRenderer->getTemplate();
$productViewModel = $viewModels->require(ProductPage::class);
$product = $productViewModel->getProduct();

$_helper = $this->helper('Webkul\Marketplace\Helper\Data');
$productId = $product->getId();

$sellerCollection = $_helper->getSellerProductDataByProductId($productId);

$sellerDataArray = [];
if ($sellerCollection && $sellerCollection->getSize() > 0) {
    foreach ($sellerCollection->getData() as $item) {
        $sellerId = $item['seller_id'];
        if (!isset($sellerDataArray[$sellerId])) {
            $sellerDataArray[$sellerId] = $item;
        }
    }
}

$shopTitle = '';
$shopUrl = '';
$sellerId = null;

if (!empty($sellerDataArray)) {
    $firstSeller = reset($sellerDataArray);
    $sellerId = $firstSeller['seller_id'];

    $sellerInfoCollection = $_helper->getSellerDataBySellerId($sellerId);
    $sellerInfoArray = [];
    if ($sellerInfoCollection && $sellerInfoCollection->getSize() > 0) {
        foreach ($sellerInfoCollection->getData() as $item) {
            $id = $item['seller_id'];
            if (!isset($sellerInfoArray[$id])) {
                $sellerInfoArray[$id] = $item;
            }
        }
    }

    if (!empty($sellerInfoArray)) {
        $firstInfo = reset($sellerInfoArray);
        $shopTitle = $firstInfo['shop_title'] ?? $firstInfo['name'] ?? '';
        $shopUrl = $firstInfo['shop_url'] ?? '';
    }
}

$handleTitle = [];
$handleContent = [];


foreach ($block->getGroupSortedChildNames('detailed_info', '') as $sectionName) {
    $sectionBlock = $block->getLayout()->getBlock($sectionName);
    $sectionHtml = (string) $sectionBlock->toHtml();
    $titleTemplate = $sectionBlock->getData('title_template') ?? $defaultTitleTemplate;

    if (empty(trim($sectionHtml))) {
        continue;
    }

    $rawTitle = $sectionBlock->getTitle() ?: '&nbsp;';
    $rawTitle = (strpos($rawTitle, 'Q/A') !== false) ? str_replace('Q/A', 'FAQs', $rawTitle) : $rawTitle;
    $handleTitle[] = $escaper->escapeHtml($rawTitle);
    $handleContent[] = $sectionHtml;
 
}
    if (isset($shopTitle) && strtolower(trim($shopTitle)) == 'off the grid surplus' || strtolower(trim($shopTitle)) == 'off the grid'){        // Render the size chart block
        $sizeChartHtml = $block->getLayout()
            ->createBlock(\Magento\Framework\View\Element\Template::class)
            ->setTemplate('Magento_Catalog::product/view/sections/product-custom-sections/size-charts.phtml')
            ->setData('product', $product)
            ->toHtml();

        $plainText = trim(strip_tags($sizeChartHtml));

        if (!empty($plainText) && strpos($plainText, 'No special content for this product.') === false) {
            $handleTitle[] = 'Size charts';
            $handleContent[] = $sizeChartHtml;
        }
    }

$tabTitle = '';
$tabContent = '';

foreach ($handleTitle as $title) {
    $tabTitle .= '
        <a :class="{ \'active border-b-4 border-ahy-blue text-ahy-blue\': tab === \'' . $title . '\' }"
            @click.prevent="tab = \'' . $title . '\'" href="#" class="text-sm mx-4 font-bold pb-4 pt-6 mt-1" :id="$id(\'' . $title . '\')"
            data-title= "' . $title . '">' . $title .'</a>
        ';

    $tabContent .= '<div x-show="tab === \'' . $title . '\'"> ' . array_shift($handleContent) . ' </div>';
}
?>
<div 
    x-data="{ 
        tab: '<?= $handleTitle[0] ?>',
        isMobile: (window.innerWidth < 768) ? true : false,
        open: false
    }" 
    id="tab_wrapper" class="pt-8 pl-4"
    x-on:resize.window="isMobile = (window.innerWidth < 768) ? true : false" 
>
    <div 
        class="text-center tab-bg-line-desktop overflow-auto md:overflow-visible pb-4 uppercase flex justify-start md:justify-center" 
        :class="{'w-screen left-1/2 right-1/2 mx-[-50vw] relative': isMobile}"
    >
        <div class="bg-ahy-bg text-ahy-blue tab-bg-mobile relative flex pr-4 pl-4 sm:pl-6 shadow-lg md:rounded-full md:pr-8 md:pl-12 w-[767px] sm:justify-center md:w-full">
            <?= $tabTitle ?>
        </div>
    </div>
    <div class="flex flex-col mt-4 xl:w-[77%] xl:m-auto pt-4 md:pt-11">
        <?= $tabContent ?>
    </div>
</div>

