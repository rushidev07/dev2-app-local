declare(strict_types=1);

use Magento\Catalog\Block\Product\Image;
use Magento\Framework\Escaper;

/** @var Image $block */
/** @var Escaper $escaper */

$hasLoadingAttribute = ($block->getCustomAttributes() ?: [])['loading'] ?? false;

// Rewrite Magento cached image URL → static CDN URL
$magentoUrl = $block->getImageUrl();
$relPath    = preg_replace('#^https?://[^/]+/pub/media/#', '', $magentoUrl);
$relPath    = preg_replace('#^catalog/product/cache/[^/]+/#', 'catalog/product/', $relPath);
$imageUrl   = 'https://static.everest.com/media/' . $relPath;
?>
<img class="hover:shadow-sm object-contain <?= $escaper->escapeHtmlAttr($block->getClass()) ?>"
     x-data=""
     @update-gallery-<?= (int)$block->getProductId() ?>.window="$root.src = $event.detail"
    <?php foreach ($block->getCustomAttributes() as $name => $value): ?>
        <?= $escaper->escapeHtmlAttr($name) ?>="<?= $escaper->escapeHtmlAttr($value) ?>"
    <?php endforeach; ?>
    src="<?= $escaper->escapeUrl($imageUrl) ?>"
    fetchpriority="high"
    <?php if (! $hasLoadingAttribute): ?>
    loading="eager"
    <?php endif; ?>
    width="<?= $escaper->escapeHtmlAttr($block->getWidth()) ?>"
    height="<?= $escaper->escapeHtmlAttr($block->getHeight()) ?>"
    alt="<?= $escaper->escapeHtmlAttr($block->getLabel()) ?>"
    title="<?= $escaper->escapeHtmlAttr($block->getLabel()) ?>"
/>
