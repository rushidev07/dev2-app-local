<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="page.main.title">
            <arguments>
                <argument name="css_class" xsi:type="string">justify-center items-center !p-0 mb-4 catalog_category_view_ahy</argument>
            </arguments>
        </referenceBlock>

        <!-- Remove all default/Klevu product list blocks — SmartSearch renders its own -->
        <referenceBlock name="category.products"        remove="true"/>
        <referenceBlock name="klevu_metadata_category"  remove="true"/>
         <referenceBlock name="sale.reorder.sidebar"     remove="true"/>
    </body>
</page>
