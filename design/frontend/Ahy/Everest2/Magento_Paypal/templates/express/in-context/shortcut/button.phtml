declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Paypal\Block\Express\InContext\Minicart\SmartButton;

/** @var SmartButton $block */
/** @var Escaper $escaper */

/*
 * This template renders the PayPal in-context shortcut button for the mini-cart and the cart.
 * For the mini-cart, the html is part of the cart.extra_actions private section data, and is injected via JS.
 */

for ($candidate = $block, $isCartPage = false; $candidate && !$isCartPage; $candidate = $candidate->getParentBlock()) {
    $isCartPage = $candidate->getNameInLayout() === 'checkout.cart.shortcut.buttons';
}
$isMinicart = !$isCartPage;

$widgetData = json_decode($block->getJsInitParams(), true);
$clientConfig = json_encode($widgetData['Magento_Paypal/js/in-context/button']['clientConfig']);
$ahyHelperSession = $this->helper('Ahy\ThemeCustomization\Helper\Session');
$ahyHelper = $this->helper('Ahy\ThemeCustomization\Helper\Data');
$checkoutSession = $ahyHelperSession->getCheckoutSession();
$quote = $checkoutSession->getQuote();
$isFflRequired = false;
$isAgeVerificationRequired = false;
$isBlockedCategory = false;
$isBlockedSku = false;
$blockedCategoryIds = [3614, 921, 490, 521, 44];
$blockedSkuPrefixes = ['KIN-'];
foreach ($quote->getAllItems() as $item) {
    $product = $item->getProduct();
    $productId = $product->getId();
    $itemFflRequired = $ahyHelper->getProductAttribute($productId, 'ffl_selection_required');
    $itemAgeVerificationRequired = $ahyHelper->getProductAttribute($productId, 'age_verification_required');
    $itemBlockedCategory = false;
    $categoryCollection = $product->getCategoryCollection()->addAttributeToSelect('path');
    foreach ($categoryCollection as $category) {
        $pathIds = explode('/', $category->getPath());
        if (array_intersect($blockedCategoryIds, $pathIds)) {
            $itemBlockedCategory = true;
        }
    }
    $sku = (string)$product->getSku();
    $itemBlockedSku = false;
    foreach ($blockedSkuPrefixes as $prefix) {
        if (str_starts_with($sku, $prefix)) {
            $itemBlockedSku = true;
            break;
        }
    }

    $isFflRequired = $itemFflRequired;
    $isAgeVerificationRequired = $itemAgeVerificationRequired;
    $isBlockedCategory = $itemBlockedCategory;
    $isBlockedSku = $itemBlockedSku;
    if ($isFflRequired || $isAgeVerificationRequired || $isBlockedCategory || $isBlockedSku) {
        break;
    }
}

$renderTargetElementId = sprintf('paypalInContextRenderTarget%d', $isMinicart);
?>
<?php if (!$isFflRequired && !$isAgeVerificationRequired && !$isBlockedCategory && !$isBlockedSku): ?>
    <div x-data="initPayPalInContextButton(
            '<?= $escaper->escapeJs($renderTargetElementId) ?>',
            <?= $escaper->escapeHtmlAttr($clientConfig) ?>,
            <?= (int) $isMinicart ?>
        )" id="<?= $escaper->escapeHtmlAttr($renderTargetElementId) ?>" <?php if ($isMinicart): ?>
            x-init="cartSection = cart; checkAndInitializeButtons()"
            @toggle-cart.window="$nextTick(() => checkAndInitializeButtons())"
            @private-content-loaded.window="getData($event.detail.data); checkAndInitializeButtons()" <?php endif; ?>
        class="paypal checkout paypal-logo min-h-a11y cart-extra-actions-container isolate <?= $isMinicart ? 'minicart-padding' : '' ?>"
        <?php if ($isCartPage): ?> @private-content-loaded.window="getData($event.detail.data); checkAndInitializeButtons()"
        <?php endif; ?>>
    </div>
    <script>
        function initPayPalInContextButton(renderTargetId, config, isMinicart) {
            return {
                cartSection: false,
                actions: {},
                alreadyLoaded: false,
                isInitializing: false,
                fallbackPollActive: false,
                getData(sectionData) {
                    this.cartSection = sectionData.cart;
                },
                initializePayPalScript() {
                    if (!window.paypalScriptPromise) {
                        window.paypalScriptPromise = new Promise((resolve, reject) => {
                            const scriptId = 'paypal-script';

                            const paypalScript = document.getElementById(scriptId);
                            if (paypalScript) {
                                if (window.paypal) {
                                    return resolve(window.paypal);
                                }
                            }

                            const script = document.createElement('script');
                            script.src = config.sdkUrl;
                            script.id = scriptId;
                            script.setAttribute('data-partner-attribution-id', config.dataAttributes['data-partner-attribution-id']);
                            script.onload = () => resolve(window.paypal);
                            script.onerror = () => reject(new Error('<?= $escaper->escapeJs('PayPal SDK could not be loaded') ?>'));
                            document.body.appendChild(script);
                        });
                    }

                    return window.paypalScriptPromise;
                },
                async initializeButtons() {
                    try {
                        const paypal = await this.initializePayPalScript();
                        if (!paypal) {
                            return;
                        }

                        await paypal.Buttons({
                            style: Object.assign({}, config.styles, {
                                height: 55, // Sets the style.height option to a value from 25 to 55.
                                disableMaxWidth: false, // The button has a default maximum width of 750px, but you can make the button larger with true and set container size
                                tagline: false // Set the style.layout to horizontal for taglines.
                            }),
                            onInit: (data, actions) => {
                                this.actions = actions || this.actions;
                            },
                            onClick: async (data, actions) => {
                                this.actions = actions || this.actions;
                            },
                            createOrder() {
                                const params = 'quote_id=' + config.quoteId +
                                    '&customer_id=' + (config.customerId || '') +
                                    '&form_key=' + hyva.getFormKey() +
                                    '&button=' + config.button;

                                return window.fetch(config.getTokenUrl, {
                                    headers: {
                                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                                        'X-Requested-With': 'XMLHttpRequest',
                                    },
                                    body: params,
                                    method: 'POST',
                                    mode: 'cors',
                                    credentials: 'include'
                                })
                                    .then(response => response.json())
                                    .then(result => result.token)
                                    .catch(console.error);
                            },

                            onApprove(data, actions) {
                                const params = 'paymentToken=' + (data.orderID || '') +
                                    '&payerId=' + (data.payerID || '') +
                                    '&quoteId=' + (config.quoteId || '') +
                                    '&customerId=' + (config.customerId || '') +
                                    '&form_key=' + hyva.getFormKey();

                                return window.fetch(config.onAuthorizeUrl, {
                                    headers: {
                                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                                        'X-Requested-With': 'XMLHttpRequest',
                                    },
                                    body: params,
                                    method: 'POST',
                                    mode: 'cors',
                                    credentials: 'include'
                                })
                                    .then(response => response.json())
                                    .then(result => {
                                        if (result.success) {
                                            return actions.redirect(result.redirectUrl);
                                        }

                                        throw new Error(result['error_message']);
                                    })
                                    .catch(console.error).finally(() => {
                                        window.dispatchEvent(new Event('reload-customer-section-data'));
                                    });
                            },
                            onCancel(data, actions) {
                                window.dispatchEvent(new Event('reload-customer-section-data'));

                                if (isMinicart) {
                                    window.dispatchEvent(new CustomEvent('toggle-cart', { detail: { isOpen: false } }));
                                }

                                return window.dispatchMessages([{
                                    type: 'error',
                                    text: '<?= $escaper->escapeJs(__('Paypal Express Checkout has been canceled.')) ?>'
                                }]);
                            },
                            onError(err) {
                                window.dispatchEvent(new Event('reload-customer-section-data'));

                                // Alternative: forward to cart
                                //window.location.href = config.onCancelUrl;

                                if (isMinicart) {
                                    window.dispatchEvent(new CustomEvent('toggle-cart', { detail: { isOpen: false } }));
                                }

                                return window.dispatchMessages([{
                                    type: 'error',
                                    text: '<?= $escaper->escapeJs(__('Error initializing Express Checkout, please try again later or choose a different checkout method.')) ?>'
                                }]);
                            }
                        }).render(document.getElementById(renderTargetId));
                        this.alreadyLoaded = true;
                    } catch (error) {
                        document.getElementById(renderTargetId).innerHTML = '';
                        console.error('Error loading PayPal SDK', error);
                    } finally {
                        this.isInitializing = false;
                    }
                },
                checkAndInitializeButtons(retriesLeft = 10) {
                    const targetEl = document.getElementById(renderTargetId);
                    const hiddenAncestor = targetEl ? targetEl.closest('[style*="display: none"]') : null;

                    // Magento's private-content reload morphs the mini-cart's DOM instead of
                    // fully destroying/recreating it, so this Alpine component's JS state
                    // (including alreadyLoaded) survives across cart updates — but the morph
                    // still resets this container's actual HTML back to the bare empty <div>
                    // the server sends, wiping out whatever the PayPal SDK had rendered into
                    // it. That leaves alreadyLoaded stuck at true with nothing actually on
                    // screen. Detect that mismatch and clear the stale flag so we re-render.
                    // Gated on !isInitializing — initializeButtons() is async, so there's a
                    // real window where alreadyLoaded is about to become true but the button
                    // hasn't rendered into the DOM yet; without this gate, any trigger that
                    // fires during that window looks identical to "wiped by morph" and causes
                    // a second, overlapping render (PayPal's render() appends, it doesn't
                    // replace, so overlapping calls stack multiple buttons).
                    if (this.alreadyLoaded && !this.isInitializing && targetEl && targetEl.childElementCount === 0) {
                        this.alreadyLoaded = false;
                    }

                    if (this.alreadyLoaded || this.isInitializing) {
                        return;
                    }
                    if (this.cartSection.items && this.cartSection.items.length) {
                        if (!targetEl || !!hiddenAncestor) {
                            if (retriesLeft > 0) {
                                setTimeout(() => this.checkAndInitializeButtons(retriesLeft - 1), 50);
                            } else if (hiddenAncestor) {
                                const observer = new MutationObserver(() => {
                                    if (!hiddenAncestor.style.display) {
                                        observer.disconnect();
                                        this.checkAndInitializeButtons();
                                    }
                                });
                                observer.observe(hiddenAncestor, { attributes: true, attributeFilter: ['style'] });

                                // Safety net for when hiddenAncestor is a STALE, DETACHED
                                // reference (e.g. an Alpine x-if rebuild replaced this exact
                                // node with a new one) — the observer above then watches a
                                // node no longer in the page and never fires. This is a SINGLE
                                // bounded poll (20 x 500ms = 10s) that re-queries fresh DOM
                                // state each tick, guarded by fallbackPollActive so it can
                                // never stack multiple concurrent chains — it does NOT call
                                // back into checkAndInitializeButtons() on every tick (that
                                // caused an earlier version of this fix to spawn a new
                                // observer + new poll chain every 500ms indefinitely).
                                if (!this.fallbackPollActive) {
                                    this.fallbackPollActive = true;
                                    let fallbackAttempts = 20;
                                    const fallbackPoll = () => {
                                        if (this.alreadyLoaded || this.isInitializing) {
                                            this.fallbackPollActive = false;
                                            return;
                                        }
                                        fallbackAttempts--;
                                        const freshTarget = document.getElementById(renderTargetId);
                                        const stillHidden = freshTarget ? freshTarget.closest('[style*="display: none"]') : null;
                                        if (freshTarget && !stillHidden) {
                                            this.fallbackPollActive = false;
                                            this.checkAndInitializeButtons();
                                            return;
                                        }
                                        if (fallbackAttempts > 0) {
                                            setTimeout(fallbackPoll, 500);
                                        } else {
                                            this.fallbackPollActive = false;
                                        }
                                    };
                                    setTimeout(fallbackPoll, 500);
                                }
                            }
                            return;
                        }
                        this.isInitializing = true;
                        this.initializeButtons();
                        return;
                    }
                    if (retriesLeft > 0) {
                        setTimeout(() => this.checkAndInitializeButtons(retriesLeft - 1), 50);
                    }
                }
            }
        }
    </script>
<?php endif; ?>

<style>
    #cart-drawer .minicart-padding {
        padding-left: .80rem;
        padding-right: .80rem;
    }
</style>